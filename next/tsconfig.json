{
  "extends": "../tsconfig.nsh.json",
  "compilerOptions": {
    "resolveJsonModule": true,
    "paths": {
      "nsh": ["./demos/.nsh/types/nsh/index.d.ts"],
      "nsh/*": ["./demos/.nsh/types/nsh/*.d.ts"],
      "@shadcn-nsh/theme": ["./theme/index.ts"]
    }
  },
  "files": [
    "./demos/.nsh/types/nsh/globals.d.ts",
    "./demos/.nsh/types/nsh/assets.d.ts",
    "./demos/.nsh/types/nsh/tokens.d.ts"
  ],
  "include": ["./theme/**/*.ts", "./ui/**/*.ts", "./ui/**/*.tsx"]
}
