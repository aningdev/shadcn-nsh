---
import Docs from "../../../layouts/Docs.astro";
import { withBase } from "../../../lib/base";
import { components } from "../../../lib/components";
---

<Docs
  title="Components"
  description="Copy-into-app components for Native Shell, built on nsh/base."
>
  <p>
    {components.length} components, one page each: Installation, Usage, Examples and API. Behavior,
    keyboard support and the full unstyled props live on{" "}
    <a href="https://nsh.dev/elements">nsh.dev/elements</a>; each page links its base element.
  </p>
  <p>
    The list is generated from <code>registry.json</code> and these pages, so every{" "}
    <code>registry:ui</code> item has a page and every page has an item. Add one with{" "}
    <code>npx shadcn-nsh@latest add &lt;name&gt;</code>.
  </p>
  <ul>
    {components.map((c) => (
      <li>
        <a href={withBase(`docs/components/${c.slug}`)}>{c.title}</a>
        <span style="color: var(--muted-foreground)"> — {c.description}</span>
      </li>
    ))}
  </ul>
</Docs>
