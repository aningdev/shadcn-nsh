---
import Docs from "../../../layouts/Docs.astro";
import { withBase } from "../../../lib/base";
import { components } from "../../../lib/components";
---

<Docs title="Components" description="Phase-1 styled wrappers on nsh/base.">
  <h1>Components</h1>
  <p class="lead">
    Phase-1 inventory mirrors <code>nsh/base</code> as documented in
    <code>references/nsh/website/elements</code>. Full map:
    <code>packages/ui/COMPONENTS.md</code>.
  </p>
  <ul>
    {
      components.map((c) => (
        <li>
          <a href={withBase(`docs/components/${c.slug}`)}>{c.title}</a>
        </li>
      ))
    }
  </ul>
</Docs>
