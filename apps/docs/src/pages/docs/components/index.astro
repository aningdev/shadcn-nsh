---
import Docs from "../../../layouts/Docs.astro";
import { withBase } from "../../../lib/base";
import { components } from "../../../lib/components";
---

<Docs title="Components" description="Phase-1 styled wrappers on nsh/base.">
  <p>
    Phase-1 inventory mirrors <code>nsh/base</code> as documented on{" "}
    <a href="https://nsh.dev/elements">nsh.dev/elements</a>. Each page covers Install, Usage,
    Composition / Examples when useful, API, Differences (vs shadcn), and Not forwarded (vs base);
    behavior deep-links to nsh.
  </p>
  <p>
    Extensions (no matching <code>nsh/base</code> export) and Phase-2 components are documented in{" "}
    <code>packages/ui/COMPONENTS.md</code> — this site does not list pages for them.
  </p>
  <ul>
    {
      components.map((c) => (
        <li>
          <a href={withBase(`docs/components/${c.slug}`)}>{c.title}</a>
          <span style="color: var(--muted-foreground)"> — {c.description}</span>
        </li>
      ))
    }
  </ul>
</Docs>
