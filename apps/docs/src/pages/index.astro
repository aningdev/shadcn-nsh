---
import Docs from "../layouts/Docs.astro";
import { withBase } from "../lib/base";
---

<Docs title="Docs" description="Styled NSH components — copy-into-app, monorepo-ready.">
  <p>
    Styled component layer for <a href="https://nsh.dev">Native Shell</a>: copy components into your
    app from the registry, same idea as shadcn/ui on Radix.
  </p>
  <p>
    Start with <a href={withBase("docs/getting-started")}>Getting started</a>, read{" "}
    <a href={withBase("docs/theme")}>Theme</a>, or jump to{" "}
    <a href={withBase("docs/components/button")}>Button</a>. Behavior and a11y deep-link to{" "}
    <a href="https://nsh.dev/elements">nsh.dev/elements</a>.
  </p>
  <blockquote>
    Live web demos use NSH’s web target (WASM → DOM) — behaviour sketch, not a platform substitute.
    Prefer <code>apps/gallery</code> for native / a11y checks.
  </blockquote>
</Docs>
