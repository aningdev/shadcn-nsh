---
import { demoPanelHtml } from "../lib/demo.js";

interface Props {
  name: string;
  /** Kept for frontmatter compat; panel sizes the iframe itself. */
  height?: number;
}

const { name } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const html = await demoPanelHtml(name, { base });
---

<Fragment set:html={html} />
