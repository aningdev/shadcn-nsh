---
import DemoFrame from "../components/DemoFrame.astro";
import { components } from "../lib/components";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  frontmatter?: {
    title?: string;
    description?: string;
    demo?: string;
    component?: boolean;
  };
}

const title = Astro.props.title ?? Astro.props.frontmatter?.title ?? "Docs";
const description = Astro.props.description ?? Astro.props.frontmatter?.description;
const demo = Astro.props.frontmatter?.demo;
const isComponentPage = !!Astro.props.frontmatter?.component || !!demo;
const path = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · shadcn-nsh</title>
    {description ? <meta name="description" content={description} /> : null}
  </head>
  <body>
    <div class="site">
      <header class="site-header">
        <a class="brand" href="/">
          shadcn-nsh
        </a>
        <nav class="nav" aria-label="Primary">
          <a
            href="/docs/getting-started"
            aria-current={path.includes("getting-started") ? "page" : undefined}
          >
            Getting started
          </a>
          <a
            href="/docs/components"
            aria-current={path.includes("/docs/components") ? "page" : undefined}
          >
            Components
          </a>
          <a href="/llms.txt">llms.txt</a>
        </nav>
      </header>
      <div class="layout">
        <aside class="side">
          <nav aria-label="Docs">
            <a
              href="/docs/getting-started"
              aria-current={path.includes("getting-started") ? "page" : undefined}
            >
              Getting started
            </a>
            <a
              href="/docs/components"
              aria-current={
                path === "/docs/components" || path === "/docs/components/" ? "page" : undefined
              }
            >
              All components
            </a>
            {
              components.map((c) => (
                <a
                  href={`/docs/components/${c.slug}`}
                  aria-current={
                    path === `/docs/components/${c.slug}` ||
                    path === `/docs/components/${c.slug}/`
                      ? "page"
                      : undefined
                  }
                >
                  {c.title}
                </a>
              ))
            }
          </nav>
        </aside>
        <main class="prose">
          {
            isComponentPage ? (
              <>
                <h1>{title}</h1>
                {demo ? (
                  <>
                    <h2>Preview</h2>
                    <p>
                      Web preview (NSH <code>--target web</code>). For native behaviour use the
                      gallery.
                    </p>
                    <DemoFrame name={demo} height={300} />
                  </>
                ) : null}
              </>
            ) : null
          }
          <slot />
        </main>
      </div>
    </div>
  </body>
</html>
