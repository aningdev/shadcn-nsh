{
  "name": "shadcn-nsh showcase",
  "id": "dev.shadcn-nsh.showcase",
  "version": "0.0.0",
  "build": 1,
  "appearance": "system",
  "schemes": ["shadcn-nsh"],
  "theme": "../../packages/theme/theme.json",
  "capabilities": {
    "network": {
      "hosts": ["*"],
      "sockets": ["127.0.0.1:9876"]
    },
    "fs": {
      "read": ["${dataDir}"],
      "write": ["${dataDir}"]
    },
    "process": {
      "exit": false,
      "execute": ["echo", "cat", "sh", "bash", "zsh", "cmd.exe", "claude", "codex"],
      "env": ["NSH_GALLERY_DEMO", "NSH_GALLERY_SECTION"]
    },
    "webview": {
      "hosts": ["*"]
    },
    "statusBar": true,
    "clipboard": true,
    "openUrl": {
      "schemes": ["https", "shadcn-nsh"]
    },
    "picker": true,
    "share": true,
    "speech": true,
    "notifications": true,
    "audio": true,
    "windows": {
      "kinds": ["normal", "dialog", "panel", "popup"]
    },
    "application": true,
    "homeDir": true
  },
  "resolve": {
    "alias": {
      "@": "../..",
      "@shadcn-nsh/theme": "../../packages/theme/index.ts",
      "@shadcn-nsh/ui": "../../packages/ui/index.ts",
      "@shadcn-nsh/theme-nsh-gallery": "../../packages/theme/themes/nsh-gallery/index.ts",
      "@shadcn-nsh/theme-shadcn": "../../packages/theme/themes/shadcn/index.ts",
      "@shadcn-nsh/theme-solid-glass": "../../packages/theme/themes/solid-glass/index.ts",
      "@shadcn-nsh/theme-apple": "../../packages/theme/themes/apple/index.ts",
      "@shadcn-nsh/theme-material": "../../packages/theme/themes/material/index.ts",
      "@shadcn-nsh/theme-winui": "../../packages/theme/themes/winui/index.ts"
    }
  }
}
