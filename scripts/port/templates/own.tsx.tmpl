// A {{id}}: the look (`{{lookFn}}`) and the `{{Id}}` that wears it.
// TODO(port): add the imports the look needs (`@shadcn-nsh/theme`, `nsh`, `./lib/*`).
import type { JSX } from "nsh";
import { split } from "nsh";
import { {{Base}} as Base{{Id}}, type {{Base}}Props as Base{{Id}}Props } from "nsh/base";

/**
 * `nsh/base`'s {{Base}} with {{id}} feedback and nothing else. Every base prop passes through; the
 * style props go over the look's. TODO(port): document what the look adds.
 */
export type {{Id}}Props = Omit<Base{{Id}}Props, "children"> & {
  /** A string is the label; anything else is drawn as given. */
  children?: string | JSX.Element;
};

/** A {{id}}. TODO(port): wire the look's options. */
export function {{Id}}(props: {{Id}}Props) {
  const [, rest] = split(props, [
    "children",
    "style",
    "hoverStyle",
    "activeStyle",
    "focusVisibleStyle",
    "disabledStyle",
  ]);
  const look = {{lookFn}}();
  return (
    <Base{{Id}}
      {...rest}
      style={[look.style, props.style ?? null]}
      hoverStyle={[look.hoverStyle ?? null, props.hoverStyle ?? null]}
      activeStyle={[look.activeStyle ?? null, props.activeStyle ?? null]}
      focusVisibleStyle={[look.focusVisibleStyle, props.focusVisibleStyle ?? null]}
      disabledStyle={[look.disabledStyle ?? null, props.disabledStyle ?? null]}
    >
      {props.children}
    </Base{{Id}}>
  );
}
