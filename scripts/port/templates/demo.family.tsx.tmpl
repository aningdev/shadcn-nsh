import { colors } from "@shadcn-nsh/theme";
import { mount, signal, Text, View } from "nsh";

import {
  {{Id}},
  {{Id}}Close,
  {{Id}}Content,
  {{Id}}Trigger,
} from "../ui/{{id}}";

function App() {
  const last = signal("–");

  return (
    <View style={{ flex: 1, backgroundColor: colors.background, padding: 20, gap: 14 }}>
      <Text style={{ fontSize: 22, fontWeight: "700", color: colors.text }}>{{Id}}</Text>
      <View style={{ flexDirection: "row" }}>
        {/* TODO(port): fill the composition to match the upstream demo */}
        <{{Id}}
          onOpenChange={({ open, reason }) => last.set(`${open ? "open" : "closed"}: ${reason}`)}
        >
          <{{Id}}Trigger variant="primary">Open…</{{Id}}Trigger>
          <{{Id}}Content>
            <{{Id}}Close>Close</{{Id}}Close>
          </{{Id}}Content>
        </{{Id}}>
      </View>
      <Text style={{ fontSize: 13, color: colors.muted }}>{last()}</Text>
    </View>
  );
}

mount(App);
