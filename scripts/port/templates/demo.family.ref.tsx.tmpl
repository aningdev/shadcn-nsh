// The reference of `{{id}}.tsx`: the same page as upstream writes a {{id}}, the look spread
// on `nsh/base`'s {{Base}}. The render check requires the two to draw the same pixels.
import { mount, signal, Text, View } from "nsh";
import { {{Base}} } from "nsh/base";

import { DemoPage } from "./kit";

// TODO(port): import the look helpers and rebuild the page without the composition shell.

function App() {
  const open = signal(false);
  const last = signal("–");

  return (
    <DemoPage title="{{Id}}" note={() => last()}>
      <View style={{ flexDirection: "row" }}>
        {/* TODO(port): trigger that sets open, content that spreads the look on {{Base}} */}
        <{{Base}}
          open={open()}
          onOpenChange={({ open: next, reason }) => {
            open.set(next);
            last.set(`${next ? "open" : "closed"}: ${reason}`);
          }}
        >
          <Text>TODO(port)</Text>
        </{{Base}}>
      </View>
    </DemoPage>
  );
}

mount(App);
