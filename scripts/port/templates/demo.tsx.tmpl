import { mount } from "nsh";

import { {{Id}} } from "../ui/{{id}}";
import { DemoCard, DemoPage, DemoSection } from "./kit";

function App() {
  return (
    <DemoPage title="{{Id}}">
      <DemoCard>
        <DemoSection title="Variant">
          {/* TODO(port): one control per variant */}
          <{{Id}}>{{Id}}</{{Id}}>
        </DemoSection>
        <DemoSection title="Size">
          {/* TODO(port): one control per size */}
          <{{Id}}>{{Id}}</{{Id}}>
        </DemoSection>
        <DemoSection title="States">
          {/* TODO(port): selected / busy / disabled as the look supports */}
          <{{Id}} disabled>{{Id}}</{{Id}}>
        </DemoSection>
      </DemoCard>
    </DemoPage>
  );
}

mount(App);
