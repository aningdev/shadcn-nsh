// The reference of `{{id}}.tsx`: the same page as upstream writes a {{id}}, the look spread
// on `nsh/base`'s {{Base}}. The render check requires the two to draw the same pixels.
import { mount, Text } from "nsh";
import { {{Base}} } from "nsh/base";

import { {{lookFn}} } from "../ui/{{id}}";
import { DemoCard, DemoPage, DemoSection } from "./kit";

function App() {
  return (
    <DemoPage title="{{Id}}">
      <DemoCard>
        <DemoSection title="Variant">
          {/* TODO(port): same controls as {{id}}.tsx, look spread on {{Base}} */}
          <{{Base}} {...{{lookFn}}(/* TODO(port): options */)}>
            <Text>{{Id}}</Text>
          </{{Base}}>
        </DemoSection>
        <DemoSection title="Size">
          <{{Base}}>
            <Text>{{Id}}</Text>
          </{{Base}}>
        </DemoSection>
        <DemoSection title="States">
          <{{Base}} disabled>
            <Text>{{Id}}</Text>
          </{{Base}}>
        </DemoSection>
      </DemoCard>
    </DemoPage>
  );
}

mount(App);
