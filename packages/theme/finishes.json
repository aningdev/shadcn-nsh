{
  "dark": {
    "card": {
      "boxShadow": "0 1px 0 rgba(0,0,0,0.35)"
    },
    "raised": {
      "boxShadow": "inset 0 0 0 1px rgba(255,255,255,0.06), inset 0 1px 1px rgba(255,255,255,0.08), 0 1px 1px rgba(0,0,0,0.12)"
    },
    "hover": {
      "boxShadow": "inset 0 0 0 1px rgba(255,255,255,0.07), inset 0 1px 1px rgba(255,255,255,0.09), 0 1px 1px rgba(0,0,0,0.12)"
    },
    "pressed": {
      "boxShadow": "inset 0 1px 1px rgba(0,0,0,0.18)"
    },
    "on": {
      "boxShadow": "inset 0 0 0 1px rgba(255,255,255,0.10), inset 0 1px 1px rgba(255,255,255,0.12), 0 1px 1px rgba(0,0,0,0.12)"
    },
    "accent": {
      "boxShadow": "inset 0 0 0 1px rgba(255,255,255,0.14), inset 0 1px 1px rgba(255,255,255,0.18), 0 1px 1px rgba(0,0,0,0.2)"
    },
    "menu": {
      "boxShadow": "0 1px 0 rgba(0,0,0,0.4), 0 16px 32px -10px rgba(0,0,0,0.6)"
    }
  },
  "light": {
    "card": {
      "boxShadow": "0 1px 0 rgba(10,15,25,0.04)"
    },
    "raised": {
      "boxShadow": "inset 0 1px 0 #ffffff, inset 0 2px 0 rgba(255,255,255,0.6), 0 1px 0 rgba(10,15,25,0.05)"
    },
    "hover": {
      "boxShadow": "inset 0 1px 0 #ffffff, inset 0 2px 0 rgba(255,255,255,0.6), 0 1px 0 rgba(10,15,25,0.05)"
    },
    "pressed": {
      "boxShadow": "inset 0 1px 1px rgba(10,15,25,0.10)"
    },
    "on": {
      "boxShadow": "inset 0 1px 0 rgba(255,255,255,0.35), 0 1px 0 rgba(10,15,25,0.05)"
    },
    "accent": {
      "boxShadow": "inset 0 1px 0 rgba(255,255,255,0.35), inset 0 -1px 0 rgba(0,0,0,0.06), 0 1px 0 rgba(10,15,25,0.08)"
    },
    "menu": {
      "boxShadow": "0 1px 0 rgba(10,15,25,0.04), 0 12px 28px -10px rgba(10,15,25,0.22)"
    }
  }
}
