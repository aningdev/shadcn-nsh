{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Appearance-invariant surface finish recipes for the Apple theme (Apple Liquid Glass material and Retina hairlines).",
  "finish": {
    "card": {
      "$description": "A surface that holds content: a card, a section.",
      "background": {
        "$type": "color",
        "$value": "{color.card}"
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": ["{shadow.md}"]
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.foreground}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": "none"
        }
      }
    },
    "inset": {
      "$description": "A well cut into a surface: an inset, a field, a track, a groove.",
      "shadow": {
        "$type": "shadow",
        "$value": ["{shadow.inset}"]
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.foreground}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": "none"
        }
      }
    },
    "channel": {
      "$description": "The channel a group of choices sits in: a segmented control's track.",
      "background": {
        "$type": "color",
        "$value": "{color.card}"
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": ["{shadow.sm}"]
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.foreground}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": "none"
        }
      }
    },
    "raised": {
      "$description": "A control on a surface: a button, a chip, a pill.",
      "border-color": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0, 0, 0],
          "alpha": 0,
          "hex": "#000000"
        },
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "transparentKeyword": true
          }
        }
      },
      "border-top-color": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0, 0, 0],
          "alpha": 0,
          "hex": "#000000"
        },
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "transparentKeyword": true
          }
        }
      },
      "border-bottom-color": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0, 0, 0],
          "alpha": 0,
          "hex": "#000000"
        },
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "transparentKeyword": true
          }
        }
      },
      "shadow": {
        "$type": "shadow",
        "$value": ["{shadow.edge.surface}", "{shadow.sm}"]
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.foreground}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "backdropFilter": "blur(30px)",
          "material": "glass"
        }
      }
    },
    "plate": {
      "$description": "A labelled block chosen inside a well: the selected tab, a segmented control's thumb.",
      "background": {
        "$type": "color",
        "$value": "{color.card}"
      },
      "border-color": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0, 0, 0],
          "alpha": 0,
          "hex": "#000000"
        },
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "transparentKeyword": true
          }
        }
      },
      "shadow": {
        "$type": "shadow",
        "$value": ["{shadow.edge.surface}", "{shadow.sm}"]
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.foreground}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "backdropFilter": "none",
          "material": "none"
        }
      }
    },
    "overlay": {
      "$description": "A panel floating over the page: a menu, a toast.",
      "border-color": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0, 0, 0],
          "alpha": 0,
          "hex": "#000000"
        },
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "transparentKeyword": true
          }
        }
      },
      "shadow": {
        "$type": "shadow",
        "$value": ["{shadow.lg}"]
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.foreground}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "backdropFilter": "blur(30px)",
          "material": "glass"
        }
      }
    },
    "modal": {
      "$description": "A surface the page waits for: a dialog, a sheet.",
      "background": {
        "$type": "color",
        "$value": "{color.card}"
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": ["{shadow.xl}"]
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.foreground}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": "none"
        }
      }
    },
    "inverse": {
      "$description": "The page's inverse: an inverse surface, a tooltip.",
      "border-color": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0, 0, 0],
          "alpha": 0,
          "hex": "#000000"
        },
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "transparentKeyword": true
          }
        }
      },
      "shadow": {
        "$type": "shadow",
        "$value": ["{shadow.lg}"]
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.inverse-foreground}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "backdropFilter": "blur(30px)",
          "material": "glass"
        }
      }
    },
    "glass": {
      "$description": "A translucent surface: what is behind it shows through.",
      "border-color": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": ["{shadow.edge.surface}", "{shadow.sm}"]
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.foreground}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "backdropFilter": "blur(30px)",
          "material": "glass"
        }
      }
    },
    "accent": {
      "$description": "The accent's own surface, with its ink.",
      "background": {
        "$type": "color",
        "$value": "{color.primary}"
      },
      "border-color": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0, 0, 0],
          "alpha": 0,
          "hex": "#000000"
        },
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "transparentKeyword": true
          }
        }
      },
      "border-top-color": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0, 0, 0],
          "alpha": 0,
          "hex": "#000000"
        },
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "transparentKeyword": true
          }
        }
      },
      "border-bottom-color": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0, 0, 0],
          "alpha": 0,
          "hex": "#000000"
        },
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "transparentKeyword": true
          }
        }
      },
      "shadow": {
        "$type": "shadow",
        "$value": ["{shadow.edge.accent}"]
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.primary-foreground}"
      },
      "pressed-opacity": {
        "$type": "number",
        "$value": 0.88
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": "none"
        }
      }
    },
    "knob": {
      "$description": "A knob: a switch's thumb, a slider's handle, a segmented thumb.",
      "background": {
        "$type": "color",
        "$value": "{color.knob}"
      },
      "border-color": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0, 0, 0],
          "alpha": 0,
          "hex": "#000000"
        },
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "transparentKeyword": true
          }
        }
      },
      "shadow": {
        "$type": "shadow",
        "$value": ["{shadow.sm}"]
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.foreground}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": "none"
        }
      }
    },
    "hover": {
      "$description": "A control under the pointer.",
      "background": {
        "$type": "color",
        "$value": "{color.hover}"
      },
      "border-color": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0, 0, 0],
          "alpha": 0,
          "hex": "#000000"
        },
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "transparentKeyword": true
          }
        }
      },
      "border-top-color": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0, 0, 0],
          "alpha": 0,
          "hex": "#000000"
        },
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "transparentKeyword": true
          }
        }
      },
      "border-bottom-color": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0, 0, 0],
          "alpha": 0,
          "hex": "#000000"
        },
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "transparentKeyword": true
          }
        }
      },
      "shadow": {
        "$type": "shadow",
        "$value": ["{shadow.edge.surface}", "{shadow.sm}"]
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.foreground}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": "none"
        }
      }
    },
    "pressed": {
      "$description": "A control held down.",
      "background": {
        "$type": "color",
        "$value": "{color.muted}"
      },
      "border-color": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0, 0, 0],
          "alpha": 0,
          "hex": "#000000"
        },
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "transparentKeyword": true
          }
        }
      },
      "border-top-color": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0, 0, 0],
          "alpha": 0,
          "hex": "#000000"
        },
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "transparentKeyword": true
          }
        }
      },
      "border-bottom-color": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0, 0, 0],
          "alpha": 0,
          "hex": "#000000"
        },
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "transparentKeyword": true
          }
        }
      },
      "shadow": {
        "$type": "shadow",
        "$value": ["{shadow.inset}"]
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.foreground}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": "none"
        }
      }
    },
    "disabled": {
      "$description": "A control that cannot be used.",
      "background": {
        "$type": "color",
        "$value": "{color.raised}"
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": ["{shadow.edge.surface}", "{shadow.sm}"]
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.foreground}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": "none"
        }
      }
    }
  }
}
