{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Material 3 Expressive desktop pointer input-tier overrides (M3 Desktop 44dp hit target, 48dp row).",
  "font": {
    "$description": "Desktop pointer typography metrics.",
    "size": {
      "$type": "dimension",
      "$description": "Font sizes per type role for pointer input.",
      "body": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "headline": {
        "$value": {
          "value": 24,
          "unit": "px"
        }
      },
      "display": {
        "$value": {
          "value": 36,
          "unit": "px"
        }
      }
    },
    "line-height": {
      "$type": "number",
      "$description": "Line heights per type role, as a multiple of the role's font size (DTCG's unitless lineHeight); `tokens:build` states the whole points it works out to.",
      "body": {
        "$value": 1.428571
      },
      "headline": {
        "$value": 1.333333
      },
      "display": {
        "$value": 1.222222
      }
    }
  },
  "dimension": {
    "$type": "dimension",
    "$description": "Desktop pointer layout density, control geometry, and icon sizes.",
    "size": {
      "$description": "Ergonomic sizing scales for pointer input.",
      "hit": {
        "$value": {
          "value": 44,
          "unit": "px"
        },
        "$description": "Minimum hit target size (0 disables padding expansion)."
      },
      "density": {
        "$description": "Page-level padding, gap, and surface spacing metrics.",
        "pad": {
          "$value": {
            "value": 16,
            "unit": "px"
          }
        },
        "surface": {
          "$value": {
            "value": 12,
            "unit": "px"
          }
        }
      },
      "control": {
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "switch": "regular"
          }
        },
        "$description": "Control internal spacing and switch size tier.",
        "dot": {
          "$value": {
            "value": 10,
            "unit": "px"
          }
        }
      },
      "height": {
        "$description": "Standard control heights (sm, md, lg).",
        "sm": {
          "$value": {
            "value": 32,
            "unit": "px"
          }
        },
        "md": {
          "$value": {
            "value": 40,
            "unit": "px"
          }
        },
        "lg": {
          "$value": {
            "value": 56,
            "unit": "px"
          }
        }
      }
    },
    "icon": {
      "$description": "Standard icon dimensions (sm, md, lg).",
      "sm": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 20,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 24,
          "unit": "px"
        }
      }
    }
  }
}
