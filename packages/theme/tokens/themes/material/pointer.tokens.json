{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Material 3 Expressive desktop pointer input-tier overrides (M3 Desktop 44dp hit target, 48dp row).",
  "font": {
    "$description": "Desktop pointer typography metrics.",
    "size": {
      "$type": "dimension",
      "$description": "Font sizes per type role for pointer input.",
      "body": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "title": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "headline": {
        "$value": {
          "value": 24,
          "unit": "px"
        }
      },
      "display": {
        "$value": {
          "value": 36,
          "unit": "px"
        }
      }
    },
    "line-height": {
      "$type": "number",
      "$description": "Unitless line-height ratios per type role for pointer input.",
      "caption": {
        "$value": 1.4545454545454546
      },
      "detail": {
        "$value": 1.3333333333333333
      },
      "body": {
        "$value": 1.4285714285714286
      },
      "title": {
        "$value": 1.5
      },
      "headline": {
        "$value": 1.3333333333333333
      },
      "display": {
        "$value": 1.2222222222222223
      }
    }
  },
  "dimension": {
    "$type": "dimension",
    "$description": "Desktop pointer layout density, control geometry, and icon sizes.",
    "size": {
      "$description": "Ergonomic sizing scales for pointer input.",
      "hit": {
        "$value": {
          "value": 44,
          "unit": "px"
        },
        "$description": "Minimum hit target size (0 disables padding expansion)."
      },
      "density": {
        "$description": "Page-level row, padding, gap, and surface spacing metrics.",
        "row": {
          "$value": {
            "value": 48,
            "unit": "px"
          }
        },
        "pad": {
          "$value": {
            "value": 16,
            "unit": "px"
          }
        },
        "surface": {
          "$value": {
            "value": 12,
            "unit": "px"
          }
        }
      },
      "control": {
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "switch": "regular"
          }
        },
        "$description": "Control internal geometry and switch size tier.",
        "row": {
          "$value": {
            "value": 48,
            "unit": "px"
          }
        },
        "padding": {
          "$value": {
            "value": 8,
            "unit": "px"
          }
        },
        "gap": {
          "$value": {
            "value": 12,
            "unit": "px"
          }
        },
        "control": {
          "$value": {
            "value": 18,
            "unit": "px"
          }
        },
        "corner": {
          "$value": {
            "value": 2,
            "unit": "px"
          }
        },
        "check": {
          "$value": {
            "value": 18,
            "unit": "px"
          }
        },
        "dot": {
          "$value": {
            "value": 10,
            "unit": "px"
          }
        },
        "tabs": {
          "$value": {
            "value": 48,
            "unit": "px"
          }
        },
        "line": {
          "$value": {
            "value": 48,
            "unit": "px"
          }
        },
        "clear": {
          "$value": {
            "value": 20,
            "unit": "px"
          }
        }
      },
      "height": {
        "$description": "Standard control heights (sm, md, lg).",
        "sm": {
          "$value": {
            "value": 32,
            "unit": "px"
          }
        },
        "md": {
          "$value": {
            "value": 40,
            "unit": "px"
          }
        },
        "lg": {
          "$value": {
            "value": 56,
            "unit": "px"
          }
        }
      }
    },
    "icon": {
      "$description": "Standard icon dimensions (sm, md, lg).",
      "sm": {
        "$value": {
          "value": 18,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 20,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 24,
          "unit": "px"
        }
      }
    }
  }
}
