        "$value": {
          "value": 20,
          "unit": "px"
        },
        "$description": "M3 RadioButton 20dp outer ring diameter (_md-comp-radio-button.scss:26)."
      },
      "dot": {
        "$value": {
          "value": 10,
          "unit": "px"
        },
        "$description": "M3 RadioButton 10dp selected inner dot diameter (20dp ring / 10dp dot per m3.material.io Radio button specs)."
      },
      "dot-hover": {
        "$value": {
          "value": 10,
          "unit": "px"
        },
        "$description": "M3 RadioButton 10dp inner dot (no hover resize)."
      },
      "dot-pressed": {
        "$value": {
          "value": 10,
          "unit": "px"
        },
        "$description": "M3 RadioButton 10dp inner dot (no press resize)."
      },
