    "switch": {
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "knob-feedback": "expand"
        }
      },
      "$description": "M3 Switch 52x32dp track, 2dp unselected outline, 16/24/28dp handle growth (_md-comp-switch.scss v34.0.21 / Compose SwitchTokens.kt).",
