          "value": 11,
          "unit": "px"
        }
      },
      "detail": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "body": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "label": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "headline": {
        "$value": {
          "value": 24,
          "unit": "px"
        }
      },
      "display": {
        "$value": {
          "value": 36,
          "unit": "px"
        }
      }
    },
    "line-height": {
