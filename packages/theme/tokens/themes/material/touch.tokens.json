      "sm-on-knob": {
        "$value": {
          "value": 24,
          "unit": "px"
        },
        "$description": "M3 Switch 24dp selected handle diameter."
      },
      "knob-hover": {
        "$value": {
          "value": 16,
          "unit": "px"
        },
        "$description": "M3 Switch handle keeps 16dp diameter on pointer hover."
