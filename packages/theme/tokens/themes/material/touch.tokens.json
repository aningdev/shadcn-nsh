      "hit": {
        "$value": {
          "value": 48,
          "unit": "px"
        },
        "$description": "Minimum hit target size (0 disables padding expansion)."
      },
      "density": {
        "$description": "Page-level padding, gap, and surface spacing metrics.",
        "pad": {
          "$value": {
            "value": 16,
            "unit": "px"
          }
        }
      },
      "control": {
        "$description": "Control internal spacing and switch size tier.",
