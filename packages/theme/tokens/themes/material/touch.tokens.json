    "radio": {
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "well": "outline",
          "checked-style": "ring",
          "has-target": true
        }
      },
      "$description": "M3 RadioButton: 20dp outer ring (2dp stroke, transparent interior, OnSurfaceVariant/Primary), 10dp inner dot, 40dp state-layer target (_md-comp-radio-button.scss v34.0.21 / Compose RadioButtonTokens.kt).",
