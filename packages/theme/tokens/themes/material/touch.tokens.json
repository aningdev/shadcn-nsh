      "knob-pressed-height": {
        "$value": {
          "value": 28,
          "unit": "px"
        },
        "$description": "M3 Switch 28dp pressed handle height (_md-comp-switch.scss:47)."
      }
    },
    "slider": {
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "handle-shape": "bar",
          "outlined": false,
          "hover-brightness": false
        }
      },
      "$description": "M3 Expressive Slider: 16dp active/inactive track, 4x44dp bar handle (2dp pressed), 6dp gap (Compose SliderTokens.kt 1.5.0).",
      "band": {
        "$value": {
          "value": 44,
          "unit": "px"
        },
        "$description": "M3 Expressive Slider 44dp hit band matching 44dp bar handle height."
      },
      "rail": {
        "$value": {
          "value": 16,
          "unit": "px"
        },
        "$description": "M3 Expressive Slider 16dp active/inactive track thickness (SliderTokens.ActiveTrackHeight)."
      },
      "thumb-width": {
        "$value": {
          "value": 4,
          "unit": "px"
        },
        "$description": "M3 Expressive Slider 4dp vertical bar handle width (SliderTokens.HandleWidth)."
      },
      "thumb-height": {
        "$value": {
          "value": 44,
          "unit": "px"
        },
        "$description": "M3 Expressive Slider 44dp vertical bar handle height (SliderTokens.HandleHeight)."
      },
      "thumb-pressed-width": {
        "$value": {
          "value": 2,
          "unit": "px"
        },
        "$description": "M3 Expressive Slider 2dp pressed handle width (SliderTokens.PressedHandleWidth)."
      },
      "gap": {
        "$value": {
          "value": 6,
          "unit": "px"
        },
        "$description": "M3 Expressive Slider 6dp gap between handle and track (SliderTokens.ActiveHandleLeadingSpace)."
      }
