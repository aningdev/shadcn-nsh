          "$value": {
            "value": 2,
            "unit": "px"
          }
        },
        "check": {
          "$value": {
            "value": 18,
            "unit": "px"
          }
        },
        "dot": {
          "$value": {
            "value": 10,
            "unit": "px"
          }
        },
        "tabs": {
          "$value": {
            "value": 48,
