      "on-border": {
        "$value": {
          "value": 0,
          "unit": "px"
        },
        "$description": "M3 Switch selected track has no outline (0dp; SwitchTokens.kt)."
      },
      "knob": {
        "$value": {
          "value": 16,
          "unit": "px"
        },
        "$description": "M3 Switch 16dp unselected handle diameter (_md-comp-switch.scss:65)."
      },
      "on-knob": {
        "$value": {
          "value": 24,
          "unit": "px"
        },
        "$description": "M3 Switch 24dp selected handle diameter (_md-comp-switch.scss:51)."
