        "$value": {
          "value": 2,
          "unit": "px"
        },
        "$description": "M3 RadioButton 2dp outer ring stroke width (Compose RadioStrokeWidth)."
      },
      "target": {
        "$value": {
          "value": 40,
          "unit": "px"
        },
        "$description": "M3 RadioButton 40dp circular state-layer target (_md-comp-radio-button.scss:28)."
