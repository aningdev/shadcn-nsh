        "$value": {
          "value": 52,
          "unit": "px"
        },
        "$description": "M3 Switch 52dp track width (_md-comp-switch.scss:63)."
      },
      "height": {
        "$value": {
          "value": 32,
          "unit": "px"
        },
        "$description": "M3 Switch 32dp track height (_md-comp-switch.scss:59)."
      },
      "sm-width": {
        "$value": {
          "value": 52,
          "unit": "px"
        },
        "$description": "M3 Switch keeps 52dp width on compact size."
      },
      "sm-height": {
        "$value": {
          "value": 32,
          "unit": "px"
        },
        "$description": "M3 Switch keeps 32dp height on compact size."
      },
      "border": {
        "$value": {
          "value": 2,
          "unit": "px"
        },
        "$description": "M3 Switch 2dp unselected track outline (_md-comp-switch.scss:61)."
