{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "name": "Material",
  "version": "2025.10",
  "description": "Material 3 Expressive theme (material-web v34.0.21 / Compose M3 1.5.0).",
  "sets": {
    "base": {
      "description": "Cross-theme semantic defaults, the control slots every theme draws from, and shared typography/motion structure.",
      "sources": [
        {
          "$ref": "../../base/style.shared.tokens.json"
        },
        {
          "$ref": "../../base/slots.tokens.json"
        }
      ]
    },
    "theme": {
      "description": "Material appearance-invariant base tokens, shared finishes, and state overrides.",
      "sources": [
        {
          "$ref": "./theme.tokens.json"
        },
        {
          "$ref": "./finishes.shared.tokens.json"
        }
      ]
    }
  },
  "modifiers": {
    "appearance": {
      "description": "Color appearance mode.",
      "default": "light",
      "contexts": {
        "light": [
          {
            "$ref": "./light.tokens.json"
          }
        ],
        "dark": [
          {
            "$ref": "./dark.tokens.json"
          }
        ]
      }
    },
    "input": {
      "description": "Pointer vs touch ergonomic sizing tier.",
      "default": "pointer",
      "contexts": {
        "pointer": [
          {
            "$ref": "../../base/style.pointer.tokens.json"
          },
          {
            "$ref": "./pointer.tokens.json"
          }
        ],
        "touch": [
          {
            "$ref": "../../base/style.touch.tokens.json"
          },
          {
            "$ref": "./touch.tokens.json"
          }
        ]
      }
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/base"
    },
    {
      "$ref": "#/sets/theme"
    },
    {
      "$ref": "#/modifiers/appearance"
    },
    {
      "$ref": "#/modifiers/input"
    }
  ]
}
