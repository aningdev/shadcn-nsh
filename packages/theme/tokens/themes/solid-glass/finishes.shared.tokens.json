{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Appearance-invariant surface finish recipes for the Solid Glass theme.",
  "finish": {
    "$description": "Appearance-invariant surface finish recipes (background, gradient, border, shadow, blur, material).",
    "card": {
      "$description": "The card face: an inner highlight, a hairline, a contact shadow and a cast one.",
      "gradient": {
        "$type": "gradient",
        "$value": [
          {
            "color": "{color.card}",
            "position": 0
          },
          {
            "color": "{color.card}",
            "position": 1
          }
        ],
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "angle": 180
          }
        }
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "section": {
      "$description": "The flat surface a section's content or card sits on (no shadow by default).",
      "background": {
        "$type": "color",
        "$value": "{color.card}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": {
          "color": {
            "colorSpace": "oklch",
            "components": [0, 0, 0],
            "alpha": 0,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 0,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "none": true
          }
        }
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.card-edge}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "inset": {
      "$description": "The well inside a card: sunk by its inner shadow alone.",
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "field": {
      "$description": "A field well: its edge and its inner shadow.",
