{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Light appearance colors and finish overrides for the Solid Glass theme.",
  "color": {
    "$type": "color",
    "$description": "Adaptive A-layer and B-layer color roles for light appearance.",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [0.925, 0.007, 265],
        "hex": "#e4e6eb"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "role": "surface"
        }
      },
      "$description": "Primary application page canvas background."
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [0.16, 0, 0],
        "hex": "#0d0d0d"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "role": "ink"
        }
      },
      "$description": "Default high-contrast text and icon ink on page surfaces."
    },
    "card": {
      "$value": {
        "colorSpace": "oklch",
        "components": [0.95776, 0.00577, 264.532],
        "hex": "#eff1f5"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "role": "surface"
        }
      },
      "$description": "Opaque composite of Solid Glass card pane over background canvas (no blur on card role)."
    },
    "card-foreground": {
      "$value": "{color.foreground}",
