{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Dark appearance colors and finish overrides for the Solid Glass theme.",
  "color": {
    "$type": "color",
    "$description": "Adaptive A-layer and B-layer color roles for dark appearance.",
    "background": {
      "$value": {
        "colorSpace": "oklch",
        "components": [0.16, 0, 0],
        "hex": "#0d0d0d"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "role": "surface"
        }
      },
      "$description": "Primary application page canvas background."
    },
    "foreground": {
      "$value": {
        "colorSpace": "oklch",
        "components": [0.985, 0, 0],
        "hex": "#fafafa"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "role": "ink"
        }
      },
      "$description": "Default high-contrast text and icon ink on page surfaces."
    },
    "card": {
      "$value": {
        "colorSpace": "oklch",
        "components": [0.23075, 0, 0],
        "hex": "#1d1d1d"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "role": "surface"
        }
      },
      "$description": "Opaque composite of Solid Glass card pane over background canvas (no blur on card role)."
    },
    "popover": {
