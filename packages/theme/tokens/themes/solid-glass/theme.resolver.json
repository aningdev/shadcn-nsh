{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "name": "Solid Glass",
  "version": "2025.10",
  "description": "DTCG 2025.10 resolver for the Solid Glass theme.",
  "sets": {
    "base": {
      "description": "Cross-theme semantic defaults and shared typography/motion structure.",
      "sources": [
        {
          "$ref": "../../base/style.shared.tokens.json"
        }
      ]
    },
    "theme": {
      "description": "Solid Glass appearance-invariant base tokens, shared finishes, and state overrides.",
      "sources": [
        {
          "$ref": "./theme.tokens.json"
        },
        {
          "$ref": "./finishes.shared.tokens.json"
        }
      ]
    }
  },
  "modifiers": {
    "appearance": {
      "description": "Color appearance mode.",
      "default": "light",
      "contexts": {
        "light": [
          {
            "$ref": "./light.tokens.json"
          }
        ],
        "dark": [
          {
            "$ref": "./dark.tokens.json"
          }
        ]
      }
    },
    "input": {
      "description": "Pointer vs touch ergonomic sizing tier.",
      "default": "pointer",
      "contexts": {
        "pointer": [
          {
            "$ref": "../../base/style.pointer.tokens.json"
          }
        ],
        "touch": [
          {
            "$ref": "../../base/style.touch.tokens.json"
          }
        ]
      }
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/base"
    },
    {
      "$ref": "#/sets/theme"
    },
    {
      "$ref": "#/modifiers/appearance"
    },
    {
      "$ref": "#/modifiers/input"
    }
  ]
}
