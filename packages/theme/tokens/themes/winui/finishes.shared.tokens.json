{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Appearance-invariant surface finish recipes for WinUI 3 (Windows backdrop blur on glass/menu/tooltip).",
  "finish": {
    "$description": "Appearance-invariant surface finish recipes (background, gradient, border, shadow, blur, material).",
    "card": {
      "$description": "WinUI 3 card surface with layering depth-8 two-layer ThemeShadow approximation.",
      "gradient": {
        "$type": "gradient",
        "$value": [
          {
            "color": "{color.card}",
            "position": 0
          },
          {
            "color": "{color.card}",
            "position": 1
          }
        ],
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "angle": 180
          }
        }
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "section": {
      "$description": "WinUI 3 section card surface using CardBackgroundFillColorDefault and CardStrokeColorDefault border (no drop shadow).",
      "background": {
        "$type": "color",
