{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "WinUI 3 desktop pointer input-tier overrides (Standard 40px ListViewItemMinHeight, 32px controls, 12/16/20px icons).",
  "font": {
    "$description": "Desktop pointer typography metrics.",
    "size": {
      "$type": "dimension",
      "$description": "Font sizes per type role for pointer input.",
      "caption": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "body": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "title": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "display": {
        "$value": {
          "value": 28,
          "unit": "px"
        }
      }
    },
    "line-height": {
      "$type": "number",
      "$description": "Unitless line-height ratios per type role for pointer input.",
      "caption": {
        "$value": 1.3333333333333333
      },
      "detail": {
        "$value": 1.3333333333333333
      },
      "body": {
        "$value": 1.4285714285714286
      },
      "title": {
        "$value": 1.4285714285714286
      },
      "headline": {
        "$value": 1.4
      },
      "display": {
        "$value": 1.2857142857142858
      }
    }
  },
  "dimension": {
    "$type": "dimension",
    "$description": "Desktop pointer layout density, control geometry, and icon sizes.",
    "size": {
      "$description": "Ergonomic sizing scales for pointer input.",
      "density": {
        "$description": "Page-level row, padding, gap, and surface spacing metrics.",
        "row": {
          "$value": {
            "value": 40,
            "unit": "px"
          }
        },
        "pad": {
          "$value": {
            "value": 16,
            "unit": "px"
          }
        },
        "gap": {
          "$value": {
            "value": 8,
            "unit": "px"
          }
        },
        "surface": {
          "$value": {
            "value": 4,
            "unit": "px"
          }
        }
      },
      "control": {
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "switch": "regular"
          }
        },
        "$description": "Control internal geometry and switch size tier.",
        "row": {
          "$value": {
            "value": 32,
            "unit": "px"
          }
        },
        "gap": {
          "$value": {
            "value": 8,
            "unit": "px"
          }
        },
        "control": {
          "$value": {
            "value": 20,
            "unit": "px"
          }
        },
        "dot": {
          "$value": {
            "value": 12,
            "unit": "px"
          }
        },
        "tabs": {
          "$value": {
            "value": 32,
            "unit": "px"
          }
        }
      },
      "height": {
        "$description": "Standard control heights (sm, md, lg).",
        "md": {
          "$value": {
            "value": 32,
            "unit": "px"
          }
        },
        "lg": {
          "$value": {
            "value": 40,
            "unit": "px"
          }
        }
      }
    },
    "icon": {
      "$description": "Standard icon dimensions (sm, md, lg).",
      "md": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 20,
          "unit": "px"
        }
      }
    }
  }
}
