{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Appearance-invariant surface finish recipes for the default theme.",
  "finish": {
    "card": {
      "$description": "A surface that holds content: a card, a section.",
      "background": {
        "$type": "color",
        "$value": "{color.card}"
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": ["{shadow.md}"]
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.foreground}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "inset": {
      "$description": "A well cut into a surface: an inset, a field, a track, a groove.",
      "shadow": {
        "$type": "shadow",
        "$value": ["{shadow.inset}"]
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.foreground}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "raised": {
      "$description": "A control on a surface: a button, a chip, a pill.",
      "background": {
        "$type": "color",
        "$value": "{color.raised}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": ["{shadow.edge.surface}", "{shadow.sm}"]
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.foreground}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "backdropFilter": "none",
          "material": null
        }
      }
    },
    "overlay": {
      "$description": "A panel floating over the page: a menu, a toast.",
      "background": {
        "$type": "color",
        "$value": "{color.popover}"
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": ["{shadow.lg}"]
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.foreground}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "backdropFilter": "none",
          "material": null
        }
      }
    },
    "modal": {
      "$description": "A surface the page waits for: a dialog, a sheet.",
      "background": {
        "$type": "color",
        "$value": "{color.card}"
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": ["{shadow.xl}"]
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.foreground}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "inverse": {
      "$description": "The page's inverse: an inverse surface, a tooltip.",
      "background": {
        "$type": "color",
        "$value": "{color.inverse}"
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": ["{shadow.lg}"]
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.muted-foreground}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "backdropFilter": "none",
          "material": null
        }
      }
    },
    "glass": {
      "$description": "A translucent surface: what is behind it shows through.",
      "border-color": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": ["{shadow.edge.surface}", "{shadow.sm}"]
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.foreground}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "backdropFilter": "blur(20px)",
          "material": null
        }
      }
    },
    "accent": {
      "$description": "The accent's own surface, with its ink.",
      "background": {
        "$type": "color",
        "$value": "{color.primary}"
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.brand-edge}"
      },
      "border-top-color": {
        "$type": "color",
        "$value": "{color.brand-edge}"
      },
      "border-bottom-color": {
        "$type": "color",
        "$value": "{color.brand-edge}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": ["{shadow.edge.accent}"]
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.primary-foreground}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "knob": {
      "$description": "A knob: a switch's thumb, a slider's handle, a segmented thumb.",
      "shadow": {
        "$type": "shadow",
        "$value": ["{shadow.sm}"]
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.foreground}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "hover": {
      "$description": "A control under the pointer.",
      "shadow": {
        "$type": "shadow",
        "$value": ["{shadow.edge.surface}", "{shadow.sm}"]
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.foreground}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "pressed": {
      "$description": "A control held down.",
      "shadow": {
        "$type": "shadow",
        "$value": ["{shadow.inset}"]
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.foreground}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "disabled": {
      "$description": "A control that cannot be used.",
      "background": {
        "$type": "color",
        "$value": "{color.raised}"
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": ["{shadow.edge.surface}", "{shadow.sm}"]
      },
      "foreground": {
        "$type": "color",
        "$value": "{color.foreground}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    }
  }
}
