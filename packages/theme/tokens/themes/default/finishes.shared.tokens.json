{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Appearance-invariant surface finish recipes for the default theme.",
  "finish": {
    "$description": "Appearance-invariant surface finish recipes (background, gradient, border, shadow, blur, material).",
    "card": {
      "$description": "The card face: an inner highlight, a hairline, a contact shadow and a cast one.",
      "gradient": {
        "$type": "gradient",
        "$value": [
          {
            "color": "{color.card}",
            "position": 0
          },
          {
            "color": "{color.card}",
            "position": 1
          }
        ],
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "angle": 180
          }
        }
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "inset": {
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      },
      "$description": "The well inside a card: sunk by its inner shadow alone."
    },
    "field": {
      "$description": "A field well: its edge and its inner shadow.",
      "shadow": {
        "$type": "shadow",
        "$value": {
          "color": {
            "colorSpace": "oklch",
            "components": [0, 0, 0],
            "alpha": 0,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 0,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "none": true
          }
        }
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "raised": {
      "$description": "A control on a card: a gradient, an inner highlight, a hard shadow, an edge.",
      "background": {
        "$type": "color",
        "$value": "{color.raised}"
      },
      "gradient": {
        "$type": "gradient",
        "$value": [
          {
            "color": "{color.raised}",
            "position": 0
          },
          {
            "color": "{color.raised}",
            "position": 1
          }
        ],
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "angle": 180
          }
        }
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "hover": {
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      },
      "$description": "The step the surface takes under the pointer."
    },
    "pressed": {
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      },
      "$description": "The step it takes while pressed."
    },
    "light": {
      "$description": "The main action brightest step: the accent gradient.",
      "background": {
        "$type": "color",
        "$value": "{color.primary}"
      },
      "gradient": {
        "$type": "gradient",
        "$value": [
          {
            "color": "{color.primary}",
            "position": 0
          },
          {
            "color": "{color.primary}",
            "position": 1
          }
        ],
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "angle": 180
          }
        }
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.brand-edge}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "accent": {
      "$description": "The accent face (the same as light).",
      "background": {
        "$type": "color",
        "$value": "{color.primary}"
      },
      "gradient": {
        "$type": "gradient",
        "$value": [
          {
            "color": "{color.primary}",
            "position": 0
          },
          {
            "color": "{color.primary}",
            "position": 1
          }
        ],
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "angle": 180
          }
        }
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.brand-edge}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "track": {
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      },
      "$description": "A groove: an inner shadow and an edge."
    },
    "fill": {
      "$description": "The filled run: a slider, a progress bar, a switch that is on.",
      "background": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0, 0, 0],
          "alpha": 0,
          "hex": "#000000"
        },
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "transparentKeyword": true
          }
        }
      },
      "shadow": {
        "$type": "shadow",
        "$value": {
          "color": {
            "colorSpace": "oklch",
            "components": [1, 0, 0],
            "alpha": 0.3,
            "hex": "#ffffff"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          },
          "inset": true
        }
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "knob": {
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      },
      "$description": "A switch knob, off."
    },
    "knobOn": {
      "$description": "A switch knob, on.",
      "background": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [1, 0, 0],
          "hex": "#ffffff"
        }
      },
      "gradient": {
        "$type": "gradient",
        "$value": [
          {
            "color": {
              "colorSpace": "oklch",
              "components": [1, 0, 0],
              "hex": "#ffffff"
            },
            "position": 0
          },
          {
            "color": {
              "colorSpace": "oklch",
              "components": [0.97867, 0.00945, 119.575],
              "hex": "#f7f9f2"
            },
            "position": 1
          }
        ],
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "angle": 180
          }
        }
      },
      "shadow": {
        "$type": "shadow",
        "$value": {
          "color": {
            "colorSpace": "oklch",
            "components": [0.42761, 0.11265, 128.534],
            "alpha": 0.18,
            "hex": "#3c5a00"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "handle": {
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      },
      "$description": "A slider handle (kept apart from knob)."
    },
    "pill": {
      "$description": "The upstream capsule, left to the app.",
      "background": {
        "$type": "color",
        "$value": "{color.raised}"
      },
      "gradient": {
        "$type": "gradient",
        "$value": [
          {
            "color": "{color.raised}",
            "position": 0
          },
          {
            "color": "{color.raised}",
            "position": 1
          }
        ],
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "angle": 180
          }
        }
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "thumb": {
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      },
      "$description": "The chosen segment of a segmented control or a tag."
    },
    "on": {
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      },
      "$description": "A chosen switch or box, and the mark on it."
    },
    "chip": {
      "$description": "A chosen value label inside a field: a fill, an inner highlight and an edge.",
      "background": {
        "$type": "color",
        "$value": "{color.raised}"
      },
      "gradient": {
        "$type": "gradient",
        "$value": [
          {
            "color": "{color.raised}",
            "position": 0
          },
          {
            "color": "{color.raised}",
            "position": 1
          }
        ],
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "angle": 180
          }
        }
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "glass": {
      "$description": "Glass: a translucent fill and a blur.",
      "border-color": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "backdropFilter": "blur(20px)",
          "material": null
        }
      }
    },
    "menu": {
      "$description": "A floating surface: a menu, a popover.",
      "background": {
        "$type": "color",
        "$value": "{color.popover}"
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "dialog": {
      "$description": "A dialog face: the card colour with the menu shadow.",
      "background": {
        "$type": "color",
        "$value": "{color.card}"
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "tooltip": {
      "$description": "A tooltip face: the popover pane, without a shadow.",
      "background": {
        "$type": "color",
        "$value": "{color.popover}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": {
          "color": {
            "colorSpace": "oklch",
            "components": [0, 0, 0],
            "alpha": 0,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 0,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "none": true
          }
        }
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "inverse": {
      "$description": "The inverse surface: a toast face.",
      "background": {
        "$type": "color",
        "$value": "{color.inverse}"
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "groove": {
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      },
      "$description": "A groove cut inside a menu."
    }
  }
}
