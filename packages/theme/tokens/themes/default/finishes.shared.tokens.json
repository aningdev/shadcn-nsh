{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Appearance-invariant surface finish recipes for the default theme.",
  "finish": {
    "card": {
      "gradient": {
        "$type": "gradient",
        "$value": [
          {
            "color": "{color.card}",
            "position": 0
          },
          {
            "color": "{color.card}",
            "position": 1
          }
        ],
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "angle": 180
          }
        }
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "inset": {
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "field": {
      "shadow": {
        "$type": "shadow",
        "$value": {
          "color": {
            "colorSpace": "oklch",
            "components": [0, 0, 0],
            "alpha": 0,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 0,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "none": true
          }
        }
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "raised": {
      "background": {
        "$type": "color",
        "$value": "{color.raised}"
      },
      "gradient": {
        "$type": "gradient",
        "$value": [
          {
            "color": "{color.raised}",
            "position": 0
          },
          {
            "color": "{color.raised}",
            "position": 1
          }
        ],
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "angle": 180
          }
        }
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "hover": {
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "pressed": {
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "light": {
      "background": {
        "$type": "color",
        "$value": "{color.primary}"
      },
      "gradient": {
        "$type": "gradient",
        "$value": [
          {
            "color": "{color.primary}",
            "position": 0
          },
          {
            "color": "{color.primary}",
            "position": 1
          }
        ],
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "angle": 180
          }
        }
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.brand-edge}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "accent": {
      "background": {
        "$type": "color",
        "$value": "{color.primary}"
      },
      "gradient": {
        "$type": "gradient",
        "$value": [
          {
            "color": "{color.primary}",
            "position": 0
          },
          {
            "color": "{color.primary}",
            "position": 1
          }
        ],
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "angle": 180
          }
        }
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.brand-edge}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "track": {
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "fill": {
      "background": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0, 0, 0],
          "alpha": 0,
          "hex": "#000000"
        },
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "transparentKeyword": true
          }
        }
      },
      "shadow": {
        "$type": "shadow",
        "$value": {
          "color": {
            "colorSpace": "oklch",
            "components": [1, 0, 0],
            "alpha": 0.3,
            "hex": "#ffffff"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          },
          "inset": true
        }
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "knob": {
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "knobOn": {
      "background": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [1, 0, 0],
          "hex": "#ffffff"
        }
      },
      "gradient": {
        "$type": "gradient",
        "$value": [
          {
            "color": {
              "colorSpace": "oklch",
              "components": [1, 0, 0],
              "hex": "#ffffff"
            },
            "position": 0
          },
          {
            "color": {
              "colorSpace": "oklch",
              "components": [0.97867, 0.00945, 119.575],
              "hex": "#f7f9f2"
            },
            "position": 1
          }
        ],
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "angle": 180
          }
        }
      },
      "shadow": {
        "$type": "shadow",
        "$value": {
          "color": {
            "colorSpace": "oklch",
            "components": [0.42761, 0.11265, 128.534],
            "alpha": 0.18,
            "hex": "#3c5a00"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 1,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        }
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "handle": {
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "pill": {
      "background": {
        "$type": "color",
        "$value": "{color.raised}"
      },
      "gradient": {
        "$type": "gradient",
        "$value": [
          {
            "color": "{color.raised}",
            "position": 0
          },
          {
            "color": "{color.raised}",
            "position": 1
          }
        ],
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "angle": 180
          }
        }
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "thumb": {
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "on": {
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "chip": {
      "background": {
        "$type": "color",
        "$value": "{color.raised}"
      },
      "gradient": {
        "$type": "gradient",
        "$value": [
          {
            "color": "{color.raised}",
            "position": 0
          },
          {
            "color": "{color.raised}",
            "position": 1
          }
        ],
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "angle": 180
          }
        }
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "glass": {
      "border-color": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "backdropFilter": "blur(20px)",
          "material": null
        }
      }
    },
    "menu": {
      "background": {
        "$type": "color",
        "$value": "{color.popover}"
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "dialog": {
      "background": {
        "$type": "color",
        "$value": "{color.card}"
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "tooltip": {
      "background": {
        "$type": "color",
        "$value": "{color.popover}"
      },
      "shadow": {
        "$type": "shadow",
        "$value": {
          "color": {
            "colorSpace": "oklch",
            "components": [0, 0, 0],
            "alpha": 0,
            "hex": "#000000"
          },
          "offsetX": {
            "value": 0,
            "unit": "px"
          },
          "offsetY": {
            "value": 0,
            "unit": "px"
          },
          "blur": {
            "value": 0,
            "unit": "px"
          },
          "spread": {
            "value": 0,
            "unit": "px"
          }
        },
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "none": true
          }
        }
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "inverse": {
      "background": {
        "$type": "color",
        "$value": "{color.inverse}"
      },
      "border-color": {
        "$type": "color",
        "$value": "{color.border}"
      },
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    },
    "groove": {
      "$extensions": {
        "dev.aning.shadcn-nsh": {
          "material": null
        }
      }
    }
  }
}
