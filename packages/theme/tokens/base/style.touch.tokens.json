  "dimension": {
    "$type": "dimension",
    "$description": "Touch layout density, control geometry, and icon sizes.",
    "size": {
      "$description": "Ergonomic sizing scales for touch input.",
      "hit": {
        "$value": {
          "value": 44,
          "unit": "px"
        },
        "$description": "Minimum hit target size (0 disables padding expansion)."
      },
      "density": {
        "$description": "Page-level row, padding, gap, and surface spacing metrics.",
        "row": {
          "$value": {
            "value": 48,
            "unit": "px"
          }
        },
        "pad": {
          "$value": {
            "value": 16,
            "unit": "px"
          }
        },
        "gap": {
          "$value": {
            "value": 12,
            "unit": "px"
          }
        },
        "surface": {
          "$value": {
            "value": 16,
            "unit": "px"
          }
        }
      },
      "control": {
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "switch": "regular"
          }
        },
        "$description": "Control internal geometry and switch size tier.",
        "row": {
          "$value": {
            "value": 44,
            "unit": "px"
          }
        },
        "padding": {
          "$value": {
            "value": 8,
            "unit": "px"
          }
        },
        "gap": {
          "$value": {
            "value": 12,
