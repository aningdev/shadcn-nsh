          "$value": {
            "value": 22,
            "unit": "px"
          }
        },
        "corner": {
          "$value": {
            "value": 7,
            "unit": "px"
          }
        },
        "check": {
          "$value": {
            "value": 16,
            "unit": "px"
          }
        },
        "dot": {
          "$value": {
            "value": 8,
            "unit": "px"
          }
        },
        "tabs": {
          "$value": {
            "value": 40,
            "unit": "px"
          }
        },
        "line": {
          "$value": {
            "value": 44,
            "unit": "px"
          }
        },
        "clear": {
          "$value": {
            "value": 20,
            "unit": "px"
          }
        }
      },
      "height": {
        "$description": "Standard control heights (sm, md, lg).",
