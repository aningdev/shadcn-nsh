{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Default pointer input-tier metrics.",
  "font": {
    "$description": "Desktop pointer typography metrics.",
    "size": {
      "$type": "dimension",
      "$description": "Font sizes per type role for pointer input.",
      "caption": {
        "$value": {
          "value": 11,
          "unit": "px"
        }
      },
      "detail": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "body": {
        "$value": {
          "value": 13,
          "unit": "px"
        }
      },
      "label": {
        "$value": {
          "value": 14,
          "unit": "px"
        }
      },
      "title": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "headline": {
        "$value": {
          "value": 20,
          "unit": "px"
        }
      },
      "display": {
        "$value": {
          "value": 26,
          "unit": "px"
        }
      }
    },
    "line-height": {
      "$type": "number",
      "$description": "Line heights per type role, as a multiple of the role's font size (DTCG's unitless lineHeight); `tokens:build` states the whole points it works out to.",
      "caption": {
        "$value": 1.454545
      },
      "detail": {
        "$value": 1.333333
      },
      "body": {
        "$value": 1.538462
      },
      "label": {
        "$value": 1.428571
      },
      "title": {
        "$value": 1.5
      },
      "headline": {
        "$value": 1.4
      },
      "display": {
        "$value": 1.230769
      }
    }
  },
  "dimension": {
    "$type": "dimension",
    "$description": "Desktop pointer layout density, control geometry, and icon sizes.",
    "size": {
      "$description": "Ergonomic sizing scales for pointer input.",
      "hit": {
        "$value": {
          "value": 0,
          "unit": "px"
        },
        "$description": "Minimum hit target size (0 disables padding expansion)."
      },
      "density": {
        "$description": "Page-level padding and gap.",
        "pad": {
          "$value": {
            "value": 12,
            "unit": "px"
          }
        },
        "gap": {
          "$value": {
            "value": 12,
            "unit": "px"
          }
        }
      },
      "item": {
        "$description": "A list's rows in a popup or a palette: inset, the container's edge to the row's fill; pad, the fill's edge to its text. shadcn's select and menus: 4 (SelectContent p-1) and 8 (SelectItem pl-2).",
        "inset": {
          "$value": {
            "value": 4,
            "unit": "px"
          }
        },
        "pad": {
          "$value": {
            "value": 8,
            "unit": "px"
          }
        }
      },
      "control": {
        "$extensions": {
          "dev.aning.shadcn-nsh": {
            "switch": "small"
          }
        },
        "$description": "Control internal spacing and switch size tier.",
        "padding": {
          "$value": {
            "value": 8,
            "unit": "px"
          }
        },
        "gap": {
          "$value": {
            "value": 8,
            "unit": "px"
          }
        },
        "dot": {
          "$value": {
            "value": 6,
            "unit": "px"
          }
        }
      },
      "height": {
        "$description": "Standard control heights (sm, md, lg).",
        "sm": {
          "$value": {
            "value": 24,
            "unit": "px"
          }
        },
        "md": {
          "$value": {
            "value": 28,
            "unit": "px"
          }
        },
        "lg": {
          "$value": {
            "value": 32,
            "unit": "px"
          }
        }
      }
    },
    "icon": {
      "$description": "Standard icon dimensions (sm, md, lg).",
      "sm": {
        "$value": {
          "value": 12,
          "unit": "px"
        }
      },
      "md": {
        "$value": {
          "value": 16,
          "unit": "px"
        }
      },
      "lg": {
        "$value": {
          "value": 20,
          "unit": "px"
        }
      }
    }
  }
}
