      "chart-1": "color-mix(in srgb, var(--foreground) 90%, var(--background))",
      "chart-2": "color-mix(in srgb, var(--foreground) 70%, var(--background))",
      "chart-3": "color-mix(in srgb, var(--foreground) 55%, var(--background))",
      "chart-4": "color-mix(in srgb, var(--foreground) 40%, var(--background))",
      "chart-5": "color-mix(in srgb, var(--foreground) 25%, var(--background))",
      "ring": "var(--primary)",
      "sidebar": "var(--background)",
      "sidebar-foreground": "var(--foreground)",
