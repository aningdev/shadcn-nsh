      "radius-modal": "20px",
      "scrim": "oklch(0 0 0 / 0.5)",
      "media": "oklch(0.1869 0.0151 266.766)",
      "on-media": "oklch(1 0 0)"
    },
    "light": {
      "background": "oklch(0.925 0.007 265)",
