{
  "typography": {
    "caption": {
      "fontSize": {
        "pointer": 11,
        "touch": 12
      },
      "lineHeight": {
        "pointer": 16,
        "touch": 16
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "detail": {
      "fontSize": {
        "pointer": 12,
        "touch": 13
      },
      "lineHeight": {
        "pointer": 16,
        "touch": 20
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "body": {
      "fontSize": {
        "pointer": 13,
        "touch": 15
      },
      "lineHeight": {
        "pointer": 20,
        "touch": 20
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "label": {
      "fontSize": {
        "pointer": 14,
        "touch": 15
      },
      "lineHeight": {
        "pointer": 20,
        "touch": 20
      },
      "fontWeight": 500,
      "letterSpacing": 0
    },
    "title": {
      "fontSize": {
        "pointer": 16,
        "touch": 16
      },
      "lineHeight": {
        "pointer": 24,
        "touch": 24
      },
      "fontWeight": 600,
      "letterSpacing": 0
    },
    "headline": {
      "fontSize": {
        "pointer": 20,
        "touch": 22
      },
      "lineHeight": {
        "pointer": 28,
        "touch": 28
      },
      "fontWeight": 600,
      "letterSpacing": 0
    },
    "display": {
      "fontSize": {
        "pointer": 26,
        "touch": 28
      },
      "lineHeight": {
        "pointer": 32,
        "touch": 36
      },
      "fontWeight": 600,
      "letterSpacing": 0
    }
  },
  "dimension": {
    "shape": {
      "control": "{radius-control}",
      "container": "{radius-container}",
      "modal": "{radius-modal}"
    },
    "size": {
      "hit": {
        "pointer": 0,
        "touch": 44
      },
      "density": {
        "pointer": {
          "pad": 16,
          "gap": 12
        },
        "touch": {
          "pad": 16,
          "gap": 12
        }
      },
      "item": {
        "pointer": {
          "inset": 4,
          "pad": 8
        },
        "touch": {
          "inset": 0,
          "pad": 16
        }
      },
      "control": {
        "pointer": {
          "padding": 8,
          "gap": 8,
          "dot": 6,
          "switch": "regular"
        },
        "touch": {
          "padding": 8,
          "gap": 8,
          "dot": 8,
          "switch": "regular"
        }
      },
      "height": {
        "pointer": {
          "sm": 24,
          "md": 28,
          "lg": 32
        },
        "touch": {
          "sm": 32,
          "md": 44,
          "lg": 56
        }
      }
    },
    "stroke": {
      "hairline": 0.5,
      "control": 1
    },
    "focus": {
      "style": "halo",
      "width": 3,
      "offset": 0
    },
    "icon": {
      "pointer": {
        "sm": 12,
        "md": 16,
        "lg": 20
      },
      "touch": {
        "sm": 16,
        "md": 20,
        "lg": 24
      }
    }
  },
  "slots": {
    "field.face": {
      "colour": "field"
    },
    "field.shade": "inset",
    "field.edge.width": "control",
    "field.edge.sides": true,
    "field.edge.colour": {
      "colour": "input"
    },
    "field.edge.bottom": {
      "colour": "input"
    },
    "field.corner.top": "control",
    "field.corner.bottom": "control",
    "field.focus.line": false,
    "choice.size": {
      "pointer": 16,
      "touch": 22
    },
    "choice.corner": {
      "pointer": 5,
      "touch": 7
    },
    "choice.face": {
      "light": {
        "colour": "field"
      },
      "dark": {
        "colour": "input",
        "alpha": 0.3
      }
    },
    "choice.shade": "inset",
    "choice.edge.width": 1,
    "choice.edge.colour": {
      "light": {
        "colour": "input"
      },
      "dark": {
        "colour": "foreground",
        "alpha": 0.2
      }
    },
    "choice.edge.disabled": {
      "light": {
        "colour": "input"
      },
      "dark": {
        "colour": "foreground",
        "alpha": 0.4
      }
    },
    "choice.checked.face": {
      "finish": "accent"
    },
    "choice.mark.size": {
      "pointer": 6,
      "touch": 8
    },
    "choice.mark.hover": "none",
    "choice.mark.pressed": "none",
    "choice.halo": "none",
    "switch.width": {
      "pointer": 36,
      "touch": 44
    },
    "switch.height": {
      "pointer": 20,
      "touch": 24
    },
    "switch.small.width": {
      "pointer": 28,
      "touch": 36
    },
    "switch.small.height": {
      "pointer": 16,
      "touch": 20
    },
    "switch.small.knob.width": {
      "pointer": 12,
      "touch": 16
    },
    "switch.small.knob.height": {
      "pointer": 12,
      "touch": 16
    },
    "switch.edge.off": 1,
    "switch.edge.on": 1,
    "switch.knob.width": {
      "pointer": 16,
      "touch": 20
    },
    "switch.knob.height": {
      "pointer": 16,
      "touch": 20
    },
    "switch.knob.on.width": {
      "pointer": 16,
      "touch": 20
    },
    "switch.knob.on.height": {
      "pointer": 16,
      "touch": 20
    },
    "switch.knob.hover": {
      "pointer": 16,
      "touch": 20
    },
    "switch.knob.pressed.width": {
      "pointer": 16,
      "touch": 20
    },
    "switch.knob.pressed.height": {
      "pointer": 16,
      "touch": 20
    },
    "switch.feedback": "none",
    "slider.rail": {
      "pointer": 6,
      "touch": 8
    },
    "slider.band": {
      "pointer": 20,
      "touch": 32
    },
    "slider.vertical": {
      "pointer": 128,
      "touch": 144
    },
    "slider.face": {
      "colour": "track"
    },
    "slider.shade": "inset",
    "slider.edge.colour": {
      "colour": "border"
    },
    "slider.edge.width": "control",
    "slider.knob.size": {
      "pointer": 14,
      "touch": 20
    },
    "slider.knob.pressed.size": {
      "pointer": 14,
      "touch": 32
    },
    "slider.mark.size": 0,
    "slider.mark.hover": 0,
    "slider.mark.pressed": 0,
    "slider.brightens": true,
    "progress.height": 6,
    "progress.line": 0,
    "progress.face": {
      "colour": "track"
    },
    "progress.shade": "inset",
    "progress.edge.colour": {
      "colour": "border"
    },
    "progress.edge.width": "control",
    "spinner.opacity": 0.25,
    "state.disabled.face": "keep",
    "state.disabled.ink": "keep",
    "state.disabled.edge": "keep"
  },
  "shape": {
    "curve": "continuous",
    "corners": {
      "button": "full"
    }
  },
  "state": {
    "press-scale": 1,
    "overlay": {
      "hover": 0,
      "focus": 0,
      "pressed": 0,
      "dragged": 0
    },
    "pressed-opacity": 0.7,
    "rest-opacity": 0.5,
    "disabled": {
      "content": 0.3
    }
  },
  "transition": {
    "enter": {
      "duration": 420,
      "timingFunction": "out-cubic"
    }
  },
  "motion": {
    "fast": {
      "duration": 150,
      "timingFunction": "out-cubic"
    },
    "default": {
      "duration": 250,
      "timingFunction": "out-cubic"
    },
    "slow": {
      "duration": 350,
      "timingFunction": "out-cubic"
    },
    "state": {
      "duration": 120,
      "timingFunction": "out-cubic"
    }
  },
  "finishes": {
    "shared": {
      "card": {
        "background": "{card}",
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "{border}",
        "elevation": null
      },
      "inset": {
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "transparent"
      },
      "channel": {
        "background": "{card}",
        "shadow": "0 1px 3px oklch(0 0 0 / 0.2)",
        "foreground": "{foreground}",
        "border-color": "{border}"
      },
      "raised": {
        "background": "oklch(from {raised} l c h / 0.72)",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent",
        "backdropFilter": "blur(30px)",
        "material": "glass"
      },
      "plate": {
        "foreground": "{foreground}",
        "border-color": "transparent",
        "elevation": null
      },
      "overlay": {
        "background": "oklch(from {popover} l c h / 0.72)",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "backdropFilter": "blur(30px)",
        "material": "glass",
        "elevation": null
      },
      "modal": {
        "background": "{card}",
        "foreground": "{foreground}",
        "border-color": "{border}",
        "elevation": null
      },
      "inverse": {
        "background": "oklch(from {inverse} l c h / 0.72)",
        "foreground": "{inverse-foreground}",
        "border-color": "transparent",
        "backdropFilter": "blur(30px)",
        "material": "glass",
        "elevation": null
      },
      "glass": {
        "foreground": "{foreground}",
        "border-color": "{border}",
        "backdropFilter": "blur(30px)",
        "background": "oklch(from {popover} l c h / 0.72)",
        "material": "glass",
        "elevation": null
      },
      "accent": {
        "background": "{primary}",
        "shadow": "none",
        "foreground": "{primary-foreground}",
        "border-color": "transparent",
        "border-bottom-color": "transparent",
        "pressed-opacity": 0.88,
        "pressed-background": null,
        "pressed-foreground": null
      },
      "fill": {
        "shadow": "none",
        "foreground": "{primary-foreground}",
        "background": "{primary}",
        "gradient": null,
        "border-color": "transparent"
      },
      "knob": {
        "shadow": "0 1px 3px oklch(0 0 0 / 0.2)",
        "foreground": "{foreground}",
        "background": "{knob}",
        "gradient": null,
        "border-color": "transparent",
        "checked-background": "{primary-foreground}"
      },
      "hover": {
        "foreground": "{foreground}",
        "background": "{hover}",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent",
        "elevation": null
      },
      "pressed": {
        "shadow": "none",
        "foreground": "{foreground}",
        "background": "{muted}",
        "border-color": "transparent",
        "elevation": null
      },
      "disabled": {
        "background": "{raised}",
        "foreground": "{foreground}",
        "border-color": "{border}"
      }
    },
    "light": {
      "raised": {
        "shadow": "0 0 0 0.5px oklch(0 0 0 / 0.08), 0 1px 3px oklch(0 0 0 / 0.2)"
      },
      "plate": {
        "background": "{card}",
        "shadow": "0 0 0 0.5px oklch(0 0 0 / 0.08), 0 1px 3px oklch(0 0 0 / 0.2)"
      },
      "overlay": {
        "shadow": "0 0 0 0.5px oklch(0 0 0 / 0.08), 0 8px 30px oklch(0 0 0 / 0.14)"
      },
      "modal": {
        "shadow": "0 0 0 0.5px oklch(0 0 0 / 0.08), 0 8px 30px oklch(0 0 0 / 0.14)"
      },
      "inverse": {
        "shadow": "0 0 0 0.5px oklch(0 0 0 / 0.08), 0 8px 30px oklch(0 0 0 / 0.14)"
      },
      "glass": {
        "shadow": "0 0 0 0.5px oklch(0 0 0 / 0.08), 0 1px 3px oklch(0 0 0 / 0.2)"
      },
      "hover": {
        "shadow": "0 0 0 0.5px oklch(0 0 0 / 0.08), 0 1px 3px oklch(0 0 0 / 0.2)"
      },
      "disabled": {
        "shadow": "0 0 0 0.5px oklch(0 0 0 / 0.08), 0 1px 3px oklch(0 0 0 / 0.2)"
      }
    },
    "dark": {
      "raised": {
        "shadow": "0 0 0 0.5px oklch(1 0 0 / 0.1), 0 1px 3px oklch(0 0 0 / 0.2)"
      },
      "plate": {
        "background": "{raised}",
        "shadow": "0 0 0 0.5px oklch(1 0 0 / 0.1), 0 1px 3px oklch(0 0 0 / 0.2)"
      },
      "overlay": {
        "shadow": "0 0 0 0.5px oklch(1 0 0 / 0.1), 0 8px 30px oklch(0 0 0 / 0.4)"
      },
      "modal": {
        "shadow": "0 0 0 0.5px oklch(1 0 0 / 0.1), 0 8px 30px oklch(0 0 0 / 0.4)"
      },
      "inverse": {
        "shadow": "0 0 0 0.5px oklch(1 0 0 / 0.1), 0 8px 30px oklch(0 0 0 / 0.4)"
      },
      "glass": {
        "shadow": "0 0 0 0.5px oklch(1 0 0 / 0.1), 0 1px 3px oklch(0 0 0 / 0.2)"
      },
      "hover": {
        "shadow": "0 0 0 0.5px oklch(1 0 0 / 0.1), 0 1px 3px oklch(0 0 0 / 0.2)"
      },
      "disabled": {
        "shadow": "0 0 0 0.5px oklch(1 0 0 / 0.1), 0 1px 3px oklch(0 0 0 / 0.2)"
      }
    }
  },
  "elevation": {
    "light": {
      "sm": "0 1px 3px oklch(0 0 0 / 0.2)",
      "md": null,
      "lg": "0 0 0 0.5px oklch(0 0 0 / 0.08), 0 8px 30px oklch(0 0 0 / 0.14)",
      "xl": "0 0 0 0.5px oklch(0 0 0 / 0.08), 0 8px 30px oklch(0 0 0 / 0.14)",
      "inset": null,
      "edge": {
        "surface": "0 0 0 0.5px oklch(0 0 0 / 0.08)",
        "accent": null
      }
    },
    "dark": {
      "sm": "0 1px 3px oklch(0 0 0 / 0.2)",
      "md": null,
      "lg": "0 0 0 0.5px oklch(1 0 0 / 0.1), 0 8px 30px oklch(0 0 0 / 0.4)",
      "xl": "0 0 0 0.5px oklch(1 0 0 / 0.1), 0 8px 30px oklch(0 0 0 / 0.4)",
      "inset": null,
      "edge": {
        "surface": "0 0 0 0.5px oklch(1 0 0 / 0.1)",
        "accent": null
      }
    }
  }
}
