{
  "typography": {
    "caption": {
      "fontSize": {
        "pointer": 10,
        "touch": 12
      },
      "lineHeight": {
        "pointer": 13,
        "touch": 16
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "detail": {
      "fontSize": {
        "pointer": 11,
        "touch": 13
      },
      "lineHeight": {
        "pointer": 14,
        "touch": 18
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "body": {
      "fontSize": {
        "pointer": 13,
        "touch": 17
      },
      "lineHeight": {
        "pointer": 16,
        "touch": 22
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "label": {
      "fontSize": {
        "pointer": 13,
        "touch": 17
      },
      "lineHeight": {
        "pointer": 16,
        "touch": 22
      },
      "fontWeight": 500,
      "letterSpacing": 0
    },
    "title": {
      "fontSize": {
        "pointer": 13,
        "touch": 17
      },
      "lineHeight": {
        "pointer": 16,
        "touch": 22
      },
      "fontWeight": 600,
      "letterSpacing": 0
    },
    "headline": {
      "fontSize": {
        "pointer": 22,
        "touch": 22
      },
      "lineHeight": {
        "pointer": 26,
        "touch": 28
      },
      "fontWeight": 600,
      "letterSpacing": 0
    },
    "display": {
      "fontSize": {
        "pointer": 26,
        "touch": 34
      },
      "lineHeight": {
        "pointer": 32,
        "touch": 41
      },
      "fontWeight": 600,
      "letterSpacing": 0
    }
  },
  "dimension": {
    "shape": {
      "control": "{radius-control}",
      "container": "{radius-container}",
      "modal": "{radius-modal}"
    },
    "size": {
      "hit": {
        "pointer": 0,
        "touch": 44
      },
      "density": {
        "pointer": {
          "pad": 16,
          "gap": 12,
          "surface": 12
        },
        "touch": {
          "pad": 16,
          "gap": 12,
          "surface": 20
        }
      },
      "control": {
        "pointer": {
          "padding": 8,
          "gap": 8,
          "dot": 6,
          "switch": "regular"
        },
        "touch": {
          "padding": 8,
          "gap": 8,
          "dot": 8,
          "switch": "regular"
        }
      },
      "height": {
        "pointer": {
          "sm": 24,
          "md": 28,
          "lg": 32
        },
        "touch": {
          "sm": 32,
          "md": 44,
          "lg": 56
        }
      }
    },
    "stroke": {
      "hairline": 0.5,
      "control": 1
    },
    "focus": {
      "style": "halo",
      "width": 3,
      "offset": 0
    },
    "icon": {
      "pointer": {
        "sm": 12,
        "md": 16,
        "lg": 20
      },
      "touch": {
        "sm": 16,
        "md": 20,
        "lg": 24
      }
    }
  },
  "shape": {
    "curve": "continuous",
    "corners": {
      "button": "full"
    }
  },
  "state": {
    "press-scale": 1,
    "overlay": {
      "hover": 0,
      "focus": 0,
      "pressed": 0,
      "dragged": 0
    },
    "ripple": false,
    "pressed-opacity": 0.7,
    "rest-opacity": 0.5,
    "disabled": {
      "content": 0.3,
      "fill": false
    }
  },
  "transition": {
    "enter": {
      "duration": 420,
      "timingFunction": "out-cubic"
    }
  },
  "motion": {
    "fast": {
      "stiffness": 1218,
      "damping": 70
    },
    "default": {
      "stiffness": 520,
      "damping": 34
    },
    "slow": {
      "stiffness": 320,
      "damping": 30
    }
  },
  "controls": "base",
  "finishes": {
    "shared": {
      "card": {
        "gradient": "linear-gradient(180deg, {card} 0%, {card} 100%)",
        "border-color": "{border}",
        "material": null,
        "shadow": "none"
      },
      "section": {
        "background": "{card}",
        "shadow": "none",
        "border-color": "{border}",
        "material": null
      },
      "inset": {
        "material": null,
        "shadow": "none"
      },
      "field": {
        "shadow": "none",
        "material": null
      },
      "raised": {
        "background": "oklch(from {raised} l c h / 0.72)",
        "gradient": "linear-gradient(180deg, transparent 0%, transparent 100%)",
        "backdropFilter": "blur(30px)",
        "material": {
          "apple": {
            "glass": "regular",
            "tint": null
          }
        },
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent"
      },
      "hover": {
        "material": null,
        "background": "{hover}",
        "gradient": "linear-gradient(180deg, {hover} 0%, {hover} 100%)",
        "shadow": "none",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent"
      },
      "pressed": {
        "foreground": "{foreground}",
        "material": null,
        "background": "{muted}",
        "gradient": "linear-gradient(180deg, {muted} 0%, {muted} 100%)",
        "shadow": "none",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent"
      },
      "disabled": {
        "background": "{raised}",
        "gradient": "linear-gradient(180deg, {raised} 0%, {raised} 100%)",
        "shadow": "none",
        "foreground": "{muted-foreground}",
        "border-color": "{border}",
        "material": null
      },
      "light": {
        "background": "{primary}",
        "gradient": "linear-gradient(180deg, {primary} 0%, {primary} 100%)",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent",
        "material": null,
        "shadow": "none"
      },
      "accent": {
        "background": "{primary}",
        "gradient": "linear-gradient(180deg, {primary} 0%, {primary} 100%)",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent",
        "material": null,
        "shadow": "none"
      },
      "accentPressed": {
        "gradient": "linear-gradient(180deg, transparent 0%, transparent 100%)",
        "foreground": "{primary-foreground}",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent",
        "material": null,
        "background": "oklch(from {primary} l c h / 0.88)",
        "shadow": "none"
      },
      "track": {
        "material": null,
        "shadow": "none",
        "border-color": "transparent"
      },
      "fill": {
        "background": "transparent",
        "shadow": "none",
        "material": null,
        "gradient": "linear-gradient(180deg, {primary} 0%, {primary} 100%)",
        "border-color": "transparent"
      },
      "knob": {
        "material": null,
        "background": "{knob}",
        "gradient": "linear-gradient(180deg, {knob} 0%, {knob} 100%)",
        "shadow": "0 1px 3px oklch(0 0 0 / 0.2)",
        "border-color": "transparent"
      },
      "knobOn": {
        "background": "{knob}",
        "gradient": "linear-gradient(180deg, {knob} 0%, {knob} 100%)",
        "shadow": "0 1px 3px oklch(0 0 0 / 0.2)",
        "material": null,
        "border-color": "transparent"
      },
      "handle": {
        "material": null,
        "background": "{knob}",
        "gradient": "linear-gradient(180deg, {knob} 0%, {knob} 100%)",
        "shadow": "0 1px 3px oklch(0 0 0 / 0.2)",
        "border-color": "transparent"
      },
      "pill": {
        "background": "{raised}",
        "gradient": "linear-gradient(180deg, {raised} 0%, {raised} 100%)",
        "material": null,
        "border-color": "transparent"
      },
      "thumb": {
        "material": null,
        "shadow": "0 1px 3px oklch(0 0 0 / 0.16)",
        "border-color": "transparent"
      },
      "on": {
        "foreground": "{foreground}",
        "material": null,
        "background": "{muted}",
        "gradient": "linear-gradient(180deg, {muted} 0%, {muted} 100%)",
        "shadow": "none",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent"
      },
      "chip": {
        "background": "{muted}",
        "gradient": "linear-gradient(180deg, {muted} 0%, {muted} 100%)",
        "border-color": "transparent",
        "material": null,
        "shadow": "none"
      },
      "glass": {
        "border-color": "{border}",
        "backdropFilter": "blur(30px)",
        "material": {
          "apple": {
            "glass": "regular",
            "tint": null
          },
          "ios": {
            "backdrop": "thin"
          }
        },
        "background": "oklch(from {popover} l c h / 0.4)",
        "shadow": "none"
      },
      "menu": {
        "background": "oklch(from {popover} l c h / 0.72)",
        "border-color": "transparent",
        "backdropFilter": "blur(30px)",
        "material": {
          "apple": {
            "glass": "regular",
            "tint": null
          },
          "ios": {
            "backdrop": "regular"
          }
        }
      },
      "modal": {
        "background": "{card}",
        "border-color": "{border}",
        "material": null
      },
      "grabber": {
        "background": "{raised}",
        "shadow": "none",
        "material": null
      },
      "tooltip": {
        "background": "{popover}",
        "shadow": "none",
        "border-color": "{border}",
        "material": null
      },
      "inverse": {
        "background": "oklch(from {inverse} l c h / 0.72)",
        "foreground": "{muted-foreground}",
        "border-color": "transparent",
        "backdropFilter": "blur(30px)",
        "material": {
          "apple": {
            "glass": "regular",
            "tint": null
          },
          "ios": {
            "backdrop": "regular"
          }
        }
      },
      "groove": {
        "material": null,
        "shadow": "none"
      }
    },
    "light": {
      "raised": {
        "shadow": "0 0 0 0.5px oklch(0 0 0 / 0.08)"
      },
      "pill": {
        "shadow": "0 0 0 0.5px oklch(0 0 0 / 0.08)"
      },
      "thumb": {
        "background": "{knob}",
        "gradient": "linear-gradient(180deg, {knob} 0%, {knob} 100%)"
      },
      "menu": {
        "shadow": "0 0 0 0.5px oklch(0 0 0 / 0.08), 0 8px 30px oklch(0 0 0 / 0.14)"
      },
      "modal": {
        "shadow": "0 0 0 0.5px oklch(0 0 0 / 0.08), 0 8px 30px oklch(0 0 0 / 0.14)"
      },
      "inverse": {
        "shadow": "0 0 0 0.5px oklch(0 0 0 / 0.08), 0 8px 30px oklch(0 0 0 / 0.14)"
      }
    },
    "dark": {
      "raised": {
        "shadow": "0 0 0 0.5px oklch(1 0 0 / 0.1)"
      },
      "pill": {
        "shadow": "0 0 0 0.5px oklch(1 0 0 / 0.1)"
      },
      "thumb": {
        "background": "{raised}",
        "gradient": "linear-gradient(180deg, {raised} 0%, {raised} 100%)"
      },
      "menu": {
        "shadow": "0 0 0 0.5px oklch(1 0 0 / 0.1), 0 8px 30px oklch(0 0 0 / 0.4)"
      },
      "modal": {
        "shadow": "0 0 0 0.5px oklch(1 0 0 / 0.1), 0 8px 30px oklch(0 0 0 / 0.4)"
      },
      "inverse": {
        "shadow": "0 0 0 0.5px oklch(1 0 0 / 0.1), 0 8px 30px oklch(0 0 0 / 0.4)"
      }
    }
  }
}
