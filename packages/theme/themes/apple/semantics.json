{
  "typography": {
    "caption": {
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "detail": {
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "body": {
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "label": {
      "fontWeight": 500,
      "letterSpacing": 0
    },
    "title": {
      "fontWeight": 600,
      "letterSpacing": 0
    },
    "headline": {
      "fontWeight": 600,
      "letterSpacing": 0
    },
    "display": {
      "fontWeight": 600,
      "letterSpacing": 0
    }
  },
  "dimension": {
    "size": {
      "hit": {
        "pointer": 0,
        "touch": 44
      },
      "density": {
        "pointer": {
          "pad": 16,
          "gap": 12
        },
        "touch": {
          "pad": 16,
          "gap": 12
        }
      },
      "item": {
        "pointer": {
          "inset": 4,
          "pad": 8
        },
        "touch": {
          "inset": 0,
          "pad": 16
        }
      },
      "control": {
        "pointer": {
          "padding": 8,
          "gap": 8
        },
        "touch": {
          "padding": 8,
          "gap": 8
        }
      },
      "height": {
        "pointer": {
          "sm": 24,
          "md": 28,
          "lg": 32
        },
        "touch": {
          "sm": 32,
          "md": 44,
          "lg": 56
        }
      }
    },
    "stroke": {
      "hairline": 0.5,
      "control": 1
    },
    "focus": {
      "style": "halo",
      "width": 3,
      "offset": 0
    },
    "icon": {
      "pointer": {
        "sm": 12,
        "md": 16,
        "lg": 20
      },
      "touch": {
        "sm": 16,
        "md": 20,
        "lg": 24
      }
    }
  },
  "controls": {
    "button": {
      "corner": {
        "sm": {
          "pointer": 5,
          "touch": "full"
        },
        "md": {
          "pointer": 6,
          "touch": "full"
        },
        "lg": {
          "pointer": 8,
          "touch": "full"
        }
      },
      "selected": {
        "face": {
          "tint": "brand"
        },
        "ink": {
          "color": "brand"
        }
      },
      "secondary": {
        "face": {
          "color": "raised"
        },
        "ink": {
          "color": "foreground"
        },
        "edge": "none",
        "hover": {
          "light": {
            "color": "muted"
          },
          "dark": {
            "color": "track"
          }
        }
      },
      "outline": {
        "edge": {
          "color": "border"
        }
      },
      "destructive": {
        "edge": "none"
      },
      "shade": "none"
    },
    "badge": {
      "corner": "full"
    },
    "field": {
      "edge": {
        "sides": true,
        "color": {
          "color": "input"
        },
        "bottom": {
          "color": "input"
        }
      },
      "corner": {
        "bottom": "control"
      },
      "focus": {
        "line": false,
        "width": 3,
        "color": {
          "color": "ring"
        }
      },
      "disabled": {
        "face": "keep"
      }
    },
    "choice": {
      "size": {
        "pointer": 16,
        "touch": 22
      },
      "box": {
        "pointer": 16,
        "touch": 20
      },
      "corner": {
        "pointer": 4,
        "touch": 7
      },
      "face": {
        "light": {
          "color": "card"
        },
        "dark": {
          "color": "raised"
        }
      },
      "shade": "none",
      "edge": {
        "width": 1,
        "color": {
          "light": {
            "color": "input"
          },
          "dark": {
            "color": "foreground",
            "alpha": 0.2
          }
        },
        "disabled": {
          "light": {
            "color": "input"
          },
          "dark": {
            "color": "foreground",
            "alpha": 0.4
          }
        }
      },
      "checked": {
        "face": {
          "finish": "accent"
        }
      },
      "radio": {
        "checked": {
          "face": {
            "finish": "accent"
          },
          "edge": "none"
        }
      },
      "mark": {
        "size": {
          "pointer": 6,
          "touch": 8
        },
        "hover": "none",
        "pressed": "none"
      },
      "halo": "none"
    },
    "switch": {
      "track": {
        "pointer": [
          54,
          24
        ],
        "touch": [
          63,
          28
        ]
      },
      "small": {
        "track": {
          "pointer": [
            40,
            18
          ],
          "touch": [
            48,
            22
          ]
        },
        "knob": {
          "pointer": [
            23,
            14
          ],
          "touch": [
            28,
            18
          ]
        }
      },
      "edge": {
        "off": 0,
        "on": 0,
        "color": "none"
      },
      "knob": {
        "size": {
          "pointer": [
            31,
            20
          ],
          "touch": [
            37,
            24
          ]
        },
        "on": "same",
        "hover": "same",
        "pressed": "same"
      }
    },
    "slider": {
      "rail": {
        "pointer": 4,
        "touch": 6
      },
      "band": {
        "pointer": 24,
        "touch": 32
      },
      "face": {
        "color": "track"
      },
      "shade": "none",
      "edge": {
        "color": {
          "color": "border"
        },
        "width": 0
      },
      "knob": {
        "size": {
          "pointer": [
            20,
            16
          ],
          "touch": [
            37,
            24
          ]
        },
        "pressed": {
          "pointer": [
            20,
            16
          ],
          "touch": [
            49,
            32
          ]
        },
        "face": {
          "finish": "knob"
        },
        "edge": {
          "color": "border"
        }
      },
      "mark": {
        "size": 0,
        "hover": 0,
        "pressed": 0
      },
      "brightens": true
    },
    "progress": {
      "height": 6,
      "line": 0,
      "face": {
        "color": "track"
      },
      "shade": "inset",
      "edge": {
        "color": {
          "color": "border"
        },
        "width": "control"
      }
    },
    "calendar": {
      "today": {
        "face": "none",
        "ink": {
          "color": "brand"
        }
      }
    },
    "spinner": {
      "opacity": 0,
      "spokes": true
    },
    "popup": {
      "corner": "container"
    },
    "tooltip": {
      "face": {
        "finish": "inverse"
      },
      "ink": {
        "finish": "inverse",
        "field": "foreground"
      },
      "edge": {
        "finish": "inverse",
        "field": "borderColor"
      },
      "shade": "plate"
    },
    "toast": {
      "action": {
        "face": {
          "finish": "accent"
        }
      }
    },
    "list": {
      "item": {
        "highlight": {
          "tint": "brand"
        },
        "edge": "none"
      }
    },
    "menubar": {
      "bar": "none"
    },
    "tabs": {
      "track": {
        "face": {
          "color": "inset"
        },
        "edge": {
          "color": "border"
        },
        "corner": "full"
      }
    },
    "well": {
      "edge": "none"
    },
    "disabled": {
      "face": "keep",
      "ink": "keep",
      "edge": "keep"
    }
  },
  "shape": {
    "curve": "continuous"
  },
  "state": {
    "press-scale": 1,
    "overlay": {
      "hover": 0,
      "pressed": 0
    },
    "pressed-opacity": 0.7,
    "rest-opacity": 0.5,
    "disabled": {
      "content": 0.4
    }
  },
  "motion": {
    "fast": {
      "duration": 150,
      "timingFunction": "out-cubic"
    },
    "default": {
      "duration": 250,
      "timingFunction": "out-cubic"
    },
    "slow": {
      "duration": 350,
      "timingFunction": "out-cubic"
    },
    "state": {
      "duration": 120,
      "timingFunction": "out-cubic"
    }
  },
  "finishes": {
    "shared": {
      "card": {
        "background": "{card}",
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "{border}",
        "elevation": null
      },
      "inset": {
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "{input}",
        "border-bottom-color": null
      },
      "channel": {
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "transparent"
      },
      "raised": {
        "background": "oklch(from {raised} l c h / 0.72)",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent",
        "backdropFilter": "blur(30px)",
        "material": "glass"
      },
      "plate": {
        "foreground": "{foreground}",
        "border-color": "transparent",
        "elevation": null
      },
      "overlay": {
        "background": "oklch(from {popover} l c h / 0.72)",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "backdropFilter": "blur(30px)",
        "material": "glass",
        "elevation": null
      },
      "modal": {
        "background": "{card}",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "elevation": null
      },
      "inverse": {
        "background": "oklch(from {inverse} l c h / 0.72)",
        "foreground": "{inverse-foreground}",
        "border-color": "transparent",
        "backdropFilter": "blur(30px)",
        "material": "glass",
        "elevation": null
      },
      "glass": {
        "foreground": "{foreground}",
        "border-color": "{border}",
        "backdropFilter": "blur(30px)",
        "background": "oklch(from {popover} l c h / 0.72)",
        "material": "glass",
        "elevation": null
      },
      "accent": {
        "background": "{primary}",
        "shadow": "none",
        "foreground": "{primary-foreground}",
        "border-color": "transparent",
        "border-bottom-color": "transparent",
        "pressed-opacity": 0.72,
        "pressed-background": null,
        "pressed-foreground": null
      },
      "fill": {
        "shadow": "none",
        "foreground": "{primary-foreground}",
        "background": "{primary}",
        "gradient": null,
        "border-color": "transparent"
      },
      "knob": {
        "foreground": "{foreground}",
        "background": "{knob}",
        "gradient": null,
        "border-color": "transparent",
        "checked-background": "{primary-foreground}"
      },
      "hover": {
        "foreground": "{foreground}",
        "background": "{hover}",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent",
        "elevation": null
      },
      "pressed": {
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "elevation": null
      },
      "disabled": {
        "background": "{raised}",
        "foreground": "{foreground}",
        "border-color": "{border}"
      }
    },
    "light": {
      "channel": {
        "background": "{raised}"
      },
      "raised": {
        "shadow": "0 0 0 0.5px oklch(0 0 0 / 0.08), 0 1px 2px oklch(0 0 0 / 0.12)"
      },
      "plate": {
        "background": "{card}",
        "shadow": "0 0 0 0.5px oklch(0 0 0 / 0.08), 0 1px 2px oklch(0 0 0 / 0.12)"
      },
      "overlay": {
        "shadow": "0 0 0 0.5px oklch(0 0 0 / 0.08), 0 8px 24px oklch(0 0 0 / 0.14)"
      },
      "modal": {
        "shadow": "0 0 0 0.5px oklch(0 0 0 / 0.08), 0 18px 48px oklch(0 0 0 / 0.2)"
      },
      "inverse": {
        "shadow": "0 0 0 0.5px oklch(0 0 0 / 0.08), 0 8px 24px oklch(0 0 0 / 0.14)"
      },
      "glass": {
        "shadow": "0 0 0 0.5px oklch(0 0 0 / 0.08), 0 1px 2px oklch(0 0 0 / 0.12)"
      },
      "knob": {
        "shadow": "0 1px 2px oklch(0 0 0 / 0.12)"
      },
      "hover": {
        "shadow": "0 0 0 0.5px oklch(0 0 0 / 0.08), 0 1px 2px oklch(0 0 0 / 0.12)"
      },
      "pressed": {
        "background": "oklch(from {foreground} l c h / 0.16)"
      },
      "disabled": {
        "shadow": "0 0 0 0.5px oklch(0 0 0 / 0.08), 0 1px 2px oklch(0 0 0 / 0.12)"
      }
    },
    "dark": {
      "channel": {
        "background": "{inset}"
      },
      "raised": {
        "shadow": "0 0 0 0.5px oklch(1 0 0 / 0.1), 0 1px 2px oklch(0 0 0 / 0.2)"
      },
      "plate": {
        "background": "{raised}",
        "shadow": "0 0 0 0.5px oklch(1 0 0 / 0.1), 0 1px 2px oklch(0 0 0 / 0.2)"
      },
      "overlay": {
        "shadow": "0 0 0 0.5px oklch(1 0 0 / 0.1), 0 8px 24px oklch(0 0 0 / 0.38)"
      },
      "modal": {
        "shadow": "0 0 0 0.5px oklch(1 0 0 / 0.1), 0 18px 48px oklch(0 0 0 / 0.5)"
      },
      "inverse": {
        "shadow": "0 0 0 0.5px oklch(1 0 0 / 0.1), 0 8px 24px oklch(0 0 0 / 0.38)"
      },
      "glass": {
        "shadow": "0 0 0 0.5px oklch(1 0 0 / 0.1), 0 1px 2px oklch(0 0 0 / 0.2)"
      },
      "knob": {
        "shadow": "0 1px 2px oklch(0 0 0 / 0.2)"
      },
      "hover": {
        "shadow": "0 0 0 0.5px oklch(1 0 0 / 0.1), 0 1px 2px oklch(0 0 0 / 0.2)"
      },
      "pressed": {
        "background": "oklch(from {foreground} l c h / 0.2)"
      },
      "disabled": {
        "shadow": "0 0 0 0.5px oklch(1 0 0 / 0.1), 0 1px 2px oklch(0 0 0 / 0.2)"
      }
    }
  },
  "elevation": {
    "light": {
      "sm": "0 1px 2px oklch(0 0 0 / 0.12)",
      "md": null,
      "lg": "0 0 0 0.5px oklch(0 0 0 / 0.08), 0 8px 24px oklch(0 0 0 / 0.14)",
      "xl": "0 0 0 0.5px oklch(0 0 0 / 0.08), 0 18px 48px oklch(0 0 0 / 0.2)",
      "inset": null,
      "edge": {
        "surface": "0 0 0 0.5px oklch(0 0 0 / 0.08)",
        "accent": null
      }
    },
    "dark": {
      "sm": "0 1px 2px oklch(0 0 0 / 0.2)",
      "md": null,
      "lg": "0 0 0 0.5px oklch(1 0 0 / 0.1), 0 8px 24px oklch(0 0 0 / 0.38)",
      "xl": "0 0 0 0.5px oklch(1 0 0 / 0.1), 0 18px 48px oklch(0 0 0 / 0.5)",
      "inset": null,
      "edge": {
        "surface": "0 0 0 0.5px oklch(1 0 0 / 0.1)",
        "accent": null
      }
    }
  }
}
