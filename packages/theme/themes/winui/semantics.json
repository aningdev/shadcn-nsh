{
  "typography": {
    "fontFamily": "{font-sans}",
    "caption": {
      "fontSize": {
        "pointer": 12,
        "touch": 12
      },
      "lineHeight": {
        "pointer": 1.3333333333333333,
        "touch": 1.3333333333333333
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "detail": {
      "fontSize": {
        "pointer": 12,
        "touch": 12
      },
      "lineHeight": {
        "pointer": 1.3333333333333333,
        "touch": 1.3333333333333333
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "body": {
      "fontSize": {
        "pointer": 14,
        "touch": 14
      },
      "lineHeight": {
        "pointer": 1.4285714285714286,
        "touch": 1.4285714285714286
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "label": {
      "fontSize": {
        "pointer": 14,
        "touch": 14
      },
      "lineHeight": {
        "pointer": 1.4285714285714286,
        "touch": 1.4285714285714286
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "title": {
      "fontSize": {
        "pointer": 14,
        "touch": 14
      },
      "lineHeight": {
        "pointer": 1.4285714285714286,
        "touch": 1.4285714285714286
      },
      "fontWeight": 600,
      "letterSpacing": 0
    },
    "headline": {
      "fontSize": {
        "pointer": 20,
        "touch": 20
      },
      "lineHeight": {
        "pointer": 1.4,
        "touch": 1.4
      },
      "fontWeight": 600,
      "letterSpacing": 0
    },
    "display": {
      "fontSize": {
        "pointer": 28,
        "touch": 28
      },
      "lineHeight": {
        "pointer": 1.2857142857142858,
        "touch": 1.2857142857142858
      },
      "fontWeight": 600,
      "letterSpacing": 0
    }
  },
  "dimension": {
    "shape": {
      "control": "{radius-control}",
      "container": "{radius-container}",
      "modal": "{radius-modal}"
    },
    "size": {
      "hit": {
        "pointer": 0,
        "touch": 40
      },
      "density": {
        "pointer": {
          "row": 40,
          "pad": 16,
          "gap": 8,
          "surface": 4
        },
        "touch": {
          "row": 40,
          "pad": 16,
          "gap": 8,
          "surface": 8
        }
      },
      "control": {
        "pointer": {
          "row": 32,
          "padding": 6,
          "gap": 8,
          "control": 20,
          "check": 12,
          "dot": 12,
          "tabs": 32,
          "line": 32,
          "clear": 16,
          "switch": "regular"
        },
        "touch": {
          "row": 40,
          "padding": 8,
          "gap": 8,
          "control": 20,
          "check": 12,
          "dot": 12,
          "tabs": 40,
          "line": 40,
          "clear": 20,
          "switch": "regular"
        }
      },
      "height": {
        "pointer": {
          "sm": 24,
          "md": 32,
          "lg": 40
        },
        "touch": {
          "sm": 32,
          "md": 40,
          "lg": 48
        }
      }
    },
    "stroke": {
      "hairline": 1,
      "surface": 1,
      "control": 1
    },
    "focus": {
      "style": "double",
      "width": 2,
      "offset": 0
    },
    "icon": {
      "pointer": {
        "sm": 12,
        "md": 16,
        "lg": 20
      },
      "touch": {
        "sm": 16,
        "md": 20,
        "lg": 24
      }
    }
  },
  "shape": {
    "curve": "circular",
    "corners": {
      "button": "radius"
    }
  },
  "state": {
    "press-scale": 1,
    "overlay": {
      "hover": 0,
      "focus": 0,
      "pressed": 0,
      "dragged": 0
    },
    "ripple": false,
    "pressed-opacity": 1,
    "accent-pressed-opacity": 1,
    "disabled": {
      "content": 0.36,
      "fill": true
    }
  },
  "duration": {
    "shake": 500
  },
  "transition": {
    "enter": {
      "duration": 250,
      "timingFunction": "decelerate"
    }
  },
  "motion": {
    "press": {
      "duration": 83,
      "timingFunction": "decelerate"
    },
    "settle": {
      "duration": 250,
      "timingFunction": "decelerate"
    },
    "control": {
      "duration": 167,
      "timingFunction": "point-to-point"
    },
    "move": {
      "duration": 333,
      "timingFunction": "point-to-point"
    }
  },
  "controls": "winui",
  "finishes": {
    "shared": {
      "card": {
        "gradient": "linear-gradient(180deg, {card} 0%, {card} 100%)",
        "material": null
      },
      "section": {
        "background": "{card}",
        "shadow": "none",
        "border-color": "{card-edge}",
        "material": null
      },
      "inset": {
        "material": null,
        "shadow": "none"
      },
      "field": {
        "shadow": "none",
        "material": null
      },
      "raised": {
        "background": "{raised}",
        "gradient": "linear-gradient(180deg, {raised} 0%, {raised} 100%)",
        "backdropFilter": "none",
        "material": null,
        "shadow": "none",
        "border-color": "{border}"
      },
      "hover": {
        "material": null,
        "background": "{hover}",
        "gradient": "linear-gradient(180deg, {hover} 0%, {hover} 100%)",
        "shadow": "none",
        "border-color": "{border}"
      },
      "pressed": {
        "material": null,
        "background": "{muted}",
        "gradient": "linear-gradient(180deg, {muted} 0%, {muted} 100%)",
        "shadow": "none",
        "border-color": "{border}",
        "border-top-color": "{border}",
        "border-bottom-color": "{border}"
      },
      "disabled": {
        "background": "{disabled}",
        "gradient": "linear-gradient(180deg, {disabled} 0%, {disabled} 100%)",
        "shadow": "none",
        "border-color": "{border}",
        "material": null
      },
      "light": {
        "background": "{primary}",
        "gradient": "linear-gradient(180deg, {primary} 0%, {primary} 100%)",
        "border-color": "{accent-bevel}",
        "border-top-color": "{accent-bevel}",
        "border-bottom-color": "{brand-edge}",
        "material": null,
        "shadow": "none"
      },
      "accent": {
        "background": "{primary}",
        "gradient": "linear-gradient(180deg, {primary} 0%, {primary} 100%)",
        "border-color": "{accent-bevel}",
        "border-top-color": "{accent-bevel}",
        "border-bottom-color": "{brand-edge}",
        "material": null,
        "shadow": "none"
      },
      "accentPressed": {
        "background": "{accent-pressed}",
        "gradient": "linear-gradient(180deg, {accent-pressed} 0%, {accent-pressed} 100%)",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent",
        "material": null,
        "shadow": "none"
      },
      "track": {
        "material": null,
        "shadow": "none",
        "border-color": "{input}"
      },
      "fill": {
        "background": "transparent",
        "shadow": "none",
        "material": null,
        "gradient": "linear-gradient(180deg, {primary} 0%, {primary} 100%)",
        "border-color": "transparent"
      },
      "knob": {
        "material": null,
        "background": "{knob}",
        "gradient": "linear-gradient(180deg, {knob} 0%, {knob} 100%)",
        "shadow": "none",
        "border-color": "transparent"
      },
      "knobOn": {
        "background": "{primary-foreground}",
        "gradient": "linear-gradient(180deg, {primary-foreground} 0%, {primary-foreground} 100%)",
        "shadow": "none",
        "material": null,
        "border-color": "transparent"
      },
      "handle": {
        "material": null,
        "background": "{popover}",
        "gradient": "linear-gradient(180deg, {popover} 0%, {popover} 100%)",
        "border-color": "{border}"
      },
      "pill": {
        "background": "{raised}",
        "gradient": "linear-gradient(180deg, {raised} 0%, {raised} 100%)",
        "material": null,
        "shadow": "none",
        "border-color": "{border}"
      },
      "thumb": {
        "material": null,
        "background": "{popover}",
        "gradient": "linear-gradient(180deg, {popover} 0%, {popover} 100%)",
        "border-color": "{border}"
      },
      "on": {
        "material": null,
        "background": "{primary}",
        "gradient": "linear-gradient(180deg, {primary} 0%, {primary} 100%)",
        "shadow": "none",
        "border-color": "{accent-bevel}",
        "border-top-color": "{accent-bevel}",
        "border-bottom-color": "{brand-edge}"
      },
      "chip": {
        "background": "{raised}",
        "gradient": "linear-gradient(180deg, {raised} 0%, {raised} 100%)",
        "border-color": "{border}",
        "material": null,
        "shadow": "none"
      },
      "glass": {
        "border-color": "{glass-edge}",
        "backdropFilter": "blur(30px)",
        "material": {
          "windows": {
            "backdrop": "blur"
          }
        }
      },
      "menu": {
        "background": "{popover}",
        "border-color": "{glass-edge}",
        "backdropFilter": "none",
        "material": {
          "windows": {
            "backdrop": "blur"
          }
        }
      },
      "dialog": {
        "background": "{dialog}",
        "material": null
      },
      "grabber": {
        "background": "{raised}",
        "shadow": "none",
        "material": null
      },
      "tooltip": {
        "background": "{popover}",
        "border-color": "{glass-edge}",
        "material": {
          "windows": {
            "backdrop": "blur"
          }
        }
      },
      "inverse": {
        "background": "{inverse}",
        "border-color": "{glass-edge}",
        "backdropFilter": "none",
        "material": null
      },
      "groove": {
        "material": null,
        "shadow": "none"
      }
    },
    "light": {
      "card": {
        "shadow": "0 0 2px oklch(0 0 0 / 0.12), 0 4px 8px oklch(0 0 0 / 0.14)"
      },
      "raised": {
        "border-top-color": "{border}",
        "border-bottom-color": "{bevel}"
      },
      "hover": {
        "border-top-color": "{border}",
        "border-bottom-color": "{bevel}"
      },
      "handle": {
        "shadow": "0 0 2px oklch(0 0 0 / 0.12), 0 1px 2px oklch(0 0 0 / 0.14)"
      },
      "thumb": {
        "shadow": "0 0 2px oklch(0 0 0 / 0.12), 0 1px 2px oklch(0 0 0 / 0.14)"
      },
      "glass": {
        "background": "oklch(from {popover} l c h / 0.85)",
        "shadow": "0 0 8px oklch(0 0 0 / 0.2), 0 16px 32px oklch(0 0 0 / 0.24)"
      },
      "menu": {
        "shadow": "0 0 8px oklch(0 0 0 / 0.2), 0 16px 32px oklch(0 0 0 / 0.24)"
      },
      "dialog": {
        "border-color": "oklch(0.81093 0 0)",
        "shadow": "0 0 8px oklch(0 0 0 / 0.2), 0 64px 128px oklch(0 0 0 / 0.24)"
      },
      "tooltip": {
        "shadow": "0 0 2px oklch(0 0 0 / 0.12), 0 8px 16px oklch(0 0 0 / 0.14)"
      },
      "inverse": {
        "shadow": "0 0 8px oklch(0 0 0 / 0.2), 0 16px 32px oklch(0 0 0 / 0.24)"
      }
    },
    "dark": {
      "card": {
        "shadow": "0 0 2px oklch(0 0 0 / 0.24), 0 4px 8px oklch(0 0 0 / 0.28)"
      },
      "raised": {
        "border-top-color": "{bevel}",
        "border-bottom-color": "{border}"
      },
      "hover": {
        "border-top-color": "{bevel}",
        "border-bottom-color": "{border}"
      },
      "handle": {
        "shadow": "0 0 2px oklch(0 0 0 / 0.24), 0 1px 2px oklch(0 0 0 / 0.28)"
      },
      "thumb": {
        "shadow": "0 0 2px oklch(0 0 0 / 0.24), 0 1px 2px oklch(0 0 0 / 0.28)"
      },
      "glass": {
        "background": "oklch(from {popover} l c h / 0.96)",
        "shadow": "0 0 8px oklch(0 0 0 / 0.4), 0 16px 32px oklch(0 0 0 / 0.48)"
      },
      "menu": {
        "shadow": "0 0 8px oklch(0 0 0 / 0.4), 0 16px 32px oklch(0 0 0 / 0.48)"
      },
      "dialog": {
        "border-color": "oklch(0.37909 0 0)",
        "shadow": "0 0 8px oklch(0 0 0 / 0.4), 0 64px 128px oklch(0 0 0 / 0.48)"
      },
      "tooltip": {
        "shadow": "0 0 2px oklch(0 0 0 / 0.24), 0 8px 16px oklch(0 0 0 / 0.28)"
      },
      "inverse": {
        "shadow": "0 0 8px oklch(0 0 0 / 0.4), 0 16px 32px oklch(0 0 0 / 0.48)"
      }
    }
  }
}
