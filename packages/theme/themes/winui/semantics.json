      "lineHeight": {
        "pointer": 16,
        "touch": 16
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "detail": {
      "fontSize": {
        "pointer": 12,
        "touch": 13
      },
      "lineHeight": {
        "pointer": 16,
        "touch": 20
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "body": {
      "fontSize": {
        "pointer": 13,
        "touch": 15
      },
      "lineHeight": {
        "pointer": 20,
        "touch": 20
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "label": {
      "fontSize": {
        "pointer": 14,
        "touch": 15
      },
      "lineHeight": {
        "pointer": 20,
        "touch": 20
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "title": {
      "fontSize": {
        "pointer": 16,
        "touch": 16
      },
      "lineHeight": {
        "pointer": 24,
        "touch": 24
      },
      "fontWeight": 600,
      "letterSpacing": 0
    },
    "headline": {
      "fontSize": {
        "pointer": 20,
        "touch": 22
      },
      "lineHeight": {
        "pointer": 28,
        "touch": 28
      },
      "fontWeight": 600,
      "letterSpacing": 0
    },
    "display": {
      "fontSize": {
        "pointer": 26,
        "touch": 28
      },
      "lineHeight": {
        "pointer": 32,
        "touch": 36
      },
      "fontWeight": 600,
      "letterSpacing": 0
    }
  },
  "dimension": {
    "shape": {
      "control": "{radius-control}",
      "container": "{radius-container}",
      "modal": "{radius-modal}"
    },
    "size": {
      "hit": {
        "pointer": 0,
        "touch": 40
      },
      "density": {
        "pointer": {
          "pad": 12,
          "gap": 8
        },
        "touch": {
          "pad": 12,
          "gap": 8
        }
      },
      "item": {
        "pointer": {
          "inset": 4,
          "pad": 11
        },
        "touch": {
          "inset": 4,
          "pad": 11
        }
      },
      "control": {
        "pointer": {
          "padding": 6,
          "gap": 8,
          "dot": 12,
          "switch": "regular"
        },
        "touch": {
          "padding": 6,
          "gap": 8,
          "dot": 12,
          "switch": "regular"
        }
      },
      "height": {
        "pointer": {
          "sm": 24,
          "md": 32,
          "lg": 40
        },
        "touch": {
          "sm": 32,
          "md": 40,
          "lg": 48
        }
      }
    },
    "stroke": {
      "hairline": 1,
      "control": 1
    },
    "focus": {
      "style": "double",
      "width": 2,
      "offset": 0
    },
    "icon": {
      "pointer": {
        "sm": 12,
        "md": 16,
        "lg": 20
      },
      "touch": {
        "sm": 16,
        "md": 20,
        "lg": 24
      }
    }
  },
  "slots": {
    "field.face": {
      "colour": "field"
    },
    "field.shade": "inset",
    "field.edge.width": "control",
    "field.edge.sides": true,
    "field.edge.colour": {
      "colour": "border"
    },
    "field.edge.bottom": {
      "colour": "input"
    },
    "field.corner.top": "control",
    "field.corner.bottom": "control",
    "field.focus.line": true,
    "field.focus.width": 2,
    "field.disabled.face": {
      "finish": "disabled"
    },
    "choice.size": {
      "pointer": 20,
      "touch": 20
    },
    "choice.box": {
      "pointer": 16,
      "touch": 20
    },
    "choice.corner": {
      "pointer": 4,
      "touch": 4
    },
    "choice.face": {
      "colour": "track"
    },
    "choice.shade": "none",
    "choice.edge.width": 1,
    "choice.edge.colour": {
      "colour": "input"
    },
    "choice.edge.disabled": {
      "colour": "input"
    },
    "choice.checked.face": {
      "finish": "accent"
    },
    "choice.mark.size": {
      "pointer": 12,
      "touch": 12
    },
    "choice.mark.hover": 14,
    "choice.mark.pressed": 10,
    "choice.halo": "none",
    "switch.width": {
      "pointer": 40,
      "touch": 40
    },
    "switch.height": {
      "pointer": 20,
      "touch": 20
    },
    "switch.small.width": {
      "pointer": 40,
      "touch": 40
    },
    "switch.small.height": {
      "pointer": 20,
      "touch": 20
    },
    "switch.small.knob.width": {
      "pointer": 12,
      "touch": 12
    },
    "switch.small.knob.height": {
      "pointer": 12,
      "touch": 12
    },
    "switch.edge.off": 1,
    "switch.edge.on": 0,
    "switch.knob.width": {
      "pointer": 12,
      "touch": 12
    },
    "switch.knob.height": {
      "pointer": 12,
      "touch": 12
    },
    "switch.knob.on.width": {
      "pointer": 12,
      "touch": 12
    },
    "switch.knob.on.height": {
      "pointer": 12,
      "touch": 12
    },
    "switch.knob.hover": {
      "pointer": 14,
      "touch": 14
    },
    "switch.knob.pressed.width": {
      "pointer": 17,
      "touch": 17
    },
    "switch.knob.pressed.height": {
      "pointer": 14,
      "touch": 14
    },
    "switch.feedback": "stretch",
    "slider.rail": {
      "pointer": 4,
      "touch": 4
    },
    "slider.band": {
      "pointer": 32,
      "touch": 32
    },
    "slider.vertical": {
      "pointer": 128,
      "touch": 144
    },
    "slider.face": {
      "colour": "input"
    },
    "slider.shade": "none",
    "slider.edge.colour": "none",
    "slider.edge.width": 0,
    "slider.knob.size": {
      "pointer": 18,
      "touch": 18
    },
    "slider.knob.pressed.size": {
      "pointer": 18,
      "touch": 18
    },
    "slider.knob.face": {
      "finish": "knob"
    },
    "slider.mark.size": 12,
    "slider.mark.hover": 14,
    "slider.mark.pressed": 10,
    "slider.brightens": false,
    "progress.height": 3,
    "progress.line": 1,
    "progress.face": {
      "colour": "input"
    },
    "progress.shade": "none",
    "progress.edge.colour": "none",
    "progress.edge.width": 0,
    "spinner.opacity": 0,
    "popup.corner": "container",
    "tabs.track.face": {
      "colour": "inset"
    },
    "well.edge": {
      "colour": "border"
    },
    "state.disabled.face": {
      "finish": "disabled"
    },
    "state.disabled.ink": {
      "finish": "disabled",
      "field": "foreground"
    },
    "state.disabled.edge": {
      "finish": "disabled",
      "field": "borderColor"
    }
  },
  "shape": {
    "curve": "circular",
    "corners": {
      "button": "{radius-control}"
    }
  },
  "state": {
    "press-scale": 1,
    "overlay": {
      "hover": 0,
      "focus": 0,
      "pressed": 0,
      "dragged": 0
    },
    "pressed-opacity": 1,
    "rest-opacity": 0.5,
    "disabled": {
      "content": 0.36
    }
  },
  "transition": {
    "enter": {
      "duration": 250,
      "timingFunction": "decelerate"
    }
  },
  "motion": {
    "fast": {
      "duration": 83,
      "timingFunction": "decelerate"
    },
    "default": {
      "duration": 167,
      "timingFunction": "decelerate"
    },
    "slow": {
      "duration": 250,
      "timingFunction": "decelerate"
    },
    "state": {
      "duration": 83,
      "timingFunction": "decelerate"
    }
  },
  "finishes": {
    "shared": {
      "card": {
        "background": "{card}",
        "foreground": "{foreground}",
        "elevation": null
      },
      "inset": {
        "shadow": "none",
        "foreground": "{foreground}",
        "border-top-color": null
      },
      "channel": {
        "background": "{inset}",
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "{line}"
      },
      "raised": {
        "background": "{raised}",
        "shadow": "none",
        "foreground": "{foreground}",
        "backdropFilter": "none",
        "material": null
      },
      "plate": {
        "background": "{card}",
        "shadow": "none",
        "foreground": "{foreground}",
        "elevation": null
      },
      "overlay": {
        "foreground": "{foreground}",
        "border-color": "oklch(0.5624 0 0 / 0.4)",
        "backdropFilter": "none",
        "material": "acrylic",
        "elevation": null
      },
      "modal": {
        "background": "{background}",
        "foreground": "{foreground}",
        "border-color": "oklch(0.5624 0 0 / 0.4)",
        "elevation": null
      },
      "inverse": {
        "background": "{inverse}",
        "foreground": "{inverse-foreground}",
        "border-color": "{line}",
        "backdropFilter": "none",
        "material": null,
        "elevation": null
      },
      "glass": {
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "{line}",
        "backdropFilter": "blur(30px)",
        "material": null,
        "elevation": null
      },
      "accent": {
        "background": "{primary}",
        "shadow": "none",
        "foreground": "{primary-foreground}",
        "border-bottom-color": "{brand-edge}",
        "pressed-opacity": 1
      },
      "fill": {
        "shadow": "none",
        "foreground": "{primary-foreground}",
        "background": "{primary}",
        "gradient": null
      },
      "knob": {
        "shadow": "none",
        "foreground": "{foreground}",
        "background": "{knob}",
        "gradient": null,
        "border-color": "transparent",
        "checked-background": "{primary-foreground}"
      },
      "hover": {
        "shadow": "none",
        "foreground": "{foreground}",
        "background": "{hover}",
        "elevation": null
      },
      "pressed": {
        "shadow": "none",
        "foreground": "{muted-foreground}",
        "background": "{muted}",
        "border-color": "{line}",
        "elevation": null
      },
      "disabled": {
        "shadow": "none"
      }
    },
    "light": {
      "card": {
        "shadow": "0 0 2px oklch(0 0 0 / 0.12), 0 4px 8px oklch(0 0 0 / 0.14)",
