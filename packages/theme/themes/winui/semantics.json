{
  "typography": {
    "caption": {
      "fontSize": {
        "pointer": 11,
        "touch": 12
      },
      "lineHeight": {
        "pointer": 16,
        "touch": 16
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "detail": {
      "fontSize": {
        "pointer": 12,
        "touch": 13
      },
      "lineHeight": {
        "pointer": 16,
        "touch": 20
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "body": {
      "fontSize": {
        "pointer": 13,
        "touch": 15
      },
      "lineHeight": {
        "pointer": 20,
        "touch": 20
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "label": {
      "fontSize": {
        "pointer": 14,
        "touch": 15
      },
      "lineHeight": {
        "pointer": 20,
        "touch": 20
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "title": {
      "fontSize": {
        "pointer": 16,
        "touch": 16
      },
      "lineHeight": {
        "pointer": 24,
        "touch": 24
      },
      "fontWeight": 600,
      "letterSpacing": 0
    },
    "headline": {
      "fontSize": {
        "pointer": 20,
        "touch": 22
      },
      "lineHeight": {
        "pointer": 28,
        "touch": 28
      },
      "fontWeight": 600,
      "letterSpacing": 0
    },
    "display": {
      "fontSize": {
        "pointer": 26,
        "touch": 28
      },
      "lineHeight": {
        "pointer": 32,
        "touch": 36
      },
      "fontWeight": 600,
      "letterSpacing": 0
    }
  },
  "dimension": {
    "shape": {
      "control": "{radius-control}",
      "container": "{radius-container}",
      "modal": "{radius-modal}"
    },
    "size": {
      "hit": {
        "pointer": 0,
        "touch": 40
      },
      "density": {
        "pointer": {
          "pad": 12,
          "gap": 8
        },
        "touch": {
          "pad": 12,
          "gap": 8
        }
      },
      "item": {
        "pointer": {
          "inset": 4,
          "pad": 11
        },
        "touch": {
          "inset": 4,
          "pad": 11
        }
      },
      "control": {
        "pointer": {
          "padding": 6,
          "gap": 8,
          "dot": 12,
          "switch": "regular"
        },
        "touch": {
          "padding": 6,
          "gap": 8,
          "dot": 12,
          "switch": "regular"
        }
      },
      "height": {
        "pointer": {
          "sm": 24,
          "md": 32,
          "lg": 40
        },
        "touch": {
          "sm": 32,
          "md": 40,
          "lg": 48
        }
      }
    },
    "stroke": {
      "hairline": 1,
      "control": 1
    },
    "focus": {
      "style": "double",
      "width": 2,
      "offset": 0
    },
    "icon": {
      "pointer": {
        "sm": 12,
        "md": 16,
        "lg": 20
      },
      "touch": {
        "sm": 16,
        "md": 20,
        "lg": 24
      }
    },
    "control": {
      "field": "box-underline",
      "choice": "inset",
      "track": "hairline",
      "handle": "ring"
    }
  },
  "shape": {
    "curve": "circular",
    "corners": {
      "button": "radius"
    }
  },
  "state": {
    "press-scale": 1,
    "overlay": {
      "hover": 0,
      "focus": 0,
      "pressed": 0,
      "dragged": 0
    },
    "ripple": false,
    "pressed-opacity": 1,
    "rest-opacity": 0.5,
    "disabled": {
      "content": 0.36,
      "fill": true
    }
  },
  "transition": {
    "enter": {
      "duration": 250,
      "timingFunction": "decelerate"
    }
  },
  "motion": {
    "fast": {
      "duration": 83,
      "timingFunction": "decelerate"
    },
    "default": {
      "duration": 167,
      "timingFunction": "decelerate"
    },
    "slow": {
      "duration": 250,
      "timingFunction": "decelerate"
    },
    "state": {
      "duration": 83,
      "timingFunction": "decelerate"
    }
  },
  "finishes": {
    "shared": {
      "card": {
        "background": "{card}",
        "foreground": "{foreground}",
        "elevation": null
      },
      "inset": {
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "{input}"
      },
      "channel": {
        "background": "{inset}",
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "{border}"
      },
      "raised": {
        "background": "{raised}",
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "{border}",
        "backdropFilter": "none",
        "material": null
      },
      "plate": {
        "background": "{card}",
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "{border}",
        "elevation": null
      },
      "overlay": {
        "foreground": "{foreground}",
        "border-color": "{line}",
        "backdropFilter": "none",
        "material": "acrylic",
        "elevation": null
      },
      "modal": {
        "background": "{background}",
        "foreground": "{foreground}",
        "elevation": null
      },
      "inverse": {
        "background": "{inverse}",
        "foreground": "{inverse-foreground}",
        "border-color": "{line}",
        "backdropFilter": "none",
        "material": null,
        "elevation": null
      },
      "glass": {
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "{line}",
        "backdropFilter": "blur(30px)",
        "material": null,
        "elevation": null
      },
      "accent": {
        "background": "{primary}",
        "shadow": "none",
        "foreground": "{primary-foreground}",
        "border-bottom-color": "{brand-edge}",
        "pressed-opacity": 1
      },
      "fill": {
        "shadow": "none",
        "foreground": "{primary-foreground}",
        "background": "{primary}",
        "gradient": null
      },
      "knob": {
        "shadow": "none",
        "foreground": "{foreground}",
        "background": "{knob}",
        "gradient": null,
        "border-color": "transparent",
        "checked-background": "{primary-foreground}"
      },
      "hover": {
        "shadow": "none",
        "foreground": "{foreground}",
        "background": "{hover}",
        "border-color": "{border}",
        "elevation": null
      },
      "pressed": {
        "shadow": "none",
        "foreground": "{muted-foreground}",
        "background": "{muted}",
        "border-color": "{border}",
        "elevation": null
      },
      "disabled": {
        "shadow": "none",
        "border-color": "{border}"
      }
    },
    "light": {
      "card": {
        "shadow": "0 0 2px oklch(0 0 0 / 0.12), 0 4px 8px oklch(0 0 0 / 0.14)",
        "border-color": "oklch(0.92191 0 0)"
      },
      "raised": {
        "border-top-color": "{border}",
        "border-bottom-color": "oklch(0.84522 0 0)"
      },
      "overlay": {
        "background": "oklch(from {popover} l c h / 0.85)",
        "shadow": "0 0 8px oklch(0 0 0 / 0.2), 0 16px 32px oklch(0 0 0 / 0.24)"
      },
      "modal": {
        "shadow": "0 0 8px oklch(0 0 0 / 0.2), 0 64px 128px oklch(0 0 0 / 0.24)",
        "border-color": "oklch(0.81093 0 0)"
      },
      "inverse": {
        "shadow": "0 0 8px oklch(0 0 0 / 0.2), 0 16px 32px oklch(0 0 0 / 0.24)"
      },
      "glass": {
        "background": "oklch(from {popover} l c h / 0.85)"
      },
      "accent": {
        "border-color": "oklch(0.52768 0.14982 252.341)",
        "pressed-background": "oklch(0.5773 0.13223 250.006)",
        "pressed-foreground": "oklch(0.87245 0.03754 247.003)"
      },
      "fill": {
        "border-color": "oklch(0.52768 0.14982 252.341)"
      },
      "hover": {
        "border-top-color": "{border}",
        "border-bottom-color": "oklch(0.84522 0 0)"
      },
      "disabled": {
        "background": "oklch(0.97015 0 0)",
        "foreground": "oklch(0.68949 0 0)"
      }
    },
    "dark": {
      "card": {
        "shadow": "0 0 2px oklch(0 0 0 / 0.24), 0 4px 8px oklch(0 0 0 / 0.28)",
        "border-color": "oklch(0.23075 0 0)"
      },
      "raised": {
        "border-top-color": "oklch(0.32897 0 0)",
        "border-bottom-color": "{border}"
      },
      "overlay": {
        "background": "oklch(from {popover} l c h / 0.96)",
        "shadow": "0 0 8px oklch(0 0 0 / 0.4), 0 16px 32px oklch(0 0 0 / 0.48)"
      },
      "modal": {
        "shadow": "0 0 8px oklch(0 0 0 / 0.4), 0 64px 128px oklch(0 0 0 / 0.48)",
        "border-color": "oklch(0.37909 0 0)"
      },
      "inverse": {
        "shadow": "0 0 8px oklch(0 0 0 / 0.4), 0 16px 32px oklch(0 0 0 / 0.48)"
      },
      "glass": {
        "background": "oklch(from {popover} l c h / 0.96)"
      },
      "accent": {
        "border-color": "oklch(0.81732 0.11439 230)",
        "pressed-background": "oklch(0.70029 0.10192 230.522)",
        "pressed-foreground": "oklch(0.42706 0.05878 229.834)"
      },
      "fill": {
        "border-color": "oklch(0.81732 0.11439 230)"
      },
      "hover": {
        "border-top-color": "oklch(0.32897 0 0)",
        "border-bottom-color": "{border}"
      },
      "disabled": {
        "background": "oklch(0.28502 0 0)",
        "foreground": "oklch(0.54863 0 0)"
      }
    }
  },
  "elevation": {
    "light": {
      "sm": null,
      "md": "0 0 2px oklch(0 0 0 / 0.12), 0 4px 8px oklch(0 0 0 / 0.14)",
      "lg": "0 0 8px oklch(0 0 0 / 0.2), 0 16px 32px oklch(0 0 0 / 0.24)",
      "xl": "0 0 8px oklch(0 0 0 / 0.2), 0 64px 128px oklch(0 0 0 / 0.24)",
      "inset": null
    },
    "dark": {
      "sm": null,
      "md": "0 0 2px oklch(0 0 0 / 0.24), 0 4px 8px oklch(0 0 0 / 0.28)",
      "lg": "0 0 8px oklch(0 0 0 / 0.4), 0 16px 32px oklch(0 0 0 / 0.48)",
      "xl": "0 0 8px oklch(0 0 0 / 0.4), 0 64px 128px oklch(0 0 0 / 0.48)",
      "inset": null
    }
  }
}
