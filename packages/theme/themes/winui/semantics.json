{
  "typography": {
    "caption": {
      "fontSize": {
        "pointer": 12,
        "touch": 12
      },
      "lineHeight": {
        "pointer": 16,
        "touch": 16
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "detail": {
      "fontSize": {
        "pointer": 12,
        "touch": 12
      },
      "lineHeight": {
        "pointer": 16,
        "touch": 16
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "body": {
      "fontSize": {
        "pointer": 14,
        "touch": 14
      },
      "lineHeight": {
        "pointer": 20,
        "touch": 20
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "label": {
      "fontSize": {
        "pointer": 14,
        "touch": 14
      },
      "lineHeight": {
        "pointer": 20,
        "touch": 20
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "title": {
      "fontSize": {
        "pointer": 14,
        "touch": 14
      },
      "lineHeight": {
        "pointer": 20,
        "touch": 20
      },
      "fontWeight": 600,
      "letterSpacing": 0
    },
    "headline": {
      "fontSize": {
        "pointer": 20,
        "touch": 20
      },
      "lineHeight": {
        "pointer": 28,
        "touch": 28
      },
      "fontWeight": 600,
      "letterSpacing": 0
    },
    "display": {
      "fontSize": {
        "pointer": 28,
        "touch": 28
      },
      "lineHeight": {
        "pointer": 36,
        "touch": 36
      },
      "fontWeight": 600,
      "letterSpacing": 0
    }
  },
  "dimension": {
    "shape": {
      "control": "{radius-control}",
      "container": "{radius-container}",
      "modal": "{radius-modal}"
    },
    "size": {
      "hit": {
        "pointer": 0,
        "touch": 40
      },
      "density": {
        "pointer": {
          "pad": 12,
          "gap": 8,
          "surface": 4
        },
        "touch": {
          "pad": 12,
          "gap": 8,
          "surface": 8
        }
      },
      "control": {
        "pointer": {
          "padding": 6,
          "gap": 8,
          "dot": 12,
          "switch": "regular"
        },
        "touch": {
          "padding": 6,
          "gap": 8,
          "dot": 12,
          "switch": "regular"
        }
      },
      "height": {
        "pointer": {
          "sm": 24,
          "md": 32,
          "lg": 40
        },
        "touch": {
          "sm": 32,
          "md": 40,
          "lg": 48
        }
      }
    },
    "stroke": {
      "hairline": 1,
      "control": 1
    },
    "focus": {
      "style": "double",
      "width": 2,
      "offset": 0
    },
    "icon": {
      "pointer": {
        "sm": 12,
        "md": 16,
        "lg": 20
      },
      "touch": {
        "sm": 16,
        "md": 20,
        "lg": 24
      }
    }
  },
  "shape": {
    "curve": "circular",
    "corners": {
      "button": "radius"
    }
  },
  "state": {
    "press-scale": 1,
    "overlay": {
      "hover": 0,
      "focus": 0,
      "pressed": 0,
      "dragged": 0
    },
    "ripple": false,
    "pressed-opacity": 1,
    "rest-opacity": 0.5,
    "disabled": {
      "content": 0.36,
      "fill": true
    }
  },
  "transition": {
    "enter": {
      "duration": 250,
      "timingFunction": "decelerate"
    }
  },
  "motion": {
    "fast": {
      "duration": 83,
      "timingFunction": "decelerate"
    },
    "default": {
      "duration": 167,
      "timingFunction": "decelerate"
    },
    "slow": {
      "duration": 250,
      "timingFunction": "decelerate"
    }
  },
  "controls": "winui",
  "finishes": {
    "shared": {
      "card": {
        "gradient": "linear-gradient(180deg, {card} 0%, {card} 100%)",
        "material": null
      },
      "section": {
        "background": "{card}",
        "shadow": "none",
        "material": null
      },
      "inset": {
        "material": null,
        "shadow": "none"
      },
      "field": {
        "shadow": "none",
        "material": null
      },
      "raised": {
        "background": "{raised}",
        "gradient": "linear-gradient(180deg, {raised} 0%, {raised} 100%)",
        "backdropFilter": "none",
        "material": null,
        "shadow": "none",
        "border-color": "{border}"
      },
      "hover": {
        "material": null,
        "background": "{hover}",
        "gradient": "linear-gradient(180deg, {hover} 0%, {hover} 100%)",
        "shadow": "none",
        "border-color": "{border}"
      },
      "pressed": {
        "foreground": "{muted-foreground}",
        "material": null,
        "background": "{muted}",
        "gradient": "linear-gradient(180deg, {muted} 0%, {muted} 100%)",
        "shadow": "none",
        "border-color": "{border}",
        "border-top-color": "{border}",
        "border-bottom-color": "{border}"
      },
      "disabled": {
        "shadow": "none",
        "border-color": "{border}",
        "material": null
      },
      "light": {
        "background": "{primary}",
        "gradient": "linear-gradient(180deg, {primary} 0%, {primary} 100%)",
        "border-bottom-color": "{brand-edge}",
        "material": null,
        "shadow": "none"
      },
      "accent": {
        "background": "{primary}",
        "gradient": "linear-gradient(180deg, {primary} 0%, {primary} 100%)",
        "border-bottom-color": "{brand-edge}",
        "material": null,
        "shadow": "none"
      },
      "accentPressed": {
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent",
        "material": null,
        "shadow": "none"
      },
      "track": {
        "material": null,
        "shadow": "none",
        "border-color": "{input}"
      },
      "fill": {
        "background": "transparent",
        "shadow": "none",
        "material": null,
        "gradient": "linear-gradient(180deg, {primary} 0%, {primary} 100%)",
        "border-color": "transparent"
      },
      "knob": {
        "material": null,
        "background": "{knob}",
        "gradient": "linear-gradient(180deg, {knob} 0%, {knob} 100%)",
        "shadow": "none",
        "border-color": "transparent"
      },
      "knobOn": {
        "background": "{primary-foreground}",
        "gradient": "linear-gradient(180deg, {primary-foreground} 0%, {primary-foreground} 100%)",
        "shadow": "none",
        "material": null,
        "border-color": "transparent"
      },
      "handle": {
        "material": null,
        "background": "{popover}",
        "gradient": "linear-gradient(180deg, {popover} 0%, {popover} 100%)",
        "border-color": "{border}"
      },
      "pill": {
        "background": "{raised}",
        "gradient": "linear-gradient(180deg, {raised} 0%, {raised} 100%)",
        "material": null,
        "shadow": "none",
        "border-color": "{border}"
      },
      "thumb": {
        "material": null,
        "background": "{popover}",
        "gradient": "linear-gradient(180deg, {popover} 0%, {popover} 100%)",
        "border-color": "{border}"
      },
      "on": {
        "foreground": "{primary-foreground}",
        "material": null,
        "background": "{primary}",
        "gradient": "linear-gradient(180deg, {primary} 0%, {primary} 100%)",
        "shadow": "none",
        "border-bottom-color": "{brand-edge}"
      },
      "chip": {
        "background": "{raised}",
        "gradient": "linear-gradient(180deg, {raised} 0%, {raised} 100%)",
        "border-color": "{border}",
        "material": null,
        "shadow": "none"
      },
      "glass": {
        "border-color": "{glass-edge}",
        "backdropFilter": "blur(30px)",
        "material": {
          "windows": {
            "backdrop": "blur"
          }
        }
      },
      "menu": {
        "background": "{popover}",
        "border-color": "{glass-edge}",
        "backdropFilter": "none",
        "material": {
          "windows": {
            "backdrop": "blur"
          }
        }
      },
      "modal": {
        "background": "{background}",
        "material": null
      },
      "grabber": {
        "background": "{raised}",
        "shadow": "none",
        "material": null
      },
      "tooltip": {
        "background": "{popover}",
        "border-color": "{glass-edge}",
        "material": {
          "windows": {
            "backdrop": "blur"
          }
        }
      },
      "inverse": {
        "background": "{inverse}",
        "foreground": "{muted-foreground}",
        "border-color": "{glass-edge}",
        "backdropFilter": "none",
        "material": null
      },
      "groove": {
        "material": null,
        "shadow": "none"
      }
    },
    "light": {
      "card": {
        "border-color": "oklch(0.92191 0 0)",
        "shadow": "0 0 2px oklch(0 0 0 / 0.12), 0 4px 8px oklch(0 0 0 / 0.14)"
      },
      "section": {
        "border-color": "oklch(0.92191 0 0)"
      },
      "raised": {
        "border-top-color": "{border}",
        "border-bottom-color": "oklch(0.84522 0 0)"
      },
      "hover": {
        "border-top-color": "{border}",
        "border-bottom-color": "oklch(0.84522 0 0)"
      },
      "disabled": {
        "background": "oklch(0.97015 0 0)",
        "gradient": "linear-gradient(180deg, oklch(0.97015 0 0) 0%, oklch(0.97015 0 0) 100%)",
        "foreground": "oklch(0.68949 0 0)"
      },
      "light": {
        "border-color": "oklch(0.52768 0.14982 252.341)",
        "border-top-color": "oklch(0.52768 0.14982 252.341)"
      },
      "accent": {
        "border-color": "oklch(0.52768 0.14982 252.341)",
        "border-top-color": "oklch(0.52768 0.14982 252.341)"
      },
      "accentPressed": {
        "gradient": "linear-gradient(180deg, oklch(0.5773 0.13223 250.006) 0%, oklch(0.5773 0.13223 250.006) 100%)",
        "foreground": "oklch(0.87245 0.03754 247.003)",
        "background": "oklch(0.5773 0.13223 250.006)"
      },
      "handle": {
        "shadow": "0 0 2px oklch(0 0 0 / 0.12), 0 1px 2px oklch(0 0 0 / 0.14)"
      },
      "thumb": {
        "shadow": "0 0 2px oklch(0 0 0 / 0.12), 0 1px 2px oklch(0 0 0 / 0.14)"
      },
      "on": {
        "border-color": "oklch(0.52768 0.14982 252.341)",
        "border-top-color": "oklch(0.52768 0.14982 252.341)"
      },
      "glass": {
        "background": "oklch(from {popover} l c h / 0.85)",
        "shadow": "0 0 8px oklch(0 0 0 / 0.2), 0 16px 32px oklch(0 0 0 / 0.24)"
      },
      "menu": {
        "shadow": "0 0 8px oklch(0 0 0 / 0.2), 0 16px 32px oklch(0 0 0 / 0.24)"
      },
      "modal": {
        "border-color": "oklch(0.81093 0 0)",
        "shadow": "0 0 8px oklch(0 0 0 / 0.2), 0 64px 128px oklch(0 0 0 / 0.24)"
      },
      "tooltip": {
        "shadow": "0 0 2px oklch(0 0 0 / 0.12), 0 8px 16px oklch(0 0 0 / 0.14)"
      },
      "inverse": {
        "shadow": "0 0 8px oklch(0 0 0 / 0.2), 0 16px 32px oklch(0 0 0 / 0.24)"
      }
    },
    "dark": {
      "card": {
        "border-color": "oklch(0.23075 0 0)",
        "shadow": "0 0 2px oklch(0 0 0 / 0.24), 0 4px 8px oklch(0 0 0 / 0.28)"
      },
      "section": {
        "border-color": "oklch(0.23075 0 0)"
      },
      "raised": {
        "border-top-color": "oklch(0.32897 0 0)",
        "border-bottom-color": "{border}"
      },
      "hover": {
        "border-top-color": "oklch(0.32897 0 0)",
        "border-bottom-color": "{border}"
      },
      "disabled": {
        "background": "oklch(0.28502 0 0)",
        "gradient": "linear-gradient(180deg, oklch(0.28502 0 0) 0%, oklch(0.28502 0 0) 100%)",
        "foreground": "oklch(0.54863 0 0)"
      },
      "light": {
        "border-color": "oklch(0.81732 0.11439 230)",
        "border-top-color": "oklch(0.81732 0.11439 230)"
      },
      "accent": {
        "border-color": "oklch(0.81732 0.11439 230)",
        "border-top-color": "oklch(0.81732 0.11439 230)"
      },
      "accentPressed": {
        "gradient": "linear-gradient(180deg, oklch(0.70029 0.10192 230.522) 0%, oklch(0.70029 0.10192 230.522) 100%)",
        "foreground": "oklch(0.42706 0.05878 229.834)",
        "background": "oklch(0.70029 0.10192 230.522)"
      },
      "handle": {
        "shadow": "0 0 2px oklch(0 0 0 / 0.24), 0 1px 2px oklch(0 0 0 / 0.28)"
      },
      "thumb": {
        "shadow": "0 0 2px oklch(0 0 0 / 0.24), 0 1px 2px oklch(0 0 0 / 0.28)"
      },
      "on": {
        "border-color": "oklch(0.81732 0.11439 230)",
        "border-top-color": "oklch(0.81732 0.11439 230)"
      },
      "glass": {
        "background": "oklch(from {popover} l c h / 0.96)",
        "shadow": "0 0 8px oklch(0 0 0 / 0.4), 0 16px 32px oklch(0 0 0 / 0.48)"
      },
      "menu": {
        "shadow": "0 0 8px oklch(0 0 0 / 0.4), 0 16px 32px oklch(0 0 0 / 0.48)"
      },
      "modal": {
        "border-color": "oklch(0.37909 0 0)",
        "shadow": "0 0 8px oklch(0 0 0 / 0.4), 0 64px 128px oklch(0 0 0 / 0.48)"
      },
      "tooltip": {
        "shadow": "0 0 2px oklch(0 0 0 / 0.24), 0 8px 16px oklch(0 0 0 / 0.28)"
      },
      "inverse": {
        "shadow": "0 0 8px oklch(0 0 0 / 0.4), 0 16px 32px oklch(0 0 0 / 0.48)"
      }
    }
  }
}
