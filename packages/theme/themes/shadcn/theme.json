{
  "name": "shadcn neutral",
  "cssVars": {
    "theme": {
      "radius": "8px",
      "radius-card": "14px",
      "radius-control": "8px",
      "brand-fill": "var(--primary)",
      "on-brand": "var(--primary-foreground)",
      "scrim": "rgba(0,0,0,0.5)",
      "window-close": "#e7000b",
      "window-minimize": "#a1a1a1",
      "window-zoom": "#404040",
      "window-control-ink": "color-mix(in srgb, #000000 50%, transparent)",
      "window-control-edge": "color-mix(in srgb, #000000 12%, transparent)"
    },
    "light": {
      "background": "#ffffff",
      "foreground": "#0a0a0a",
      "card": "#ffffff",
      "card-foreground": "var(--foreground)",
      "popover": "#ffffff",
      "popover-foreground": "var(--foreground)",
      "primary": "#171717",
      "primary-foreground": "#fafafa",
      "secondary": "var(--raised)",
      "secondary-foreground": "var(--foreground)",
      "muted": "#f5f5f5",
      "muted-foreground": "#737373",
      "accent": "#f5f5f5",
      "accent-foreground": "var(--foreground)",
      "destructive": "#e7000b",
      "border": "#e5e5e5",
      "input": "#e5e5e5",
      "ring": "#a1a1a1",
      "chart-1": "#d4d4d4",
      "chart-2": "#737373",
      "chart-3": "#525252",
      "chart-4": "#404040",
      "chart-5": "#262626",
      "sidebar": "#fafafa",
      "sidebar-foreground": "var(--foreground)",
      "sidebar-primary": "var(--primary)",
      "sidebar-primary-foreground": "var(--primary-foreground)",
      "sidebar-accent": "#f5f5f5",
      "sidebar-accent-foreground": "var(--foreground)",
      "sidebar-border": "#e5e5e5",
      "sidebar-ring": "var(--ring)",
      "inset": "#f5f5f5",
      "raised": "#f5f5f5",
      "scrollbar-thumb": "color-mix(in srgb, var(--muted-foreground) 50%, var(--background))",
      "scrollbar-thumb-hover": "color-mix(in srgb, var(--muted-foreground) 80%, var(--background))",
      "field": "#ffffff",
      "line": "#e5e5e5",
      "hover": "color-mix(in srgb, var(--foreground) 5%, transparent)",
      "faint": "#a1a1a1",
      "brand": "#171717",
      "track": "#f5f5f5",
      "knob": "#ffffff",
      "code": "#0a0a0a",
      "info": "#737373",
      "warn": "#525252",
      "up": "#404040",
      "down": "var(--destructive)",
      "brand-tint": "color-mix(in srgb, var(--brand) 10%, transparent)",
      "info-tint": "color-mix(in srgb, var(--info) 10%, transparent)",
      "warn-tint": "color-mix(in srgb, var(--warn) 10%, transparent)",
      "destructive-tint": "color-mix(in srgb, var(--destructive) 10%, transparent)",
      "up-tint": "color-mix(in srgb, var(--up) 10%, transparent)",
      "down-tint": "color-mix(in srgb, var(--destructive) 10%, transparent)",
      "violet": "#262626",
      "window-control-off": "#a1a1a1"
    },
    "dark": {
      "background": "#0a0a0a",
      "foreground": "#fafafa",
      "card": "#171717",
      "popover": "#171717",
      "primary": "#e5e5e5",
      "primary-foreground": "#171717",
      "muted": "#262626",
      "muted-foreground": "#a1a1a1",
      "accent": "#262626",
      "destructive": "#ff6467",
      "border": "rgba(255,255,255,0.1)",
      "input": "rgba(255,255,255,0.15)",
      "inset": "#262626",
      "raised": "#262626",
      "scrollbar-thumb": "color-mix(in srgb, var(--muted-foreground) 50%, var(--background))",
      "scrollbar-thumb-hover": "color-mix(in srgb, var(--muted-foreground) 80%, var(--background))",
      "field": "rgba(255,255,255,0.045)",
      "line": "rgba(255,255,255,0.1)",
      "hover": "color-mix(in srgb, var(--foreground) 5%, transparent)",
      "faint": "#a1a1a1",
      "brand": "#e5e5e5",
      "track": "#262626",
      "knob": "#fafafa",
      "code": "#fafafa",
      "info": "#a1a1a1",
      "warn": "#d4d4d4",
      "up": "#e5e5e5",
      "brand-tint": "color-mix(in srgb, var(--brand) 10%, transparent)",
      "info-tint": "color-mix(in srgb, var(--info) 10%, transparent)",
      "warn-tint": "color-mix(in srgb, var(--warn) 10%, transparent)",
      "destructive-tint": "color-mix(in srgb, var(--destructive) 10%, transparent)",
      "up-tint": "color-mix(in srgb, var(--up) 10%, transparent)",
      "down-tint": "color-mix(in srgb, var(--destructive) 10%, transparent)",
      "violet": "#fafafa",
      "card-foreground": "var(--foreground)",
      "popover-foreground": "var(--foreground)",
      "accent-foreground": "var(--foreground)",
      "secondary": "var(--raised)",
      "secondary-foreground": "var(--foreground)",
      "chart-1": "#d4d4d4",
      "chart-2": "#737373",
      "chart-3": "#525252",
      "chart-4": "#404040",
      "chart-5": "#262626",
      "ring": "#737373",
      "sidebar": "#171717",
      "sidebar-foreground": "var(--foreground)",
      "sidebar-accent": "#262626",
      "sidebar-accent-foreground": "var(--foreground)",
      "sidebar-border": "rgba(255,255,255,0.1)",
      "sidebar-primary": "var(--primary)",
      "sidebar-primary-foreground": "var(--primary-foreground)",
      "sidebar-ring": "var(--ring)",
      "down": "var(--destructive)",
      "window-control-off": "#a1a1a1"
    }
  }
}
