{
  "typography": {
    "caption": {
      "fontSize": {
        "pointer": 11,
        "touch": 12
      },
      "lineHeight": {
        "pointer": 16,
        "touch": 16
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "detail": {
      "fontSize": {
        "pointer": 12,
        "touch": 13
      },
      "lineHeight": {
        "pointer": 16,
        "touch": 20
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "body": {
      "fontSize": {
        "pointer": 13,
        "touch": 15
      },
      "lineHeight": {
        "pointer": 20,
        "touch": 20
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "label": {
      "fontSize": {
        "pointer": 14,
        "touch": 15
      },
      "lineHeight": {
        "pointer": 20,
        "touch": 20
      },
      "fontWeight": 500,
      "letterSpacing": 0
    },
    "title": {
      "fontSize": {
        "pointer": 16,
        "touch": 16
      },
      "lineHeight": {
        "pointer": 24,
        "touch": 24
      },
      "fontWeight": 600,
      "letterSpacing": 0
    },
    "headline": {
      "fontSize": {
        "pointer": 20,
        "touch": 22
      },
      "lineHeight": {
        "pointer": 28,
        "touch": 28
      },
      "fontWeight": 600,
      "letterSpacing": 0
    },
    "display": {
      "fontSize": {
        "pointer": 26,
        "touch": 28
      },
      "lineHeight": {
        "pointer": 32,
        "touch": 36
      },
      "fontWeight": 600,
      "letterSpacing": 0
    }
  },
  "dimension": {
    "shape": {
      "control": "{radius-control}",
      "container": "{radius-container}",
      "modal": "{radius-modal}"
    },
    "size": {
      "hit": {
        "pointer": 0,
        "touch": 44
      },
      "density": {
        "pointer": {
          "pad": 12,
          "gap": 12
        },
        "touch": {
          "pad": 12,
          "gap": 12
        }
      },
      "item": {
        "pointer": {
          "inset": 4,
          "pad": 8
        },
        "touch": {
          "inset": 8,
          "pad": 8
        }
      },
      "control": {
        "pointer": {
          "padding": 8,
          "gap": 8,
          "dot": 6,
          "switch": "small"
        },
        "touch": {
          "padding": 8,
          "gap": 8,
          "dot": 8,
          "switch": "regular"
        }
      },
      "height": {
        "pointer": {
          "sm": 24,
          "md": 28,
          "lg": 32
        },
        "touch": {
          "sm": 32,
          "md": 40,
          "lg": 48
        }
      }
    },
    "stroke": {
      "hairline": 1,
      "control": 1
    },
    "focus": {
      "style": "halo",
      "width": 3,
      "offset": 0
    },
    "icon": {
      "pointer": {
        "sm": 12,
        "md": 16,
        "lg": 20
      },
      "touch": {
        "sm": 16,
        "md": 20,
        "lg": 24
      }
    },
    "control": {
      "field": "box",
      "choice": "well",
      "track": "sunk",
      "handle": "circle"
    }
  },
  "shape": {
    "curve": "continuous",
    "corners": {
      "button": "radius"
    }
  },
  "state": {
    "press-scale": 1,
    "overlay": {
      "hover": 0,
      "focus": 0,
      "pressed": 0,
      "dragged": 0
    },
    "pressed-opacity": 0.7,
    "rest-opacity": 0.5,
    "disabled": {
      "content": 0.5,
      "fill": false
    }
  },
  "transition": {
    "enter": {
      "duration": 420,
      "timingFunction": "out-cubic"
    }
  },
  "motion": {
    "fast": {
      "duration": 150,
      "timingFunction": "out-cubic"
    },
    "default": {
      "duration": 250,
      "timingFunction": "out-cubic"
    },
    "slow": {
      "duration": 350,
      "timingFunction": "out-cubic"
    },
    "state": {
      "duration": 120,
      "timingFunction": "out-cubic"
    }
  },
  "finishes": {
    "shared": {
      "card": {
        "background": "{card}",
        "shadow": "0 1px 3px oklch(0 0 0 / 0.1), 0 1px 2px -1px oklch(0 0 0 / 0.1)",
        "foreground": "{foreground}",
        "border-color": "{border}",
        "elevation": null
      },
      "inset": {
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "{border}"
      },
      "channel": {
        "background": "{inset}",
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "{border}"
      },
      "raised": {
        "background": "{raised}",
        "shadow": "0 1px 2px oklch(0 0 0 / 0.05)",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent",
        "backdropFilter": "none",
        "material": null
      },
      "plate": {
        "background": "{field}",
        "shadow": "0 1px 2px oklch(0 0 0 / 0.05)",
        "foreground": "{foreground}",
        "elevation": null
      },
      "overlay": {
        "background": "{card}",
        "shadow": "0 4px 6px -1px oklch(0 0 0 / 0.1), 0 2px 4px -2px oklch(0 0 0 / 0.1)",
        "foreground": "{foreground}",
        "border-color": "{border}",
        "backdropFilter": "none",
        "material": null,
        "elevation": null
      },
      "modal": {
        "background": "{card}",
        "shadow": "0 4px 6px -1px oklch(0 0 0 / 0.1), 0 2px 4px -2px oklch(0 0 0 / 0.1)",
        "foreground": "{foreground}",
        "border-color": "{border}",
        "elevation": null
      },
      "inverse": {
        "background": "{inverse}",
        "shadow": "0 4px 6px -1px oklch(0 0 0 / 0.1), 0 2px 4px -2px oklch(0 0 0 / 0.1)",
        "foreground": "{inverse-foreground}",
        "border-color": "{border}",
        "backdropFilter": "none",
        "material": null,
        "elevation": null
      },
      "glass": {
        "shadow": "0 1px 2px oklch(0 0 0 / 0.05)",
        "foreground": "{foreground}",
        "border-color": "{border}",
        "backdropFilter": "blur(20px)",
        "background": "oklch(from {card} l c h / 0.8)",
        "material": null,
        "elevation": null
      },
      "accent": {
        "background": "{primary}",
        "shadow": "none",
        "foreground": "{primary-foreground}",
        "border-color": "transparent",
        "border-bottom-color": "transparent",
        "pressed-opacity": 0.88,
        "pressed-background": null,
        "pressed-foreground": null
      },
      "fill": {
        "shadow": "none",
        "foreground": "{primary-foreground}",
        "background": "{primary}",
        "gradient": null,
        "border-color": "transparent"
      },
      "knob": {
        "shadow": "0 1px 2px oklch(0 0 0 / 0.05)",
        "foreground": "{foreground}",
        "background": "{knob}",
        "gradient": null,
        "border-color": "transparent",
        "checked-background": "{primary-foreground}"
      },
      "hover": {
        "shadow": "0 1px 2px oklch(0 0 0 / 0.05)",
        "foreground": "{foreground}",
        "background": "{hover}",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent",
        "elevation": null
      },
      "pressed": {
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "elevation": null
      },
      "disabled": {
        "background": "{raised}",
        "shadow": "0 1px 2px oklch(0 0 0 / 0.05)",
        "foreground": "{foreground}",
        "border-color": "{border}"
      }
    },
    "light": {
      "plate": {
        "border-color": "transparent"
      },
      "pressed": {
        "background": "{border}"
      }
    },
    "dark": {
      "plate": {
        "border-color": "{input}"
      },
      "pressed": {
        "background": "oklch(0.34846 0 0)"
      }
    }
  },
  "elevation": {
    "light": {
      "sm": "0 1px 2px oklch(0 0 0 / 0.05)",
      "md": "0 1px 3px oklch(0 0 0 / 0.1), 0 1px 2px -1px oklch(0 0 0 / 0.1)",
      "lg": "0 4px 6px -1px oklch(0 0 0 / 0.1), 0 2px 4px -2px oklch(0 0 0 / 0.1)",
      "xl": "0 4px 6px -1px oklch(0 0 0 / 0.1), 0 2px 4px -2px oklch(0 0 0 / 0.1)",
      "inset": null
    },
    "dark": {
      "sm": "0 1px 2px oklch(0 0 0 / 0.05)",
      "md": "0 1px 3px oklch(0 0 0 / 0.1), 0 1px 2px -1px oklch(0 0 0 / 0.1)",
      "lg": "0 4px 6px -1px oklch(0 0 0 / 0.1), 0 2px 4px -2px oklch(0 0 0 / 0.1)",
      "xl": "0 4px 6px -1px oklch(0 0 0 / 0.1), 0 2px 4px -2px oklch(0 0 0 / 0.1)",
      "inset": null
    }
  }
}
