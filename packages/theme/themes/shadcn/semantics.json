{
  "typography": {
    "caption": {
      "fontSize": {
        "pointer": 11,
        "touch": 12
      },
      "lineHeight": {
        "pointer": 16,
        "touch": 16
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "detail": {
      "fontSize": {
        "pointer": 12,
        "touch": 13
      },
      "lineHeight": {
        "pointer": 16,
        "touch": 20
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "body": {
      "fontSize": {
        "pointer": 13,
        "touch": 15
      },
      "lineHeight": {
        "pointer": 20,
        "touch": 20
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "label": {
      "fontSize": {
        "pointer": 14,
        "touch": 15
      },
      "lineHeight": {
        "pointer": 20,
        "touch": 20
      },
      "fontWeight": 500,
      "letterSpacing": 0
    },
    "title": {
      "fontSize": {
        "pointer": 16,
        "touch": 16
      },
      "lineHeight": {
        "pointer": 24,
        "touch": 24
      },
      "fontWeight": 600,
      "letterSpacing": 0
    },
    "headline": {
      "fontSize": {
        "pointer": 20,
        "touch": 22
      },
      "lineHeight": {
        "pointer": 28,
        "touch": 28
      },
      "fontWeight": 600,
      "letterSpacing": 0
    },
    "display": {
      "fontSize": {
        "pointer": 26,
        "touch": 28
      },
      "lineHeight": {
        "pointer": 32,
        "touch": 36
      },
      "fontWeight": 600,
      "letterSpacing": 0
    }
  },
  "dimension": {
    "shape": {
      "control": "{radius-control}",
      "container": "{radius-container}",
      "modal": "{radius-modal}"
    },
    "size": {
      "hit": {
        "pointer": 0,
        "touch": 44
      },
      "density": {
        "pointer": {
          "pad": 12,
          "gap": 12,
          "surface": 10
        },
        "touch": {
          "pad": 12,
          "gap": 12,
          "surface": 16
        }
      },
      "control": {
        "pointer": {
          "padding": 8,
          "gap": 8,
          "dot": 6,
          "switch": "small"
        },
        "touch": {
          "padding": 8,
          "gap": 8,
          "dot": 8,
          "switch": "regular"
        }
      },
      "height": {
        "pointer": {
          "sm": 24,
          "md": 28,
          "lg": 32
        },
        "touch": {
          "sm": 32,
          "md": 40,
          "lg": 48
        }
      }
    },
    "stroke": {
      "hairline": 1,
      "control": 1
    },
    "focus": {
      "style": "halo",
      "width": 3,
      "offset": 0
    },
    "icon": {
      "pointer": {
        "sm": 12,
        "md": 16,
        "lg": 20
      },
      "touch": {
        "sm": 16,
        "md": 20,
        "lg": 24
      }
    }
  },
  "shape": {
    "curve": "continuous",
    "corners": {
      "button": "radius"
    }
  },
  "state": {
    "press-scale": 1,
    "overlay": {
      "hover": 0,
      "focus": 0,
      "pressed": 0,
      "dragged": 0
    },
    "ripple": false,
    "pressed-opacity": 0.7,
    "rest-opacity": 0.5,
    "disabled": {
      "content": 0.5,
      "fill": false
    }
  },
  "transition": {
    "enter": {
      "duration": 420,
      "timingFunction": "out-cubic"
    }
  },
  "motion": {
    "fast": {
      "stiffness": 1218,
      "damping": 70
    },
    "default": {
      "stiffness": 520,
      "damping": 34
    },
    "slow": {
      "stiffness": 320,
      "damping": 30
    }
  },
  "controls": "base",
  "finishes": {
    "shared": {
      "card": {
        "gradient": "linear-gradient(180deg, {card} 0%, {card} 100%)",
        "border-color": "{border}",
        "material": null,
        "shadow": "0 1px 3px oklch(0 0 0 / 0.1), 0 1px 2px -1px oklch(0 0 0 / 0.1)"
      },
      "section": {
        "background": "{card}",
        "shadow": "none",
        "border-color": "{border}",
        "material": null
      },
      "inset": {
        "material": null,
        "shadow": "none"
      },
      "field": {
        "shadow": "0 1px 2px oklch(0 0 0 / 0.05)",
        "material": null
      },
      "raised": {
        "background": "{raised}",
        "gradient": "linear-gradient(180deg, {raised} 0%, {raised} 100%)",
        "backdropFilter": "none",
        "material": null,
        "shadow": "0 1px 2px oklch(0 0 0 / 0.05)",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent"
      },
      "hover": {
        "material": null,
        "background": "{hover}",
        "gradient": "linear-gradient(180deg, {hover} 0%, {hover} 100%)",
        "shadow": "0 1px 2px oklch(0 0 0 / 0.05)",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent"
      },
      "pressed": {
        "foreground": "{foreground}",
        "material": null,
        "shadow": "none",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent"
      },
      "disabled": {
        "background": "{raised}",
        "gradient": "linear-gradient(180deg, {raised} 0%, {raised} 100%)",
        "shadow": "none",
        "foreground": "{muted-foreground}",
        "border-color": "{border}",
        "material": null
      },
      "light": {
        "background": "{primary}",
        "gradient": "linear-gradient(180deg, {primary} 0%, {primary} 100%)",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent",
        "material": null,
        "shadow": "none"
      },
      "accent": {
        "background": "{primary}",
        "gradient": "linear-gradient(180deg, {primary} 0%, {primary} 100%)",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent",
        "material": null,
        "shadow": "none"
      },
      "accentPressed": {
        "gradient": "linear-gradient(180deg, transparent 0%, transparent 100%)",
        "foreground": "{primary-foreground}",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent",
        "material": null,
        "background": "oklch(from {primary} l c h / 0.88)",
        "shadow": "none"
      },
      "track": {
        "material": null,
        "shadow": "none",
        "border-color": "{border}"
      },
      "fill": {
        "background": "transparent",
        "shadow": "none",
        "material": null,
        "gradient": "linear-gradient(180deg, {primary} 0%, {primary} 100%)",
        "border-color": "transparent"
      },
      "knob": {
        "material": null,
        "background": "{knob}",
        "gradient": "linear-gradient(180deg, {knob} 0%, {knob} 100%)",
        "shadow": "0 1px 3px oklch(0 0 0 / 0.1), 0 1px 2px -1px oklch(0 0 0 / 0.1)",
        "border-color": "transparent"
      },
      "knobOn": {
        "shadow": "0 1px 3px oklch(0 0 0 / 0.1), 0 1px 2px -1px oklch(0 0 0 / 0.1)",
        "material": null,
        "border-color": "transparent"
      },
      "handle": {
        "material": null,
        "background": "oklch(1 0 0)",
        "gradient": "linear-gradient(180deg, oklch(1 0 0) 0%, oklch(1 0 0) 100%)",
        "shadow": "0 1px 3px oklch(0 0 0 / 0.1), 0 1px 2px -1px oklch(0 0 0 / 0.1)",
        "border-color": "{primary}"
      },
      "pill": {
        "background": "{raised}",
        "gradient": "linear-gradient(180deg, {raised} 0%, {raised} 100%)",
        "material": null,
        "shadow": "0 1px 2px oklch(0 0 0 / 0.05)",
        "border-color": "transparent"
      },
      "thumb": {
        "material": null,
        "shadow": "0 1px 3px oklch(0 0 0 / 0.1), 0 1px 2px -1px oklch(0 0 0 / 0.1)",
        "border-color": "transparent"
      },
      "on": {
        "foreground": "{foreground}",
        "material": null,
        "shadow": "none",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent"
      },
      "chip": {
        "background": "{muted}",
        "gradient": "linear-gradient(180deg, {muted} 0%, {muted} 100%)",
        "border-color": "transparent",
        "material": null,
        "shadow": "none"
      },
      "glass": {
        "border-color": "{border}",
        "backdropFilter": "blur(20px)",
        "material": null,
        "background": "oklch(from {card} l c h / 0.8)",
        "shadow": "none"
      },
      "menu": {
        "background": "{card}",
        "border-color": "{border}",
        "backdropFilter": "none",
        "material": null,
        "shadow": "0 4px 6px -1px oklch(0 0 0 / 0.1), 0 2px 4px -2px oklch(0 0 0 / 0.1)"
      },
      "modal": {
        "background": "{card}",
        "border-color": "{border}",
        "material": null,
        "shadow": "0 4px 6px -1px oklch(0 0 0 / 0.1), 0 2px 4px -2px oklch(0 0 0 / 0.1)"
      },
      "grabber": {
        "background": "{raised}",
        "shadow": "none",
        "material": null
      },
      "tooltip": {
        "background": "{popover}",
        "shadow": "none",
        "border-color": "{border}",
        "material": null
      },
      "inverse": {
        "background": "{inverse}",
        "foreground": "{muted-foreground}",
        "border-color": "{border}",
        "backdropFilter": "none",
        "material": null,
        "shadow": "0 4px 6px -1px oklch(0 0 0 / 0.1), 0 2px 4px -2px oklch(0 0 0 / 0.1)"
      },
      "groove": {
        "material": null,
        "shadow": "none"
      }
    },
    "light": {
      "pressed": {
        "background": "{border}",
        "gradient": "linear-gradient(180deg, {border} 0%, {border} 100%)"
      },
      "knobOn": {
        "background": "{background}",
        "gradient": "linear-gradient(180deg, {background} 0%, {background} 100%)"
      },
      "thumb": {
        "background": "oklch(1 0 0)",
        "gradient": "linear-gradient(180deg, oklch(1 0 0) 0%, oklch(1 0 0) 100%)"
      },
      "on": {
        "background": "{chart-1}",
        "gradient": "linear-gradient(180deg, {chart-1} 0%, {chart-1} 100%)"
      }
    },
    "dark": {
      "pressed": {
        "background": "oklch(0.34846 0 0)",
        "gradient": "linear-gradient(180deg, oklch(0.34846 0 0) 0%, oklch(0.34846 0 0) 100%)"
      },
      "knobOn": {
        "background": "{primary-foreground}",
        "gradient": "linear-gradient(180deg, {primary-foreground} 0%, {primary-foreground} 100%)"
      },
      "thumb": {
        "background": "oklch(0.34846 0 0)",
        "gradient": "linear-gradient(180deg, oklch(0.34846 0 0) 0%, oklch(0.34846 0 0) 100%)"
      },
      "on": {
        "background": "{chart-3}",
        "gradient": "linear-gradient(180deg, {chart-3} 0%, {chart-3} 100%)"
      }
    }
  }
}
