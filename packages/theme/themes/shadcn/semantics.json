{
  "typography": {
    "caption": {
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "detail": {
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "body": {
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "label": {
      "fontWeight": 500,
      "letterSpacing": 0
    },
    "title": {
      "fontWeight": 600,
      "letterSpacing": 0
    },
    "headline": {
      "fontWeight": 600,
      "letterSpacing": 0
    },
    "display": {
      "fontWeight": 600,
      "letterSpacing": 0
    }
  },
  "dimension": {
    "size": {
      "hit": {
        "pointer": 0,
        "touch": 44
      },
      "density": {
        "pointer": {
          "pad": 12,
          "gap": 12
        },
        "touch": {
          "pad": 12,
          "gap": 12
        }
      },
      "item": {
        "pointer": {
          "inset": 4,
          "pad": 8
        },
        "touch": {
          "inset": 8,
          "pad": 8
        }
      },
      "control": {
        "pointer": {
          "padding": 8,
          "gap": 8
        },
        "touch": {
          "padding": 8,
          "gap": 8
        }
      },
      "height": {
        "pointer": {
          "sm": 24,
          "md": 28,
          "lg": 32
        },
        "touch": {
          "sm": 32,
          "md": 40,
          "lg": 48
        }
      }
    },
    "stroke": {
      "hairline": 1,
      "control": 1
    },
    "focus": {
      "style": "halo",
      "width": 3,
      "offset": 0
    },
    "icon": {
      "pointer": {
        "sm": 12,
        "md": 16,
        "lg": 20
      },
      "touch": {
        "sm": 16,
        "md": 20,
        "lg": 24
      }
    }
  },
  "controls": {
    "button": {
      "corner": {
        "sm": "control",
        "md": "control",
        "lg": "control"
      },
      "selected": {
        "face": {
          "color": "track"
        },
        "ink": {
          "color": "foreground"
        }
      },
      "secondary": {
        "face": {
          "finish": "raised"
        },
        "ink": {
          "color": "foreground"
        },
        "edge": {
          "finish": "raised",
          "field": "borderColor"
        },
        "hover": {
          "finish": "hover"
        }
      },
      "outline": {
        "edge": {
          "color": "border"
        }
      },
      "destructive": {
        "edge": "none"
      },
      "shade": "raised"
    },
    "badge": {
      "corner": "full"
    },
    "field": {
      "edge": {
        "sides": true,
        "color": {
          "color": "input"
        },
        "bottom": {
          "color": "input"
        }
      },
      "corner": {
        "bottom": "control"
      },
      "focus": {
        "line": false,
        "width": 3,
        "color": {
          "color": "ring"
        }
      },
      "disabled": {
        "face": "keep"
      }
    },
    "choice": {
      "size": {
        "pointer": 16,
        "touch": 22
      },
      "box": {
        "pointer": 16,
        "touch": 20
      },
      "corner": {
        "pointer": 4,
        "touch": 4
      },
      "face": {
        "light": {
          "color": "field"
        },
        "dark": {
          "color": "input",
          "alpha": 0.3
        }
      },
      "shade": "none",
      "edge": {
        "width": 1,
        "color": {
          "light": {
            "color": "input"
          },
          "dark": {
            "color": "foreground",
            "alpha": 0.2
          }
        },
        "disabled": {
          "light": {
            "color": "input"
          },
          "dark": {
            "color": "foreground",
            "alpha": 0.4
          }
        }
      },
      "checked": {
        "face": {
          "finish": "accent"
        }
      },
      "radio": {
        "checked": {
          "face": "none",
          "edge": "none"
        }
      },
      "mark": {
        "size": {
          "pointer": 8,
          "touch": 8
        },
        "hover": "none",
        "pressed": "none"
      },
      "halo": "none"
    },
    "switch": {
      "track": {
        "pointer": [
          32,
          18
        ],
        "touch": [
          44,
          24
        ]
      },
      "small": {
        "track": {
          "pointer": [
            24,
            14
          ],
          "touch": [
            36,
            20
          ]
        },
        "knob": {
          "pointer": 12,
          "touch": 16
        }
      },
      "edge": {
        "off": 0,
        "on": 0,
        "color": "none"
      },
      "knob": {
        "size": {
          "pointer": 16,
          "touch": 20
        },
        "on": "same",
        "hover": "same",
        "pressed": "same"
      }
    },
    "slider": {
      "rail": {
        "pointer": 6,
        "touch": 8
      },
      "band": {
        "pointer": 20,
        "touch": 32
      },
      "face": {
        "color": "muted"
      },
      "shade": "none",
      "edge": {
        "color": "none",
        "width": 0
      },
      "knob": {
        "size": {
          "pointer": 16,
          "touch": 20
        },
        "pressed": {
          "pointer": 16,
          "touch": 32
        },
        "face": {
          "finish": "knob"
        },
        "edge": {
          "color": "primary"
        }
      },
      "mark": {
        "size": 0,
        "hover": 0,
        "pressed": 0
      },
      "brightens": true
    },
    "progress": {
      "height": 6,
      "line": 0,
      "face": {
        "color": "track"
      },
      "shade": "inset",
      "edge": {
        "color": {
          "color": "border"
        },
        "width": "control"
      }
    },
    "calendar": {
      "today": {
        "face": {
          "color": "foreground",
          "alpha": 0.08
        },
        "ink": {
          "color": "foreground"
        }
      }
    },
    "spinner": {
      "opacity": 0.25,
      "spokes": false
    },
    "popup": {
      "corner": "control"
    },
    "tooltip": {
      "face": {
        "color": "foreground"
      },
      "ink": {
        "color": "background"
      },
      "edge": "none",
      "shade": "none"
    },
    "toast": {
      "action": {
        "face": {
          "finish": "accent"
        }
      }
    },
    "list": {
      "item": {
        "highlight": {
          "color": "accent"
        },
        "edge": "none"
      }
    },
    "menubar": {
      "bar": {
        "finish": "card"
      }
    },
    "tabs": {
      "track": {
        "face": {
          "color": "inset"
        },
        "edge": "none",
        "corner": "control"
      }
    },
    "well": {
      "edge": {
        "color": "border"
      }
    },
    "disabled": {
      "face": "keep",
      "ink": "keep",
      "edge": "keep"
    }
  },
  "shape": {
    "curve": "continuous"
  },
  "state": {
    "press-scale": 1,
    "overlay": {
      "hover": 0,
      "pressed": 0
    },
    "pressed-opacity": 0.7,
    "rest-opacity": 0.5,
    "disabled": {
      "content": 0.5
    }
  },
  "motion": {
    "fast": {
      "duration": 150,
      "timingFunction": "out-cubic"
    },
    "default": {
      "duration": 250,
      "timingFunction": "out-cubic"
    },
    "slow": {
      "duration": 350,
      "timingFunction": "out-cubic"
    },
    "state": {
      "duration": 120,
      "timingFunction": "out-cubic"
    }
  },
  "finishes": {
    "shared": {
      "card": {
        "background": "{card}",
        "shadow": "0 1px 2px oklch(0 0 0 / 0.05)",
        "foreground": "{foreground}",
        "border-color": "{border}",
        "elevation": null
      },
      "inset": {
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "{border}",
        "border-bottom-color": null
      },
      "channel": {
        "background": "{inset}",
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "{border}"
      },
      "raised": {
        "background": "{raised}",
        "shadow": "0 1px 2px oklch(0 0 0 / 0.05)",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent",
        "backdropFilter": "none",
        "material": null
      },
      "plate": {
        "background": "{field}",
        "shadow": "0 1px 2px oklch(0 0 0 / 0.05)",
        "foreground": "{foreground}",
        "elevation": null
      },
      "overlay": {
        "background": "{card}",
        "shadow": "0 4px 6px -1px oklch(0 0 0 / 0.1), 0 2px 4px -2px oklch(0 0 0 / 0.1)",
        "foreground": "{foreground}",
        "border-color": "{border}",
        "backdropFilter": "none",
        "material": null,
        "elevation": null
      },
      "modal": {
        "background": "{card}",
        "shadow": "0 10px 15px -3px oklch(0 0 0 / 0.1), 0 4px 6px -4px oklch(0 0 0 / 0.1)",
        "foreground": "{foreground}",
        "border-color": "{border}",
        "elevation": null
      },
      "inverse": {
        "background": "{inverse}",
        "shadow": "0 4px 6px -1px oklch(0 0 0 / 0.1), 0 2px 4px -2px oklch(0 0 0 / 0.1)",
        "foreground": "{inverse-foreground}",
        "border-color": "{border}",
        "backdropFilter": "none",
        "material": null,
        "elevation": null
      },
      "glass": {
        "shadow": "0 1px 2px oklch(0 0 0 / 0.05)",
        "foreground": "{foreground}",
        "border-color": "{border}",
        "backdropFilter": "blur(20px)",
        "background": "oklch(from {card} l c h / 0.8)",
        "material": null,
        "elevation": null
      },
      "accent": {
        "background": "{primary}",
        "shadow": "none",
        "foreground": "{primary-foreground}",
        "border-color": "transparent",
        "border-bottom-color": "transparent",
        "pressed-opacity": 0.88,
        "pressed-background": null,
        "pressed-foreground": null
      },
      "fill": {
        "shadow": "none",
        "foreground": "{primary-foreground}",
        "background": "{primary}",
        "gradient": null,
        "border-color": "transparent"
      },
      "knob": {
        "shadow": "0 1px 2px oklch(0 0 0 / 0.05)",
        "foreground": "{foreground}",
        "background": "{knob}",
        "gradient": null,
        "border-color": "transparent",
        "checked-background": "{primary-foreground}"
      },
      "hover": {
        "shadow": "0 1px 2px oklch(0 0 0 / 0.05)",
        "foreground": "{foreground}",
        "background": "{hover}",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent",
        "elevation": null
      },
      "pressed": {
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "elevation": null
      },
      "disabled": {
        "background": "{raised}",
        "shadow": "0 1px 2px oklch(0 0 0 / 0.05)",
        "foreground": "{foreground}",
        "border-color": "{border}"
      }
    },
    "light": {
      "plate": {
        "border-color": "transparent"
      },
      "pressed": {
        "background": "{border}"
      }
    },
    "dark": {
      "plate": {
        "border-color": "{input}"
      },
      "pressed": {
        "background": "oklch(0.34846 0 0)"
      }
    }
  },
  "elevation": {
    "light": {
      "sm": "0 1px 2px oklch(0 0 0 / 0.05)",
      "md": "0 1px 3px oklch(0 0 0 / 0.1), 0 1px 2px -1px oklch(0 0 0 / 0.1)",
      "lg": "0 4px 6px -1px oklch(0 0 0 / 0.1), 0 2px 4px -2px oklch(0 0 0 / 0.1)",
      "xl": "0 10px 15px -3px oklch(0 0 0 / 0.1), 0 4px 6px -4px oklch(0 0 0 / 0.1)",
      "inset": null
    },
    "dark": {
      "sm": "0 1px 2px oklch(0 0 0 / 0.05)",
      "md": "0 1px 3px oklch(0 0 0 / 0.1), 0 1px 2px -1px oklch(0 0 0 / 0.1)",
      "lg": "0 4px 6px -1px oklch(0 0 0 / 0.1), 0 2px 4px -2px oklch(0 0 0 / 0.1)",
      "xl": "0 10px 15px -3px oklch(0 0 0 / 0.1), 0 4px 6px -4px oklch(0 0 0 / 0.1)",
      "inset": null
    }
  }
}
