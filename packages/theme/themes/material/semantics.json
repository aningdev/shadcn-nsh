{
  "typography": {
    "caption": {
      "fontWeight": 500,
      "letterSpacing": 0.5
    },
    "detail": {
      "fontWeight": 400,
      "letterSpacing": 0.4
    },
    "body": {
      "fontWeight": 400,
      "letterSpacing": 0.25
    },
    "label": {
      "fontWeight": 500,
      "letterSpacing": 0.1
    },
    "title": {
      "fontWeight": 500,
      "letterSpacing": 0.15
    },
    "headline": {
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "display": {
      "fontWeight": 400,
      "letterSpacing": 0
    }
  },
  "dimension": {
    "size": {
      "hit": {
        "pointer": 0,
        "touch": 48
      },
      "density": {
        "pointer": {
          "pad": 16,
          "gap": 12
        },
        "touch": {
          "pad": 16,
          "gap": 12
        }
      },
      "item": {
        "pointer": {
          "inset": 0,
          "pad": 12
        },
        "touch": {
          "inset": 0,
          "pad": 12
        }
      },
      "control": {
        "pointer": {
          "padding": 8,
          "gap": 8
        },
        "touch": {
          "padding": 8,
          "gap": 8
        }
      },
      "height": {
        "pointer": {
          "sm": 24,
          "md": 32,
          "lg": 40
        },
        "touch": {
          "sm": 32,
          "md": 40,
          "lg": 56
        }
      }
    },
    "stroke": {
      "hairline": 1,
      "control": 1
    },
    "focus": {
      "style": "outline",
      "width": 3,
      "offset": 2
    },
    "icon": {
      "pointer": {
        "sm": 12,
        "md": 16,
        "lg": 20
      },
      "touch": {
        "sm": 16,
        "md": 20,
        "lg": 24
      }
    }
  },
  "controls": {
    "button": {
      "corner": {
        "sm": "full",
        "md": "full",
        "lg": "full"
      },
      "selected": {
        "face": {
          "finish": "accent"
        },
        "ink": {
          "color": "primary-foreground"
        }
      },
      "secondary": {
        "face": {
          "color": "secondary"
        },
        "ink": {
          "color": "secondary-foreground"
        },
        "edge": "none",
        "hover": {
          "finish": "hover"
        }
      },
      "outline": {
        "edge": {
          "color": "input"
        }
      },
      "destructive": {
        "edge": "none"
      },
      "shade": "none"
    },
    "badge": {
      "corner": "full"
    },
    "field": {
      "edge": {
        "sides": false,
        "color": {
          "color": "input"
        },
        "bottom": {
          "color": "muted-foreground"
        }
      },
      "corner": {
        "bottom": 0
      },
      "focus": {
        "line": true,
        "width": 2,
        "color": {
          "color": "brand"
        }
      },
      "disabled": {
        "face": "keep"
      }
    },
    "choice": {
      "size": {
        "pointer": 20,
        "touch": 20
      },
      "box": {
        "pointer": 18,
        "touch": 18
      },
      "corner": {
        "pointer": 2,
        "touch": 2
      },
      "face": "none",
      "shade": "none",
      "edge": {
        "width": 2,
        "color": {
          "color": "muted-foreground"
        },
        "disabled": {
          "color": "muted-foreground"
        }
      },
      "checked": {
        "face": {
          "color": "primary"
        }
      },
      "radio": {
        "checked": {
          "face": "none",
          "edge": {
            "color": "primary"
          }
        }
      },
      "mark": {
        "size": {
          "pointer": 10,
          "touch": 10
        },
        "hover": "none",
        "pressed": "none"
      },
      "halo": 32
    },
    "switch": {
      "track": {
        "pointer": [
          40,
          24
        ],
        "touch": [
          52,
          32
        ]
      },
      "small": {
        "track": {
          "pointer": [
            32,
            20
          ],
          "touch": [
            40,
            24
          ]
        },
        "knob": {
          "pointer": 12,
          "touch": 12
        }
      },
      "edge": {
        "off": {
          "pointer": 2,
          "touch": 2
        },
        "on": 0,
        "color": {
          "color": "input"
        }
      },
      "knob": {
        "size": {
          "pointer": 16,
          "touch": 16
        },
        "on": {
          "pointer": 20,
          "touch": 24
        },
        "hover": "same",
        "pressed": {
          "pointer": 22,
          "touch": 28
        }
      }
    },
    "slider": {
      "rail": {
        "pointer": 4,
        "touch": 4
      },
      "band": {
        "pointer": 20,
        "touch": 32
      },
      "face": {
        "color": "secondary"
      },
      "shade": "none",
      "edge": {
        "color": "none",
        "width": 0
      },
      "knob": {
        "size": {
          "pointer": 16,
          "touch": 20
        },
        "pressed": {
          "pointer": 16,
          "touch": 32
        },
        "face": {
          "color": "primary"
        },
        "edge": "none"
      },
      "mark": {
        "size": 0,
        "hover": 0,
        "pressed": 0
      },
      "brightens": true
    },
    "progress": {
      "height": 4,
      "line": 0,
      "face": {
        "color": "secondary"
      },
      "shade": "none",
      "edge": {
        "color": "none",
        "width": 0
      }
    },
    "calendar": {
      "today": {
        "face": {
          "color": "foreground",
          "alpha": 0.08
        },
        "ink": {
          "color": "foreground"
        }
      }
    },
    "spinner": {
      "opacity": 0,
      "spokes": false
    },
    "popup": {
      "corner": "control"
    },
    "tooltip": {
      "face": {
        "finish": "inverse"
      },
      "ink": {
        "finish": "inverse",
        "field": "foreground"
      },
      "edge": "none",
      "shade": "none"
    },
    "toast": {
      "action": {
        "face": "none"
      }
    },
    "list": {
      "item": {
        "highlight": {
          "color": "accent"
        },
        "edge": "none"
      }
    },
    "menubar": {
      "bar": {
        "finish": "card"
      }
    },
    "tabs": {
      "track": {
        "face": "none",
        "edge": {
          "color": "border"
        },
        "corner": "full"
      }
    },
    "well": {
      "edge": "none"
    },
    "disabled": {
      "face": {
        "finish": "disabled"
      },
      "ink": {
        "finish": "disabled",
        "field": "foreground"
      },
      "edge": {
        "color": "foreground",
        "alpha": 0.12
      }
    }
  },
  "shape": {
    "curve": "circular"
  },
  "state": {
    "press-scale": 1,
    "overlay": {
      "hover": 0.08,
      "pressed": 0.1
    },
    "pressed-opacity": 1,
    "rest-opacity": 0.38,
    "disabled": {
      "content": 0.38
    }
  },
  "motion": {
    "fast": {
      "duration": 150,
      "timingFunction": "standard"
    },
    "default": {
      "duration": 250,
      "timingFunction": "standard"
    },
    "slow": {
      "duration": 400,
      "timingFunction": "emphasized-decelerate"
    },
    "state": {
      "duration": 100,
      "timingFunction": "standard"
    }
  },
  "finishes": {
    "shared": {
      "card": {
        "background": "{card}",
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "elevation": 1
      },
      "inset": {
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "{muted-foreground}",
        "border-bottom-color": null
      },
      "channel": {
        "background": "{inset}",
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "{line}"
      },
      "raised": {
        "background": "{raised}",
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent",
        "backdropFilter": "none",
        "material": null
      },
      "plate": {
        "background": "{secondary}",
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "elevation": 0
      },
      "overlay": {
        "background": "{popover}",
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 2px 6px 2px oklch(0 0 0 / 0.15)",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "backdropFilter": "none",
        "material": null,
        "elevation": 3
      },
      "modal": {
        "shadow": "0 1px 3px oklch(0 0 0 / 0.3), 0 4px 8px 3px oklch(0 0 0 / 0.15)",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "elevation": 6
      },
      "inverse": {
        "background": "{inverse}",
        "shadow": "0 1px 3px oklch(0 0 0 / 0.3), 0 4px 8px 3px oklch(0 0 0 / 0.15)",
        "foreground": "{inverse-foreground}",
        "border-color": "transparent",
        "backdropFilter": "none",
        "material": null,
        "elevation": 6
      },
      "glass": {
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "backdropFilter": "none",
        "background": "{popover}",
        "material": null,
        "elevation": 3
      },
      "accent": {
        "background": "{primary}",
        "shadow": "none",
        "foreground": "{primary-foreground}",
        "border-color": "transparent",
        "border-bottom-color": "transparent",
        "pressed-opacity": 1,
        "pressed-background": null,
        "pressed-foreground": null
      },
      "fill": {
        "shadow": "none",
        "foreground": "{primary-foreground}",
        "background": "{primary}",
        "gradient": null,
        "border-color": "transparent"
      },
      "knob": {
        "shadow": "none",
        "foreground": "{foreground}",
        "background": "{knob}",
        "gradient": null,
        "border-color": "transparent",
        "checked-background": "{primary-foreground}"
      },
      "hover": {
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
        "foreground": "{foreground}",
        "background": "{raised}",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent",
        "elevation": 1
      },
      "pressed": {
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
        "foreground": "{foreground}",
        "background": "{raised}",
        "border-color": "transparent",
        "elevation": 1
      },
      "disabled": {
        "background": "oklch(from {foreground} l c h / 0.12)",
        "shadow": "none",
        "foreground": "oklch(from {foreground} l c h / 0.38)",
        "border-color": "transparent"
      }
    },
    "light": {
      "modal": {
        "background": "oklch(0.93251 0.01479 312.24)"
      }
    },
    "dark": {
      "modal": {
        "background": "oklch(0.2859 0.01293 298.633)"
      }
    }
  },
  "elevation": {
    "light": {
      "sm": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
      "md": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
      "lg": "0 1px 2px oklch(0 0 0 / 0.3), 0 2px 6px 2px oklch(0 0 0 / 0.15)",
      "xl": "0 1px 3px oklch(0 0 0 / 0.3), 0 4px 8px 3px oklch(0 0 0 / 0.15)",
      "inset": null
    },
    "dark": {
      "sm": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
      "md": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
      "lg": "0 1px 2px oklch(0 0 0 / 0.3), 0 2px 6px 2px oklch(0 0 0 / 0.15)",
      "xl": "0 1px 3px oklch(0 0 0 / 0.3), 0 4px 8px 3px oklch(0 0 0 / 0.15)",
      "inset": null
    }
  }
}
