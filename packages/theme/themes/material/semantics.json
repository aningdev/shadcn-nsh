{
  "typography": {
    "caption": {
      "fontSize": {
        "pointer": 11,
        "touch": 12
      },
      "lineHeight": {
        "pointer": 16,
        "touch": 16
      },
      "fontWeight": 500,
      "letterSpacing": 0.5
    },
    "detail": {
      "fontSize": {
        "pointer": 12,
        "touch": 13
      },
      "lineHeight": {
        "pointer": 16,
        "touch": 20
      },
      "fontWeight": 400,
      "letterSpacing": 0.4
    },
    "body": {
      "fontSize": {
        "pointer": 13,
        "touch": 15
      },
      "lineHeight": {
        "pointer": 20,
        "touch": 20
      },
      "fontWeight": 400,
      "letterSpacing": 0.25
    },
    "label": {
      "fontSize": {
        "pointer": 14,
        "touch": 15
      },
      "lineHeight": {
        "pointer": 20,
        "touch": 20
      },
      "fontWeight": 500,
      "letterSpacing": 0.1
    },
    "title": {
      "fontSize": {
        "pointer": 16,
        "touch": 16
      },
      "lineHeight": {
        "pointer": 24,
        "touch": 24
      },
      "fontWeight": 500,
      "letterSpacing": 0.15
    },
    "headline": {
      "fontSize": {
        "pointer": 20,
        "touch": 22
      },
      "lineHeight": {
        "pointer": 28,
        "touch": 28
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "display": {
      "fontSize": {
        "pointer": 26,
        "touch": 28
      },
      "lineHeight": {
        "pointer": 32,
        "touch": 36
      },
      "fontWeight": 400,
      "letterSpacing": 0
    }
  },
  "dimension": {
    "shape": {
      "control": "{radius-control}",
      "container": "{radius-container}",
      "modal": "{radius-modal}"
    },
    "size": {
      "hit": {
        "pointer": 0,
        "touch": 48
      },
      "density": {
        "pointer": {
          "pad": 16,
          "gap": 12
        },
        "touch": {
          "pad": 16,
          "gap": 12
        }
      },
      "item": {
        "pointer": {
          "inset": 0,
          "pad": 12
        },
        "touch": {
          "inset": 0,
          "pad": 12
        }
      },
      "control": {
        "pointer": {
          "padding": 8,
          "gap": 8,
          "dot": 10,
          "switch": "regular"
        },
        "touch": {
          "padding": 8,
          "gap": 8,
          "dot": 10,
          "switch": "regular"
        }
      },
      "height": {
        "pointer": {
          "sm": 24,
          "md": 32,
          "lg": 40
        },
        "touch": {
          "sm": 32,
          "md": 40,
          "lg": 56
        }
      }
    },
    "stroke": {
      "hairline": 1,
      "control": 1
    },
    "focus": {
      "style": "outline",
      "width": 3,
      "offset": 2
    },
    "icon": {
      "pointer": {
        "sm": 12,
        "md": 16,
        "lg": 20
      },
      "touch": {
        "sm": 16,
        "md": 20,
        "lg": 24
      }
    }
  },
  "slots": {
    "field.face": {
      "colour": "field"
    },
    "field.shade": "inset",
    "field.edge.width": "control",
    "field.edge.sides": false,
    "field.edge.colour": {
      "colour": "input"
    },
    "field.edge.bottom": {
      "colour": "mutedForeground"
    },
    "field.corner.top": "control",
    "field.corner.bottom": 0,
    "field.focus.line": true,
    "field.focus.width": 2,
    "field.disabled.face": "keep",
    "choice.size": {
      "pointer": 20,
      "touch": 20
    },
    "choice.box": {
      "pointer": 18,
      "touch": 18
    },
    "choice.corner": {
      "pointer": 2,
      "touch": 2
    },
    "choice.face": "none",
    "choice.shade": "none",
    "choice.edge.width": 2,
    "choice.edge.colour": {
      "colour": "mutedForeground"
    },
    "choice.edge.disabled": {
      "colour": "mutedForeground"
    },
    "choice.checked.face": {
      "colour": "primary"
    },
    "choice.mark.size": {
      "pointer": 10,
      "touch": 10
    },
    "choice.mark.hover": "none",
    "choice.mark.pressed": "none",
    "choice.halo": 32,
    "switch.width": {
      "pointer": 40,
      "touch": 52
    },
    "switch.height": {
      "pointer": 24,
      "touch": 32
    },
    "switch.small.width": {
      "pointer": 40,
      "touch": 52
    },
    "switch.small.height": {
      "pointer": 24,
      "touch": 32
    },
    "switch.small.knob.width": {
      "pointer": 16,
      "touch": 16
    },
    "switch.small.knob.height": {
      "pointer": 16,
      "touch": 16
    },
    "switch.edge.off": {
      "pointer": 1,
      "touch": 2
    },
    "switch.edge.on": 0,
    "switch.knob.width": {
      "pointer": 16,
      "touch": 16
    },
    "switch.knob.height": {
      "pointer": 16,
      "touch": 16
    },
    "switch.knob.on.width": {
      "pointer": 20,
      "touch": 24
    },
    "switch.knob.on.height": {
      "pointer": 20,
      "touch": 24
    },
    "switch.knob.hover": {
      "pointer": 16,
      "touch": 16
    },
    "switch.knob.pressed.width": {
      "pointer": 22,
      "touch": 28
    },
    "switch.knob.pressed.height": {
      "pointer": 22,
      "touch": 28
    },
    "switch.feedback": "expand",
    "slider.rail": {
      "pointer": 6,
      "touch": 8
    },
    "slider.band": {
      "pointer": 20,
      "touch": 32
    },
    "slider.vertical": {
      "pointer": 128,
      "touch": 144
    },
    "slider.face": {
      "colour": "secondary"
    },
    "slider.shade": "none",
    "slider.edge.colour": "none",
    "slider.edge.width": 0,
    "slider.knob.size": {
      "pointer": 14,
      "touch": 20
    },
    "slider.knob.pressed.size": {
      "pointer": 14,
      "touch": 32
    },
    "slider.knob.face": {
      "colour": "primary"
    },
    "slider.mark.size": 0,
    "slider.mark.hover": 0,
    "slider.mark.pressed": 0,
    "slider.brightens": true,
    "progress.height": 4,
    "progress.line": 0,
    "progress.face": {
      "colour": "secondary"
    },
    "progress.shade": "none",
    "progress.edge.colour": "none",
    "progress.edge.width": 0,
    "spinner.opacity": 0,
    "popup.corner": "control",
    "tabs.track.face": "none",
    "well.edge": "none",
    "state.disabled.face": {
      "finish": "disabled"
    },
    "state.disabled.ink": {
      "finish": "disabled",
      "field": "foreground"
    },
    "state.disabled.edge": {
      "finish": "disabled",
      "field": "borderColor"
    }
  },
  "shape": {
    "curve": "circular",
    "corners": {
      "button": "full"
    }
  },
  "state": {
    "press-scale": 1,
    "overlay": {
      "hover": 0.08,
      "focus": 0.1,
      "pressed": 0.1,
      "dragged": 0.16
    },
    "pressed-opacity": 1,
    "rest-opacity": 0.38,
    "disabled": {
      "content": 0.38
    }
  },
  "transition": {
    "enter": {
      "duration": 500,
      "timingFunction": "emphasized-decelerate"
    }
  },
  "motion": {
    "fast": {
      "duration": 150,
      "timingFunction": "standard"
    },
    "default": {
      "duration": 250,
      "timingFunction": "standard"
    },
    "slow": {
      "duration": 400,
      "timingFunction": "emphasized-decelerate"
    },
    "state": {
      "duration": 100,
      "timingFunction": "standard"
    }
  },
  "finishes": {
    "shared": {
      "card": {
        "background": "{card}",
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "elevation": 1
      },
      "inset": {
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "{muted-foreground}",
        "border-top-color": null,
        "border-bottom-color": null
      },
      "channel": {
        "background": "{inset}",
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "{line}"
      },
      "raised": {
        "background": "{raised}",
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent",
        "backdropFilter": "none",
        "material": null
      },
      "plate": {
        "background": "{secondary}",
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "elevation": 0
      },
      "overlay": {
        "background": "{popover}",
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 2px 6px 2px oklch(0 0 0 / 0.15)",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "backdropFilter": "none",
        "material": null,
        "elevation": 3
      },
      "modal": {
        "shadow": "0 1px 3px oklch(0 0 0 / 0.3), 0 4px 8px 3px oklch(0 0 0 / 0.15)",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "elevation": 6
      },
      "inverse": {
        "background": "{inverse}",
        "shadow": "0 1px 3px oklch(0 0 0 / 0.3), 0 4px 8px 3px oklch(0 0 0 / 0.15)",
        "foreground": "{inverse-foreground}",
        "border-color": "transparent",
        "backdropFilter": "none",
        "material": null,
        "elevation": 6
      },
      "glass": {
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "backdropFilter": "none",
        "background": "{popover}",
        "material": null,
        "elevation": 3
      },
      "accent": {
        "background": "{primary}",
        "shadow": "none",
        "foreground": "{primary-foreground}",
        "border-color": "transparent",
        "border-bottom-color": "transparent",
        "pressed-opacity": 1,
        "pressed-background": null,
        "pressed-foreground": null
      },
      "fill": {
        "shadow": "none",
        "foreground": "{primary-foreground}",
        "background": "{primary}",
        "gradient": null,
        "border-color": "transparent"
      },
      "knob": {
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
        "foreground": "{foreground}",
        "background": "{knob}",
        "gradient": null,
        "border-color": "transparent",
        "checked-background": "{primary-foreground}"
      },
      "hover": {
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
        "foreground": "{foreground}",
        "background": "{raised}",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent",
        "elevation": 1
      },
      "pressed": {
        "shadow": "none",
        "foreground": "{foreground}",
        "background": "{raised}",
        "border-color": "transparent",
        "elevation": 1
      },
      "disabled": {
        "background": "oklch(from {foreground} l c h / 0.12)",
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
        "foreground": "oklch(from {foreground} l c h / 0.38)",
        "border-color": "transparent"
      }
    },
    "light": {
      "modal": {
        "background": "oklch(0.93251 0.01479 312.24)"
      }
    },
    "dark": {
      "modal": {
        "background": "oklch(0.2859 0.01293 298.633)"
      }
    }
  },
  "elevation": {
    "light": {
      "sm": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
      "md": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
      "lg": "0 1px 2px oklch(0 0 0 / 0.3), 0 2px 6px 2px oklch(0 0 0 / 0.15)",
      "xl": "0 1px 3px oklch(0 0 0 / 0.3), 0 4px 8px 3px oklch(0 0 0 / 0.15)",
      "inset": null
    },
    "dark": {
      "sm": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
      "md": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
      "lg": "0 1px 2px oklch(0 0 0 / 0.3), 0 2px 6px 2px oklch(0 0 0 / 0.15)",
      "xl": "0 1px 3px oklch(0 0 0 / 0.3), 0 4px 8px 3px oklch(0 0 0 / 0.15)",
      "inset": null
    }
  }
}
