{
  "typography": {
    "caption": {
      "fontSize": {
        "pointer": 11,
        "touch": 11
      },
      "lineHeight": {
        "pointer": 16,
        "touch": 16
      },
      "fontWeight": 500,
      "letterSpacing": 0.5
    },
    "detail": {
      "fontSize": {
        "pointer": 12,
        "touch": 12
      },
      "lineHeight": {
        "pointer": 16,
        "touch": 16
      },
      "fontWeight": 400,
      "letterSpacing": 0.4
    },
    "body": {
      "fontSize": {
        "pointer": 14,
        "touch": 14
      },
      "lineHeight": {
        "pointer": 20,
        "touch": 20
      },
      "fontWeight": 400,
      "letterSpacing": 0.25
    },
    "label": {
      "fontSize": {
        "pointer": 14,
        "touch": 14
      },
      "lineHeight": {
        "pointer": 20,
        "touch": 20
      },
      "fontWeight": 500,
      "letterSpacing": 0.1
    },
    "title": {
      "fontSize": {
        "pointer": 16,
        "touch": 16
      },
      "lineHeight": {
        "pointer": 24,
        "touch": 24
      },
      "fontWeight": 500,
      "letterSpacing": 0.15
    },
    "headline": {
      "fontSize": {
        "pointer": 24,
        "touch": 24
      },
      "lineHeight": {
        "pointer": 32,
        "touch": 32
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "display": {
      "fontSize": {
        "pointer": 36,
        "touch": 36
      },
      "lineHeight": {
        "pointer": 44,
        "touch": 44
      },
      "fontWeight": 400,
      "letterSpacing": 0
    }
  },
  "dimension": {
    "shape": {
      "control": "{radius-control}",
      "container": "{radius-container}",
      "modal": "{radius-modal}"
    },
    "size": {
      "hit": {
        "pointer": 0,
        "touch": 48
      },
      "density": {
        "pointer": {
          "pad": 16,
          "gap": 12
        },
        "touch": {
          "pad": 16,
          "gap": 12
        }
      },
      "item": {
        "pointer": {
          "inset": 0,
          "pad": 12
        },
        "touch": {
          "inset": 0,
          "pad": 12
        }
      },
      "control": {
        "pointer": {
          "padding": 8,
          "gap": 8,
          "dot": 10,
          "switch": "regular"
        },
        "touch": {
          "padding": 8,
          "gap": 8,
          "dot": 10,
          "switch": "regular"
        }
      },
      "height": {
        "pointer": {
          "sm": 24,
          "md": 32,
          "lg": 40
        },
        "touch": {
          "sm": 32,
          "md": 40,
          "lg": 56
        }
      }
    },
    "stroke": {
      "hairline": 1,
      "control": 1
    },
    "focus": {
      "style": "outline",
      "width": 3,
      "offset": 2
    },
    "icon": {
      "pointer": {
        "sm": 12,
        "md": 16,
        "lg": 20
      },
      "touch": {
        "sm": 16,
        "md": 20,
        "lg": 24
      }
    },
    "control": {
      "field": "underline",
      "choice": "outline",
      "track": "tint",
      "handle": "circle"
    }
  },
  "shape": {
    "curve": "circular",
    "corners": {
      "button": "full"
    }
  },
  "state": {
    "press-scale": 1,
    "overlay": {
      "hover": 0.08,
      "focus": 0.1,
      "pressed": 0.1,
      "dragged": 0.16
    },
    "ripple": true,
    "pressed-opacity": 1,
    "rest-opacity": 0.38,
    "disabled": {
      "content": 0.38,
      "fill": true
    }
  },
  "transition": {
    "enter": {
      "duration": 500,
      "timingFunction": "emphasized-decelerate"
    }
  },
  "motion": {
    "fast": {
      "stiffness": 800,
      "damping": 33.94
    },
    "default": {
      "stiffness": 380,
      "damping": 31.19
    },
    "slow": {
      "stiffness": 200,
      "damping": 22.63
    },
    "state": {
      "duration": 100,
      "timingFunction": "standard"
    }
  },
  "finishes": {
    "shared": {
      "card": {
        "background": "{card}",
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "elevation": 1
      },
      "inset": {
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "{input}"
      },
      "channel": {
        "background": "{inset}",
        "shadow": "none",
        "foreground": "{foreground}",
        "border-color": "{border}"
      },
      "raised": {
        "background": "{raised}",
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent",
        "backdropFilter": "none",
        "material": null
      },
      "plate": {
        "background": "{secondary}",
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "elevation": 1
      },
      "overlay": {
        "background": "{popover}",
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 2px 6px 2px oklch(0 0 0 / 0.15)",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "backdropFilter": "none",
        "material": null,
        "elevation": 3
      },
      "modal": {
        "shadow": "0 1px 3px oklch(0 0 0 / 0.3), 0 4px 8px 3px oklch(0 0 0 / 0.15)",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "elevation": 6
      },
      "inverse": {
        "background": "{inverse}",
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 2px 6px 2px oklch(0 0 0 / 0.15)",
        "foreground": "{inverse-foreground}",
        "border-color": "transparent",
        "backdropFilter": "none",
        "material": null,
        "elevation": 6
      },
      "glass": {
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
        "foreground": "{foreground}",
        "border-color": "transparent",
        "backdropFilter": "none",
        "background": "{popover}",
        "material": null,
        "elevation": 3
      },
      "accent": {
        "background": "{primary}",
        "shadow": "none",
        "foreground": "{primary-foreground}",
        "border-color": "transparent",
        "border-bottom-color": "transparent",
        "pressed-opacity": 1,
        "pressed-background": null,
        "pressed-foreground": null
      },
      "fill": {
        "shadow": "none",
        "foreground": "{primary-foreground}",
        "background": "{primary}",
        "gradient": null,
        "border-color": "transparent"
      },
      "knob": {
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
        "foreground": "{foreground}",
        "background": "{knob}",
        "gradient": null,
        "border-color": "transparent",
        "checked-background": "{primary-foreground}"
      },
      "hover": {
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
        "foreground": "{foreground}",
        "background": "{raised}",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent",
        "elevation": 1
      },
      "pressed": {
        "shadow": "none",
        "foreground": "{foreground}",
        "background": "{raised}",
        "border-color": "transparent",
        "elevation": 1
      },
      "disabled": {
        "background": "oklch(from {foreground} l c h / 0.1)",
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
        "foreground": "oklch(from {foreground} l c h / 0.38)",
        "border-color": "transparent"
      }
    },
    "light": {
      "modal": {
        "background": "oklch(0.93251 0.01479 312.24)"
      }
    },
    "dark": {
      "modal": {
        "background": "oklch(0.2859 0.01293 298.633)"
      }
    }
  },
  "elevation": {
    "light": {
      "sm": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
      "md": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
      "lg": "0 1px 2px oklch(0 0 0 / 0.3), 0 2px 6px 2px oklch(0 0 0 / 0.15)",
      "xl": "0 1px 3px oklch(0 0 0 / 0.3), 0 4px 8px 3px oklch(0 0 0 / 0.15)",
      "inset": null
    },
    "dark": {
      "sm": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
      "md": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
      "lg": "0 1px 2px oklch(0 0 0 / 0.3), 0 2px 6px 2px oklch(0 0 0 / 0.15)",
      "xl": "0 1px 3px oklch(0 0 0 / 0.3), 0 4px 8px 3px oklch(0 0 0 / 0.15)",
      "inset": null
    }
  }
}
