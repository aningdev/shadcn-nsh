{
  "typography": {
    "caption": {
      "fontSize": {
        "pointer": 11,
        "touch": 11
      },
      "lineHeight": {
        "pointer": 16,
        "touch": 16
      },
      "fontWeight": 500,
      "letterSpacing": 0.5
    },
    "detail": {
      "fontSize": {
        "pointer": 12,
        "touch": 12
      },
      "lineHeight": {
        "pointer": 16,
        "touch": 16
      },
      "fontWeight": 400,
      "letterSpacing": 0.4
    },
    "body": {
      "fontSize": {
        "pointer": 14,
        "touch": 14
      },
      "lineHeight": {
        "pointer": 20,
        "touch": 20
      },
      "fontWeight": 400,
      "letterSpacing": 0.25
    },
    "label": {
      "fontSize": {
        "pointer": 14,
        "touch": 14
      },
      "lineHeight": {
        "pointer": 20,
        "touch": 20
      },
      "fontWeight": 500,
      "letterSpacing": 0.1
    },
    "title": {
      "fontSize": {
        "pointer": 16,
        "touch": 16
      },
      "lineHeight": {
        "pointer": 24,
        "touch": 24
      },
      "fontWeight": 500,
      "letterSpacing": 0.15
    },
    "headline": {
      "fontSize": {
        "pointer": 24,
        "touch": 24
      },
      "lineHeight": {
        "pointer": 32,
        "touch": 32
      },
      "fontWeight": 400,
      "letterSpacing": 0
    },
    "display": {
      "fontSize": {
        "pointer": 36,
        "touch": 36
      },
      "lineHeight": {
        "pointer": 44,
        "touch": 44
      },
      "fontWeight": 400,
      "letterSpacing": 0
    }
  },
  "dimension": {
    "shape": {
      "control": "{radius-control}",
      "container": "{radius-container}",
      "modal": "{radius-modal}"
    },
    "size": {
      "hit": {
        "pointer": 44,
        "touch": 48
      },
      "density": {
        "pointer": {
          "pad": 16,
          "gap": 12,
          "surface": 12
        },
        "touch": {
          "pad": 16,
          "gap": 12,
          "surface": 16
        }
      },
      "control": {
        "pointer": {
          "padding": 8,
          "gap": 8,
          "dot": 10,
          "switch": "regular"
        },
        "touch": {
          "padding": 8,
          "gap": 8,
          "dot": 10,
          "switch": "regular"
        }
      },
      "height": {
        "pointer": {
          "sm": 32,
          "md": 40,
          "lg": 56
        },
        "touch": {
          "sm": 32,
          "md": 40,
          "lg": 56
        }
      }
    },
    "stroke": {
      "hairline": 1,
      "control": 1
    },
    "focus": {
      "style": "outline",
      "width": 3,
      "offset": 2
    },
    "icon": {
      "pointer": {
        "sm": 16,
        "md": 20,
        "lg": 24
      },
      "touch": {
        "sm": 16,
        "md": 20,
        "lg": 24
      }
    }
  },
  "shape": {
    "curve": "circular",
    "corners": {
      "button": "full"
    }
  },
  "state": {
    "press-scale": 1,
    "overlay": {
      "hover": 0.08,
      "focus": 0.1,
      "pressed": 0.1,
      "dragged": 0.16
    },
    "ripple": true,
    "pressed-opacity": 1,
    "rest-opacity": 0.38,
    "disabled": {
      "content": 0.38,
      "fill": true
    }
  },
  "transition": {
    "enter": {
      "duration": 500,
      "timingFunction": "emphasized-decelerate"
    }
  },
  "motion": {
    "fast": {
      "stiffness": 800,
      "damping": 33.94
    },
    "default": {
      "stiffness": 380,
      "damping": 31.19
    },
    "slow": {
      "stiffness": 200,
      "damping": 22.63
    }
  },
  "controls": "material",
  "finishes": {
    "shared": {
      "card": {
        "gradient": "linear-gradient(180deg, {card} 0%, {card} 100%)",
        "border-color": "transparent",
        "material": {
          "android": {
            "elevation": 1
          }
        },
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)"
      },
      "section": {
        "background": "{card}",
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
        "border-color": "transparent",
        "material": {
          "android": {
            "elevation": 1
          }
        }
      },
      "inset": {
        "material": null,
        "shadow": "none"
      },
      "field": {
        "shadow": "none",
        "material": null
      },
      "raised": {
        "background": "{raised}",
        "gradient": "linear-gradient(180deg, {raised} 0%, {raised} 100%)",
        "backdropFilter": "none",
        "material": {
          "android": {
            "elevation": 1
          }
        },
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent"
      },
      "hover": {
        "material": {
          "android": {
            "elevation": 1
          }
        },
        "background": "{raised}",
        "gradient": "linear-gradient(180deg, {hover} 0%, {hover} 100%)",
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent"
      },
      "pressed": {
        "foreground": "{foreground}",
        "material": {
          "android": {
            "elevation": 1
          }
        },
        "background": "{raised}",
        "gradient": "linear-gradient(180deg, {raised} 0%, {raised} 100%)",
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent"
      },
      "disabled": {
        "background": "oklch(from {foreground} l c h / 0.1)",
        "gradient": "linear-gradient(180deg, transparent 0%, transparent 100%)",
        "shadow": "none",
        "foreground": "oklch(from {foreground} l c h / 0.38)",
        "border-color": "transparent",
        "material": null
      },
      "light": {
        "background": "{primary}",
        "gradient": "linear-gradient(180deg, {primary} 0%, {primary} 100%)",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent",
        "material": null,
        "shadow": "none"
      },
      "accent": {
        "background": "{primary}",
        "gradient": "linear-gradient(180deg, {primary} 0%, {primary} 100%)",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent",
        "material": null,
        "shadow": "none"
      },
      "accentPressed": {
        "gradient": "linear-gradient(180deg, {primary} 0%, {primary} 100%)",
        "foreground": "{primary-foreground}",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent",
        "material": null,
        "background": "{primary}",
        "shadow": "none"
      },
      "track": {
        "material": null,
        "shadow": "none",
        "border-color": "{input}"
      },
      "fill": {
        "background": "transparent",
        "shadow": "none",
        "material": null,
        "gradient": "linear-gradient(180deg, {primary} 0%, {primary} 100%)",
        "border-color": "transparent"
      },
      "knob": {
        "material": null,
        "background": "{knob}",
        "gradient": "linear-gradient(180deg, {knob} 0%, {knob} 100%)",
        "shadow": "none",
        "border-color": "transparent"
      },
      "knobOn": {
        "background": "{primary-foreground}",
        "gradient": "linear-gradient(180deg, {primary-foreground} 0%, {primary-foreground} 100%)",
        "shadow": "none",
        "material": null,
        "border-color": "transparent"
      },
      "handle": {
        "material": null,
        "background": "{primary}",
        "gradient": "linear-gradient(180deg, {primary} 0%, {primary} 100%)",
        "shadow": "none",
        "border-color": "transparent"
      },
      "pill": {
        "background": "{raised}",
        "gradient": "linear-gradient(180deg, {raised} 0%, {raised} 100%)",
        "material": {
          "android": {
            "elevation": 1
          }
        },
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 1px 3px 1px oklch(0 0 0 / 0.15)",
        "border-color": "transparent"
      },
      "thumb": {
        "material": null,
        "background": "{secondary}",
        "gradient": "linear-gradient(180deg, {secondary} 0%, {secondary} 100%)",
        "shadow": "none",
        "border-color": "transparent"
      },
      "on": {
        "foreground": "{accent-foreground}",
        "material": null,
        "background": "{secondary}",
        "gradient": "linear-gradient(180deg, {secondary} 0%, {secondary} 100%)",
        "shadow": "none",
        "border-color": "transparent",
        "border-top-color": "transparent",
        "border-bottom-color": "transparent"
      },
      "chip": {
        "background": "{background}",
        "gradient": "linear-gradient(180deg, {background} 0%, {background} 100%)",
        "border-color": "{border}",
        "material": null,
        "shadow": "none"
      },
      "glass": {
        "border-color": "transparent",
        "backdropFilter": "none",
        "material": {
          "android": {
            "elevation": 3
          }
        },
        "background": "{popover}",
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 2px 6px 2px oklch(0 0 0 / 0.15)"
      },
      "menu": {
        "background": "{popover}",
        "border-color": "transparent",
        "backdropFilter": "none",
        "material": {
          "android": {
            "elevation": 3
          }
        },
        "shadow": "0 1px 2px oklch(0 0 0 / 0.3), 0 2px 6px 2px oklch(0 0 0 / 0.15)"
      },
      "modal": {
        "border-color": "transparent",
        "material": {
          "android": {
            "elevation": 6
          }
        },
        "shadow": "0 1px 3px oklch(0 0 0 / 0.3), 0 4px 8px 3px oklch(0 0 0 / 0.15)"
      },
      "grabber": {
        "background": "oklch(from {muted-foreground} l c h / 0.4)",
        "shadow": "none",
        "material": null
      },
      "tooltip": {
        "background": "{inverse}",
        "shadow": "none",
        "border-color": "transparent",
        "material": null
      },
      "inverse": {
        "background": "{inverse}",
        "foreground": "{inverse-foreground}",
        "border-color": "transparent",
        "backdropFilter": "none",
        "material": {
          "android": {
            "elevation": 6
          }
        },
        "shadow": "0 1px 3px oklch(0 0 0 / 0.3), 0 4px 8px 3px oklch(0 0 0 / 0.15)"
      },
      "groove": {
        "material": null,
        "shadow": "none"
      }
    },
    "light": {
      "modal": {
        "background": "oklch(0.93251 0.01479 312.24)"
      }
    },
    "dark": {
      "modal": {
        "background": "oklch(0.2859 0.01293 298.633)"
      }
    }
  }
}
