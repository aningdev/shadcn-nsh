  },
  "files": [
    "../../apps/web/.nsh/types/nsh/globals.d.ts",
    "../../apps/web/.nsh/types/nsh/assets.d.ts",
    "../../apps/web/.nsh/types/nsh/tokens.d.ts"
  ],
  "include": ["./**/*.ts", "./**/*.tsx"]
}
