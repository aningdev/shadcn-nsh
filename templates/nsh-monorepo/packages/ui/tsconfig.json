{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "nsh": ["../../apps/web/.nsh/types/nsh/index.d.ts"],
      "nsh/*": ["../../apps/web/.nsh/types/nsh/*.d.ts"],
      "*": ["../../apps/web/.nsh/types/*.d.ts"]
