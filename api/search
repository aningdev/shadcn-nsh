hange's own row (`up` for an added line, `down` for a deleted one), and any of the theme's tones works, read where the backing is drawn."},"792":{"id":"/docs/components/diff-view#13","page_id":"/docs/components/diff-view","tags":[],"type":"text","url":"/docs/components/diff-view#side-by-side","content":"`layout=\"split\"` puts the old text on the left and the new on the right."},"793":{"id":"/docs/components/diff-view#14","page_id":"/docs/components/diff-view","tags":[],"type":"text","url":"/docs/components/diff-view#actions-on-a-change","content":"`renderHunkActions` drops `DiffHunkActions` onto each change; `diffHunkTone` picks the tint its backing needs."},"794":{"id":"/docs/components/diff-view#15","page_id":"/docs/components/diff-view","tags":[],"type":"text","url":"/docs/components/diff-view#theme-colors","content":"`DiffView` defaults `styles` to `diffViewStyles()`; pass your own to change only the parts you name."},"795":{"id":"/docs/components/diff-view#16","page_id":"/docs/components/diff-view","tags":[],"type":"text","url":"/docs/components/diff-view#api","content":"| Part       | Props                                                            | Description           |\n| ---------- | ---------------------------------------------------------------- | --------------------- |\n| `DiffView` | every `nsh/base` DiffView prop; `styles` over `diffViewStyles()` | Two texts, or a patch |","table":"table-0"},"796":{"id":"/docs/components/diff-view#17","page_id":"/docs/components/diff-view","tags":[],"type":"text","url":"/docs/components/diff-view#api","content":"| Part              | Props                                             | Description                 |\n| ----------------- | ------------------------------------------------- | --------------------------- |\n| `DiffHunkActions` | `index`, `iconOnly`, `tone`, `onRevert`, `onKeep` | Revert and Keep on a change |","table":"table-0"},"797":{"id":"/docs/components/diff-view#18","page_id":"/docs/components/diff-view","tags":[],"type":"text","url":"/docs/components/diff-view#api","content":"Every prop of `nsh/base` DiffView passes through."},"798":{"id":"/docs/components/dock-area","page_id":"/docs/components/dock-area","type":"page","content":"DockArea","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/dock-area"},"799":{"id":"/docs/components/dock-area#0","page_id":"/docs/components/dock-area","tags":[],"type":"text","url":"/docs/components/dock-area","content":"Dockable workspace chrome for tabs, splits, and edge docks."},"800":{"id":"/docs/components/dock-area#1","page_id":"/docs/components/dock-area","type":"heading","tags":[],"url":"/docs/components/dock-area#installation","content":"Installation"},"801":{"id":"/docs/components/dock-area#2","page_id":"/docs/components/dock-area","type":"heading","tags":[],"url":"/docs/components/dock-area#usage","content":"Usage"},"802":{"id":"/docs/components/dock-area#3","page_id":"/docs/components/dock-area","type":"heading","tags":[],"url":"/docs/components/dock-area#examples","content":"Examples"},"803":{"id":"/docs/components/dock-area#4","page_id":"/docs/components/dock-area","type":"heading","tags":[],"url":"/docs/components/dock-area#tabs","content":"Tabs"},"804":{"id":"/docs/components/dock-area#5","page_id":"/docs/components/dock-area","type":"heading","tags":[],"url":"/docs/components/dock-area#default-chrome","content":"Default chrome"},"805":{"id":"/docs/components/dock-area#6","page_id":"/docs/components/dock-area","type":"heading","tags":[],"url":"/docs/components/dock-area#api","content":"API"},"806":{"id":"/docs/components/dock-area#7","page_id":"/docs/components/dock-area","tags":[],"type":"text","url":"/docs/components/dock-area#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"807":{"id":"/docs/components/dock-area#8","page_id":"/docs/components/dock-area","tags":[],"type":"text","url":"/docs/components/dock-area#usage","content":"Use `DockTab`, `dockTabCloseClass`, and `DockDragPreview` in `renderTab` / `renderDragPreview`, or rely on the defaults."},"808":{"id":"/docs/components/dock-area#9","page_id":"/docs/components/dock-area","tags":[],"type":"text","url":"/docs/components/dock-area#tabs","content":"`defaultLayout` is the data; `renderTab` and `renderPanel` draw each tab and panel."},"809":{"id":"/docs/components/dock-area#10","page_id":"/docs/components/dock-area","tags":[],"type":"text","url":"/docs/components/dock-area#default-chrome","content":"Leave the render props out and the area uses `DockTab` and `DockDragPreview`. The area's own classes are the chrome of every part, and a class you pass follows them."},"810":{"id":"/docs/components/dock-area#11","page_id":"/docs/components/dock-area","tags":[],"type":"text","url":"/docs/components/dock-area#api","content":"| Part       | Props                                                                                                                               | Description                 |\n| ---------- | ----------------------------------------------------------------------------------------------------------------------------------- | --------------------------- |\n| `DockArea` | every `nsh/base` DockArea prop; `renderTab`, `renderDragPreview`, `renderEmpty` and the part classes, the caller's after the area's | Tabs, splits and edge docks |","table":"table-0"},"811":{"id":"/docs/components/dock-area#12","page_id":"/docs/components/dock-area","tags":[],"type":"text","url":"/docs/components/dock-area#api","content":"| Part      | Props                                   | Description                 |\n| --------- | --------------------------------------- | --------------------------- |\n| `DockTab` | `title`, `active`, `testID`, `children` | A tab's title and underline |","table":"table-0"},"812":{"id":"/docs/components/dock-area#13","page_id":"/docs/components/dock-area","tags":[],"type":"text","url":"/docs/components/dock-area#api","content":"| Part              | Props   | Description          |\n| ----------------- | ------- | -------------------- |\n| `DockDragPreview` | `title` | A dragged tab's chip |","table":"table-0"},"813":{"id":"/docs/components/dock-area#14","page_id":"/docs/components/dock-area","tags":[],"type":"text","url":"/docs/components/dock-area#api","content":"`DockArea` applies its chrome classes and default tab, preview and empty renderers. Every prop of `nsh/base` DockArea passes through, and so do the types those props, its ref and its callbacks name — a call site reads them from this file, not from `nsh/base`: `DockAreaProps`, `DockAreaRef`, `DockAreaLayout`, `DockRegion`, `DockNode`, `DockPlacement`, `DockPanel`, `DockPanelOptions`, `DockTarget`, `DockDropIndicator` and `DockInfo`."},"814":{"id":"/docs/components/dock-area#15","page_id":"/docs/components/dock-area","tags":[],"type":"text","url":"/docs/components/dock-area#api","content":"`groupClass` is applied after the look's `flex-1 bg-muted`. A later background utility replaces the fill, so `groupClass=\"bg-card\"` draws card-colored groups without `groupStyle`."},"815":{"id":"/docs/components/dock-area#16","page_id":"/docs/components/dock-area","tags":[],"type":"text","url":"/docs/components/dock-area#api","content":"A tab as `renderTab` and `renderDragPreview` receive it is `DockTabValue`: `nsh/base`'s `DockTab`, named so here because `DockTab` is the component the tab is drawn with."},"816":{"id":"/docs/components/drawer","page_id":"/docs/components/drawer","type":"page","content":"Drawer","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/drawer"},"817":{"id":"/docs/components/drawer#0","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer","content":"A panel from the bottom edge, with a grabber, that a swipe closes."},"818":{"id":"/docs/components/drawer#1","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#installation","content":"Installation"},"819":{"id":"/docs/components/drawer#2","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#usage","content":"Usage"},"820":{"id":"/docs/components/drawer#3","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#composition","content":"Composition"},"821":{"id":"/docs/components/drawer#4","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#examples","content":"Examples"},"822":{"id":"/docs/components/drawer#5","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#a-swipe-closes-it","content":"A swipe closes it"},"823":{"id":"/docs/components/drawer#6","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#the-grabber","content":"The grabber"},"824":{"id":"/docs/components/drawer#7","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#another-edge","content":"Another edge"},"825":{"id":"/docs/components/drawer#8","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#a-list-of-actions","content":"A list of actions"},"826":{"id":"/docs/components/drawer#9","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#against-sheet","content":"Against `Sheet`"},"827":{"id":"/docs/components/drawer#10","page_id":"/docs/components/drawer","type":"heading","tags":[],"url":"/docs/components/drawer#api","content":"API"},"828":{"id":"/docs/components/drawer#11","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"829":{"id":"/docs/components/drawer#12","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#composition","content":"Use the following composition to build a `Drawer`:"},"830":{"id":"/docs/components/drawer#13","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#a-swipe-closes-it","content":"`closeOnSwipe` is on by default — unlike `Sheet`, which does not follow a drag: the drawer is\na phone's panel, so dragging its top edge down past a third of its height (or 800 points a second)\ncloses it, and a scroll inside it hands the drag over at its top. Escape, Android's back and a press\non the scrim close it too; all of them are `nsh/base`'s, and `closeOnEscape` /\n`closeOnBackdropPress` / `closeOnSwipe` turn each one off."},"831":{"id":"/docs/components/drawer#14","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#the-grabber","content":"The pill at the top edge is 100 by 8 points, fully round, in the muted fill, and it shows on a\nbottom drawer only, the one it can be dragged from. A sheet's grabber is the narrower pill. The\ngrabber is drawn by the component, not by the app."},"832":{"id":"/docs/components/drawer#15","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#another-edge","content":"`side` takes any edge of the panel (`\"bottom\"` unless set). A drawer from the left or the right keeps\nthe panel's full height and its inner corners on the card's radius."},"833":{"id":"/docs/components/drawer#16","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#a-list-of-actions","content":"A drawer's actions stack — that is what a finger reaches on a phone — so `DrawerFooter` is a column\nand each action is as wide as the drawer. A row of destinations is a `DrawerClose` each, so tapping\none closes the drawer after its `onPress`."},"834":{"id":"/docs/components/drawer#17","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#against-sheet","content":"Opening from the bottom by default, the grabber, the swipe, and the four parts around the panel\n(`DrawerHeader`, `DrawerTitle`, `DrawerDescription`, `DrawerFooter`). The panel, the scrim and the\ntitle's type are shared: `sheetPanel(side)`, `backdrop()`, `dialogTitle()` and `dialogText()`, so a\ndrawer and the rest of the library wear one surface."},"835":{"id":"/docs/components/drawer#18","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#api","content":"| Part     | Props                                                                                    | Description              |\n| -------- | ---------------------------------------------------------------------------------------- | ------------------------ |\n| `Drawer` | `open`, `defaultOpen`, `onOpenChange({ open, reason })`, `onOpen`, `onClose`, `onCancel` | Open state and lifecycle |","table":"table-0"},"836":{"id":"/docs/components/drawer#19","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#api","content":"| Part            | Props                                      | Description                                                |\n| --------------- | ------------------------------------------ | ---------------------------------------------------------- |\n| `DrawerTrigger` | `children`, `variant`, `disabled`, `style` | A `Button` for a string child, else a pressable of its own |","table":"table-0"},"837":{"id":"/docs/components/drawer#20","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#api","content":"| Part            | Props                                                                                                         | Description |\n| --------------- | ------------------------------------------------------------------------------------------------------------- | ----------- |\n| `DrawerContent` | `side`, every `nsh/base` Sheet prop but open state and the lifecycle callbacks; `popupStyle`, `backdropStyle` | The panel   |","table":"table-0"},"838":{"id":"/docs/components/drawer#21","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#api","content":"| Part           | Props               | Description                                                    |\n| -------------- | ------------------- | -------------------------------------------------------------- |\n| `DrawerHeader` | `children`, `style` | A column holding the title and its description, 2 points apart |","table":"table-0"},"839":{"id":"/docs/components/drawer#22","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#api","content":"| Part          | Props               | Description       |\n| ------------- | ------------------- | ----------------- |\n| `DrawerTitle` | `children`, `style` | The panel's title |","table":"table-0"},"840":{"id":"/docs/components/drawer#23","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#api","content":"| Part                | Props               | Description             |\n| ------------------- | ------------------- | ----------------------- |\n| `DrawerDescription` | `children`, `style` | The muted line under it |","table":"table-0"},"841":{"id":"/docs/components/drawer#24","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#api","content":"| Part           | Props               | Description                                      |\n| -------------- | ------------------- | ------------------------------------------------ |\n| `DrawerFooter` | `children`, `style` | The actions, stacked, each as wide as the drawer |","table":"table-0"},"842":{"id":"/docs/components/drawer#25","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#api","content":"| Part          | Props                              | Description                       |\n| ------------- | ---------------------------------- | --------------------------------- |\n| `DrawerClose` | As `DrawerTrigger`, plus `onPress` | Closes it after its own `onPress` |","table":"table-0"},"843":{"id":"/docs/components/drawer#26","page_id":"/docs/components/drawer","tags":[],"type":"text","url":"/docs/components/drawer#api","content":"Every prop of `nsh/base` Sheet passes through on `DrawerContent`\nexcept open state and the lifecycle callbacks, which the root owns. `popupStyle` and `backdropStyle`\ngo over the look's. Defaults: `side` `\"bottom\"`, `closeOnSwipe` `true`."},"844":{"id":"/docs/components/editor","page_id":"/docs/components/editor","type":"page","content":"Editor","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/editor"},"845":{"id":"/docs/components/editor#0","page_id":"/docs/components/editor","tags":[],"type":"text","url":"/docs/components/editor","content":"An editor on the field's well, with line numbers, diagnostics and a find bar."},"846":{"id":"/docs/components/editor#1","page_id":"/docs/components/editor","type":"heading","tags":[],"url":"/docs/components/editor#installation","content":"Installation"},"847":{"id":"/docs/components/editor#2","page_id":"/docs/components/editor","type":"heading","tags":[],"url":"/docs/components/editor#usage","content":"Usage"},"848":{"id":"/docs/components/editor#3","page_id":"/docs/components/editor","type":"heading","tags":[],"url":"/docs/components/editor#composition","content":"Composition"},"849":{"id":"/docs/components/editor#4","page_id":"/docs/components/editor","type":"heading","tags":[],"url":"/docs/components/editor#examples","content":"Examples"},"850":{"id":"/docs/components/editor#5","page_id":"/docs/components/editor","type":"heading","tags":[],"url":"/docs/components/editor#languages","content":"Languages"},"851":{"id":"/docs/components/editor#6","page_id":"/docs/components/editor","type":"heading","tags":[],"url":"/docs/components/editor#diagnostics","content":"Diagnostics"},"852":{"id":"/docs/components/editor#7","page_id":"/docs/components/editor","type":"heading","tags":[],"url":"/docs/components/editor#find-and-replace","content":"Find and replace"},"853":{"id":"/docs/components/editor#8","page_id":"/docs/components/editor","type":"heading","tags":[],"url":"/docs/components/editor#parts","content":"Parts"},"854":{"id":"/docs/components/editor#9","page_id":"/docs/components/editor","type":"heading","tags":[],"url":"/docs/components/editor#hover-and-quick-fixes","content":"Hover and quick fixes"},"855":{"id":"/docs/components/editor#10","page_id":"/docs/components/editor","type":"heading","tags":[],"url":"/docs/components/editor#controlled-text","content":"Controlled text"},"856":{"id":"/docs/components/editor#11","page_id":"/docs/components/editor","type":"heading","tags":[],"url":"/docs/components/editor#api","content":"API"},"857":{"id":"/docs/components/editor#12","page_id":"/docs/components/editor","tags":[],"type":"text","url":"/docs/components/editor#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"858":{"id":"/docs/components/editor#13","page_id":"/docs/components/editor","tags":[],"type":"text","url":"/docs/components/editor#usage","content":"Every prop of `nsh/base` Editor passes through: the text (`value` / `defaultValue`, `onChange`), the language and its highlighting, folding, soft wrap, search, the editing keys and the diagnostics. The shell adds the look of the editor's parts and the field's well."},"859":{"id":"/docs/components/editor#14","page_id":"/docs/components/editor","tags":[],"type":"text","url":"/docs/components/editor#composition","content":"Use the following composition to build an `Editor`:"},"860":{"id":"/docs/components/editor#15","page_id":"/docs/components/editor","tags":[],"type":"text","url":"/docs/components/editor#languages","content":"`language` takes a name, an extension or a file name; the editor highlights it and follows its editing rules (comments, brackets, indentation)."},"861":{"id":"/docs/components/editor#16","page_id":"/docs/components/editor","tags":[],"type":"text","url":"/docs/components/editor#diagnostics","content":"Ranges the app marks, carried through edits until it sets new ones: an error is underlined in the theme's `destructive`, a warning in `warn`, information in `info`, a hint in `muted-foreground`."},"862":{"id":"/docs/components/editor#17","page_id":"/docs/components/editor","tags":[],"type":"text","url":"/docs/components/editor#find-and-replace","content":"`search` is what the editor finds and highlights; `onSearchChange` says what it found — how many\nmatches, which of them the selection is on, or why a pattern is not a regular expression. The editor\nnever sets the search itself (`EditorRef` replaces a match, it does not find one), so the bar that\nedits it is a part: `EditorFindBar` takes the editor's `ref`, **the same object the app hands the\neditor's `search`**, and the `result` the editor reported. What is typed into the bar goes back\nthrough `onSearchChange`; its buttons run the editor's own `findNext`, `findPrevious`, `replace` and\n`replaceAll` (and the bar says how many a Replace all rewrote for a moment)."},"863":{"id":"/docs/components/editor#18","page_id":"/docs/components/editor","tags":[],"type":"text","url":"/docs/components/editor#find-and-replace","content":"Where the bar is and whether it is open are the app's: it sits beside the editor in the same `View`\nrather than inside it, since a part cannot leave the tree. The keys are the app's too — Escape and\n`mod+f` belong to its `keymap`, as a part that captured them would take them from the editor while\nthe bar is closed. Because the search is one object, a query the app sets — from\n`onFindWithSelection`, or from a keybinding — reads in the bar, and the bar's edits move the\neditor's matches as it types."},"864":{"id":"/docs/components/editor#19","page_id":"/docs/components/editor","tags":[],"type":"text","url":"/docs/components/editor#parts","content":"`classes` goes over the shell's classes part by part (an app's classes come after the shell's; `null` drops the shell's), and `style` over the field's well. The font is set with `fontFamily`, `fontSize` and `lineHeight`, which the editor measures its rows in."},"865":{"id":"/docs/components/editor#20","page_id":"/docs/components/editor","tags":[],"type":"text","url":"/docs/components/editor#hover-and-quick-fixes","content":"`onHover` reports where the pointer rests: the character, the word it is in, **the word's box on the\npage** (`pageBounds`, what a popup is placed against) and the diagnostics there; `onHoverEnd` says\nit left. The app answers with an `Overlay` anchored to that box, so the card follows the word as the\ntext scrolls and flips below it where there is no room. A card that carries buttons is kept alive\nwhile the pointer is over it — `onMouseEnter` / `onMouseLeave` on the card, a timer that closes it a\nmoment after the pointer leaves — or it vanishes under the pointer on the way to them. A fix\nrewrites the file, which the app owns (`value` / `onChange`)."},"866":{"id":"/docs/components/editor#21","page_id":"/docs/components/editor","tags":[],"type":"text","url":"/docs/components/editor#controlled-text","content":"Pass `value` and set it again in `onChange`; the app owns the file, as a formatter's output or a loaded file replaces it."},"867":{"id":"/docs/components/editor#22","page_id":"/docs/components/editor","tags":[],"type":"text","url":"/docs/components/editor#api","content":"| Part     | Props                        | Description                                   |\n| -------- | ---------------------------- | --------------------------------------------- |\n| `Editor` | every `nsh/base` Editor prop | Themed `nsh/base` Editor on the field's well. |","table":"table-0"},"868":{"id":"/docs/components/editor#23","page_id":"/docs/components/editor","tags":[],"type":"text","url":"/docs/components/editor#api","content":"| Part          | Props | Description                            |\n| ------------- | ----- | -------------------------------------- |\n| `EditorProps` | —     | `nsh/base`'s `EditorProps`, unchanged. |","table":"table-0"},"869":{"id":"/docs/components/editor#24","page_id":"/docs/components/editor","tags":[],"type":"text","url":"/docs/components/editor#api","content":"| Part            | Props                | Description                                                     |\n| --------------- | -------------------- | --------------------------------------------------------------- |\n| `EditorFindBar` | `EditorFindBarProps` | The find bar: the query with its count, its modes, and replace. |","table":"table-0"},"870":{"id":"/docs/components/editor#25","page_id":"/docs/components/editor","tags":[],"type":"text","url":"/docs/components/editor#api","content":"| Part                 | Props | Description                                                                  |\n| -------------------- | ----- | ---------------------------------------------------------------------------- |\n| `EditorFindBarProps` | —     | `editor`, `search`, `onSearchChange`, `result`, `onClose`, `class`, `style`. |","table":"table-0"},"871":{"id":"/docs/components/editor#26","page_id":"/docs/components/editor","tags":[],"type":"text","url":"/docs/components/editor#api","content":"The session types the props name are re-exported from this file, so an app does not import them from `nsh/base`: `EditorRef`, `EditorDecoration`, `EditorDiagnostic`, `EditorPosition`, `EditorRange`, `EditorSelection`, `EditorSearchResult`, `EditorCommand`, `EditorCompletionItem`, and the rest of the editor's value types."},"872":{"id":"/docs/components/emoji-picker","page_id":"/docs/components/emoji-picker","type":"page","content":"Emoji picker","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/emoji-picker"},"873":{"id":"/docs/components/emoji-picker#0","page_id":"/docs/components/emoji-picker","tags":[],"type":"text","url":"/docs/components/emoji-picker","content":"Tabs, search, skin tones and grid styled for nsh/base EmojiPicker."},"874":{"id":"/docs/components/emoji-picker#1","page_id":"/docs/components/emoji-picker","type":"heading","tags":[],"url":"/docs/components/emoji-picker#installation","content":"Installation"},"875":{"id":"/docs/components/emoji-picker#2","page_id":"/docs/components/emoji-picker","type":"heading","tags":[],"url":"/docs/components/emoji-picker#usage","content":"Usage"},"876":{"id":"/docs/components/emoji-picker#3","page_id":"/docs/components/emoji-picker","type":"heading","tags":[],"url":"/docs/components/emoji-picker#examples","content":"Examples"},"877":{"id":"/docs/components/emoji-picker#4","page_id":"/docs/components/emoji-picker","type":"heading","tags":[],"url":"/docs/components/emoji-picker#recent-emoji","content":"Recent emoji"},"878":{"id":"/docs/components/emoji-picker#5","page_id":"/docs/components/emoji-picker","type":"heading","tags":[],"url":"/docs/components/emoji-picker#in-a-composer","content":"In a composer"},"879":{"id":"/docs/components/emoji-picker#6","page_id":"/docs/components/emoji-picker","type":"heading","tags":[],"url":"/docs/components/emoji-picker#reactions","content":"Reactions"},"880":{"id":"/docs/components/emoji-picker#7","page_id":"/docs/components/emoji-picker","type":"heading","tags":[],"url":"/docs/components/emoji-picker#api","content":"API"},"881":{"id":"/docs/components/emoji-picker#8","page_id":"/docs/components/emoji-picker","tags":[],"type":"text","url":"/docs/components/emoji-picker#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"882":{"id":"/docs/components/emoji-picker#9","page_id":"/docs/components/emoji-picker","tags":[],"type":"text","url":"/docs/components/emoji-picker#in-a-composer","content":"A composer keeps the panel behind a `Popover` on the field's leading addon. Choosing closes the\npanel and puts the emoji at the end of the draft; `base` (the emoji without its skin tone) is what\nleads the recents, so the tab that holds it opens first the next time."},"883":{"id":"/docs/components/emoji-picker#10","page_id":"/docs/components/emoji-picker","tags":[],"type":"text","url":"/docs/components/emoji-picker#in-a-composer","content":"The popover goes in the addon, where the smile goes: `PopoverContent` is what mounts the popover,\nand it draws the trigger in its own place — a `PopoverContent` written outside the group leaves the\nsmile under the field. `placement=\"top\"` puts the panel over the field, where a composer at the\nbottom of a window has room; on a narrow frame give the panel a narrower `class` and the popover\nthe same `width`."},"884":{"id":"/docs/components/emoji-picker#11","page_id":"/docs/components/emoji-picker","tags":[],"type":"text","url":"/docs/components/emoji-picker#reactions","content":"The counted chips are a row of pressables under the bubble: one tap adds yours or takes it back\noff, and a count that reaches zero drops the chip. `BubbleReactions` draws a row of emoji alone —\nits children are text, and the room it keeps is a line of it — so counted chips go in the\n`MessageContent` below the bubble."},"885":{"id":"/docs/components/emoji-picker#12","page_id":"/docs/components/emoji-picker","tags":[],"type":"text","url":"/docs/components/emoji-picker#reactions","content":"A row of quick emoji beside the picker is the same pressables in a pill: six of them, a divider,\nthen a `Popover` whose trigger is a plus, with the same `EmojiPanel` inside it and `react` as its\n`onSelect`."},"886":{"id":"/docs/components/emoji-picker#13","page_id":"/docs/components/emoji-picker","tags":[],"type":"text","url":"/docs/components/emoji-picker#api","content":"| Part         | Props                                                                                                                                                           | Description                                                  |\n| ------------ | --------------------------------------------------------------------------------------------------------------------------------------------------------------- | ------------------------------------------------------------ |\n| `EmojiPanel` | `onSelect` (required, `(e: { emoji: string; base: string })`), `onCancel`, `recent` (`string[]`, default `[]`), `fill`, `class`, `testID`, `accessibilityLabel` | The whole picker: tabs, search, skin tones, grid and preview |","table":"table-0"},"887":{"id":"/docs/components/emoji-picker#14","page_id":"/docs/components/emoji-picker","tags":[],"type":"text","url":"/docs/components/emoji-picker#api","content":"| Part           | Props   | Description       |\n| -------------- | ------- | ----------------- |\n| `EmojiHeading` | `group` | A group's heading |","table":"table-0"},"888":{"id":"/docs/components/emoji-picker#15","page_id":"/docs/components/emoji-picker","tags":[],"type":"text","url":"/docs/components/emoji-picker#api","content":"| Part        | Props                        | Description    |\n| ----------- | ---------------------------- | -------------- |\n| `EmojiTabs` | `group`, `groups`, `onPress` | The group tabs |","table":"table-0"},"889":{"id":"/docs/components/emoji-picker#16","page_id":"/docs/components/emoji-picker","tags":[],"type":"text","url":"/docs/components/emoji-picker#api","content":"| Part         | Props              | Description                                |\n| ------------ | ------------------ | ------------------------------------------ |\n| `EmojiTones` | `tone`, `onChange` | The skin tone hand beside the search field |","table":"table-0"},"890":{"id":"/docs/components/emoji-picker#17","page_id":"/docs/components/emoji-picker","tags":[],"type":"text","url":"/docs/components/emoji-picker#api","content":"| Part           | Props           | Description                        |\n| -------------- | --------------- | ---------------------------------- |\n| `EmojiPreview` | `entry`, `hint` | The emoji under the pointer, named |","table":"table-0"},"891":{"id":"/docs/components/emoji-picker#18","page_id":"/docs/components/emoji-picker","tags":[],"type":"text","url":"/docs/components/emoji-picker#api","content":"`EmojiPanel` wraps `nsh/base` EmojiPicker with gallery classes and chrome. Pass through any base picker prop via extending the shell later; today only the upstream panel props are supported."},"892":{"id":"/docs/components/empty","page_id":"/docs/components/empty","type":"page","content":"Empty","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/empty"},"893":{"id":"/docs/components/empty#0","page_id":"/docs/components/empty","tags":[],"type":"text","url":"/docs/components/empty","content":"A centered block that says there is nothing here yet, and what to do about it."},"894":{"id":"/docs/components/empty#1","page_id":"/docs/components/empty","type":"heading","tags":[],"url":"/docs/components/empty#installation","content":"Installation"},"895":{"id":"/docs/components/empty#2","page_id":"/docs/components/empty","type":"heading","tags":[],"url":"/docs/components/empty#usage","content":"Usage"},"896":{"id":"/docs/components/empty#3","page_id":"/docs/components/empty","type":"heading","tags":[],"url":"/docs/components/empty#composition","content":"Composition"},"897":{"id":"/docs/components/empty#4","page_id":"/docs/components/empty","type":"heading","tags":[],"url":"/docs/components/empty#examples","content":"Examples"},"898":{"id":"/docs/components/empty#5","page_id":"/docs/components/empty","type":"heading","tags":[],"url":"/docs/components/empty#with-what-the-reader-can-do","content":"With what the reader can do"},"899":{"id":"/docs/components/empty#6","page_id":"/docs/components/empty","type":"heading","tags":[],"url":"/docs/components/empty#the-apps-own-art","content":"The app's own art"},"900":{"id":"/docs/components/empty#7","page_id":"/docs/components/empty","type":"heading","tags":[],"url":"/docs/components/empty#a-block-that-says-one-thing","content":"A block that says one thing"},"901":{"id":"/docs/components/empty#8","page_id":"/docs/components/empty","type":"heading","tags":[],"url":"/docs/components/empty#in-the-terminal","content":"In the terminal"},"902":{"id":"/docs/components/empty#9","page_id":"/docs/components/empty","type":"heading","tags":[],"url":"/docs/components/empty#api","content":"API"},"903":{"id":"/docs/components/empty#10","page_id":"/docs/components/empty","tags":[],"type":"text","url":"/docs/components/empty#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"904":{"id":"/docs/components/empty#11","page_id":"/docs/components/empty","tags":[],"type":"text","url":"/docs/components/empty#usage","content":"The examples draw icons with `Icon` from `lib/ui/icons`; see Icons for adding it and picking a size and color."},"905":{"id":"/docs/components/empty#12","page_id":"/docs/components/empty","tags":[],"type":"text","url":"/docs/components/empty#composition","content":"Use the following composition to build an `Empty`:"},"906":{"id":"/docs/components/empty#13","page_id":"/docs/components/empty","tags":[],"type":"text","url":"/docs/components/empty#with-what-the-reader-can-do","content":"`EmptyContent` holds the actions under the words: a button, a field, a link. The block takes the\nroom its parent leaves it (`flexGrow: 1`), so a list that ends in an empty state fills its pane."},"907":{"id":"/docs/components/empty#14","page_id":"/docs/components/empty","tags":[],"type":"text","url":"/docs/components/empty#the-apps-own-art","content":"`variant=\"default\"` is the media as the app draws it — an `Avatar`, an illustration, an `Icon`\ndrawn large — with no box around it. `variant=\"icon\"` is the square of the muted fill with a\nsurface's corners, an icon of `EMPTY_ICON` (24 points) in it."},"908":{"id":"/docs/components/empty#15","page_id":"/docs/components/empty","tags":[],"type":"text","url":"/docs/components/empty#a-block-that-says-one-thing","content":"The parts are optional: a line on its own is centered in the room the block has."},"909":{"id":"/docs/components/empty#16","page_id":"/docs/components/empty","tags":[],"type":"text","url":"/docs/components/empty#in-the-terminal","content":"A terminal draws the block as its lines: no padding, one Cell row between the words and the\nactions, the title and the description as plain text."},"910":{"id":"/docs/components/empty#17","page_id":"/docs/components/empty","tags":[],"type":"text","url":"/docs/components/empty#api","content":"| Part    | Props                 | Description                                      |\n| ------- | --------------------- | ------------------------------------------------ |\n| `Empty` | every `nsh` View prop | A centered block that takes the room it is given |","table":"table-0"},"911":{"id":"/docs/components/empty#18","page_id":"/docs/components/empty","tags":[],"type":"text","url":"/docs/components/empty#api","content":"| Part          | Props                 | Description                      |\n| ------------- | --------------------- | -------------------------------- |\n| `EmptyHeader` | every `nsh` View prop | The media and the words under it |","table":"table-0"},"912":{"id":"/docs/components/empty#19","page_id":"/docs/components/empty","tags":[],"type":"text","url":"/docs/components/empty#api","content":"| Part         | Props                            | Description     |\n| ------------ | -------------------------------- | --------------- |\n| `EmptyMedia` | `variant`; every `nsh` View prop | The media's box |","table":"table-0"},"913":{"id":"/docs/components/empty#20","page_id":"/docs/components/empty","tags":[],"type":"text","url":"/docs/components/empty#api","content":"| Part         | Props                 | Description                              |\n| ------------ | --------------------- | ---------------------------------------- |\n| `EmptyTitle` | every `nsh` Text prop | The line that says there is nothing here |","table":"table-0"},"914":{"id":"/docs/components/empty#21","page_id":"/docs/components/empty","tags":[],"type":"text","url":"/docs/components/empty#api","content":"| Part               | Props                 | Description                              |\n| ------------------ | --------------------- | ---------------------------------------- |\n| `EmptyDescription` | every `nsh` Text prop | The line under the title, a step quieter |","table":"table-0"},"915":{"id":"/docs/components/empty#22","page_id":"/docs/components/empty","tags":[],"type":"text","url":"/docs/components/empty#api","content":"| Part           | Props                 | Description                     |\n| -------------- | --------------------- | ------------------------------- |\n| `EmptyContent` | every `nsh` View prop | What the reader can do about it |","table":"table-0"},"916":{"id":"/docs/components/empty#23","page_id":"/docs/components/empty","tags":[],"type":"text","url":"/docs/components/empty#api","content":"Every prop of `nsh` View passes through on `Empty`,\n`EmptyHeader`, `EmptyMedia` and `EmptyContent`, and every prop of\n`nsh` Text on `EmptyTitle` and `EmptyDescription`; `style` goes\nover the look's on each."},"917":{"id":"/docs/components/empty#24","page_id":"/docs/components/empty","tags":[],"type":"text","url":"/docs/components/empty#api","content":"| Prop      | Type                  | Default   |\n| --------- | --------------------- | --------- |\n| `variant` | `\"default\" \\| \"icon\"` | `default` |","table":"table-1"},"918":{"id":"/docs/components/empty#25","page_id":"/docs/components/empty","tags":[],"type":"text","url":"/docs/components/empty#api","content":"The block is a centered column padded 24, its header a step of 8 apart from its content, the words\nand the actions no wider than 384 points. The title is medium at `body + 2` (15 points with a\npointer, 17 on a touch screen), the description the body's size in the muted ink, both centered.\n`EMPTY_ICON` is the size an icon takes in the `icon` variant."},"919":{"id":"/docs/components/field","page_id":"/docs/components/field","type":"page","content":"Field","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/field"},"920":{"id":"/docs/components/field#0","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field","content":"A set of fields under a legend: a label, its control, a description and errors that are read out."},"921":{"id":"/docs/components/field#1","page_id":"/docs/components/field","type":"heading","tags":[],"url":"/docs/components/field#installation","content":"Installation"},"922":{"id":"/docs/components/field#2","page_id":"/docs/components/field","type":"heading","tags":[],"url":"/docs/components/field#usage","content":"Usage"},"923":{"id":"/docs/components/field#3","page_id":"/docs/components/field","type":"heading","tags":[],"url":"/docs/components/field#composition","content":"Composition"},"924":{"id":"/docs/components/field#4","page_id":"/docs/components/field","type":"heading","tags":[],"url":"/docs/components/field#examples","content":"Examples"},"925":{"id":"/docs/components/field#5","page_id":"/docs/components/field","type":"heading","tags":[],"url":"/docs/components/field#vertical-and-horizontal","content":"Vertical and horizontal"},"926":{"id":"/docs/components/field#6","page_id":"/docs/components/field","type":"heading","tags":[],"url":"/docs/components/field#responsive","content":"Responsive"},"927":{"id":"/docs/components/field#7","page_id":"/docs/components/field","type":"heading","tags":[],"url":"/docs/components/field#a-group-of-choices","content":"A group of choices"},"928":{"id":"/docs/components/field#8","page_id":"/docs/components/field","type":"heading","tags":[],"url":"/docs/components/field#separators","content":"Separators"},"929":{"id":"/docs/components/field#9","page_id":"/docs/components/field","type":"heading","tags":[],"url":"/docs/components/field#errors","content":"Errors"},"930":{"id":"/docs/components/field#10","page_id":"/docs/components/field","type":"heading","tags":[],"url":"/docs/components/field#api","content":"API"},"931":{"id":"/docs/components/field#11","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"932":{"id":"/docs/components/field#12","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#usage","content":"`FieldSet` holds a legend and the fields under it; `FieldGroup` holds the fields themselves, 16\npoints apart. `Field` is one label and its control. A control that carries its own label (a\n`Checkbox` with children, a `Switch` with children) needs no `Field`: put it in the group as it is."},"933":{"id":"/docs/components/field#13","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#composition","content":"Use the following composition to build a `FieldSet`:"},"934":{"id":"/docs/components/field#14","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#vertical-and-horizontal","content":"`orientation` defaults to `vertical`: the label over the control. `horizontal` puts them on one\nrow, the label as wide as its text and the control taking the rest."},"935":{"id":"/docs/components/field#15","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#vertical-and-horizontal","content":"`FieldContent` stacks a label and its description (or an input and its error) beside the control\nof a horizontal field. A label inside `FieldContent` keeps the label's width rather than the\nroom left by the control, whatever the field's orientation."},"936":{"id":"/docs/components/field#16","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#vertical-and-horizontal","content":"A label is not associated with its control: NSH has no `<label for>`, so a screen reader hears the\ncontrol's own `accessibilityLabel`, then the `FieldLabel` as separate text. Give the control the\nsame words: `<Input accessibilityLabel=\"Email\" />` beside `<FieldLabel>Email</FieldLabel>`. A\ncontrol that carries its own label (`<Checkbox>Hard disks</Checkbox>`) needs neither."},"937":{"id":"/docs/components/field#17","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#responsive","content":"`orientation=\"responsive\"` is `vertical` in a narrow window — a phone, or a narrow desktop\nwindow, under 600 points — and `horizontal` above it (`narrowWindow`)."},"938":{"id":"/docs/components/field#18","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#a-group-of-choices","content":"A legend one step smaller over a group of checkboxes or switches: `variant=\"label\"`."},"939":{"id":"/docs/components/field#19","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#separators","content":"A `FieldSeparator` is a hairline between fields; with children it is a hairline broken by its word."},"940":{"id":"/docs/components/field#20","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#errors","content":"`FieldError` shows `errors`' messages — as many as there are, each distinct message once — or its\n`children` when they say more. With neither it draws nothing."},"941":{"id":"/docs/components/field#21","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#errors","content":"An error is announced where the platform does it by itself. `FieldError` is a view with\n`role=\"alert\"` (macOS and the web read it when it appears) and TalkBack's live region\n(`accessibilityLiveRegion: \"assertive\"` on Android). iOS has no live region: `UIAccessibility`'s\nannouncement is the app's call, and NSH does not expose it — put the message in the control's\n`accessibilityHint` there as well if it must be heard the moment it appears. Mark the control\ninvalid, not just the field: pass `invalid` to the control (an `Input`, a `Select`'s trigger),\nbecause `role=\"alert\"` tells a reader that something is wrong, not which field."},"942":{"id":"/docs/components/field#22","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#api","content":"| Part       | Props           | Description                         |\n| ---------- | --------------- | ----------------------------------- |\n| `FieldSet` | every view prop | `role=\"group\"`, named by its legend |","table":"table-0"},"943":{"id":"/docs/components/field#23","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#api","content":"| Part          | Props                                                         | Description                                   |\n| ------------- | ------------------------------------------------------------- | --------------------------------------------- |\n| `FieldLegend` | `variant`: `\"legend\"` (default) or `\"label\"`; every text prop | The set's legend, one step smaller as a label |","table":"table-0"},"944":{"id":"/docs/components/field#24","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#api","content":"| Part         | Props           | Description                         |\n| ------------ | --------------- | ----------------------------------- |\n| `FieldGroup` | every view prop | A column of fields, 16 points apart |","table":"table-0"},"945":{"id":"/docs/components/field#25","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#api","content":"| Part    | Props                                                                          | Description                               |\n| ------- | ------------------------------------------------------------------------------ | ----------------------------------------- |\n| `Field` | `orientation`: `\"vertical\"`, `\"horizontal\"` or `\"responsive\"`; every view prop | One label and its control, `role=\"group\"` |","table":"table-0"},"946":{"id":"/docs/components/field#26","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#api","content":"| Part           | Props           | Description                       |\n| -------------- | --------------- | --------------------------------- |\n| `FieldContent` | every view prop | A column that takes the room left |","table":"table-0"},"947":{"id":"/docs/components/field#27","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#api","content":"| Part         | Props           | Description                                               |\n| ------------ | --------------- | --------------------------------------------------------- |\n| `FieldLabel` | every text prop | The control's visible name, in a row, as wide as its text |","table":"table-0"},"948":{"id":"/docs/components/field#28","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#api","content":"| Part         | Props           | Description                     |\n| ------------ | --------------- | ------------------------------- |\n| `FieldTitle` | every text prop | A label over a group of choices |","table":"table-0"},"949":{"id":"/docs/components/field#29","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#api","content":"| Part               | Props           | Description                                      |\n| ------------------ | --------------- | ------------------------------------------------ |\n| `FieldDescription` | every text prop | The word under the label (`density.note`, muted) |","table":"table-0"},"950":{"id":"/docs/components/field#30","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#api","content":"| Part             | Props                                                       | Description               |\n| ---------------- | ----------------------------------------------------------- | ------------------------- |\n| `FieldSeparator` | `children`: the word between the hairlines; every view prop | A hairline between fields |","table":"table-0"},"951":{"id":"/docs/components/field#31","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#api","content":"| Part         | Props                                     | Description                                       |\n| ------------ | ----------------------------------------- | ------------------------------------------------- |\n| `FieldError` | `errors`, `role=\"alert\"`; every view prop | The messages, read out where the platform does it |","table":"table-0"},"952":{"id":"/docs/components/field#32","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#api","content":"Every view prop passes through the parts drawn as views, and every text prop the parts drawn as\ntexts. `style` goes over the look's, so a width or a gap on a part wins."},"953":{"id":"/docs/components/field#33","page_id":"/docs/components/field","tags":[],"type":"text","url":"/docs/components/field#api","content":"`FieldError`'s `errors` is `Array<{ message?: string } | undefined>`, as a form library reports them\n(a field may collect several). `fieldFamilyLook()` is exported for a field the app draws itself —\nthe same look without the parts; it is not `fieldLook()`, which is the input's well."},"954":{"id":"/docs/components/hover-card","page_id":"/docs/components/hover-card","type":"page","content":"Hover Card","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/hover-card"},"955":{"id":"/docs/components/hover-card#0","page_id":"/docs/components/hover-card","tags":[],"type":"text","url":"/docs/components/hover-card","content":"A preview card that grows from its trigger, on the shared popover surface."},"956":{"id":"/docs/components/hover-card#1","page_id":"/docs/components/hover-card","type":"heading","tags":[],"url":"/docs/components/hover-card#installation","content":"Installation"},"957":{"id":"/docs/components/hover-card#2","page_id":"/docs/components/hover-card","type":"heading","tags":[],"url":"/docs/components/hover-card#usage","content":"Usage"},"958":{"id":"/docs/components/hover-card#3","page_id":"/docs/components/hover-card","type":"heading","tags":[],"url":"/docs/components/hover-card#composition","content":"Composition"},"959":{"id":"/docs/components/hover-card#4","page_id":"/docs/components/hover-card","type":"heading","tags":[],"url":"/docs/components/hover-card#examples","content":"Examples"},"960":{"id":"/docs/components/hover-card#5","page_id":"/docs/components/hover-card","type":"heading","tags":[],"url":"/docs/components/hover-card#compact","content":"Compact"},"961":{"id":"/docs/components/hover-card#6","page_id":"/docs/components/hover-card","type":"heading","tags":[],"url":"/docs/components/hover-card#placement-and-delays","content":"Placement and delays"},"962":{"id":"/docs/components/hover-card#7","page_id":"/docs/components/hover-card","type":"heading","tags":[],"url":"/docs/components/hover-card#a-trigger-of-your-own-or-a-disabled-one","content":"A trigger of your own, or a disabled one"},"963":{"id":"/docs/components/hover-card#8","page_id":"/docs/components/hover-card","type":"heading","tags":[],"url":"/docs/components/hover-card#api","content":"API"},"964":{"id":"/docs/components/hover-card#9","page_id":"/docs/components/hover-card","tags":[],"type":"text","url":"/docs/components/hover-card#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"965":{"id":"/docs/components/hover-card#10","page_id":"/docs/components/hover-card","tags":[],"type":"text","url":"/docs/components/hover-card#composition","content":"Use the following composition to build a `HoverCard`:"},"966":{"id":"/docs/components/hover-card#11","page_id":"/docs/components/hover-card","tags":[],"type":"text","url":"/docs/components/hover-card#compact","content":"A line or two: 12 points of padding and 4 between rows."},"967":{"id":"/docs/components/hover-card#12","page_id":"/docs/components/hover-card","tags":[],"type":"text","url":"/docs/components/hover-card#placement-and-delays","content":"The base defaults are 600 ms before it opens and 300 ms before it closes."},"968":{"id":"/docs/components/hover-card#13","page_id":"/docs/components/hover-card","tags":[],"type":"text","url":"/docs/components/hover-card#a-trigger-of-your-own-or-a-disabled-one","content":"A string child is a `Button` (`variant`, `secondary` by default). A single element child is\nthe trigger itself: its look, `testID`, name and own press and hover styles stay, and\n`nsh/base` adds the open state (`expandedStyle`) to it. `variant` and `disabled` shape a\nstring child; an element brings its own `disabled`, and the root's `disabled` still keeps\nthe card closed."},"969":{"id":"/docs/components/hover-card#14","page_id":"/docs/components/hover-card","tags":[],"type":"text","url":"/docs/components/hover-card#api","content":"| Part        | Props                                                                                  | Description                                 |\n| ----------- | -------------------------------------------------------------------------------------- | ------------------------------------------- |\n| `HoverCard` | `open` / `defaultOpen`, `openDelay`, `closeDelay`, `onOpenChange`, `onOpen`, `onClose` | Open state, the delays and the trigger slot |","table":"table-0"},"970":{"id":"/docs/components/hover-card#15","page_id":"/docs/components/hover-card","tags":[],"type":"text","url":"/docs/components/hover-card#api","content":"| Part               | Props                                                                  | Description                                       |\n| ------------------ | ---------------------------------------------------------------------- | ------------------------------------------------- |\n| `HoverCardTrigger` | `children`, `variant` (a string child's `Button`), `disabled`, `style` | What the card previews; an element is the trigger |","table":"table-0"},"971":{"id":"/docs/components/hover-card#16","page_id":"/docs/components/hover-card","tags":[],"type":"text","url":"/docs/components/hover-card#api","content":"| Part               | Props                                                                   | Description      |\n| ------------------ | ----------------------------------------------------------------------- | ---------------- |\n| `HoverCardContent` | `compact`, `width`, and base's `placement`, `align`, `offset`, `margin` | The preview card |","table":"table-0"},"972":{"id":"/docs/components/hover-card#17","page_id":"/docs/components/hover-card","tags":[],"type":"text","url":"/docs/components/hover-card#api","content":"The root owns the open flag and the two delays (`openDelay`, 600 ms by default; `closeDelay`, 300):\n`Infinity` in either makes the card wait for the app, which is how a card a press opens keeps still\nunder the pointer. `HoverCardContent` mounts\n`nsh/base` HoverCard and every base prop passes through\nexcept the open state, the delays and the lifecycle callbacks, which the root owns. Its children\ncome in on a `PopIn` with `popoverLook`."},"973":{"id":"/docs/components/image-viewer","page_id":"/docs/components/image-viewer","type":"page","content":"ImageViewer","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/image-viewer"},"974":{"id":"/docs/components/image-viewer#0","page_id":"/docs/components/image-viewer","tags":[],"type":"text","url":"/docs/components/image-viewer","content":"One image full screen over a dimmed ground, fitted, with pinch to zoom, drag to pan and swipe down to close."},"975":{"id":"/docs/components/image-viewer#1","page_id":"/docs/components/image-viewer","type":"heading","tags":[],"url":"/docs/components/image-viewer#installation","content":"Installation"},"976":{"id":"/docs/components/image-viewer#2","page_id":"/docs/components/image-viewer","type":"heading","tags":[],"url":"/docs/components/image-viewer#usage","content":"Usage"},"977":{"id":"/docs/components/image-viewer#3","page_id":"/docs/components/image-viewer","type":"heading","tags":[],"url":"/docs/components/image-viewer#examples","content":"Examples"},"978":{"id":"/docs/components/image-viewer#4","page_id":"/docs/components/image-viewer","type":"heading","tags":[],"url":"/docs/components/image-viewer#an-image-viewer","content":"An image viewer"},"979":{"id":"/docs/components/image-viewer#5","page_id":"/docs/components/image-viewer","type":"heading","tags":[],"url":"/docs/components/image-viewer#from-a-text-view","content":"From a text view"},"980":{"id":"/docs/components/image-viewer#6","page_id":"/docs/components/image-viewer","type":"heading","tags":[],"url":"/docs/components/image-viewer#api","content":"API"},"981":{"id":"/docs/components/image-viewer#7","page_id":"/docs/components/image-viewer","tags":[],"type":"text","url":"/docs/components/image-viewer#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"982":{"id":"/docs/components/image-viewer#8","page_id":"/docs/components/image-viewer","tags":[],"type":"text","url":"/docs/components/image-viewer#usage","content":"The viewer is open while `image` is set; `onClose` is where it asks to close (the close button, Escape, the back button, a press on the ground, a swipe down), so set `image` back to `null` there. A pinch zooms to 4×, a double tap or click to 2.5× at the point, a drag pans the zoomed image, and at 1× a drag down closes it. The `alt` text is the caption and the image's name for screen readers."},"983":{"id":"/docs/components/image-viewer#9","page_id":"/docs/components/image-viewer","tags":[],"type":"text","url":"/docs/components/image-viewer#an-image-viewer","content":"A row of photographs, each a `Pressable` that sets the image; one viewer serves them all."},"984":{"id":"/docs/components/image-viewer#10","page_id":"/docs/components/image-viewer","tags":[],"type":"text","url":"/docs/components/image-viewer#from-a-text-view","content":"`TextView` reports the image that was pressed (`onImagePress`) in the shape the viewer takes; see **Images that open** there."},"985":{"id":"/docs/components/image-viewer#11","page_id":"/docs/components/image-viewer","tags":[],"type":"text","url":"/docs/components/image-viewer#api","content":"`ImageViewer` is a `Dialog` as a page (`dialogPage`) with its body given whole (`scroll={false}`), so every prop of `DialogContent` passes through but `width`, `scroll` and `children`; `style` goes over the page's, and `animation` defaults to `fade`. Gestures are `nsh` View's `pinch` and `pan`; behavior and accessibility are `nsh/base` Dialog's."},"986":{"id":"/docs/components/image-viewer#12","page_id":"/docs/components/image-viewer","tags":[],"type":"text","url":"/docs/components/image-viewer#api","content":"| Part          | Props                                                                     | Description                                                                        |\n| ------------- | ------------------------------------------------------------------------- | ---------------------------------------------------------------------------------- |\n| `ImageViewer` | `image`: `{ src: string; alt?: string } \\| null`; `onClose`: `() => void` | The viewer, open while `image` is set. The image stays while the dialog fades out. |","table":"table-0"},"987":{"id":"/docs/components/image-viewer#13","page_id":"/docs/components/image-viewer","tags":[],"type":"text","url":"/docs/components/image-viewer#api","content":"There are no `ImageViewerClose` or `ImageViewerCaption` parts. The close button is always there and the caption is always the `alt`, so a part would only be a place to put what the viewer already draws. A gallery of several images in one viewer is the app's: set `image` to the next one."},"988":{"id":"/docs/components/image-viewer#14","page_id":"/docs/components/image-viewer","tags":[],"type":"text","url":"/docs/components/image-viewer#api","content":"The ink is `on-media` and the ground is the theme's `media`, the pair that stays dark in either appearance and in every theme; the caption strip and the close chip carry a wash of that ink so they read over any photograph."},"989":{"id":"/docs/components/input-group","page_id":"/docs/components/input-group","type":"page","content":"InputGroup","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/input-group"},"990":{"id":"/docs/components/input-group#0","page_id":"/docs/components/input-group","tags":[],"type":"text","url":"/docs/components/input-group","content":"A field's frame around an input and what sits beside it — an icon, a unit, a button."},"991":{"id":"/docs/components/input-group#1","page_id":"/docs/components/input-group","type":"heading","tags":[],"url":"/docs/components/input-group#installation","content":"Installation"},"992":{"id":"/docs/components/input-group#2","page_id":"/docs/components/input-group","type":"heading","tags":[],"url":"/docs/components/input-group#usage","content":"Usage"},"993":{"id":"/docs/components/input-group#3","page_id":"/docs/components/input-group","type":"heading","tags":[],"url":"/docs/components/input-group#composition","content":"Composition"},"994":{"id":"/docs/components/input-group#4","page_id":"/docs/components/input-group","type":"heading","tags":[],"url":"/docs/components/input-group#examples","content":"Examples"},"995":{"id":"/docs/components/input-group#5","page_id":"/docs/components/input-group","type":"heading","tags":[],"url":"/docs/components/input-group#invalid-and-disabled","content":"Invalid and disabled"},"996":{"id":"/docs/components/input-group#6","page_id":"/docs/components/input-group","type":"heading","tags":[],"url":"/docs/components/input-group#an-addon-before-and-after-the-input","content":"An addon before and after the input"},"997":{"id":"/docs/components/input-group#7","page_id":"/docs/components/input-group","type":"heading","tags":[],"url":"/docs/components/input-group#a-unit-after-the-control","content":"A unit after the control"},"998":{"id":"/docs/components/input-group#8","page_id":"/docs/components/input-group","type":"heading","tags":[],"url":"/docs/components/input-group#a-radius-of-your-own","content":"A radius of your own"},"999":{"id":"/docs/components/input-group#9","page_id":"/docs/components/input-group","type":"heading","tags":[],"url":"/docs/components/input-group#addons-over-and-under-the-control","content":"Addons over and under the control"},"1000":{"id":"/docs/components/input-group#10","page_id":"/docs/components/input-group","type":"heading","tags":[],"url":"/docs/components/input-group#buttons-in-a-group","content":"Buttons in a group"},"1001":{"id":"/docs/components/input-group#11","page_id":"/docs/components/input-group","type":"heading","tags":[],"url":"/docs/components/input-group#a-search-field","content":"A search field"},"1002":{"id":"/docs/components/input-group#12","page_id":"/docs/components/input-group","type":"heading","tags":[],"url":"/docs/components/input-group#a-message-composer","content":"A message composer"},"1003":{"id":"/docs/components/input-group#13","page_id":"/docs/components/input-group","type":"heading","tags":[],"url":"/docs/components/input-group#when-to-use-a-group-and-when-an-input","content":"When to use a group, and when an `Input`"},"1004":{"id":"/docs/components/input-group#14","page_id":"/docs/components/input-group","type":"heading","tags":[],"url":"/docs/components/input-group#focus-from-code","content":"Focus from code"},"1005":{"id":"/docs/components/input-group#15","page_id":"/docs/components/input-group","type":"heading","tags":[],"url":"/docs/components/input-group#the-look-alone","content":"The look alone"},"1006":{"id":"/docs/components/input-group#16","page_id":"/docs/components/input-group","type":"heading","tags":[],"url":"/docs/components/input-group#api","content":"API"},"1007":{"id":"/docs/components/input-group#17","page_id":"/docs/components/input-group","tags":[],"type":"text","url":"/docs/components/input-group#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1008":{"id":"/docs/components/input-group#18","page_id":"/docs/components/input-group","tags":[],"type":"text","url":"/docs/components/input-group#usage","content":"The examples draw icons with `Icon` from `lib/ui/icons`; see Icons for adding it and picking a size and color."},"1009":{"id":"/docs/components/input-group#19","page_id":"/docs/components/input-group","tags":[],"type":"text","url":"/docs/components/input-group#usage","content":"The group draws the field: its fill, its edge and, while the input inside has the keys, the focus edge and its ring. The input inside draws none of that, so a group has one frame, not two."},"1010":{"id":"/docs/components/input-group#20","page_id":"/docs/components/input-group","tags":[],"type":"text","url":"/docs/components/input-group#composition","content":"Use the following composition to build an `InputGroup`:"},"1011":{"id":"/docs/components/input-group#21","page_id":"/docs/components/input-group","tags":[],"type":"text","url":"/docs/components/input-group#invalid-and-disabled","content":"A disabled group disables what it holds and dims it."},"1012":{"id":"/docs/components/input-group#22","page_id":"/docs/components/input-group","tags":[],"type":"text","url":"/docs/components/input-group#an-addon-before-and-after-the-input","content":"`InputGroupAddon` holds an icon, a word or a button at the start or at the end of the group's line (`align`: `inline-start`, `inline-end`). A press on an addon puts the keys in the input, so the magnifier works as part of the field; a press on a button in it is the button's alone."},"1013":{"id":"/docs/components/input-group#23","page_id":"/docs/components/input-group","tags":[],"type":"text","url":"/docs/components/input-group#a-radius-of-your-own","content":"Write the radius and the padding on the group. The focus ring is drawn on the group's edge, so it follows the radius: a composer on 22 points lights a 22-point ring, with the input and its button inside it."},"1014":{"id":"/docs/components/input-group#24","page_id":"/docs/components/input-group","tags":[],"type":"text","url":"/docs/components/input-group#addons-over-and-under-the-control","content":"`block-start` and `block-end` take a line of their own, above or below the input's: a word over a note, a count under it."},"1015":{"id":"/docs/components/input-group#25","page_id":"/docs/components/input-group","tags":[],"type":"text","url":"/docs/components/input-group#buttons-in-a-group","content":"`InputGroupButton` sizes a button inside a group: `xs` is a `sm` button (24 points high with a\npointer), `sm` a `default` one (28), and `icon-xs` / `icon-sm` a square of that height. `variant`\nis a button's, `ghost` unless set."},"1016":{"id":"/docs/components/input-group#26","page_id":"/docs/components/input-group","tags":[],"type":"text","url":"/docs/components/input-group#a-search-field","content":"A magnifier before the control, the work after it: a spinner while the query settles, then a button\nthat clears it. Search on what the field settles on, not on every key — 300 ms after the last one\nis enough, and the spinner says the search is under way. Put the matches under the field, with the\nletters that matched in the accent, so the answer reads as the field's."},"1017":{"id":"/docs/components/input-group#27","page_id":"/docs/components/input-group","tags":[],"type":"text","url":"/docs/components/input-group#a-message-composer","content":"The composer of a chat: a `block-end` addon under the textarea holds a round button that opens\nwhat can be added, the key hint, and the send button. Give the group the composer's radius and\npadding (`borderRadius: 22`, `padding: 6`), and let the textarea grow to five lines with\n`grownFieldHeight` — an `Input` takes the lines' height from `onContentSizeChange`. Return sends\nand Shift-Return breaks the line under a keyboard (`submitBehavior=\"submit\"` on desktop); on a\ntouch screen Return breaks the line, and the button sends."},"1018":{"id":"/docs/components/input-group#28","page_id":"/docs/components/input-group","tags":[],"type":"text","url":"/docs/components/input-group#a-message-composer","content":"While a reply streams, the send button becomes a stop: the same press that sent the message stops\nthe answer. The plus turns a quarter as the menu under it opens, so the same button shows it can be\nclosed."},"1019":{"id":"/docs/components/input-group#29","page_id":"/docs/components/input-group","tags":[],"type":"text","url":"/docs/components/input-group#when-to-use-a-group-and-when-an-input","content":"A frame of your own around an input is a group. Do not wrap a `variant=\"ghost\"` `Input` in a `View` with a border: the ghost input keeps its own focus edge and ring, so the frame ends up with a second edge inside it that does not follow the frame's radius."},"1020":{"id":"/docs/components/input-group#30","page_id":"/docs/components/input-group","tags":[],"type":"text","url":"/docs/components/input-group#focus-from-code","content":"A ref on the control focuses it from code — a shortcut, a request to focus a draft. The ref is the control's, not the group's."},"1021":{"id":"/docs/components/input-group#31","page_id":"/docs/components/input-group","tags":[],"type":"text","url":"/docs/components/input-group#the-look-alone","content":"`inputGroupLook` is the frame's props and `inputGroupControlLook` the control's, for a `nsh/base` control of your own. This is what `InputGroup` wraps."},"1022":{"id":"/docs/components/input-group#32","page_id":"/docs/components/input-group","tags":[],"type":"text","url":"/docs/components/input-group#api","content":"| Part         | Props                                                                              | Description                        |\n| ------------ | ---------------------------------------------------------------------------------- | ---------------------------------- |\n| `InputGroup` | `invalid`; every `View` prop; `class`, `style` and `disabledStyle` over the look's | The field's frame around its parts |","table":"table-0"},"1023":{"id":"/docs/components/input-group#33","page_id":"/docs/components/input-group","tags":[],"type":"text","url":"/docs/components/input-group#api","content":"| Part              | Props                                                                                                                   | Description                                    |\n| ----------------- | ----------------------------------------------------------------------------------------------------------------------- | ---------------------------------------------- |\n| `InputGroupAddon` | `align`: `\"inline-start\" \\| \"inline-end\" \\| \"block-start\" \\| \"block-end\"` (default `\"inline-start\"`); every `View` prop | An icon, a word or a button beside the control |","table":"table-0"},"1024":{"id":"/docs/components/input-group#34","page_id":"/docs/components/input-group","tags":[],"type":"text","url":"/docs/components/input-group#api","content":"| Part             | Props                         | Description                           |\n| ---------------- | ----------------------------- | ------------------------------------- |\n| `InputGroupText` | `children`; every `View` prop | A word or an icon in the field's type |","table":"table-0"},"1025":{"id":"/docs/components/input-group#35","page_id":"/docs/components/input-group","tags":[],"type":"text","url":"/docs/components/input-group#api","content":"| Part               | Props                                                                                                                                                                         | Description                |\n| ------------------ | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | -------------------------- |\n| `InputGroupButton` | `size`: `\"xs\" \\| \"sm\" \\| \"icon-xs\" \\| \"icon-sm\"` (default `\"xs\"`), `variant`: `\"default\" \\| \"secondary\" \\| \"ghost\" \\| \"destructive\"` (default `\"ghost\"`); every `Button` prop | A button sized for a group |","table":"table-0"},"1026":{"id":"/docs/components/input-group#36","page_id":"/docs/components/input-group","tags":[],"type":"text","url":"/docs/components/input-group#api","content":"| Part              | Props                                       | Description                     |\n| ----------------- | ------------------------------------------- | ------------------------------- |\n| `InputGroupInput` | every `nsh/base` Input prop, `ref` included | The group's single-line control |","table":"table-0"},"1027":{"id":"/docs/components/input-group#37","page_id":"/docs/components/input-group","tags":[],"type":"text","url":"/docs/components/input-group#api","content":"| Part                 | Props                                       | Description                   |\n| -------------------- | ------------------------------------------- | ----------------------------- |\n| `InputGroupTextarea` | every `nsh/base` Input prop, `ref` included | The group's multiline control |","table":"table-0"},"1028":{"id":"/docs/components/input-group#38","page_id":"/docs/components/input-group","tags":[],"type":"text","url":"/docs/components/input-group#api","content":"`InputGroup` is a view: every `View` prop passes through. `class`, `style` and `disabledStyle` go over its look's."},"1029":{"id":"/docs/components/input-group#39","page_id":"/docs/components/input-group","tags":[],"type":"text","url":"/docs/components/input-group#api","content":"| Prop      | Type      | Default | What it does                                  |\n| --------- | --------- | ------- | --------------------------------------------- |\n| `invalid` | `boolean` |         | Edged in the danger tone, its focus edge too. |","table":"table-1"},"1030":{"id":"/docs/components/input-group#40","page_id":"/docs/components/input-group","tags":[],"type":"text","url":"/docs/components/input-group#api","content":"| Prop    | Type        | Default | What it does                                                         |\n| ------- | ----------- | ------- | -------------------------------------------------------------------- |\n| `style` | `ViewStyle` |         | Over the look's: the radius, the padding and the width of the group. |","table":"table-1"},"1031":{"id":"/docs/components/input-group#41","page_id":"/docs/components/input-group","tags":[],"type":"text","url":"/docs/components/input-group#api","content":"`InputGroupInput` and `InputGroupTextarea` take every prop of `nsh/base` Input, `ref` included: `value`, `onChange`, `placeholder`, `keyboardType`, `maxLength`, `readonly`, `disabled` and the rest. `InputGroupTextarea` is the multiline one. Their `style` goes over the look's. A `ref` is the control's `InputRef`: `ref.focus()` puts the keys in it from code (a shortcut, a request to focus a draft)."},"1032":{"id":"/docs/components/input","page_id":"/docs/components/input","type":"page","content":"Input","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/input"},"1033":{"id":"/docs/components/input#0","page_id":"/docs/components/input","tags":[],"type":"text","url":"/docs/components/input","content":"A text field — sunk, ghost, multiline, masked, or invalid."},"1034":{"id":"/docs/components/input#1","page_id":"/docs/components/input","type":"heading","tags":[],"url":"/docs/components/input#installation","content":"Installation"},"1035":{"id":"/docs/components/input#2","page_id":"/docs/components/input","type":"heading","tags":[],"url":"/docs/components/input#usage","content":"Usage"},"1036":{"id":"/docs/components/input#3","page_id":"/docs/components/input","type":"heading","tags":[],"url":"/docs/components/input#examples","content":"Examples"},"1037":{"id":"/docs/components/input#4","page_id":"/docs/components/input","type":"heading","tags":[],"url":"/docs/components/input#variant","content":"Variant"},"1038":{"id":"/docs/components/input#5","page_id":"/docs/components/input","type":"heading","tags":[],"url":"/docs/components/input#invalid","content":"Invalid"},"1039":{"id":"/docs/components/input#6","page_id":"/docs/components/input","type":"heading","tags":[],"url":"/docs/components/input#read-only-and-disabled","content":"Read-only and disabled"},"1040":{"id":"/docs/components/input#7","page_id":"/docs/components/input","type":"heading","tags":[],"url":"/docs/components/input#multiline","content":"Multiline"},"1041":{"id":"/docs/components/input#8","page_id":"/docs/components/input","type":"heading","tags":[],"url":"/docs/components/input#a-password-with-a-strength-meter","content":"A password with a strength meter"},"1042":{"id":"/docs/components/input#9","page_id":"/docs/components/input","type":"heading","tags":[],"url":"/docs/components/input#ghost","content":"Ghost"},"1043":{"id":"/docs/components/input#10","page_id":"/docs/components/input","type":"heading","tags":[],"url":"/docs/components/input#api","content":"API"},"1044":{"id":"/docs/components/input#11","page_id":"/docs/components/input","tags":[],"type":"text","url":"/docs/components/input#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1045":{"id":"/docs/components/input#12","page_id":"/docs/components/input","tags":[],"type":"text","url":"/docs/components/input#variant","content":"No fill and no edge until the keys are in it, with the text, the placeholder and the focus ring as they are: a search field, a title that turns into a field. Disabled still dims, and invalid still shows the danger edge."},"1046":{"id":"/docs/components/input#13","page_id":"/docs/components/input","tags":[],"type":"text","url":"/docs/components/input#variant","content":"A ghost input is the field itself: it keeps its own focus edge and ring, so it is not what a frame you draw around it wants. For an input in a frame of your own — a search field with a magnifier, a composer with a send button — use `InputGroup` instead: the group draws the frame and the input in it draws nothing, so the focus ring follows the group's radius."},"1047":{"id":"/docs/components/input#14","page_id":"/docs/components/input","tags":[],"type":"text","url":"/docs/components/input#multiline","content":"`multiline` makes the same field several lines: the content starts at the top, the box is at least one line tall, and Return writes a line break."},"1048":{"id":"/docs/components/input#15","page_id":"/docs/components/input","tags":[],"type":"text","url":"/docs/components/input#multiline","content":"`invalid`, `readonly` and `disabled` are the single-line field's, and a multiline one takes them the same way. A composer that sends on Return takes `submitBehavior=\"submit\"` and keeps Shift + Return for a break:"},"1049":{"id":"/docs/components/input#16","page_id":"/docs/components/input","tags":[],"type":"text","url":"/docs/components/input#multiline","content":"The box grows only as the app sizes it: `nsh/base`'s multi-line input reports the size of its text (`onContentSizeChange`) rather than sizing itself to it, and the look keeps only a least height — one line's, so a multiline field sits as tall as a one-line input until the app says otherwise. Keep the reported height plus the room the look keeps inside the box:"},"1050":{"id":"/docs/components/input#17","page_id":"/docs/components/input","tags":[],"type":"text","url":"/docs/components/input#multiline","content":"A least height of your own is how the box starts taller than one line, since `style` goes over the look's — 64 points:"},"1051":{"id":"/docs/components/input#18","page_id":"/docs/components/input","tags":[],"type":"text","url":"/docs/components/input#a-password-with-a-strength-meter","content":"A password field that says what it asks for and how far the reader has got: four segments, one for\neach rule the password meets, the word for the score, and the rules under the field — a dot until\nit is met, a tick on the tone that says it is. Score the field as it is typed, and score nothing as\nnothing: an empty field asks for a password rather than calling it weak."},"1052":{"id":"/docs/components/input#19","page_id":"/docs/components/input","tags":[],"type":"text","url":"/docs/components/input#a-password-with-a-strength-meter","content":"The segments keep the field's own width — a bar of four parts, each a share of it — and the word\nkeeps a column at the end, so the meter does not reflow as the word changes from `Empty` to\n`Strong`."},"1053":{"id":"/docs/components/input#20","page_id":"/docs/components/input","tags":[],"type":"text","url":"/docs/components/input#api","content":"| Part    | Props                                                                                                                                                                                    | Description                                                   |\n| ------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ------------------------------------------------------------- |\n| `Input` | `variant`: `\"default\" \\| \"ghost\"` (default `\"default\"`), `invalid`: `boolean`, `multiline`: `boolean`; every `nsh/base` Input prop; `class`, `style` and `disabledStyle` over the look's | A text field — `default` or `ghost`, single-line or multiline |","table":"table-0"},"1054":{"id":"/docs/components/input#21","page_id":"/docs/components/input","tags":[],"type":"text","url":"/docs/components/input#api","content":"Every prop of `nsh/base` Input passes through. `class`, `style` and `disabledStyle` go over the look's. Focus and hover edges are classes on the look."},"1055":{"id":"/docs/components/input#22","page_id":"/docs/components/input","tags":[],"type":"text","url":"/docs/components/input#api","content":"| Prop      | Type           | Default     | What it does                                                                                                   |\n| --------- | -------------- | ----------- | -------------------------------------------------------------------------------------------------------------- |\n| `variant` | `InputVariant` | `\"default\"` | `ghost` draws no fill and no edge until the keys are in it; the text, the placeholder and the focus ring stay. |","table":"table-1"},"1056":{"id":"/docs/components/input#23","page_id":"/docs/components/input","tags":[],"type":"text","url":"/docs/components/input#api","content":"| Prop      | Type      | Default | What it does                                  |\n| --------- | --------- | ------- | --------------------------------------------- |\n| `invalid` | `boolean` |         | Edged in the danger tone, its focus edge too. |","table":"table-1"},"1057":{"id":"/docs/components/input#24","page_id":"/docs/components/input","tags":[],"type":"text","url":"/docs/components/input#api","content":"| Prop        | Type      | Default | What it does                                                                                                     |\n| ----------- | --------- | ------- | ---------------------------------------------------------------------------------------------------------------- |\n| `multiline` | `boolean` | `false` | Several lines: the content starts at the top, the box is at least one line tall, and Return writes a line break. |","table":"table-1"},"1058":{"id":"/docs/components/input#25","page_id":"/docs/components/input","tags":[],"type":"text","url":"/docs/components/input#api","content":"| Prop   | Type                | Default | What it does                                                                                                               |\n| ------ | ------------------- | ------- | -------------------------------------------------------------------------------------------------------------------------- |\n| `grow` | `boolean \\| number` |         | Multiline only. `true` grows with the text up to five lines; a number is that cap. No transition. A `style` `height` wins. |","table":"table-1"},"1059":{"id":"/docs/components/input#26","page_id":"/docs/components/input","tags":[],"type":"text","url":"/docs/components/input#api","content":"| Prop     | Type     | Default | What it does                                                                                                        |\n| -------- | -------- | ------- | ------------------------------------------------------------------------------------------------------------------- |\n| `reject` | `number` |         | Shakes the field each time this becomes a new number. `invalid` only recolours the edge. Less motion plays nothing. |","table":"table-1"},"1060":{"id":"/docs/components/item","page_id":"/docs/components/item","type":"page","content":"Item","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/item"},"1061":{"id":"/docs/components/item#0","page_id":"/docs/components/item","tags":[],"type":"text","url":"/docs/components/item","content":"A row of a list: what sits before its content, a title with a note, and controls after it."},"1062":{"id":"/docs/components/item#1","page_id":"/docs/components/item","type":"heading","tags":[],"url":"/docs/components/item#installation","content":"Installation"},"1063":{"id":"/docs/components/item#2","page_id":"/docs/components/item","type":"heading","tags":[],"url":"/docs/components/item#usage","content":"Usage"},"1064":{"id":"/docs/components/item#3","page_id":"/docs/components/item","type":"heading","tags":[],"url":"/docs/components/item#composition","content":"Composition"},"1065":{"id":"/docs/components/item#4","page_id":"/docs/components/item","type":"heading","tags":[],"url":"/docs/components/item#examples","content":"Examples"},"1066":{"id":"/docs/components/item#5","page_id":"/docs/components/item","type":"heading","tags":[],"url":"/docs/components/item#variant","content":"Variant"},"1067":{"id":"/docs/components/item#6","page_id":"/docs/components/item","type":"heading","tags":[],"url":"/docs/components/item#size","content":"Size"},"1068":{"id":"/docs/components/item#7","page_id":"/docs/components/item","type":"heading","tags":[],"url":"/docs/components/item#media","content":"Media"},"1069":{"id":"/docs/components/item#8","page_id":"/docs/components/item","type":"heading","tags":[],"url":"/docs/components/item#a-row-that-takes-presses","content":"A row that takes presses"},"1070":{"id":"/docs/components/item#9","page_id":"/docs/components/item","type":"heading","tags":[],"url":"/docs/components/item#a-long-list","content":"A long list"},"1071":{"id":"/docs/components/item#10","page_id":"/docs/components/item","type":"heading","tags":[],"url":"/docs/components/item#api","content":"API"},"1072":{"id":"/docs/components/item#11","page_id":"/docs/components/item","tags":[],"type":"text","url":"/docs/components/item#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1073":{"id":"/docs/components/item#12","page_id":"/docs/components/item","tags":[],"type":"text","url":"/docs/components/item#usage","content":"The examples draw icons with `Icon` from `lib/ui/icons`; see Icons for adding it and picking a size and color."},"1074":{"id":"/docs/components/item#13","page_id":"/docs/components/item","tags":[],"type":"text","url":"/docs/components/item#usage","content":"`ItemGroup` is a `role=\"list\"` column of rows, `density.gap` apart; `ItemSeparator` is the hairline\nbetween them. `Item` is the row: `ItemMedia` before its content, `ItemContent` for the title and\nthe note, `ItemActions` for its controls. `ItemHeader` and `ItemFooter` are lines across the whole\nrow — a header above the content, a footer under it."},"1075":{"id":"/docs/components/item#14","page_id":"/docs/components/item","tags":[],"type":"text","url":"/docs/components/item#composition","content":"Use the following composition to build an `Item`:"},"1076":{"id":"/docs/components/item#15","page_id":"/docs/components/item","tags":[],"type":"text","url":"/docs/components/item#variant","content":"`default` draws no surface, for rows split by a separator. `outline` edges the row, for one that\nstands alone. `muted` puts it on a muted fill (`token(\"muted\")`, shadcn's `bg-muted`): a well\nthat reads on a card and on the page, in either appearance, and is still lighter than an edge."},"1077":{"id":"/docs/components/item#16","page_id":"/docs/components/item","tags":[],"type":"text","url":"/docs/components/item#size","content":"`size=\"default\"` has room for a title, a note and a control; `size=\"sm\"` takes four points off each\nside for a single line."},"1078":{"id":"/docs/components/item#17","page_id":"/docs/components/item","tags":[],"type":"text","url":"/docs/components/item#media","content":"`ItemMedia` holds what comes before the content: `default` the app's own (an avatar), `icon` a\nsquare tile with a surface's edge for an icon, `image` a square frame that clips what is put in it.\nAn `Avatar` names its person; an `Icon` is a canvas a reader does not stop at, so the title must\nsay what the icon means."},"1079":{"id":"/docs/components/item#18","page_id":"/docs/components/item","tags":[],"type":"text","url":"/docs/components/item#a-row-that-takes-presses","content":"An `Item` is layout only: it draws a row and takes no presses, so the container decides what a row\ndoes. For a row that is a control — hover fill, keyboard focus, disabled — use the same content on\n`listRow` instead, or wrap it in a view with `onPress` and `role=\"button\"`. `ItemGroup` is\n`role=\"list\"`, but NSH has no `listitem` role, so an `Item` is a plain view and a reader moves\nthrough its text element by element: when the rows can be pressed, mark the pressable view\n`role=\"button\"` and give it an `accessibilityLabel` that says the whole row (or use `listRow`,\nwhich does)."},"1080":{"id":"/docs/components/item#19","page_id":"/docs/components/item","tags":[],"type":"text","url":"/docs/components/item#a-long-list","content":"Contacts as `ItemGroup` rows inside a `List` (`nsh`'s virtualized list), with a heading per letter that sticks to the top until the next one pushes it out. Rows are made as they scroll in, so the list can be as long as the data. `stickyHeaderIndices` names the heading rows; a heading needs an opaque background (the surface's own), or the rows show through it while it sticks."},"1081":{"id":"/docs/components/item#20","page_id":"/docs/components/item","tags":[],"type":"text","url":"/docs/components/item#a-long-list","content":"The heading is the app's: a row of the letter and its count on `colors.card`, 34 points tall. To pull the list down to reload it, put a `RefreshIndicator` over it."},"1082":{"id":"/docs/components/item#21","page_id":"/docs/components/item","tags":[],"type":"text","url":"/docs/components/item#api","content":"| Part        | Props           | Description                                 |\n| ----------- | --------------- | ------------------------------------------- |\n| `ItemGroup` | every view prop | `role=\"list\"`, a column `density.gap` apart |","table":"table-0"},"1083":{"id":"/docs/components/item#22","page_id":"/docs/components/item","tags":[],"type":"text","url":"/docs/components/item#api","content":"| Part            | Props           | Description                          |\n| --------------- | --------------- | ------------------------------------ |\n| `ItemSeparator` | every view prop | A hairline, 4 points above and below |","table":"table-0"},"1084":{"id":"/docs/components/item#23","page_id":"/docs/components/item","tags":[],"type":"text","url":"/docs/components/item#api","content":"| Part   | Props                                                                           | Description |\n| ------ | ------------------------------------------------------------------------------- | ----------- |\n| `Item` | `variant`: `\"default\"`, `\"outline\"` or `\"muted\"`; `size`: `\"default\"` or `\"sm\"` | The row     |","table":"table-0"},"1085":{"id":"/docs/components/item#24","page_id":"/docs/components/item","tags":[],"type":"text","url":"/docs/components/item#api","content":"| Part        | Props                                         | Description                  |\n| ----------- | --------------------------------------------- | ---------------------------- |\n| `ItemMedia` | `variant`: `\"default\"`, `\"icon\"` or `\"image\"` | What sits before the content |","table":"table-0"},"1086":{"id":"/docs/components/item#25","page_id":"/docs/components/item","tags":[],"type":"text","url":"/docs/components/item#api","content":"| Part          | Props           | Description                                 |\n| ------------- | --------------- | ------------------------------------------- |\n| `ItemContent` | every view prop | A column that takes the room the row leaves |","table":"table-0"},"1087":{"id":"/docs/components/item#26","page_id":"/docs/components/item","tags":[],"type":"text","url":"/docs/components/item#api","content":"| Part        | Props           | Description                                  |\n| ----------- | --------------- | -------------------------------------------- |\n| `ItemTitle` | every text prop | The label's size, medium, in the text colour |","table":"table-0"},"1088":{"id":"/docs/components/item#27","page_id":"/docs/components/item","tags":[],"type":"text","url":"/docs/components/item#api","content":"| Part              | Props           | Description                                                                             |\n| ----------------- | --------------- | --------------------------------------------------------------------------------------- |\n| `ItemDescription` | every text prop | A step quieter, muted, two lines (`numberOfLines: 2`); a reader hears the text it shows |","table":"table-0"},"1089":{"id":"/docs/components/item#28","page_id":"/docs/components/item","tags":[],"type":"text","url":"/docs/components/item#api","content":"| Part          | Props           | Description           |\n| ------------- | --------------- | --------------------- |\n| `ItemActions` | every view prop | A row, 8 points apart |","table":"table-0"},"1090":{"id":"/docs/components/item#29","page_id":"/docs/components/item","tags":[],"type":"text","url":"/docs/components/item#api","content":"| Part         | Props           | Description                              |\n| ------------ | --------------- | ---------------------------------------- |\n| `ItemHeader` | every view prop | A line across the row, above the content |","table":"table-0"},"1091":{"id":"/docs/components/item#30","page_id":"/docs/components/item","tags":[],"type":"text","url":"/docs/components/item#api","content":"| Part         | Props           | Description                              |\n| ------------ | --------------- | ---------------------------------------- |\n| `ItemFooter` | every view prop | A line across the row, under the content |","table":"table-0"},"1092":{"id":"/docs/components/item#31","page_id":"/docs/components/item","tags":[],"type":"text","url":"/docs/components/item#api","content":"Every view prop passes through the parts drawn as views, and every text prop the parts drawn as\ntexts. `style` goes over the look's."},"1093":{"id":"/docs/components/item#32","page_id":"/docs/components/item","tags":[],"type":"text","url":"/docs/components/item#api","content":"An icon's tile is `controlSize.control + 12` square and an image's frame `controlSize.row - 8`,\nboth of the theme's control corners, so both grow on a touch screen. `itemLook()` is exported for a\nrow the app draws itself: the same look without the parts. `muted`'s fill is the theme's `muted`\ntoken (`token(\"muted\")`); `default` and `outline` draw what they always did."},"1094":{"id":"/docs/components/kbd","page_id":"/docs/components/kbd","type":"page","content":"Kbd","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/kbd"},"1095":{"id":"/docs/components/kbd#0","page_id":"/docs/components/kbd","tags":[],"type":"text","url":"/docs/components/kbd","content":"A key of a shortcut, alone or in a group."},"1096":{"id":"/docs/components/kbd#1","page_id":"/docs/components/kbd","type":"heading","tags":[],"url":"/docs/components/kbd#installation","content":"Installation"},"1097":{"id":"/docs/components/kbd#2","page_id":"/docs/components/kbd","type":"heading","tags":[],"url":"/docs/components/kbd#usage","content":"Usage"},"1098":{"id":"/docs/components/kbd#3","page_id":"/docs/components/kbd","type":"heading","tags":[],"url":"/docs/components/kbd#composition","content":"Composition"},"1099":{"id":"/docs/components/kbd#4","page_id":"/docs/components/kbd","type":"heading","tags":[],"url":"/docs/components/kbd#examples","content":"Examples"},"1100":{"id":"/docs/components/kbd#5","page_id":"/docs/components/kbd","type":"heading","tags":[],"url":"/docs/components/kbd#a-group-of-keys","content":"A group of keys"},"1101":{"id":"/docs/components/kbd#6","page_id":"/docs/components/kbd","type":"heading","tags":[],"url":"/docs/components/kbd#in-a-sentence","content":"In a sentence"},"1102":{"id":"/docs/components/kbd#7","page_id":"/docs/components/kbd","type":"heading","tags":[],"url":"/docs/components/kbd#beside-a-buttons-label","content":"Beside a button's label"},"1103":{"id":"/docs/components/kbd#8","page_id":"/docs/components/kbd","type":"heading","tags":[],"url":"/docs/components/kbd#the-terminal","content":"The terminal"},"1104":{"id":"/docs/components/kbd#9","page_id":"/docs/components/kbd","type":"heading","tags":[],"url":"/docs/components/kbd#api","content":"API"},"1105":{"id":"/docs/components/kbd#10","page_id":"/docs/components/kbd","tags":[],"type":"text","url":"/docs/components/kbd#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1106":{"id":"/docs/components/kbd#11","page_id":"/docs/components/kbd","tags":[],"type":"text","url":"/docs/components/kbd#composition","content":"Use the following composition to build a `Kbd`:"},"1107":{"id":"/docs/components/kbd#12","page_id":"/docs/components/kbd","tags":[],"type":"text","url":"/docs/components/kbd#a-group-of-keys","content":"`KbdGroup` puts keys side by side, a small gap apart; `Kbd` is one cap — a modifier, a letter, a\nword (`Esc`, `Ctrl`)."},"1108":{"id":"/docs/components/kbd#13","page_id":"/docs/components/kbd","tags":[],"type":"text","url":"/docs/components/kbd#in-a-sentence","content":"A cap is a view, not a span of a paragraph: in running text the sentence is a row of `Text` and\n`KbdGroup`, wrapping together."},"1109":{"id":"/docs/components/kbd#14","page_id":"/docs/components/kbd","tags":[],"type":"text","url":"/docs/components/kbd#beside-a-buttons-label","content":"A key cap in a button says what its shortcut is; the label is the button's own type\n(`buttonLabel`), the caps are the keys."},"1110":{"id":"/docs/components/kbd#15","page_id":"/docs/components/kbd","tags":[],"type":"text","url":"/docs/components/kbd#the-terminal","content":"A terminal draws no cap: a key is its name in the monospaced face, one Cell row high, with no fill\nand no edge."},"1111":{"id":"/docs/components/kbd#16","page_id":"/docs/components/kbd","tags":[],"type":"text","url":"/docs/components/kbd#api","content":"| Part  | Props                                                      | Description         |\n| ----- | ---------------------------------------------------------- | ------------------- |\n| `Kbd` | `children`: `string \\| JSX.Element`; every `nsh` View prop | A key of a shortcut |","table":"table-0"},"1112":{"id":"/docs/components/kbd#17","page_id":"/docs/components/kbd","tags":[],"type":"text","url":"/docs/components/kbd#api","content":"| Part       | Props                 | Description       |\n| ---------- | --------------------- | ----------------- |\n| `KbdGroup` | every `nsh` View prop | Keys side by side |","table":"table-0"},"1113":{"id":"/docs/components/kbd#18","page_id":"/docs/components/kbd","tags":[],"type":"text","url":"/docs/components/kbd#api","content":"Every prop of `nsh` View passes through on both parts (`style`, `accessibilityLabel`, …); `style` goes over the look's."},"1114":{"id":"/docs/components/kbd#19","page_id":"/docs/components/kbd","tags":[],"type":"text","url":"/docs/components/kbd#api","content":"| Prop       | Type                    | Default |\n| ---------- | ----------------------- | ------- |\n| `children` | `string \\| JSX.Element` |         |","table":"table-1"},"1115":{"id":"/docs/components/kbd#20","page_id":"/docs/components/kbd","tags":[],"type":"text","url":"/docs/components/kbd#api","content":"A `Kbd` is one line high with a minimum width (20 points with a pointer, one Cell row in the\nterminal), a hairline edge and the `muted` fill; its name is small type in the muted ink. There is\nno axis. A key is one cap; a group is those caps in a row."},"1116":{"id":"/docs/components/label","page_id":"/docs/components/label","type":"page","content":"Label","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/label"},"1117":{"id":"/docs/components/label#0","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label","content":"The visible name of a control, beside it or over a group of them."},"1118":{"id":"/docs/components/label#1","page_id":"/docs/components/label","type":"heading","tags":[],"url":"/docs/components/label#installation","content":"Installation"},"1119":{"id":"/docs/components/label#2","page_id":"/docs/components/label","type":"heading","tags":[],"url":"/docs/components/label#usage","content":"Usage"},"1120":{"id":"/docs/components/label#3","page_id":"/docs/components/label","type":"heading","tags":[],"url":"/docs/components/label#examples","content":"Examples"},"1121":{"id":"/docs/components/label#4","page_id":"/docs/components/label","type":"heading","tags":[],"url":"/docs/components/label#disabled","content":"Disabled"},"1122":{"id":"/docs/components/label#5","page_id":"/docs/components/label","type":"heading","tags":[],"url":"/docs/components/label#beside-a-choice","content":"Beside a choice"},"1123":{"id":"/docs/components/label#6","page_id":"/docs/components/label","type":"heading","tags":[],"url":"/docs/components/label#over-a-group","content":"Over a group"},"1124":{"id":"/docs/components/label#7","page_id":"/docs/components/label","type":"heading","tags":[],"url":"/docs/components/label#naming-the-control","content":"Naming the control"},"1125":{"id":"/docs/components/label#8","page_id":"/docs/components/label","type":"heading","tags":[],"url":"/docs/components/label#api","content":"API"},"1126":{"id":"/docs/components/label#9","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1127":{"id":"/docs/components/label#10","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label#disabled","content":"A label beside a control that cannot be used dims to half. Set `disabled` where the control's own\n`disabled` is set."},"1128":{"id":"/docs/components/label#11","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label#beside-a-choice","content":"A label is a row, so an icon or a switch can sit before its text; a control beside it is the\ncaller's own view, a gap of the caller's `style` apart."},"1129":{"id":"/docs/components/label#12","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label#beside-a-choice","content":"The label does not press the control: nsh has no `for` to hang the pair on. A row that toggles its\ncontrol is a `listRow` of the app's, as the `Checkbox` page shows."},"1130":{"id":"/docs/components/label#13","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label#over-a-group","content":"The caption of a set of choices, a column's first line."},"1131":{"id":"/docs/components/label#14","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label#naming-the-control","content":"This `Label` is the visible name, and nothing more: it names nothing for a screen reader. nsh has\nno `htmlFor` and no `labelledBy`, so the control's own `accessibilityLabel` is its name — the same\nwords, said twice:"},"1132":{"id":"/docs/components/label#15","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label#naming-the-control","content":"`lib/ui/as-text.tsx` compiles into the app beside it and is a different thing: a `Label` draws\ntype, while a control's name for screen readers is its own `accessibilityLabel`, or the text it\ndraws — the string child `AsText` hands to a `Text`."},"1133":{"id":"/docs/components/label#16","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label#api","content":"| Part    | Props                                                                                                                        | Description                   |\n| ------- | ---------------------------------------------------------------------------------------------------------------------------- | ----------------------------- |\n| `Label` | `disabled`: `boolean` (default `false`), `children`: `string \\| JSX.Element`; every `nsh` View prop; `style` over the look's | The visible name of a control |","table":"table-0"},"1134":{"id":"/docs/components/label#17","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label#api","content":"Every prop of `nsh` View passes through (`style`, `role`, …); `style` goes over the look's."},"1135":{"id":"/docs/components/label#18","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label#api","content":"| Prop       | Type      | Default |\n| ---------- | --------- | ------- |\n| `disabled` | `boolean` | `false` |","table":"table-1"},"1136":{"id":"/docs/components/label#19","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label#api","content":"| Prop       | Type                    | Default |\n| ---------- | ----------------------- | ------- |\n| `children` | `string \\| JSX.Element` |         |","table":"table-1"},"1137":{"id":"/docs/components/label#20","page_id":"/docs/components/label","tags":[],"type":"text","url":"/docs/components/label#api","content":"There is no other axis: the text is `controlSize.label` (14 points with a pointer, 15 on a touch\nscreen) and medium, in the theme's text color, a row with a gap of 8. `disabled` dims that row to\nhalf."},"1138":{"id":"/docs/components/link","page_id":"/docs/components/link","type":"page","content":"Link","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/link"},"1139":{"id":"/docs/components/link#0","page_id":"/docs/components/link","tags":[],"type":"text","url":"/docs/components/link","content":"A text link with underline motion, on the shared nav look."},"1140":{"id":"/docs/components/link#1","page_id":"/docs/components/link","type":"heading","tags":[],"url":"/docs/components/link#installation","content":"Installation"},"1141":{"id":"/docs/components/link#2","page_id":"/docs/components/link","type":"heading","tags":[],"url":"/docs/components/link#usage","content":"Usage"},"1142":{"id":"/docs/components/link#3","page_id":"/docs/components/link","type":"heading","tags":[],"url":"/docs/components/link#examples","content":"Examples"},"1143":{"id":"/docs/components/link#4","page_id":"/docs/components/link","type":"heading","tags":[],"url":"/docs/components/link#quiet","content":"Quiet"},"1144":{"id":"/docs/components/link#5","page_id":"/docs/components/link","type":"heading","tags":[],"url":"/docs/components/link#current","content":"Current"},"1145":{"id":"/docs/components/link#6","page_id":"/docs/components/link","type":"heading","tags":[],"url":"/docs/components/link#external","content":"External"},"1146":{"id":"/docs/components/link#7","page_id":"/docs/components/link","type":"heading","tags":[],"url":"/docs/components/link#names-for-screen-readers","content":"Names for screen readers"},"1147":{"id":"/docs/components/link#8","page_id":"/docs/components/link","type":"heading","tags":[],"url":"/docs/components/link#api","content":"API"},"1148":{"id":"/docs/components/link#9","page_id":"/docs/components/link","tags":[],"type":"text","url":"/docs/components/link#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1149":{"id":"/docs/components/link#10","page_id":"/docs/components/link","tags":[],"type":"text","url":"/docs/components/link#quiet","content":"A quiet link sits in a footer: muted, with no resting underline."},"1150":{"id":"/docs/components/link#11","page_id":"/docs/components/link","tags":[],"type":"text","url":"/docs/components/link#current","content":"The page a link names is the one shown."},"1151":{"id":"/docs/components/link#12","page_id":"/docs/components/link","tags":[],"type":"text","url":"/docs/components/link#external","content":"`icon` adds the arrow a site outside the app gets."},"1152":{"id":"/docs/components/link#13","page_id":"/docs/components/link","tags":[],"type":"text","url":"/docs/components/link#names-for-screen-readers","content":"A string child is the link's name for screen readers too, so `<Link href=\"/docs\">Documentation</Link>` needs nothing else; `accessibilityLabel` wins when the name should differ from the text. Children drawn as given are named by the texts inside them."},"1153":{"id":"/docs/components/link#14","page_id":"/docs/components/link","tags":[],"type":"text","url":"/docs/components/link#api","content":"| Part   | Props                                                                                                                                                                                                                        | Description                           |\n| ------ | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ------------------------------------- |\n| `Link` | `quiet`: `boolean` (muted footer style), `current`: `boolean` (current page), `visited`: `boolean` (muted once opened), `inline`: `boolean` (in a paragraph), `icon`: `boolean` (external arrow); every `nsh/base` Link prop | A text link with the underline motion |","table":"table-0"},"1154":{"id":"/docs/components/link#15","page_id":"/docs/components/link","tags":[],"type":"text","url":"/docs/components/link#api","content":"Every prop of `nsh/base` Link passes through."},"1155":{"id":"/docs/components/marker","page_id":"/docs/components/marker","type":"page","content":"Marker","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/marker"},"1156":{"id":"/docs/components/marker#0","page_id":"/docs/components/marker","tags":[],"type":"text","url":"/docs/components/marker","content":"A line in a conversation that is not a message: a status, a note, a labeled separator."},"1157":{"id":"/docs/components/marker#1","page_id":"/docs/components/marker","type":"heading","tags":[],"url":"/docs/components/marker#installation","content":"Installation"},"1158":{"id":"/docs/components/marker#2","page_id":"/docs/components/marker","type":"heading","tags":[],"url":"/docs/components/marker#usage","content":"Usage"},"1159":{"id":"/docs/components/marker#3","page_id":"/docs/components/marker","type":"heading","tags":[],"url":"/docs/components/marker#composition","content":"Composition"},"1160":{"id":"/docs/components/marker#4","page_id":"/docs/components/marker","type":"heading","tags":[],"url":"/docs/components/marker#examples","content":"Examples"},"1161":{"id":"/docs/components/marker#5","page_id":"/docs/components/marker","type":"heading","tags":[],"url":"/docs/components/marker#inline","content":"Inline"},"1162":{"id":"/docs/components/marker#6","page_id":"/docs/components/marker","type":"heading","tags":[],"url":"/docs/components/marker#separator","content":"Separator"},"1163":{"id":"/docs/components/marker#7","page_id":"/docs/components/marker","type":"heading","tags":[],"url":"/docs/components/marker#border","content":"Border"},"1164":{"id":"/docs/components/marker#8","page_id":"/docs/components/marker","type":"heading","tags":[],"url":"/docs/components/marker#status","content":"Status"},"1165":{"id":"/docs/components/marker#9","page_id":"/docs/components/marker","type":"heading","tags":[],"url":"/docs/components/marker#a-marker-that-acts","content":"A marker that acts"},"1166":{"id":"/docs/components/marker#10","page_id":"/docs/components/marker","type":"heading","tags":[],"url":"/docs/components/marker#api","content":"API"},"1167":{"id":"/docs/components/marker#11","page_id":"/docs/components/marker","tags":[],"type":"text","url":"/docs/components/marker#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1168":{"id":"/docs/components/marker#12","page_id":"/docs/components/marker","tags":[],"type":"text","url":"/docs/components/marker#composition","content":"Use the following composition to build a `Marker`:"},"1169":{"id":"/docs/components/marker#13","page_id":"/docs/components/marker","tags":[],"type":"text","url":"/docs/components/marker#inline","content":"`Marker` is one muted line at the body's size, at least 16 points tall, an icon 8 points before\nthe text. `MarkerIcon` takes a lucide node (`icon`) or a part of its own as children — a `Spinner`,\nfor a status."},"1170":{"id":"/docs/components/marker#14","page_id":"/docs/components/marker","tags":[],"type":"text","url":"/docs/components/marker#separator","content":"`variant=\"separator\"` centers the label between two hairlines, each taking the room left on its\nside. Use it for a date, a compaction, or the start of a section."},"1171":{"id":"/docs/components/marker#15","page_id":"/docs/components/marker","tags":[],"type":"text","url":"/docs/components/marker#border","content":"`variant=\"border\"` keeps the inline layout and closes the line with a hairline 8 points under it,\nfor a row that separates what follows."},"1172":{"id":"/docs/components/marker#16","page_id":"/docs/components/marker","tags":[],"type":"text","url":"/docs/components/marker#status","content":"A marker that is still going takes a `Spinner` in `MarkerIcon`. NSH has no `status` role and no\nlive-region prop, so a marker whose change must be announced takes `role=\"alert\"`, the one it has\nfor this."},"1173":{"id":"/docs/components/marker#17","page_id":"/docs/components/marker","tags":[],"type":"text","url":"/docs/components/marker#a-marker-that-acts","content":"Give the marker `onPress` and `role=\"button\"`: its line is underlined and the pointer over it is a\nhand."},"1174":{"id":"/docs/components/marker#18","page_id":"/docs/components/marker","tags":[],"type":"text","url":"/docs/components/marker#api","content":"| Part     | Props                            | Description                                    |\n| -------- | -------------------------------- | ---------------------------------------------- |\n| `Marker` | `variant`; every `nsh` View prop | A line in a conversation that is not a message |","table":"table-0"},"1175":{"id":"/docs/components/marker#19","page_id":"/docs/components/marker","tags":[],"type":"text","url":"/docs/components/marker#api","content":"| Part         | Props                                     | Description              |\n| ------------ | ----------------------------------------- | ------------------------ |\n| `MarkerIcon` | `icon`, `children`; every `nsh` View prop | The icon beside the line |","table":"table-0"},"1176":{"id":"/docs/components/marker#20","page_id":"/docs/components/marker","tags":[],"type":"text","url":"/docs/components/marker#api","content":"| Part            | Props                             | Description      |\n| --------------- | --------------------------------- | ---------------- |\n| `MarkerContent` | `children`; every `nsh` Text prop | The line's words |","table":"table-0"},"1177":{"id":"/docs/components/marker#21","page_id":"/docs/components/marker","tags":[],"type":"text","url":"/docs/components/marker#api","content":"Every prop of `nsh` View passes through on `Marker` and\n`MarkerIcon` (`role`, `onPress`, `accessibilityLabel`, …), and every prop of\n`nsh` Text on `MarkerContent`. Style props go over the look's:\n`style` on a `View` or `Text` part."},"1178":{"id":"/docs/components/marker#22","page_id":"/docs/components/marker","tags":[],"type":"text","url":"/docs/components/marker#api","content":"| Prop      | On       | Type                                   | Default   |\n| --------- | -------- | -------------------------------------- | --------- |\n| `variant` | `Marker` | `\"default\" \\| \"border\" \\| \"separator\"` | `default` |","table":"table-1"},"1179":{"id":"/docs/components/marker#23","page_id":"/docs/components/marker","tags":[],"type":"text","url":"/docs/components/marker#api","content":"| Prop   | On           | Type                       | Default |\n| ------ | ------------ | -------------------------- | ------- |\n| `icon` | `MarkerIcon` | `IconNode` (from `lucide`) |         |","table":"table-1"},"1180":{"id":"/docs/components/marker#24","page_id":"/docs/components/marker","tags":[],"type":"text","url":"/docs/components/marker#api","content":"| Prop       | On              | Type                    | Default |\n| ---------- | --------------- | ----------------------- | ------- |\n| `children` | `MarkerContent` | `string \\| JSX.Element` |         |","table":"table-1"},"1181":{"id":"/docs/components/marker#25","page_id":"/docs/components/marker","tags":[],"type":"text","url":"/docs/components/marker#api","content":"The line is in the muted ink at the body's size (13 points with a pointer, 15 on a touch screen),\nits icon 16 points in the same ink; a marker's icon box is never shrunk by a tight row. In a\nterminal the icon is drawn as NSH draws icons there (a check is `✓`, the others show nothing) and\nthe rules are hairlines."},"1182":{"id":"/docs/components/menu","page_id":"/docs/components/menu","type":"page","content":"Menu","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/menu"},"1183":{"id":"/docs/components/menu#0","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu","content":"A menu of items, separators and submenus on the shared menu look."},"1184":{"id":"/docs/components/menu#1","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#installation","content":"Installation"},"1185":{"id":"/docs/components/menu#2","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#usage","content":"Usage"},"1186":{"id":"/docs/components/menu#3","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#composition","content":"Composition"},"1187":{"id":"/docs/components/menu#4","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#examples","content":"Examples"},"1188":{"id":"/docs/components/menu#5","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#checkbox-and-radio","content":"Checkbox and radio"},"1189":{"id":"/docs/components/menu#6","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#a-line-under-the-label","content":"A line under the label"},"1190":{"id":"/docs/components/menu#7","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#a-destructive-item","content":"A destructive item"},"1191":{"id":"/docs/components/menu#8","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#submenu","content":"Submenu"},"1192":{"id":"/docs/components/menu#9","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#the-systems-menu","content":"The system's menu"},"1193":{"id":"/docs/components/menu#10","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#names-for-screen-readers","content":"Names for screen readers"},"1194":{"id":"/docs/components/menu#11","page_id":"/docs/components/menu","type":"heading","tags":[],"url":"/docs/components/menu#api","content":"API"},"1195":{"id":"/docs/components/menu#12","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1196":{"id":"/docs/components/menu#13","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#composition","content":"Use the following composition to build a `Menu`:"},"1197":{"id":"/docs/components/menu#14","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#a-line-under-the-label","content":"A row's height in the size table is its least: give it a `View` holding its label and a note under it (`menuItemNote`) and the row grows to hold both, growing over the theme's row inset so it never touches the row after it. A neighbour with one line keeps the one-line height."},"1198":{"id":"/docs/components/menu#15","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#a-destructive-item","content":"`variant=\"destructive\"` puts the danger tone on the row's label, its note and its icon; `default` is the row as it is."},"1199":{"id":"/docs/components/menu#16","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#a-destructive-item","content":"`MenuItemVariant` is `\"default\" | \"destructive\"`, and `menuItemLabel`, `menuItemNote` and `menuItemGlyph` take the same word."},"1200":{"id":"/docs/components/menu#17","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#submenu","content":"`lead` is what sits before the label — an icon, or a mark of the app's. A string child is the row's\nlabel, and the label the touch sheet's back row shows above the nested menu; children drawn as given\nare laid out between the lead and the chevron, which stays either way."},"1201":{"id":"/docs/components/menu#18","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#the-systems-menu","content":"`MenuButton` is the platform's pull-down menu — `UIContextMenu` on iOS, the context menu a pointer\nopens on the desktops — with its items as data (`MenuButtonItem`: `id`, `label`, `icon`, `checked`,\n`disabled`, `destructive`, `items`, `inline`). The app decides that is the better menu there; a phone\nwithout one (Android) draws `Menu` instead. On the web a menu is always the app's own drawing, so\n`Menu` and its parts are."},"1202":{"id":"/docs/components/menu#19","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#the-systems-menu","content":"A string child is drawn as the button's label in the theme's look (`variant`, `ghost` by default;\n`size` as `Button`'s). It is not a `Button` inside: `nsh/base` makes the button's own view the\npressable on the desktops, and a nested one would take the press. A single element child is the\ntrigger itself, with no wrapper: its look, `testID`, name, own press and hover styles stay, and\n`nsh/base` adds the open state to it (`expandedStyle`, `expanded:` classes)."},"1203":{"id":"/docs/components/menu#20","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#names-for-screen-readers","content":"A string child is the row's label and its name for screen readers; `accessibilityLabel` wins when it should differ. Children drawn as given are named by the texts inside them."},"1204":{"id":"/docs/components/menu#21","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#api","content":"Looks are `menuItemLook`, `menuItemLabel`, `menuItemNote`, `menuItemGlyph`, `menuPopup`, `menuSeparator` and `menuHighlight`; `menuItemSize.height` is a row's least height, not its height; `SubmenuRow` and `SubmenuBack` draw a submenu's row and its touch back row. Every prop of `nsh/base` Menu on `MenuContent` passes through except open state and `trigger`. There is no radio-group part: a `MenuGroup` holds the rows, and each `MenuRadioItem` carries its own `checked`."},"1205":{"id":"/docs/components/menu#22","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#api","content":"| Part   | Props                                                                                    | Description                     |\n| ------ | ---------------------------------------------------------------------------------------- | ------------------------------- |\n| `Menu` | `open`, `defaultOpen`, `onOpenChange({ open, reason })`, `onOpen`, `onClose`, `onCancel` | Open state and the trigger slot |","table":"table-0"},"1206":{"id":"/docs/components/menu#23","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#api","content":"| Part          | Props                              | Description                                                                    |\n| ------------- | ---------------------------------- | ------------------------------------------------------------------------------ |\n| `MenuTrigger` | every `Button` prop but `children` | Registers the trigger; a string child is a `Button`, an element is the trigger |","table":"table-0"},"1207":{"id":"/docs/components/menu#24","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#api","content":"| Part          | Props                                                                                | Description        |\n| ------------- | ------------------------------------------------------------------------------------ | ------------------ |\n| `MenuContent` | every `nsh/base` Menu prop but open state and `trigger`; defaults bottom / start / 4 | The popup or sheet |","table":"table-0"},"1208":{"id":"/docs/components/menu#25","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#api","content":"| Part       | Props                                                                           | Description |\n| ---------- | ------------------------------------------------------------------------------- | ----------- |\n| `MenuItem` | every `nsh/base` MenuItem prop; `variant`, `inset`; a string child is the label | A row       |","table":"table-0"},"1209":{"id":"/docs/components/menu#26","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#api","content":"| Part               | Props                         | Description     |\n| ------------------ | ----------------------------- | --------------- |\n| `MenuCheckboxItem` | as `MenuItem`, plus `checked` | A checkable row |","table":"table-0"},"1210":{"id":"/docs/components/menu#27","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#api","content":"| Part            | Props                         | Description    |\n| --------------- | ----------------------------- | -------------- |\n| `MenuRadioItem` | as `MenuItem`, plus `checked` | One of a group |","table":"table-0"},"1211":{"id":"/docs/components/menu#28","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#api","content":"| Part        | Props                                      | Description     |\n| ----------- | ------------------------------------------ | --------------- |\n| `MenuLabel` | `children`, `inset`; every `nsh` text prop | A group's title |","table":"table-0"},"1212":{"id":"/docs/components/menu#29","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#api","content":"| Part            | Props                               | Description |\n| --------------- | ----------------------------------- | ----------- |\n| `MenuSeparator` | every `nsh/base` MenuSeparator prop | A hairline  |","table":"table-0"},"1213":{"id":"/docs/components/menu#30","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#api","content":"| Part           | Props                                                              | Description     |\n| -------------- | ------------------------------------------------------------------ | --------------- |\n| `MenuShortcut` | `children`; every `nsh` view prop (`style` is type, a `TextStyle`) | A trailing note |","table":"table-0"},"1214":{"id":"/docs/components/menu#31","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#api","content":"| Part      | Props                  | Description          |\n| --------- | ---------------------- | -------------------- |\n| `MenuSub` | `children`, `disabled` | A nested menu's root |","table":"table-0"},"1215":{"id":"/docs/components/menu#32","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#api","content":"| Part             | Props                                                                                    | Description                  |\n| ---------------- | ---------------------------------------------------------------------------------------- | ---------------------------- |\n| `MenuSubTrigger` | `SubmenuRow`'s props (`children`, `lead`, `inset`, `disabled`, `style`, every view prop) | The row that opens a submenu |","table":"table-0"},"1216":{"id":"/docs/components/menu#33","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#api","content":"| Part             | Props                                                                 | Description             |\n| ---------------- | --------------------------------------------------------------------- | ----------------------- |\n| `MenuSubContent` | every `nsh/base` Submenu prop but `trigger`; `back` on a touch screen | The nested menu's popup |","table":"table-0"},"1217":{"id":"/docs/components/menu#34","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#api","content":"| Part         | Props                                                                                                                        | Description                                                |\n| ------------ | ---------------------------------------------------------------------------------------------------------------------------- | ---------------------------------------------------------- |\n| `MenuButton` | `items`, `title`, `disabled`, `accessibilityLabel`, `onSelect({ id })`, `variant`, `size`; the rest of `nsh/base` MenuButton | The platform's pull-down menu; a string child is its label |","table":"table-0"},"1218":{"id":"/docs/components/menu#35","page_id":"/docs/components/menu","tags":[],"type":"text","url":"/docs/components/menu#api","content":"Every part that draws a view takes `nsh`'s view props and spreads them on it after its own look, so an app's `testID`, `accessibilityLabel`, `onLongPress` or `class` reaches the row it passes them to; `style` goes over the look's, and the states an app passes (`hoverStyle`, `focusStyle`, `activeStyle`, `disabledStyle`) are merged after the look's own. `Menu` and `MenuSub` draw no view of their own (they own the open state and the trigger slot), so they take none: an app gives those props to the trigger or the content."},"1219":{"id":"/docs/components/menubar","page_id":"/docs/components/menubar","type":"page","content":"Menubar","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/menubar"},"1220":{"id":"/docs/components/menubar#0","page_id":"/docs/components/menubar","tags":[],"type":"text","url":"/docs/components/menubar","content":"A row of menus whose triggers stand in one bar, as a desktop app's menu bar."},"1221":{"id":"/docs/components/menubar#1","page_id":"/docs/components/menubar","type":"heading","tags":[],"url":"/docs/components/menubar#installation","content":"Installation"},"1222":{"id":"/docs/components/menubar#2","page_id":"/docs/components/menubar","type":"heading","tags":[],"url":"/docs/components/menubar#usage","content":"Usage"},"1223":{"id":"/docs/components/menubar#3","page_id":"/docs/components/menubar","type":"heading","tags":[],"url":"/docs/components/menubar#composition","content":"Composition"},"1224":{"id":"/docs/components/menubar#4","page_id":"/docs/components/menubar","type":"heading","tags":[],"url":"/docs/components/menubar#examples","content":"Examples"},"1225":{"id":"/docs/components/menubar#5","page_id":"/docs/components/menubar","type":"heading","tags":[],"url":"/docs/components/menubar#the-bar","content":"The bar"},"1226":{"id":"/docs/components/menubar#6","page_id":"/docs/components/menubar","type":"heading","tags":[],"url":"/docs/components/menubar#the-trigger-that-is-open","content":"The trigger that is open"},"1227":{"id":"/docs/components/menubar#7","page_id":"/docs/components/menubar","type":"heading","tags":[],"url":"/docs/components/menubar#a-row-with-its-key-equivalent","content":"A row with its key equivalent"},"1228":{"id":"/docs/components/menubar#8","page_id":"/docs/components/menubar","type":"heading","tags":[],"url":"/docs/components/menubar#the-rows-are-the-menus","content":"The rows are the menu's"},"1229":{"id":"/docs/components/menubar#9","page_id":"/docs/components/menubar","type":"heading","tags":[],"url":"/docs/components/menubar#api","content":"API"},"1230":{"id":"/docs/components/menubar#10","page_id":"/docs/components/menubar","tags":[],"type":"text","url":"/docs/components/menubar#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1231":{"id":"/docs/components/menubar#11","page_id":"/docs/components/menubar","tags":[],"type":"text","url":"/docs/components/menubar#composition","content":"Use the following composition to build a `Menubar`:"},"1232":{"id":"/docs/components/menubar#12","page_id":"/docs/components/menubar","tags":[],"type":"text","url":"/docs/components/menubar#the-bar","content":"`Menubar` is a row a step over its triggers — the theme's height step under a row, the room either\nside of them and its own 1-point edge — inside a 1-point edge with the card's fill, its triggers 8\npoints either side. It places nothing itself: a `MenubarMenu` gives a trigger\nand its popup, and the trigger stands in the bar, not in a box of its\nown."},"1233":{"id":"/docs/components/menubar#13","page_id":"/docs/components/menubar","tags":[],"type":"text","url":"/docs/components/menubar#the-trigger-that-is-open","content":"The trigger of the menu that is open wears the neutral `accent` fill — the modal-less bar says which\nmenu it belongs to without the bar changing — and the pointer over another trigger whispers the same\nfill. A press opens one menu and a press closes it; once one is open, the pointer moves between\nmenus. A disabled trigger takes no presses and dims to 50%; a string child is the trigger's name, in\nthe menu's type; anything else (an icon and a name) is drawn as given."},"1234":{"id":"/docs/components/menubar#14","page_id":"/docs/components/menubar","tags":[],"type":"text","url":"/docs/components/menubar#a-row-with-its-key-equivalent","content":"A string child is a row's label; a label and a note at the row's trailing edge (`MenubarShortcut`,\nwhich is `MenuShortcut`) are written out — the note takes the rest of the row:"},"1235":{"id":"/docs/components/menubar#15","page_id":"/docs/components/menubar","tags":[],"type":"text","url":"/docs/components/menubar#the-rows-are-the-menus","content":"`MenubarItem`, `MenubarCheckboxItem`, `MenubarRadioItem`, `MenubarLabel`, `MenubarSeparator`,\n`MenubarShortcut`, `MenubarGroup` and `MenubarSub` / `MenubarSubTrigger` / `MenubarSubContent` are\n`Menu`'s parts under the bar's names: a row of a bar wears what a row of a menu wears, down\nto its danger tone, its check and its dot. `MenubarShortcut` is `MenuShortcut` (the row's trailing\nnote), and `MenubarLabel` is `MenuLabel`: its child is the title. There is no radio-group part:\n`MenubarGroup` is a `View`, and each `MenubarRadioItem` carries its own `checked`."},"1236":{"id":"/docs/components/menubar#16","page_id":"/docs/components/menubar","tags":[],"type":"text","url":"/docs/components/menubar#api","content":"Every prop of `nsh/base` Menu passes through on `MenubarContent`\nexcept the trigger, the open state and the lifecycle callbacks, which the root owns. `popupStyle`,\n`backdropStyle` and `popupStartingStyle` go over `menuPopup`'s. Defaults: `placement` `\"bottom\"`,\n`align` `\"start\"`, `offset` `8` — a menu under the trigger it belongs to, whatever the bar's width."},"1237":{"id":"/docs/components/menubar#17","page_id":"/docs/components/menubar","tags":[],"type":"text","url":"/docs/components/menubar#api","content":"| Part      | Props                 | Description                      |\n| --------- | --------------------- | -------------------------------- |\n| `Menubar` | every `nsh` view prop | The bar; a row holding its menus |","table":"table-0"},"1238":{"id":"/docs/components/menubar#18","page_id":"/docs/components/menubar","tags":[],"type":"text","url":"/docs/components/menubar#api","content":"| Part          | Props          | Description                                        |\n| ------------- | -------------- | -------------------------------------------------- |\n| `MenubarMenu` | `onOpenChange` | Open state + lifecycle; reports `{ open, reason }` |","table":"table-0"},"1239":{"id":"/docs/components/menubar#19","page_id":"/docs/components/menubar","tags":[],"type":"text","url":"/docs/components/menubar#api","content":"| Part             | Props                                         | Description                                            |\n| ---------------- | --------------------------------------------- | ------------------------------------------------------ |\n| `MenubarTrigger` | `children`, `disabled`; every `nsh` view prop | A string is the name; wears the chosen fill while open |","table":"table-0"},"1240":{"id":"/docs/components/menubar#20","page_id":"/docs/components/menubar","tags":[],"type":"text","url":"/docs/components/menubar#api","content":"| Part             | Props | Description                      |\n| ---------------- | ----- | -------------------------------- |\n| `MenubarContent` |       | The popup, over the menu surface |","table":"table-0"},"1241":{"id":"/docs/components/menubar#21","page_id":"/docs/components/menubar","tags":[],"type":"text","url":"/docs/components/menubar#api","content":"| Part          | Props     | Description                               |\n| ------------- | --------- | ----------------------------------------- |\n| `MenubarItem` | `variant` | A row; `\"destructive\"` is the danger tone |","table":"table-0"},"1242":{"id":"/docs/components/menubar#22","page_id":"/docs/components/menubar","tags":[],"type":"text","url":"/docs/components/menubar#api","content":"| Part                  | Props           | Description                              |\n| --------------------- | --------------- | ---------------------------------------- |\n| `MenubarCheckboxItem` | `closeOnSelect` | A row with a check; `false` to stay open |","table":"table-0"},"1243":{"id":"/docs/components/menubar#23","page_id":"/docs/components/menubar","tags":[],"type":"text","url":"/docs/components/menubar#api","content":"| Part               | Props | Description      |\n| ------------------ | ----- | ---------------- |\n| `MenubarRadioItem` |       | A row with a dot |","table":"table-0"},"1244":{"id":"/docs/components/menubar#24","page_id":"/docs/components/menubar","tags":[],"type":"text","url":"/docs/components/menubar#api","content":"| Part           | Props | Description             |\n| -------------- | ----- | ----------------------- |\n| `MenubarLabel` |       | A group's name (`text`) |","table":"table-0"},"1245":{"id":"/docs/components/menubar#25","page_id":"/docs/components/menubar","tags":[],"type":"text","url":"/docs/components/menubar#api","content":"| Part               | Props | Description             |\n| ------------------ | ----- | ----------------------- |\n| `MenubarSeparator` |       | A hairline between rows |","table":"table-0"},"1246":{"id":"/docs/components/menubar#26","page_id":"/docs/components/menubar","tags":[],"type":"text","url":"/docs/components/menubar#api","content":"| Part              | Props | Description                                |\n| ----------------- | ----- | ------------------------------------------ |\n| `MenubarShortcut` |       | The row's trailing note (a key equivalent) |","table":"table-0"},"1247":{"id":"/docs/components/menubar#27","page_id":"/docs/components/menubar","tags":[],"type":"text","url":"/docs/components/menubar#api","content":"| Part           | Props | Description           |\n| -------------- | ----- | --------------------- |\n| `MenubarGroup` |       | A block grouping rows |","table":"table-0"},"1248":{"id":"/docs/components/menubar#28","page_id":"/docs/components/menubar","tags":[],"type":"text","url":"/docs/components/menubar#api","content":"| Part         | Props | Description                                            |\n| ------------ | ----- | ------------------------------------------------------ |\n| `MenubarSub` |       | A submenu: `MenubarSubTrigger` and `MenubarSubContent` |","table":"table-0"},"1249":{"id":"/docs/components/menubar#29","page_id":"/docs/components/menubar","tags":[],"type":"text","url":"/docs/components/menubar#api","content":"| Part                | Props | Description                                     |\n| ------------------- | ----- | ----------------------------------------------- |\n| `MenubarSubTrigger` |       | The row that opens it (a chevron with a string) |","table":"table-0"},"1250":{"id":"/docs/components/menubar#30","page_id":"/docs/components/menubar","tags":[],"type":"text","url":"/docs/components/menubar#api","content":"| Part                | Props | Description                             |\n| ------------------- | ----- | --------------------------------------- |\n| `MenubarSubContent` |       | Its popup; a back row on a touch screen |","table":"table-0"},"1251":{"id":"/docs/components/menubar#31","page_id":"/docs/components/menubar","tags":[],"type":"text","url":"/docs/components/menubar#api","content":"The bar and its triggers spread the view props they are given on the row they draw, after the look\n(`style` included), and merge a given `hoverStyle`, `activeStyle`, `expandedStyle` or `disabledStyle`\nafter the look's own. The rows, labels, notes and groups are `menu.tsx`'s, so they take what a menu's\nparts take."},"1252":{"id":"/docs/components/message-scroller","page_id":"/docs/components/message-scroller","type":"page","content":"Message scroller","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/message-scroller"},"1253":{"id":"/docs/components/message-scroller#0","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller","content":"A conversation that keeps up with itself: new turns follow the newest message while you are at the end, and wait when you are not."},"1254":{"id":"/docs/components/message-scroller#1","page_id":"/docs/components/message-scroller","type":"heading","tags":[],"url":"/docs/components/message-scroller#installation","content":"Installation"},"1255":{"id":"/docs/components/message-scroller#2","page_id":"/docs/components/message-scroller","type":"heading","tags":[],"url":"/docs/components/message-scroller#usage","content":"Usage"},"1256":{"id":"/docs/components/message-scroller#3","page_id":"/docs/components/message-scroller","type":"heading","tags":[],"url":"/docs/components/message-scroller#composition","content":"Composition"},"1257":{"id":"/docs/components/message-scroller#4","page_id":"/docs/components/message-scroller","type":"heading","tags":[],"url":"/docs/components/message-scroller#examples","content":"Examples"},"1258":{"id":"/docs/components/message-scroller#5","page_id":"/docs/components/message-scroller","type":"heading","tags":[],"url":"/docs/components/message-scroller#following","content":"Following"},"1259":{"id":"/docs/components/message-scroller#6","page_id":"/docs/components/message-scroller","type":"heading","tags":[],"url":"/docs/components/message-scroller#opening-elsewhere","content":"Opening elsewhere"},"1260":{"id":"/docs/components/message-scroller#7","page_id":"/docs/components/message-scroller","type":"heading","tags":[],"url":"/docs/components/message-scroller#keys","content":"Keys"},"1261":{"id":"/docs/components/message-scroller#8","page_id":"/docs/components/message-scroller","type":"heading","tags":[],"url":"/docs/components/message-scroller#buttons","content":"Buttons"},"1262":{"id":"/docs/components/message-scroller#9","page_id":"/docs/components/message-scroller","type":"heading","tags":[],"url":"/docs/components/message-scroller#a-short-thread-and-an-arrival","content":"A short thread, and an arrival"},"1263":{"id":"/docs/components/message-scroller#10","page_id":"/docs/components/message-scroller","type":"heading","tags":[],"url":"/docs/components/message-scroller#a-chat","content":"A chat"},"1264":{"id":"/docs/components/message-scroller#11","page_id":"/docs/components/message-scroller","type":"heading","tags":[],"url":"/docs/components/message-scroller#older-turns","content":"Older turns"},"1265":{"id":"/docs/components/message-scroller#12","page_id":"/docs/components/message-scroller","type":"heading","tags":[],"url":"/docs/components/message-scroller#selecting-across-turns","content":"Selecting across turns"},"1266":{"id":"/docs/components/message-scroller#13","page_id":"/docs/components/message-scroller","type":"heading","tags":[],"url":"/docs/components/message-scroller#commands","content":"Commands"},"1267":{"id":"/docs/components/message-scroller#14","page_id":"/docs/components/message-scroller","type":"heading","tags":[],"url":"/docs/components/message-scroller#turns","content":"Turns"},"1268":{"id":"/docs/components/message-scroller#15","page_id":"/docs/components/message-scroller","type":"heading","tags":[],"url":"/docs/components/message-scroller#api","content":"API"},"1269":{"id":"/docs/components/message-scroller#16","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1270":{"id":"/docs/components/message-scroller#17","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#usage","content":"The examples draw icons with `Icon` from `lib/ui/icons`; see Icons for adding it and picking a size and color."},"1271":{"id":"/docs/components/message-scroller#18","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#usage","content":"The viewport is `nsh`'s `List`: `each` is the conversation in reading\norder, oldest first, and the child renders one row. It is called once per cell, not once per turn —\nread `item()` where the turn is used (`item().text`), because the cell is reused for another turn as\nthe reader scrolls."},"1272":{"id":"/docs/components/message-scroller#19","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#composition","content":"Use the following composition to build a `MessageScroller`:"},"1273":{"id":"/docs/components/message-scroller#20","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#following","content":"The scroller opens at the end, on the newest turn, and keeps itself there: when the content grows\n— a turn is sent, a stream answers — the list keeps the end in view. Scroll up and it stops\nfollowing; the view stays where the reader put it while new turns arrive below. Scroll back to the\nend and it follows again."},"1274":{"id":"/docs/components/message-scroller#21","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#following","content":"Give the frame a height (`style={{ height: 320 }}`): it fills what it is in, and its viewport takes\nthe room left. Four hundred turns cost what four do: the list mounts only the rows near the screen."},"1275":{"id":"/docs/components/message-scroller#22","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#opening-elsewhere","content":"`initialScroll=\"start\"` opens at the oldest turn and does not follow, for a thread read from the\ntop. Anything else (the default, `end`) opens on the newest."},"1276":{"id":"/docs/components/message-scroller#23","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#keys","content":"`keyExtractor` names a turn's row. The default reads the turn's `key`, then its `id`, then its\nindex; give it one when the data has nothing to name a turn by. A key does two things: it keeps a\nrow's cell and its size as rows come and go, and it is the name `scrollToMessage` takes — a turn\nwith the same id on screen and in the command find each other. Keys must be unique and stable: with\nan index, every append that shifts a row makes the list rebuild it."},"1277":{"id":"/docs/components/message-scroller#24","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#buttons","content":"`MessageScrollerButton` floats 16 points above the newest turn (or below the oldest) in the middle\nof the viewport, and shows only while there is somewhere to go that way. It says \"Scroll to end\" or\n\"Scroll to start\" to screen readers; give it `accessibilityLabel` to say something else."},"1278":{"id":"/docs/components/message-scroller#25","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#a-short-thread-and-an-arrival","content":"`alignment=\"bottom\"` on the viewport passes through to the list, so a conversation shorter than the frame sits at the bottom. `indicator` is a mark at the button's top-end corner; `variant` and `size` are the button's (default `secondary` and `sm`)."},"1279":{"id":"/docs/components/message-scroller#26","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#a-chat","content":"A conversation starts with an empty frame: keep the greeting and its suggestions inside the\n`MessageScroller` until the first turn arrives, so the frame holds its height and the composer under\nit never jumps. `MessageScrollerProvider` shares the scroller with that composer, and the send\nbutton is a `RoundButton` beside an `Input`."},"1280":{"id":"/docs/components/message-scroller#27","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#a-chat","content":"`EmptyChat` takes the whole viewport (`flex: 1`, centered) and calls `send` with a starter prompt;\n`turnRow` draws a turn with `Message`, `MessageAvatar` and `Bubble`. While the reader is at the end\nthe viewport follows a new turn; while they are not, it waits where they are."},"1281":{"id":"/docs/components/message-scroller#28","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#older-turns","content":"`onLoadMoreAtStart` is the list's own, passed through the viewport: while the reader is within\n`loadMoreAtStartThreshold` viewports of the first row, the scroller asks for an older page and\nprepends it. Rows on screen keep their place, so the reading position does not jump. Guard the call\nwith a signal — it can fire again while a page is in flight."},"1282":{"id":"/docs/components/message-scroller#29","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#older-turns","content":"The trigger fires on the frame's start side — the top of a normal list — so the same call also\nworks over an inverted list, where older turns sit at the top."},"1283":{"id":"/docs/components/message-scroller#30","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#selecting-across-turns","content":"`MessageScroller` is a `View`, so `selectable` passes straight through: a drag over the frame is one\nselection over the rows that are mounted, instead of one per bubble."},"1284":{"id":"/docs/components/message-scroller#31","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#commands","content":"`MessageScrollerProvider` shares the scroller with controls outside the frame, such as a list of\nmessage titles: under it, `useMessageScroller()` returns `scrollToMessage`, `scrollToStart` and\n`scrollToEnd`, plus `atStart` and `atEnd` (read those in a binding, like any signal). The turn\ntargeted by `scrollToMessage` is the one whose key is that name; without a matching row the call\ndoes nothing. `MessageScroller` works without the provider, with the hook reading the scroller it is\ninside."},"1285":{"id":"/docs/components/message-scroller#32","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#commands","content":"`MessageScrollerViewport` calls its `ref` with the `ListRef` beside\nthe one the scroller keeps, so the app can reach the list directly — `scroller?.scrollToIndex({ index: 0 })`,\nfor example."},"1286":{"id":"/docs/components/message-scroller#33","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#turns","content":"`MessageScrollerItem` is the box one turn sits in, sized by what is in it; `MessageScrollerViewport`\nis the list the turns are in, 32 points apart. What a turn is, is `Message`'s business."},"1287":{"id":"/docs/components/message-scroller#34","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#api","content":"Every prop of `nsh` View passes through on `MessageScroller` and\n`MessageScrollerItem`; `MessageScrollerViewport` takes a `List`'s\n(`keyExtractor`, `estimatedItemSize`, `onViewableItemsChange`, `scrollbar`, …) less the state the\nscroller keeps (`inverted`, `initialScrollIndex`, `initialScrollAtEnd`,\n`maintainVisibleContentPosition`, …), plus `each`, `alignment` and `onLoadMoreAtStart` (all passed to\nthe list — the last one loads older turns) and the child that renders a row; and `MessageScrollerButton` takes this library's\n`Button` props (`variant` defaults to `secondary`, `size` to\n`sm`). `alignment=\"bottom\"` pins a short conversation to the bottom of the viewport. `indicator`\nis a mark at the button's top-end corner (an arrival dot); the arrow stays."},"1288":{"id":"/docs/components/message-scroller#35","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#api","content":"| Part              | Props           | Description                                              |\n| ----------------- | --------------- | -------------------------------------------------------- |\n| `MessageScroller` | `initialScroll` | Renders `View`: a column that fills its parent and clips |","table":"table-0"},"1289":{"id":"/docs/components/message-scroller#36","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#api","content":"| Part                      | Props                                                                       | Description                          |\n| ------------------------- | --------------------------------------------------------------------------- | ------------------------------------ |\n| `MessageScrollerViewport` | `each`, `children`, `keyExtractor`, `alignment`, `onLoadMoreAtStart`, `ref` | Renders `List`; `ref` is a `ListRef` |","table":"table-0"},"1290":{"id":"/docs/components/message-scroller#37","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#api","content":"| Part                  | Props | Description                              |\n| --------------------- | ----- | ---------------------------------------- |\n| `MessageScrollerItem` |       | Renders `View`: the box one turn sits in |","table":"table-0"},"1291":{"id":"/docs/components/message-scroller#38","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#api","content":"| Part                    | Props                                       | Description                                                       |\n| ----------------------- | ------------------------------------------- | ----------------------------------------------------------------- |\n| `MessageScrollerButton` | `direction`, `variant`, `size`, `indicator` | Renders `Button`, floating 16 points from the edge it points past |","table":"table-0"},"1292":{"id":"/docs/components/message-scroller#39","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#api","content":"| Prop            | On                | Type               | Default |\n| --------------- | ----------------- | ------------------ | ------- |\n| `initialScroll` | `MessageScroller` | `\"start\" \\| \"end\"` | `end`   |","table":"table-1"},"1293":{"id":"/docs/components/message-scroller#40","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#api","content":"| Prop   | On                        | Type           | Default |\n| ------ | ------------------------- | -------------- | ------- |\n| `each` | `MessageScrollerViewport` | `readonly T[]` |         |","table":"table-1"},"1294":{"id":"/docs/components/message-scroller#41","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#api","content":"| Prop        | On                        | Type                | Default    |\n| ----------- | ------------------------- | ------------------- | ---------- |\n| `alignment` | `MessageScrollerViewport` | `\"top\" \\| \"bottom\"` | the list's |","table":"table-1"},"1295":{"id":"/docs/components/message-scroller#42","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#api","content":"| Prop       | On                        | Type                                                  | Default |\n| ---------- | ------------------------- | ----------------------------------------------------- | ------- |\n| `children` | `MessageScrollerViewport` | `(item: () => T, index: () => number) => JSX.Element` |         |","table":"table-1"},"1296":{"id":"/docs/components/message-scroller#43","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#api","content":"| Prop           | On                        | Type                                 | Default       |\n| -------------- | ------------------------- | ------------------------------------ | ------------- |\n| `keyExtractor` | `MessageScrollerViewport` | `(item: T, index: number) => string` | the item's id |","table":"table-1"},"1297":{"id":"/docs/components/message-scroller#44","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#api","content":"| Prop        | On                      | Type               | Default |\n| ----------- | ----------------------- | ------------------ | ------- |\n| `direction` | `MessageScrollerButton` | `\"start\" \\| \"end\"` | `end`   |","table":"table-1"},"1298":{"id":"/docs/components/message-scroller#45","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#api","content":"| Prop      | On                      | Type             | Default     |\n| --------- | ----------------------- | ---------------- | ----------- |\n| `variant` | `MessageScrollerButton` | `Button` variant | `secondary` |","table":"table-1"},"1299":{"id":"/docs/components/message-scroller#46","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#api","content":"| Prop   | On                      | Type                        | Default |\n| ------ | ----------------------- | --------------------------- | ------- |\n| `size` | `MessageScrollerButton` | `\"sm\" \\| \"default\" \\| \"lg\"` | `sm`    |","table":"table-1"},"1300":{"id":"/docs/components/message-scroller#47","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#api","content":"| Prop        | On                      | Type          | Default |\n| ----------- | ----------------------- | ------------- | ------- |\n| `indicator` | `MessageScrollerButton` | `JSX.Element` |         |","table":"table-1"},"1301":{"id":"/docs/components/message-scroller#48","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#api","content":"| Export                    | Props / returns | Description                                                       |\n| ------------------------- | --------------- | ----------------------------------------------------------------- |\n| `MessageScrollerProvider` | `children`      | Shares the `MessageScroller` inside it; one provider per scroller |","table":"table-2"},"1302":{"id":"/docs/components/message-scroller#49","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#api","content":"| Export                 | Props / returns                                          | Description                                                       |\n| ---------------------- | -------------------------------------------------------- | ----------------------------------------------------------------- |\n| `useMessageScroller()` | `scrollToMessage`, `scrollToStart`, `scrollToEnd`, edges | The commands and edge state (`atStart`, `atEnd`) of that scroller |","table":"table-2"},"1303":{"id":"/docs/components/message-scroller#50","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#api","content":"| Command option | Type                           | Default |\n| -------------- | ------------------------------ | ------- |\n| `align`        | `\"start\" \\| \"center\" \\| \"end\"` | `start` |","table":"table-3"},"1304":{"id":"/docs/components/message-scroller#51","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#api","content":"| Command option | Type      | Default |\n| -------------- | --------- | ------- |\n| `animated`     | `boolean` | `true`  |","table":"table-3"},"1305":{"id":"/docs/components/message-scroller#52","page_id":"/docs/components/message-scroller","tags":[],"type":"text","url":"/docs/components/message-scroller#api","content":"The frame fills its parent, clips what is in it, and holds its viewport and its buttons; the list's\ncontent is 32 points apart; a button floats 16 points from its edge."},"1306":{"id":"/docs/components/message","page_id":"/docs/components/message","type":"page","content":"Message","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/message"},"1307":{"id":"/docs/components/message#0","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message","content":"One row of a conversation: the sender's avatar, who they are, the turn, and what is under it."},"1308":{"id":"/docs/components/message#1","page_id":"/docs/components/message","type":"heading","tags":[],"url":"/docs/components/message#installation","content":"Installation"},"1309":{"id":"/docs/components/message#2","page_id":"/docs/components/message","type":"heading","tags":[],"url":"/docs/components/message#usage","content":"Usage"},"1310":{"id":"/docs/components/message#3","page_id":"/docs/components/message","type":"heading","tags":[],"url":"/docs/components/message#composition","content":"Composition"},"1311":{"id":"/docs/components/message#4","page_id":"/docs/components/message","type":"heading","tags":[],"url":"/docs/components/message#examples","content":"Examples"},"1312":{"id":"/docs/components/message#5","page_id":"/docs/components/message","type":"heading","tags":[],"url":"/docs/components/message#alignment","content":"Alignment"},"1313":{"id":"/docs/components/message#6","page_id":"/docs/components/message","type":"heading","tags":[],"url":"/docs/components/message#avatar","content":"Avatar"},"1314":{"id":"/docs/components/message#7","page_id":"/docs/components/message","type":"heading","tags":[],"url":"/docs/components/message#group","content":"Group"},"1315":{"id":"/docs/components/message#8","page_id":"/docs/components/message","type":"heading","tags":[],"url":"/docs/components/message#header-and-footer","content":"Header and footer"},"1316":{"id":"/docs/components/message#9","page_id":"/docs/components/message","type":"heading","tags":[],"url":"/docs/components/message#a-reply-that-is-still-arriving","content":"A reply that is still arriving"},"1317":{"id":"/docs/components/message#10","page_id":"/docs/components/message","type":"heading","tags":[],"url":"/docs/components/message#a-failed-turn","content":"A failed turn"},"1318":{"id":"/docs/components/message#11","page_id":"/docs/components/message","type":"heading","tags":[],"url":"/docs/components/message#rating-a-reply","content":"Rating a reply"},"1319":{"id":"/docs/components/message#12","page_id":"/docs/components/message","type":"heading","tags":[],"url":"/docs/components/message#actions","content":"Actions"},"1320":{"id":"/docs/components/message#13","page_id":"/docs/components/message","type":"heading","tags":[],"url":"/docs/components/message#api","content":"API"},"1321":{"id":"/docs/components/message#14","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1322":{"id":"/docs/components/message#15","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#usage","content":"The examples draw icons with `Icon` from `lib/ui/icons`; see Icons for adding it and picking a size and color."},"1323":{"id":"/docs/components/message#16","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#composition","content":"Use the following composition to build a `Message`:"},"1324":{"id":"/docs/components/message#17","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#alignment","content":"`align=\"end\"` mirrors the row for what you sent: the avatar moves to the end and the column with\nit, so the bubbles inside follow the message — a `Bubble` takes its place from the column unless\nyou give it an `align` of its own."},"1325":{"id":"/docs/components/message#18","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#avatar","content":"`MessageAvatar` is 32 points round (36 on a touch screen), at the bottom of the row. With no\n`children` it is this library's `Avatar`: `name` gives it initials on an identity hue, `src` a\npicture. An avatar with neither keeps the muted circle that holds the row's alignment."},"1326":{"id":"/docs/components/message#19","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#avatar","content":"Give it `children` and it is that same circle as a muted slot — a bot's glyph, or an `Avatar` of\nyour own — centered and clipped to the round. `name` and `src` are not used then. The glyph here\nis 16 points, in the muted ink."},"1327":{"id":"/docs/components/message#20","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#group","content":"`MessageGroup` stacks messages from one sender 8 points apart. Render an empty `MessageAvatar` on\nthe earlier ones to keep them aligned with the avatar on the last."},"1328":{"id":"/docs/components/message#21","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#header-and-footer","content":"`MessageHeader` names the sender above the turn, at the start of the row; `MessageFooter` carries\nwhat is under it — a delivery status — on the message's side. A string child is drawn in the look's\ntype."},"1329":{"id":"/docs/components/message#22","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#a-reply-that-is-still-arriving","content":"A reply arrives a few characters at a time. While it does, `TextView` takes\n`options={{ streaming: true }}` and a `streamingCaret` — a `View` with `textViewCaretClass`, the\ntheme's brand-colored block that pulses — where the next word will land. Before the first word\nthere is no text to hang the caret on, so draw the caret alone in a line as tall as the reply's\ntext and leave the view out."},"1330":{"id":"/docs/components/message#23","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#a-reply-that-is-still-arriving","content":"Stopping is the app's: it keeps the words already received, replaces the `Assistant` name in the\nheader with `Stopped` (a warn `Badge`) and adds a faint row saying what happened. `Resume` streams\nthe rest through the same signals."},"1331":{"id":"/docs/components/message#24","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#a-failed-turn","content":"A turn that fails leaves two marks. The sent turn keeps its place, with a `Spinner` and\n`Waiting for a connection` in its footer while the app retries. The assistant's turn holds a\ndestructive `Alert`: an `AlertCircle`, `AlertTitle` naming the failure, and an `AlertDescription`\nwhose `Retry` button asks for the turn again."},"1332":{"id":"/docs/components/message#25","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#rating-a-reply","content":"What a reply carries under it is the app's: a copy that flips to a check for a moment, and two\nthumbs. `IconButton` takes `selected`, so a pressed thumb shows the brand ink and reports\n`accessibilityState={{ selected: true }}`; the rating itself is only the app's state until the app\nsends it."},"1333":{"id":"/docs/components/message#26","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#actions","content":"Anything else in `MessageFooter` is drawn as given: a row of `IconButton`s, a retry, an error."},"1334":{"id":"/docs/components/message#27","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#api","content":"Every prop of `nsh` View passes through on `MessageGroup`,\n`Message` and `MessageContent` (`role`, `accessibilityLabel`, `style`, …). With no `children`,\n`MessageAvatar` is this library's `Avatar`: `name`, `src`,\n`fallback`, `onStatusChange` and the rest of its props pass through. With `children` it renders a\n`View` (`style`, `accessibilityLabel` and the other host props still pass through; `name`, `src`\nand the image props are not used). A string child of `MessageFooter` and of `MessageHeader` is\ndrawn as `nsh` Text."},"1335":{"id":"/docs/components/message#28","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#api","content":"| Part           | Props | Description                              |\n| -------------- | ----- | ---------------------------------------- |\n| `MessageGroup` |       | Renders `View`: a column, 8 points apart |","table":"table-0"},"1336":{"id":"/docs/components/message#29","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#api","content":"| Part      | Props   | Description                                                                |\n| --------- | ------- | -------------------------------------------------------------------------- |\n| `Message` | `align` | Renders `View`: the avatar and the content, mirrored when `align` is `end` |","table":"table-0"},"1337":{"id":"/docs/components/message#30","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#api","content":"| Part            | Props                     | Description                                         |\n| --------------- | ------------------------- | --------------------------------------------------- |\n| `MessageAvatar` | `name`, `src`, `children` | Renders `Avatar`, or a round `View` with `children` |","table":"table-0"},"1338":{"id":"/docs/components/message#31","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#api","content":"| Part             | Props | Description                                                                |\n| ---------------- | ----- | -------------------------------------------------------------------------- |\n| `MessageContent` |       | Renders `View`: the header, the turn and the footer, on the message's side |","table":"table-0"},"1339":{"id":"/docs/components/message#32","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#api","content":"| Part            | Props      | Description                                          |\n| --------------- | ---------- | ---------------------------------------------------- |\n| `MessageHeader` | `children` | Renders `View`: who sent it, at the start of the row |","table":"table-0"},"1340":{"id":"/docs/components/message#33","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#api","content":"| Part            | Props      | Description                                                   |\n| --------------- | ---------- | ------------------------------------------------------------- |\n| `MessageFooter` | `children` | Renders `View`: what is under the turn, on the message's side |","table":"table-0"},"1341":{"id":"/docs/components/message#34","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#api","content":"| Prop    | On        | Type               | Default |\n| ------- | --------- | ------------------ | ------- |\n| `align` | `Message` | `\"start\" \\| \"end\"` | `start` |","table":"table-1"},"1342":{"id":"/docs/components/message#35","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#api","content":"| Prop   | On              | Type     | Default |\n| ------ | --------------- | -------- | ------- |\n| `name` | `MessageAvatar` | `string` |         |","table":"table-1"},"1343":{"id":"/docs/components/message#36","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#api","content":"| Prop  | On              | Type     | Default |\n| ----- | --------------- | -------- | ------- |\n| `src` | `MessageAvatar` | `string` |         |","table":"table-1"},"1344":{"id":"/docs/components/message#37","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#api","content":"| Prop       | On              | Type          | Default |\n| ---------- | --------------- | ------------- | ------- |\n| `children` | `MessageAvatar` | `JSX.Element` |         |","table":"table-1"},"1345":{"id":"/docs/components/message#38","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#api","content":"| Prop       | On              | Type                    | Default |\n| ---------- | --------------- | ----------------------- | ------- |\n| `children` | `MessageHeader` | `string \\| JSX.Element` |         |","table":"table-1"},"1346":{"id":"/docs/components/message#39","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#api","content":"| Prop       | On              | Type                    | Default |\n| ---------- | --------------- | ----------------------- | ------- |\n| `children` | `MessageFooter` | `string \\| JSX.Element` |         |","table":"table-1"},"1347":{"id":"/docs/components/message#40","page_id":"/docs/components/message","tags":[],"type":"text","url":"/docs/components/message#api","content":"The row is its avatar and its content 8 points apart, the content a column 10 points apart in the\nbody's size; the header and the footer are small (12 with a pointer, 13 on a touch screen), medium\nand in the muted ink, 12 points in from the turn's edge."},"1348":{"id":"/docs/components/nav-stack","page_id":"/docs/components/nav-stack","type":"page","content":"NavStack","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/nav-stack"},"1349":{"id":"/docs/components/nav-stack#0","page_id":"/docs/components/nav-stack","tags":[],"type":"text","url":"/docs/components/nav-stack","content":"Pages pushed on a stack — the system header on a phone, the app's own themed header on a desktop."},"1350":{"id":"/docs/components/nav-stack#1","page_id":"/docs/components/nav-stack","type":"heading","tags":[],"url":"/docs/components/nav-stack#installation","content":"Installation"},"1351":{"id":"/docs/components/nav-stack#2","page_id":"/docs/components/nav-stack","type":"heading","tags":[],"url":"/docs/components/nav-stack#usage","content":"Usage"},"1352":{"id":"/docs/components/nav-stack#3","page_id":"/docs/components/nav-stack","type":"heading","tags":[],"url":"/docs/components/nav-stack#composition","content":"Composition"},"1353":{"id":"/docs/components/nav-stack#4","page_id":"/docs/components/nav-stack","type":"heading","tags":[],"url":"/docs/components/nav-stack#examples","content":"Examples"},"1354":{"id":"/docs/components/nav-stack#5","page_id":"/docs/components/nav-stack","type":"heading","tags":[],"url":"/docs/components/nav-stack#the-stack-and-its-routes","content":"The stack and its routes"},"1355":{"id":"/docs/components/nav-stack#6","page_id":"/docs/components/nav-stack","type":"heading","tags":[],"url":"/docs/components/nav-stack#the-header-on-a-desktop","content":"The header on a desktop"},"1356":{"id":"/docs/components/nav-stack#7","page_id":"/docs/components/nav-stack","type":"heading","tags":[],"url":"/docs/components/nav-stack#the-back-button","content":"The back button"},"1357":{"id":"/docs/components/nav-stack#8","page_id":"/docs/components/nav-stack","type":"heading","tags":[],"url":"/docs/components/nav-stack#your-own-header","content":"Your own header"},"1358":{"id":"/docs/components/nav-stack#9","page_id":"/docs/components/nav-stack","type":"heading","tags":[],"url":"/docs/components/nav-stack#on-a-phone","content":"On a phone"},"1359":{"id":"/docs/components/nav-stack#10","page_id":"/docs/components/nav-stack","type":"heading","tags":[],"url":"/docs/components/nav-stack#a-large-title","content":"A large title"},"1360":{"id":"/docs/components/nav-stack#11","page_id":"/docs/components/nav-stack","type":"heading","tags":[],"url":"/docs/components/nav-stack#asking-before-leaving","content":"Asking before leaving"},"1361":{"id":"/docs/components/nav-stack#12","page_id":"/docs/components/nav-stack","type":"heading","tags":[],"url":"/docs/components/nav-stack#api","content":"API"},"1362":{"id":"/docs/components/nav-stack#13","page_id":"/docs/components/nav-stack","tags":[],"type":"text","url":"/docs/components/nav-stack#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1363":{"id":"/docs/components/nav-stack#14","page_id":"/docs/components/nav-stack","tags":[],"type":"text","url":"/docs/components/nav-stack#composition","content":"Use the following composition to build a `NavStack`:"},"1364":{"id":"/docs/components/nav-stack#15","page_id":"/docs/components/nav-stack","tags":[],"type":"text","url":"/docs/components/nav-stack#examples","content":"shadcn/ui has no navigation stack, and no page of its own; the behavior is NSH's\n`NavStack` — the pages, the transitions, the back gestures\nand the pages kept mounted with their state. This component is that stack and its pages, plus the\nheader a page shows on the desktops and the web, where NSH draws none."},"1365":{"id":"/docs/components/nav-stack#16","page_id":"/docs/components/nav-stack","tags":[],"type":"text","url":"/docs/components/nav-stack#the-stack-and-its-routes","content":"`createNavStack` is `nsh/base`'s, re-exported so a page's navigation is one import; the routes are\nits state, and `routes` is an accessor, so what reads it follows a push or a pop."},"1366":{"id":"/docs/components/nav-stack#17","page_id":"/docs/components/nav-stack","tags":[],"type":"text","url":"/docs/components/nav-stack#the-stack-and-its-routes","content":"`setRoutes` swaps the whole list — a route that stays keeps its page and its state — and `remove`\ntakes the topmost page of a route out. `onChange` reports the routes after a page is added."},"1367":{"id":"/docs/components/nav-stack#18","page_id":"/docs/components/nav-stack","tags":[],"type":"text","url":"/docs/components/nav-stack#the-header-on-a-desktop","content":"A page's `title` is the system header's on iOS and Android, and on the desktops and the web — which\nhave no system header — it is the one `NavPage` draws: a bar's height (the theme's tallest height\nstep, and never under 48 points — shadcn's `h-12`), on the page's fill, a hairline under it, the\ntitle the theme's `title` type role semibold and the room between the back button and the trailing\nslot. It takes the roles the theme keeps for a header wherever it comes from\n(`header.headerStyle`: the page's fill, the text color, the accent for the back button's tint)."},"1368":{"id":"/docs/components/nav-stack#19","page_id":"/docs/components/nav-stack","tags":[],"type":"text","url":"/docs/components/nav-stack#the-header-on-a-desktop","content":"`headerRight` is the system header's trailing item, and this header's: on a desktop it is where the\npage's own action goes, drawn as given. A page with nothing to put in the header — its stack's first\none, no title, no trailing action — shows none, and its content starts at the top."},"1369":{"id":"/docs/components/nav-stack#20","page_id":"/docs/components/nav-stack","tags":[],"type":"text","url":"/docs/components/nav-stack#the-back-button","content":"The header's back button appears while there is a page below it, on the leading edge: this library's\nghost `IconButton` with a `ChevronLeft`, named \"Back\". It does what a platform's back does — calls\n`onBackPress`, then pops unless `popOnBack` is `false`:"},"1370":{"id":"/docs/components/nav-stack#21","page_id":"/docs/components/nav-stack","tags":[],"type":"text","url":"/docs/components/nav-stack#the-back-button","content":"The platform's own back works beside it: Escape, Alt+Left, the mouse's back button and the browser's\nback on the desktops, the swipe on iOS and predictive back on Android. `nsh/base` takes those, calls\n`onBackPress`, and removes the route from the stack's state, so `routes()` follows without the app\ndoing anything."},"1371":{"id":"/docs/components/nav-stack#22","page_id":"/docs/components/nav-stack","tags":[],"type":"text","url":"/docs/components/nav-stack#your-own-header","content":"`header` is `nsh/base`'s slot: give one and `NavPage` draws that instead, as wide as the page and as\ntall as it lays out, with the content below it. `navPageLook()` has the words to build one that\nmatches — `header()`, `title()`, `backGlyph()` and `page()`."},"1372":{"id":"/docs/components/nav-stack#23","page_id":"/docs/components/nav-stack","tags":[],"type":"text","url":"/docs/components/nav-stack#your-own-header","content":"A header of the app's own still answers Back, and knows where in the stack it is: `header` takes a\nfunction of the page, which is handed the slot the drawn header reads. `back()` is what that header's\nback button does — `onBackPress`, then `pop()` unless `popOnBack` is `false`; `pages()` is how many\nroutes the stack holds, so a header can show a back button only when there is one to go to."},"1373":{"id":"/docs/components/nav-stack#24","page_id":"/docs/components/nav-stack","tags":[],"type":"text","url":"/docs/components/nav-stack#your-own-header","content":"A header that is the one `NavPage` draws with something added to it composes `PageHeader` instead of\ndrawing the bar again: it keeps the back button, the title and the trailing slot in the header's\nlook, and Back still calls `onBackPress` before it pops."},"1374":{"id":"/docs/components/nav-stack#25","page_id":"/docs/components/nav-stack","tags":[],"type":"text","url":"/docs/components/nav-stack#your-own-header","content":"A header that is not this one at all is still built from `navPageLook()`'s words — `header()`,\n`title()` and `backGlyph()` — as any content of the app's is:"},"1375":{"id":"/docs/components/nav-stack#26","page_id":"/docs/components/nav-stack","tags":[],"type":"text","url":"/docs/components/nav-stack#your-own-header","content":"It is a function, not a bare element, because `nsh/base` mounts the header in the page's own header\nhost: what the page provides around its content does not reach there, so an element passed as\n`header` could not read the page it heads."},"1376":{"id":"/docs/components/nav-stack#27","page_id":"/docs/components/nav-stack","tags":[],"type":"text","url":"/docs/components/nav-stack#on-a-phone","content":"iOS shows `UINavigationController`'s header and Android its toolbar, with the system's transitions,\nthe swipe back and predictive back; this component draws nothing of the header there, and `title`,\n`headerLeft`, `headerRight`, `headerStyle`, `headerLargeTitle`, `hidesBottomBarWhenPushed` and\n`statusBar` are the platform's. The header does not follow the theme unless the app says so: pass\n`headerStyle={header.headerStyle}` from `@shadcn-nsh/theme` for the page's fill, the text color and\nthe accent, which is what the desktop header wears already."},"1377":{"id":"/docs/components/nav-stack#28","page_id":"/docs/components/nav-stack","tags":[],"type":"text","url":"/docs/components/nav-stack#a-large-title","content":"On iOS `headerLargeTitle` is the platform's: a large title in the content that shrinks into the bar\nas the page scrolls. The desktops and the web have no such header, so the page draws one: the large\ntitle is the first thing in the `Scroll`, and a header of the app's own keeps the small title in the\nbar once the large one has scrolled past."},"1378":{"id":"/docs/components/nav-stack#29","page_id":"/docs/components/nav-stack","tags":[],"type":"text","url":"/docs/components/nav-stack#a-large-title","content":"The header keeps its height and only its title changes, so the content starts under the bar at every\noffset — which is what the platform's large title does there too. The header is a function so the\npage closes its own offset over it, and the title's child is an accessor, so the title re-reads the\noffset as the page moves."},"1379":{"id":"/docs/components/nav-stack#30","page_id":"/docs/components/nav-stack","tags":[],"type":"text","url":"/docs/components/nav-stack#asking-before-leaving","content":"`popOnBack` says whether the back button pops; `onBackPress` hears every back — the header's button\nand the platform's (Escape, Alt+Left, the mouse's back button, the swipe). A page with unsaved text\nturns the first off, asks in an alert, and pops only when the answer discards:"},"1380":{"id":"/docs/components/nav-stack#31","page_id":"/docs/components/nav-stack","tags":[],"type":"text","url":"/docs/components/nav-stack#asking-before-leaving","content":"With nothing to lose (`popOnBack` true) the same back press pops without the alert, so the guard\ndisappears the moment the text does."},"1381":{"id":"/docs/components/nav-stack#32","page_id":"/docs/components/nav-stack","tags":[],"type":"text","url":"/docs/components/nav-stack#api","content":"`NavStack` and `NavPage` take every prop of\n`nsh/base`'s NavStack and NavPage; `style` goes over the look's. `createNavStack`,\n`NavStackState` and `NavStackChangeEvent` are `nsh/base`'s, re-exported."},"1382":{"id":"/docs/components/nav-stack#33","page_id":"/docs/components/nav-stack","tags":[],"type":"text","url":"/docs/components/nav-stack#api","content":"| Part       | Props                           | Description                                                                     |\n| ---------- | ------------------------------- | ------------------------------------------------------------------------------- |\n| `NavStack` | `state`, `children`, `onChange` | `state` from `createNavStack`; `children(route, index)`; `onChange({ routes })` |","table":"table-0"},"1383":{"id":"/docs/components/nav-stack#34","page_id":"/docs/components/nav-stack","tags":[],"type":"text","url":"/docs/components/nav-stack#api","content":"| Part      | Props                                                        | Description                                                                          |\n| --------- | ------------------------------------------------------------ | ------------------------------------------------------------------------------------ |\n| `NavPage` | `title`, `headerRight`, `header`, `onBackPress`, `popOnBack` | The page's header on the desktops and the web; `header` takes a function of the page |","table":"table-0"},"1384":{"id":"/docs/components/nav-stack#35","page_id":"/docs/components/nav-stack","tags":[],"type":"text","url":"/docs/components/nav-stack#api","content":"| Part         | Props                             | Description                                                                              |\n| ------------ | --------------------------------- | ---------------------------------------------------------------------------------------- |\n| `PageHeader` | `title`, `right`, `back`, `above` | The drawn header, for a `header` that adds to it; `above()` says whether a page is below |","table":"table-0"},"1385":{"id":"/docs/components/nav-stack#36","page_id":"/docs/components/nav-stack","tags":[],"type":"text","url":"/docs/components/nav-stack#api","content":"| Part             | Props                                                                  | Description               |\n| ---------------- | ---------------------------------------------------------------------- | ------------------------- |\n| `createNavStack` | `routes`, `push`, `pop`, `popToRoot`, `replace`, `setRoutes`, `remove` | `nsh/base`'s, re-exported |","table":"table-0"},"1386":{"id":"/docs/components/nav-stack#37","page_id":"/docs/components/nav-stack","tags":[],"type":"text","url":"/docs/components/nav-stack#api","content":"The page's look — spread it on the views it names, or read its words for content of your own:\n`navPageLook()` (`page`, `header`, `title`, `backGlyph`)."},"1387":{"id":"/docs/components/navigation-menu","page_id":"/docs/components/navigation-menu","type":"page","content":"Navigation Menu","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/navigation-menu"},"1388":{"id":"/docs/components/navigation-menu#0","page_id":"/docs/components/navigation-menu","tags":[],"type":"text","url":"/docs/components/navigation-menu","content":"A row of triggers, each opening a panel of anything under the bar — one at a time."},"1389":{"id":"/docs/components/navigation-menu#1","page_id":"/docs/components/navigation-menu","type":"heading","tags":[],"url":"/docs/components/navigation-menu#installation","content":"Installation"},"1390":{"id":"/docs/components/navigation-menu#2","page_id":"/docs/components/navigation-menu","type":"heading","tags":[],"url":"/docs/components/navigation-menu#usage","content":"Usage"},"1391":{"id":"/docs/components/navigation-menu#3","page_id":"/docs/components/navigation-menu","type":"heading","tags":[],"url":"/docs/components/navigation-menu#composition","content":"Composition"},"1392":{"id":"/docs/components/navigation-menu#4","page_id":"/docs/components/navigation-menu","type":"heading","tags":[],"url":"/docs/components/navigation-menu#examples","content":"Examples"},"1393":{"id":"/docs/components/navigation-menu#5","page_id":"/docs/components/navigation-menu","type":"heading","tags":[],"url":"/docs/components/navigation-menu#the-bar","content":"The bar"},"1394":{"id":"/docs/components/navigation-menu#6","page_id":"/docs/components/navigation-menu","type":"heading","tags":[],"url":"/docs/components/navigation-menu#what-a-trigger-opens","content":"What a trigger opens"},"1395":{"id":"/docs/components/navigation-menu#7","page_id":"/docs/components/navigation-menu","type":"heading","tags":[],"url":"/docs/components/navigation-menu#a-link-in-a-panel","content":"A link in a panel"},"1396":{"id":"/docs/components/navigation-menu#8","page_id":"/docs/components/navigation-menu","type":"heading","tags":[],"url":"/docs/components/navigation-menu#a-bar-item-that-is-a-link","content":"A bar item that is a link"},"1397":{"id":"/docs/components/navigation-menu#9","page_id":"/docs/components/navigation-menu","type":"heading","tags":[],"url":"/docs/components/navigation-menu#api","content":"API"},"1398":{"id":"/docs/components/navigation-menu#10","page_id":"/docs/components/navigation-menu","tags":[],"type":"text","url":"/docs/components/navigation-menu#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1399":{"id":"/docs/components/navigation-menu#11","page_id":"/docs/components/navigation-menu","tags":[],"type":"text","url":"/docs/components/navigation-menu#composition","content":"Use the following composition to build a `NavigationMenu`:"},"1400":{"id":"/docs/components/navigation-menu#12","page_id":"/docs/components/navigation-menu","tags":[],"type":"text","url":"/docs/components/navigation-menu#the-bar","content":"`NavigationMenu` is a navigation landmark (`role=\"navigation\"`, named `\"Navigation\"` unless\n`accessibilityLabel` says otherwise) as wide as the app gives it, holding a `NavigationMenuList`: a\nrow of items 4 points apart with a pointer (6 on a touch screen), wrapping onto a second line when\nthe window is narrow. An item is its trigger, or a link of its own. A trigger is drawn by its\nitem's content, which is what places it in the bar: a `NavigationMenuTrigger` declared after its\n`NavigationMenuContent` draws nothing."},"1401":{"id":"/docs/components/navigation-menu#13","page_id":"/docs/components/navigation-menu","tags":[],"type":"text","url":"/docs/components/navigation-menu#the-bar","content":"A trigger is the theme's tallest height step high and 16 points in either side, its name in the\nbar's type and a chevron after it — the theme's smallest icon, an indicator's."},"1402":{"id":"/docs/components/navigation-menu#14","page_id":"/docs/components/navigation-menu","tags":[],"type":"text","url":"/docs/components/navigation-menu#what-a-trigger-opens","content":"A panel: `NavigationMenuContent` mounts `nsh/base` Popover on the\nshared popup surface (`popupSurface`: one edge, the menu tier's shadow, the theme's radius) 10 points\nof room inside (12 on a touch screen), placed against its trigger — `bottom` and `start` unless\n`placement`, `align` and `offset` say otherwise — so it takes that trigger's width unless `width`\nnames another. What goes in it is the app's: a grid of links, a card\nwith a description, a form."},"1403":{"id":"/docs/components/navigation-menu#15","page_id":"/docs/components/navigation-menu","tags":[],"type":"text","url":"/docs/components/navigation-menu#what-a-trigger-opens","content":"Only one panel is open at a time, and the root owns which: `value` (controlled) or `defaultValue`,\nreported by `onValueChange({ value, reason })`. The open trigger wears the `accent` fill at half and\nits chevron turns 180° — at once under reduced motion, in 200 ms otherwise."},"1404":{"id":"/docs/components/navigation-menu#16","page_id":"/docs/components/navigation-menu","tags":[],"type":"text","url":"/docs/components/navigation-menu#what-a-trigger-opens","content":"A press opens and closes a panel (Return or Space with the keyboard on the trigger), and on a desktop\nthe pointer's rest opens one too: 200 ms on a trigger (`delayDuration`), and the panel closes 300 ms\nafter the pointer has left both the trigger and the panel (`closeDelay`) — time to cross from one to\nthe other, not to browse. `Infinity` turns that off: only presses and the keyboard, or only Escape and\na press outside. A touch screen has no pointer to rest, so a tap opens and closes there."},"1405":{"id":"/docs/components/navigation-menu#17","page_id":"/docs/components/navigation-menu","tags":[],"type":"text","url":"/docs/components/navigation-menu#a-link-in-a-panel","content":"`NavigationMenuLink` is `nsh/base` Link in the bar's look: a name 13\npoints medium (15 on a touch screen) and, under it, a description in the muted ink. `active` is the\npage the app is on — the `accent` fill at half, and announced as the current page."},"1406":{"id":"/docs/components/navigation-menu#18","page_id":"/docs/components/navigation-menu","tags":[],"type":"text","url":"/docs/components/navigation-menu#a-link-in-a-panel","content":"It goes somewhere with `href` and `openWith`, or reports a press — and on the web a link with an\n`href` shows no hover of its own, so a navigation menu's links are usually `onPress`. A `style` goes\nover the look's: the demo's leading card is one link on the inset surface of\n`lib/ui/surface` (`insetSurface()`)."},"1407":{"id":"/docs/components/navigation-menu#19","page_id":"/docs/components/navigation-menu","tags":[],"type":"text","url":"/docs/components/navigation-menu#a-bar-item-that-is-a-link","content":"The current page is often a plain link standing where a trigger would:"},"1408":{"id":"/docs/components/navigation-menu#20","page_id":"/docs/components/navigation-menu","tags":[],"type":"text","url":"/docs/components/navigation-menu#a-bar-item-that-is-a-link","content":"A `NavigationMenuTrigger` or `NavigationMenuLink` that is not a string is drawn as given, so an icon\ncan lead a name."},"1409":{"id":"/docs/components/navigation-menu#21","page_id":"/docs/components/navigation-menu","tags":[],"type":"text","url":"/docs/components/navigation-menu#api","content":"The root owns the open item and the two delays; a panel mounts `nsh/base` Popover\nand every base prop passes through except the trigger, the open state and the lifecycle callbacks."},"1410":{"id":"/docs/components/navigation-menu#22","page_id":"/docs/components/navigation-menu","tags":[],"type":"text","url":"/docs/components/navigation-menu#api","content":"| Part             | Props                                                                   | Description                                 |\n| ---------------- | ----------------------------------------------------------------------- | ------------------------------------------- |\n| `NavigationMenu` | `value`, `defaultValue`, `onValueChange`, `delayDuration`, `closeDelay` | `onValueChange` reports `{ value, reason }` |","table":"table-0"},"1411":{"id":"/docs/components/navigation-menu#23","page_id":"/docs/components/navigation-menu","tags":[],"type":"text","url":"/docs/components/navigation-menu#api","content":"| Part                 | Props | Description      |\n| -------------------- | ----- | ---------------- |\n| `NavigationMenuList` |       | The wrapping row |","table":"table-0"},"1412":{"id":"/docs/components/navigation-menu#24","page_id":"/docs/components/navigation-menu","tags":[],"type":"text","url":"/docs/components/navigation-menu#api","content":"| Part                 | Props                          | Description                                                          |\n| -------------------- | ------------------------------ | -------------------------------------------------------------------- |\n| `NavigationMenuItem` | `value`; every `nsh` view prop | `value` is what the root opens; a trigger and its content, or a link |","table":"table-0"},"1413":{"id":"/docs/components/navigation-menu#25","page_id":"/docs/components/navigation-menu","tags":[],"type":"text","url":"/docs/components/navigation-menu#api","content":"| Part                    | Props                             | Description                                |\n| ----------------------- | --------------------------------- | ------------------------------------------ |\n| `NavigationMenuTrigger` | `disabled`; every `nsh` view prop | A string is the name, a chevron follows it |","table":"table-0"},"1414":{"id":"/docs/components/navigation-menu#26","page_id":"/docs/components/navigation-menu","tags":[],"type":"text","url":"/docs/components/navigation-menu#api","content":"| Part                    | Props                                                              | Description                                                               |\n| ----------------------- | ------------------------------------------------------------------ | ------------------------------------------------------------------------- |\n| `NavigationMenuContent` | `width`, `placement`, `align`, `offset`, `margin`, `closeOnEscape` | The panel; `margin` and `closeOnEscape` are base's, and more pass through |","table":"table-0"},"1415":{"id":"/docs/components/navigation-menu#27","page_id":"/docs/components/navigation-menu","tags":[],"type":"text","url":"/docs/components/navigation-menu#api","content":"| Part                 | Props                                                        | Description |\n| -------------------- | ------------------------------------------------------------ | ----------- |\n| `NavigationMenuLink` | `href`, `openWith`, `onPress`, `active`, `disabled`, `style` | A link      |","table":"table-0"},"1416":{"id":"/docs/components/navigation-menu#28","page_id":"/docs/components/navigation-menu","tags":[],"type":"text","url":"/docs/components/navigation-menu#api","content":"`NavigationMenuItem` and `NavigationMenuTrigger` spread the view props they are given on their own\nview, after the look (`style` included), and merge a given `hoverStyle`, `activeStyle`,\n`focusVisibleStyle` or `disabledStyle` after the look's own; the trigger keeps the pointer's enter\nand leave, which drive the item's delays. `NavigationMenu` and `NavigationMenuList` do the same on the root and the\nrow."},"1417":{"id":"/docs/components/navigation-menu#29","page_id":"/docs/components/navigation-menu","tags":[],"type":"text","url":"/docs/components/navigation-menu#api","content":"The look is `navigationMenuLook()` — `root`, `list`, `item`, `panel`, `link`, `linkText`,\n`linkHint` — and `navigationMenuTriggerLook({ open })` for a trigger. Spread them on the part they\nname."},"1418":{"id":"/docs/components/number-input","page_id":"/docs/components/number-input","type":"page","content":"Number Input","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/number-input"},"1419":{"id":"/docs/components/number-input#0","page_id":"/docs/components/number-input","tags":[],"type":"text","url":"/docs/components/number-input","content":"A sunk number field with − / + or stacked chevron steppers."},"1420":{"id":"/docs/components/number-input#1","page_id":"/docs/components/number-input","type":"heading","tags":[],"url":"/docs/components/number-input#installation","content":"Installation"},"1421":{"id":"/docs/components/number-input#2","page_id":"/docs/components/number-input","type":"heading","tags":[],"url":"/docs/components/number-input#usage","content":"Usage"},"1422":{"id":"/docs/components/number-input#3","page_id":"/docs/components/number-input","type":"heading","tags":[],"url":"/docs/components/number-input#examples","content":"Examples"},"1423":{"id":"/docs/components/number-input#4","page_id":"/docs/components/number-input","type":"heading","tags":[],"url":"/docs/components/number-input#split-steppers","content":"Split steppers"},"1424":{"id":"/docs/components/number-input#5","page_id":"/docs/components/number-input","type":"heading","tags":[],"url":"/docs/components/number-input#pair-steppers","content":"Pair steppers"},"1425":{"id":"/docs/components/number-input#6","page_id":"/docs/components/number-input","type":"heading","tags":[],"url":"/docs/components/number-input#a-rolling-figure","content":"A rolling figure"},"1426":{"id":"/docs/components/number-input#7","page_id":"/docs/components/number-input","type":"heading","tags":[],"url":"/docs/components/number-input#api","content":"API"},"1427":{"id":"/docs/components/number-input#8","page_id":"/docs/components/number-input","tags":[],"type":"text","url":"/docs/components/number-input#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1428":{"id":"/docs/components/number-input#9","page_id":"/docs/components/number-input","tags":[],"type":"text","url":"/docs/components/number-input#pair-steppers","content":"Default `pair`: chevrons stacked at the end. `split`: − before the field and + after it."},"1429":{"id":"/docs/components/number-input#10","page_id":"/docs/components/number-input","tags":[],"type":"text","url":"/docs/components/number-input#a-rolling-figure","content":"The field draws its own glyphs, and the caret lives in them, so the digits inside the field do not roll. `Roll` (`@/lib/ui/motion`, the `motion` registry item, which `input` installs) is the figure beside it — upstream's ticker. It rolls on the theme's `control` spring. The first value is already there. Less motion replaces it in place."},"1430":{"id":"/docs/components/number-input#11","page_id":"/docs/components/number-input","tags":[],"type":"text","url":"/docs/components/number-input#api","content":"Every prop of `nsh/base` NumberInput passes through. `class`, `inputStyle` and the step props go over the look's."},"1431":{"id":"/docs/components/number-input#12","page_id":"/docs/components/number-input","tags":[],"type":"text","url":"/docs/components/number-input#api","content":"| Part          | Props                                           | Description                                         |\n| ------------- | ----------------------------------------------- | --------------------------------------------------- |\n| `NumberInput` | `steps` (`\"split\" \\| \"pair\"`, default `\"pair\"`) | Every prop of `nsh/base` NumberInput passes through |","table":"table-0"},"1432":{"id":"/docs/components/otp-input","page_id":"/docs/components/otp-input","type":"page","content":"OTP Input","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/otp-input"},"1433":{"id":"/docs/components/otp-input#0","page_id":"/docs/components/otp-input","tags":[],"type":"text","url":"/docs/components/otp-input","content":"One-time code cells that lift out of sunk wells as digits fill in."},"1434":{"id":"/docs/components/otp-input#1","page_id":"/docs/components/otp-input","type":"heading","tags":[],"url":"/docs/components/otp-input#installation","content":"Installation"},"1435":{"id":"/docs/components/otp-input#2","page_id":"/docs/components/otp-input","type":"heading","tags":[],"url":"/docs/components/otp-input#usage","content":"Usage"},"1436":{"id":"/docs/components/otp-input#3","page_id":"/docs/components/otp-input","type":"heading","tags":[],"url":"/docs/components/otp-input#examples","content":"Examples"},"1437":{"id":"/docs/components/otp-input#4","page_id":"/docs/components/otp-input","type":"heading","tags":[],"url":"/docs/components/otp-input#tone","content":"Tone"},"1438":{"id":"/docs/components/otp-input#5","page_id":"/docs/components/otp-input","type":"heading","tags":[],"url":"/docs/components/otp-input#verdict","content":"Verdict"},"1439":{"id":"/docs/components/otp-input#6","page_id":"/docs/components/otp-input","type":"heading","tags":[],"url":"/docs/components/otp-input#a-verdict-that-changes","content":"A verdict that changes"},"1440":{"id":"/docs/components/otp-input#7","page_id":"/docs/components/otp-input","type":"heading","tags":[],"url":"/docs/components/otp-input#api","content":"API"},"1441":{"id":"/docs/components/otp-input#8","page_id":"/docs/components/otp-input","tags":[],"type":"text","url":"/docs/components/otp-input#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1442":{"id":"/docs/components/otp-input#9","page_id":"/docs/components/otp-input","tags":[],"type":"text","url":"/docs/components/otp-input#verdict","content":"A verdict tints every cell of the whole code."},"1443":{"id":"/docs/components/otp-input#10","page_id":"/docs/components/otp-input","tags":[],"type":"text","url":"/docs/components/otp-input#api","content":"Every prop of `nsh/base` OtpInput passes through. Cell and caret props go over the look's."},"1444":{"id":"/docs/components/otp-input#11","page_id":"/docs/components/otp-input","tags":[],"type":"text","url":"/docs/components/otp-input#api","content":"| Part       | Props                                                                                                     | Description                                                                                                                     |\n| ---------- | --------------------------------------------------------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------------- |\n| `OtpInput` | `cells` (`string`, default `otpCells`), `tone` (`Tone \\| (() => Tone \\| undefined)`), `reject` (`number`) | Cell and caret props go over the look's. `reject` shakes the cells each time it becomes a new number; less motion plays nothing |","table":"table-0"},"1445":{"id":"/docs/components/pagination","page_id":"/docs/components/pagination","type":"page","content":"Pagination","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/pagination"},"1446":{"id":"/docs/components/pagination#0","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination","content":"Page numbers and chevrons with the current page lit primary."},"1447":{"id":"/docs/components/pagination#1","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#installation","content":"Installation"},"1448":{"id":"/docs/components/pagination#2","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#usage","content":"Usage"},"1449":{"id":"/docs/components/pagination#3","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#examples","content":"Examples"},"1450":{"id":"/docs/components/pagination#4","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#compact","content":"Compact"},"1451":{"id":"/docs/components/pagination#5","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#custom-items","content":"Custom items"},"1452":{"id":"/docs/components/pagination#6","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#a-jump-menu","content":"A jump menu"},"1453":{"id":"/docs/components/pagination#7","page_id":"/docs/components/pagination","type":"heading","tags":[],"url":"/docs/components/pagination#api","content":"API"},"1454":{"id":"/docs/components/pagination#8","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1455":{"id":"/docs/components/pagination#9","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#compact","content":"A `compact` pager keeps Previous, a child label, and Next on one row."},"1456":{"id":"/docs/components/pagination#10","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#a-jump-menu","content":"`renderItem` draws every item, the ellipsis included, and an ellipsis is handed the run it hides:\n`start`, the first page left out, and `end`, the page after the last. Drawing that item as a `Menu`\nis what makes a ten-thousand-page archive navigable — the pages of the run nearest the one shown,\na First page and a Last page, the rest through the arrows. `disabled` (an offline archive) makes\nevery item inert, the ellipsis with them."},"1457":{"id":"/docs/components/pagination#11","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#api","content":"Uses `paginationItemClass` and `paginationArrows` by default. Every prop of `nsh/base` Pagination passes through."},"1458":{"id":"/docs/components/pagination#12","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#api","content":"| Part         | Props                                                                                                                                                          | Description                                                                                                                                  |\n| ------------ | -------------------------------------------------------------------------------------------------------------------------------------------------------------- | -------------------------------------------------------------------------------------------------------------------------------------------- |\n| `Pagination` | `variant` (`PaginationVariant`; `default`, or `outline` on the ends), `compact` (`boolean`; label slot between ends), `page` (`number`; current page, 1-based) | Uses `paginationItemClass` and `paginationArrows` by default; `renderItem` draws every item, an ellipsis' `start` and `end` the run it hides |","table":"table-0"},"1459":{"id":"/docs/components/pagination#13","page_id":"/docs/components/pagination","tags":[],"type":"text","url":"/docs/components/pagination#api","content":"`PaginationVariant` is `\"default\" | \"outline\"`; `paginationItemClass` takes the same word, as\n`PaginationItemClassOptions`' `variant`."},"1460":{"id":"/docs/components/plot","page_id":"/docs/components/plot","type":"page","content":"Plot","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/plot"},"1461":{"id":"/docs/components/plot#0","page_id":"/docs/components/plot","tags":[],"type":"text","url":"/docs/components/plot","content":"Chart colors, grid, cross line and tooltip for nsh/base/plot."},"1462":{"id":"/docs/components/plot#1","page_id":"/docs/components/plot","type":"heading","tags":[],"url":"/docs/components/plot#installation","content":"Installation"},"1463":{"id":"/docs/components/plot#2","page_id":"/docs/components/plot","type":"heading","tags":[],"url":"/docs/components/plot#usage","content":"Usage"},"1464":{"id":"/docs/components/plot#3","page_id":"/docs/components/plot","type":"heading","tags":[],"url":"/docs/components/plot#examples","content":"Examples"},"1465":{"id":"/docs/components/plot#4","page_id":"/docs/components/plot","type":"heading","tags":[],"url":"/docs/components/plot#legend","content":"Legend"},"1466":{"id":"/docs/components/plot#5","page_id":"/docs/components/plot","type":"heading","tags":[],"url":"/docs/components/plot#line-and-area","content":"Line and area"},"1467":{"id":"/docs/components/plot#6","page_id":"/docs/components/plot","type":"heading","tags":[],"url":"/docs/components/plot#cross-line","content":"Cross line"},"1468":{"id":"/docs/components/plot#7","page_id":"/docs/components/plot","type":"heading","tags":[],"url":"/docs/components/plot#axis-labels","content":"Axis labels"},"1469":{"id":"/docs/components/plot#8","page_id":"/docs/components/plot","type":"heading","tags":[],"url":"/docs/components/plot#a-label-on-a-tile","content":"A label on a tile"},"1470":{"id":"/docs/components/plot#9","page_id":"/docs/components/plot","type":"heading","tags":[],"url":"/docs/components/plot#a-sparkline","content":"A sparkline"},"1471":{"id":"/docs/components/plot#10","page_id":"/docs/components/plot","type":"heading","tags":[],"url":"/docs/components/plot#bars-and-a-donut","content":"Bars and a donut"},"1472":{"id":"/docs/components/plot#11","page_id":"/docs/components/plot","type":"heading","tags":[],"url":"/docs/components/plot#candles-with-volume","content":"Candles with volume"},"1473":{"id":"/docs/components/plot#12","page_id":"/docs/components/plot","type":"heading","tags":[],"url":"/docs/components/plot#api","content":"API"},"1474":{"id":"/docs/components/plot#13","page_id":"/docs/components/plot","tags":[],"type":"text","url":"/docs/components/plot#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1475":{"id":"/docs/components/plot#14","page_id":"/docs/components/plot","tags":[],"type":"text","url":"/docs/components/plot#line-and-area","content":"`Plot` takes the rows and the axis; `Area`, `Line` and `Grid` are the marks."},"1476":{"id":"/docs/components/plot#15","page_id":"/docs/components/plot","tags":[],"type":"text","url":"/docs/components/plot#a-label-on-a-tile","content":"A `Treemap` or `Bar` tile filled with a chart role takes two inks: a light tile reads a dark\nlabel, a dark one a light label. `nsh/base/plot` sets `data-dark` on a label whose cell's colour\nis dark, so `labelClass` names both:"},"1477":{"id":"/docs/components/plot#16","page_id":"/docs/components/plot","tags":[],"type":"text","url":"/docs/components/plot#a-label-on-a-tile","content":"`foreground` stays out of the appearance (dark in light and dark alike); `on-media` is the\nwhite the theme keeps for a dark ground. Keep the scale's midpoint opaque: a fill mixed with the\nbackground reads as a dark cell, and every label then wears the light ink, pale tiles included."},"1478":{"id":"/docs/components/plot#17","page_id":"/docs/components/plot","tags":[],"type":"text","url":"/docs/components/plot#a-sparkline","content":"A row's chart is a `Plot` with `interactive={false}`: no cross line, no hover dot, just the line. The\nwash under it is `plotWash`, the previous close a dashed `Grid` at that value with\n`plotReference`, and the newest point a second `Plot` over the first — only the last row in it — so\nits `Dot` can be a ring around a solid centre."},"1479":{"id":"/docs/components/plot#18","page_id":"/docs/components/plot","tags":[],"type":"text","url":"/docs/components/plot#a-sparkline","content":"The domain is padded by a fifth of the range so the ring is not clipped at the top or the bottom;\n`tone` is the theme's `up` or `down`, the same role the figure beside it uses."},"1480":{"id":"/docs/components/plot#19","page_id":"/docs/components/plot","tags":[],"type":"text","url":"/docs/components/plot#bars-and-a-donut","content":"A grouped or stacked bar chart keeps its bands on the x scale and its baseline in the theme's\nborder: `paddingInner` and `paddingOuter` set the gap, `maxBandWidth` stops a wide window from\nstretching a bar."},"1481":{"id":"/docs/components/plot#20","page_id":"/docs/components/plot","tags":[],"type":"text","url":"/docs/components/plot#bars-and-a-donut","content":"A donut is a `Pie` with an `innerRadius` in percent and a small `padAngle`; the figure in its hole\nis a view placed over the plot, not a label the plot writes:"},"1482":{"id":"/docs/components/plot#21","page_id":"/docs/components/plot","tags":[],"type":"text","url":"/docs/components/plot#candles-with-volume","content":"A candle is a `Bar` from the open to the close and a `Rule` from the low to the high, both colored\nby a `\"dir\"` category. The volume is a second `Plot` under the price one, sharing its band scale so\nthe bars line up, with its own right axis:"},"1483":{"id":"/docs/components/plot#22","page_id":"/docs/components/plot","tags":[],"type":"text","url":"/docs/components/plot#candles-with-volume","content":"Give both plots the same `colorScale` (`{ type: \"ordinal\", domain: [\"up\", \"down\"], range: [up, down] }`)\nso a day's candle and its volume bar are one color."},"1484":{"id":"/docs/components/plot#23","page_id":"/docs/components/plot","tags":[],"type":"text","url":"/docs/components/plot#api","content":"Uses `plotCrossLine` and `plotDotClass` by default. Every prop of `nsh/base/plot` Plot passes through."},"1485":{"id":"/docs/components/plot#24","page_id":"/docs/components/plot","tags":[],"type":"text","url":"/docs/components/plot#api","content":"`Plot` does not expose its scales or a canvas the app can paint on. The geometry, including the insets the axis labels take, is computed in `nsh/base` (`references/nsh/crates/nsh-base/src/plot/mod.rs`: the plot around line 800, the y insets around 803–812, the y map around 902–926, and `.child` around 1361; `axis.rs` `label_insets` around line 474). Copying that inset in JavaScript would drift from the line, so this library does not add an overlay hook. A wash over a band is `plotWash`."},"1486":{"id":"/docs/components/plot#25","page_id":"/docs/components/plot","tags":[],"type":"text","url":"/docs/components/plot#api","content":"Also export `Legend` for a colored square and label beside a chart."},"1487":{"id":"/docs/components/plot#26","page_id":"/docs/components/plot","tags":[],"type":"text","url":"/docs/components/plot#api","content":"| Part   | Props              | Description                                        |\n| ------ | ------------------ | -------------------------------------------------- |\n| `Plot` | `band` (`boolean`) | Uses `plotCrossLine` and `plotDotClass` by default |","table":"table-0"},"1488":{"id":"/docs/components/plot#27","page_id":"/docs/components/plot","tags":[],"type":"text","url":"/docs/components/plot#api","content":"| Part     | Props | Description                               |\n| -------- | ----- | ----------------------------------------- |\n| `Legend` |       | A colored square and label beside a chart |","table":"table-0"},"1489":{"id":"/docs/components/popover","page_id":"/docs/components/popover","type":"page","content":"Popover","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/popover"},"1490":{"id":"/docs/components/popover#0","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover","content":"A popup panel that grows from its trigger, on the shared menu surface."},"1491":{"id":"/docs/components/popover#1","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#installation","content":"Installation"},"1492":{"id":"/docs/components/popover#2","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#usage","content":"Usage"},"1493":{"id":"/docs/components/popover#3","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#composition","content":"Composition"},"1494":{"id":"/docs/components/popover#4","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#examples","content":"Examples"},"1495":{"id":"/docs/components/popover#5","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#with-a-header","content":"With a header"},"1496":{"id":"/docs/components/popover#6","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#compact","content":"Compact"},"1497":{"id":"/docs/components/popover#7","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#content-with-its-own-frame","content":"Content with its own frame"},"1498":{"id":"/docs/components/popover#8","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#placement","content":"Placement"},"1499":{"id":"/docs/components/popover#9","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#a-trigger-of-your-own","content":"A trigger of your own"},"1500":{"id":"/docs/components/popover#10","page_id":"/docs/components/popover","type":"heading","tags":[],"url":"/docs/components/popover#api","content":"API"},"1501":{"id":"/docs/components/popover#11","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1502":{"id":"/docs/components/popover#12","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#composition","content":"Use the following composition to build a `Popover`:"},"1503":{"id":"/docs/components/popover#13","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#with-a-header","content":"`PopoverHeader`, `PopoverTitle` and `PopoverDescription` are layout and text: upstream writes a\npopover's content inline, so give them the app's type with `style`."},"1504":{"id":"/docs/components/popover#14","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#compact","content":"A line or two: 12 points of padding and 4 between rows."},"1505":{"id":"/docs/components/popover#15","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#content-with-its-own-frame","content":"`style` goes over the surface: a panel that brings its own padding, such as an emoji panel, drops the\npopover's."},"1506":{"id":"/docs/components/popover#16","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#a-trigger-of-your-own","content":"A string child is a `Button` (`variant`, `secondary` by default). A single element child is\nthe trigger itself, with no wrapper: its look, `testID`, name, own press, hover, active and\nfocus styles all stay, and `nsh/base` adds the open state to it, so `expandedStyle` and\n`expanded:` classes answer the popup. `variant`, `disabled` and `style` shape a string\nchild; an element brings its own (its `disabled` is the one that counts)."},"1507":{"id":"/docs/components/popover#17","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#api","content":"The root owns the open flag; `PopoverContent` mounts `nsh/base` Popover and every base prop passes through except those. Its children come in on a `PopIn` with `popoverLook` (the surface, 14 points of padding with a pointer and 16 on a touch screen); `class` and `style` go over that surface."},"1508":{"id":"/docs/components/popover#18","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#api","content":"| Part      | Props                                                                  | Description                 |\n| --------- | ---------------------------------------------------------------------- | --------------------------- |\n| `Popover` | `open`, `defaultOpen`, `onOpenChange`, `onOpen`, `onClose`, `onCancel` | The root owns the open flag |","table":"table-0"},"1509":{"id":"/docs/components/popover#19","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#api","content":"| Part             | Props                          | Description                                                |\n| ---------------- | ------------------------------ | ---------------------------------------------------------- |\n| `PopoverTrigger` | `variant`, `disabled`, `style` | A string child's `Button`; an element child is the trigger |","table":"table-0"},"1510":{"id":"/docs/components/popover#20","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#api","content":"| Part             | Props                                                                                                                  | Description                                                     |\n| ---------------- | ---------------------------------------------------------------------------------------------------------------------- | --------------------------------------------------------------- |\n| `PopoverContent` | `compact`, `width`, `class`, `style`, `placement`, `align`, `offset`, `margin`, `closeOnEscape`, `closeOnPressOutside` | The panel; `placement` through `closeOnPressOutside` are base's |","table":"table-0"},"1511":{"id":"/docs/components/popover#21","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#api","content":"| Part            | Props            | Description                                 |\n| --------------- | ---------------- | ------------------------------------------- |\n| `PopoverHeader` | `style`, `class` | A `View` around a title and its description |","table":"table-0"},"1512":{"id":"/docs/components/popover#22","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#api","content":"| Part           | Props            | Description        |\n| -------------- | ---------------- | ------------------ |\n| `PopoverTitle` | `style`, `class` | A string is `Text` |","table":"table-0"},"1513":{"id":"/docs/components/popover#23","page_id":"/docs/components/popover","tags":[],"type":"text","url":"/docs/components/popover#api","content":"| Part                 | Props            | Description       |\n| -------------------- | ---------------- | ----------------- |\n| `PopoverDescription` | `style`, `class` | As `PopoverTitle` |","table":"table-0"},"1514":{"id":"/docs/components/pressable","page_id":"/docs/components/pressable","type":"page","content":"Pressable","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/pressable"},"1515":{"id":"/docs/components/pressable#0","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable","content":"A region that takes presses and adds only their feedback."},"1516":{"id":"/docs/components/pressable#1","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#installation","content":"Installation"},"1517":{"id":"/docs/components/pressable#2","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#usage","content":"Usage"},"1518":{"id":"/docs/components/pressable#3","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#examples","content":"Examples"},"1519":{"id":"/docs/components/pressable#4","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#disabled","content":"Disabled"},"1520":{"id":"/docs/components/pressable#5","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#a-region-with-its-own-look","content":"A region with its own look"},"1521":{"id":"/docs/components/pressable#6","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#a-picture","content":"A picture"},"1522":{"id":"/docs/components/pressable#7","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#a-stretch-of-text","content":"A stretch of text"},"1523":{"id":"/docs/components/pressable#8","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#the-role-it-reads-as","content":"The role it reads as"},"1524":{"id":"/docs/components/pressable#9","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#press-scale","content":"Press scale"},"1525":{"id":"/docs/components/pressable#10","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#the-look-alone","content":"The look alone"},"1526":{"id":"/docs/components/pressable#11","page_id":"/docs/components/pressable","type":"heading","tags":[],"url":"/docs/components/pressable#api","content":"API"},"1527":{"id":"/docs/components/pressable#12","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1528":{"id":"/docs/components/pressable#13","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#a-region-with-its-own-look","content":"`Pressable` draws nothing of its own: no fill, no padding, no height. It is its content, and a `style` adds whatever geometry the region needs. The theme's lightest hover fill, the press's sink and the keyboard's ring are the whole of its look."},"1529":{"id":"/docs/components/pressable#14","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#a-stretch-of-text","content":"A string child is plain text, and its text is the region's name for screen readers unless `accessibilityLabel` says otherwise. Children drawn as given are named by the texts inside them; one that draws no text needs an `accessibilityLabel` (the icon-only case is an `IconButton`, where it is required). `accessibilityHint` says what a press does, read after the name."},"1530":{"id":"/docs/components/pressable#15","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#the-role-it-reads-as","content":"A region says what it is with `role` (`role=\"button\"` is the default, `role=\"link\"`, `role=\"tab\"`, …): that is NSH's own name for it, and React Native's `accessibilityRole` is not it. What a region _is_ — a link, a key in a toolbar — is the `role`; its state is `selected` and `disabled`, the base button's own props, which screen readers say. There is no `accessibilityState` prop: React Native's state names are not NSH's."},"1531":{"id":"/docs/components/pressable#16","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#the-role-it-reads-as","content":"A pressable is not an on / off control: `role=\"switch\"` does not make one a switch, and it has no\n`checked` — its state is `selected`. For a setting, use `Switch`, which owns the switch role and\nits value for screen readers — either the whole row (the switch's children are its label, so a tap\nanywhere toggles it) or a `Field` with the switch at the end of the row. See `Switch`."},"1532":{"id":"/docs/components/pressable#17","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#press-scale","content":"A press sinks a pressable to 98%. `scale` is that much and nothing else: `0.8` for a dot that gives under a thumb, `1` for a row that should not move. Nothing sinks with reduced motion, or in a theme that draws no press (`press.scale` of 1)."},"1533":{"id":"/docs/components/pressable#18","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#the-look-alone","content":"The look is a function, for a `nsh/base` control of your own. Its `shape.control` corners shape the focus ring; a `style` with its own radius moves the ring with it."},"1534":{"id":"/docs/components/pressable#19","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#api","content":"Every prop of `nsh/base` Button passes through (`onPress`, `disabled`, `selected`, `role`, `hitSlop`, `accessibilityLabel`, `accessibilityHint`, …). `style`, `hoverStyle`, `activeStyle` and `focusVisibleStyle` go over the look's. `scale` is the sink of a press."},"1535":{"id":"/docs/components/pressable#20","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#api","content":"| Part        | Props                                | Description                                                                       |\n| ----------- | ------------------------------------ | --------------------------------------------------------------------------------- |\n| `Pressable` | `children` (`string \\| JSX.Element`) | One look — the hover, the sink and the ring — and its appearance is its content's |","table":"table-0"},"1536":{"id":"/docs/components/pressable#21","page_id":"/docs/components/pressable","tags":[],"type":"text","url":"/docs/components/pressable#api","content":"There is no axis: a pressable has one look — the hover, the sink and the ring — and its appearance\nis its content's. `pressableLook` takes `disabled` (no hover or press feedback), `scale` (how far a\npress sinks it) and `style` (geometry over the look's), and is what the reference page spreads on\n`nsh/base`'s Button."},"1537":{"id":"/docs/components/progress","page_id":"/docs/components/progress","type":"page","content":"Progress","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/progress"},"1538":{"id":"/docs/components/progress#0","page_id":"/docs/components/progress","tags":[],"type":"text","url":"/docs/components/progress","content":"A determinate or indeterminate progress bar."},"1539":{"id":"/docs/components/progress#1","page_id":"/docs/components/progress","type":"heading","tags":[],"url":"/docs/components/progress#installation","content":"Installation"},"1540":{"id":"/docs/components/progress#2","page_id":"/docs/components/progress","type":"heading","tags":[],"url":"/docs/components/progress#usage","content":"Usage"},"1541":{"id":"/docs/components/progress#3","page_id":"/docs/components/progress","type":"heading","tags":[],"url":"/docs/components/progress#composition","content":"Composition"},"1542":{"id":"/docs/components/progress#4","page_id":"/docs/components/progress","type":"heading","tags":[],"url":"/docs/components/progress#examples","content":"Examples"},"1543":{"id":"/docs/components/progress#5","page_id":"/docs/components/progress","type":"heading","tags":[],"url":"/docs/components/progress#tone","content":"Tone"},"1544":{"id":"/docs/components/progress#6","page_id":"/docs/components/progress","type":"heading","tags":[],"url":"/docs/components/progress#thin-rail","content":"Thin rail"},"1545":{"id":"/docs/components/progress#7","page_id":"/docs/components/progress","type":"heading","tags":[],"url":"/docs/components/progress#indeterminate","content":"Indeterminate"},"1546":{"id":"/docs/components/progress#8","page_id":"/docs/components/progress","type":"heading","tags":[],"url":"/docs/components/progress#marker","content":"Marker"},"1547":{"id":"/docs/components/progress#9","page_id":"/docs/components/progress","type":"heading","tags":[],"url":"/docs/components/progress#steps","content":"Steps"},"1548":{"id":"/docs/components/progress#10","page_id":"/docs/components/progress","type":"heading","tags":[],"url":"/docs/components/progress#api","content":"API"},"1549":{"id":"/docs/components/progress#11","page_id":"/docs/components/progress","tags":[],"type":"text","url":"/docs/components/progress#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1550":{"id":"/docs/components/progress#12","page_id":"/docs/components/progress","tags":[],"type":"text","url":"/docs/components/progress#composition","content":"Use the following composition to build a `Progress` with steps:"},"1551":{"id":"/docs/components/progress#13","page_id":"/docs/components/progress","tags":[],"type":"text","url":"/docs/components/progress#indeterminate","content":"Pass a shared `progressSweep()` from the look and set `indeterminate`."},"1552":{"id":"/docs/components/progress#14","page_id":"/docs/components/progress","tags":[],"type":"text","url":"/docs/components/progress#marker","content":"`marker` is where a limit stands, a percentage along the bar: a hairline crossing the rail and\nstanding past it. The hairline is drawn on the bar's own frame, so the rail comes first in the\nbar's row and a label goes after it."},"1553":{"id":"/docs/components/progress#15","page_id":"/docs/components/progress","tags":[],"type":"text","url":"/docs/components/progress#steps","content":"`ProgressSteps` draws step marks on the bar, a `ProgressStep` each, with `state` `done`, `current` or `upcoming`. The bar runs from the first mark's middle to the last's, so the row hangs half a mark (`progressStepSize()`) past each end: give the `Progress` that room at its sides. `value` stays the app's (0 at the first step, 100 at the last), as do Back and Next. A done step shows a check that pops in; the current one a ring and a dot; reduced motion lands each at once. A string child is the label under the mark and, with the state, its name for screen readers. Middle labels are centred under their marks; the first starts at its mark's outer edge and the last ends at its, so no label hangs past the half mark. The row is laid out left to right whatever the reading direction, as the bar fills."},"1554":{"id":"/docs/components/progress#16","page_id":"/docs/components/progress","tags":[],"type":"text","url":"/docs/components/progress#api","content":"Uses `progressLook`. Every prop of `nsh/base` Progress passes through.\nThe rail is the theme's track form: a sunk groove 6 points high with the inset shade, an accent-tinted\nband 4 points high, or WinUI's 1-point input line under a 3-point run; `height` overrides the height,\nnever the form."},"1555":{"id":"/docs/components/progress#17","page_id":"/docs/components/progress","tags":[],"type":"text","url":"/docs/components/progress#api","content":"| Part       | Props                                                                                                                                                                                | Description                                                  |\n| ---------- | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ | ------------------------------------------------------------ |\n| `Progress` | `height` (`number`, default the track form's: 6 sunk, 4 tint, 3 hairline), `tone` (`Tone \\| (() => Tone)`, default citrus), `sweep` (`ProgressSweep`), `marker` (`number`, 0 to 100) | Uses `progressLook`; `marker` stands a hairline at the limit |","table":"table-0"},"1556":{"id":"/docs/components/progress#18","page_id":"/docs/components/progress","tags":[],"type":"text","url":"/docs/components/progress#api","content":"| Part            | Props                 | Description                                                         |\n| --------------- | --------------------- | ------------------------------------------------------------------- |\n| `ProgressSteps` | every `nsh` View prop | The row of marks over the bar, centred on it; a child of `Progress` |","table":"table-0"},"1557":{"id":"/docs/components/progress#19","page_id":"/docs/components/progress","tags":[],"type":"text","url":"/docs/components/progress#api","content":"| Part           | Props                                                                                                 | Description                  |\n| -------------- | ----------------------------------------------------------------------------------------------------- | ---------------------------- |\n| `ProgressStep` | `state` (`\"done\" \\| \"current\" \\| \"upcoming\"`, default `upcoming`), `children` (a string is the label) | One mark, its label under it |","table":"table-0"},"1558":{"id":"/docs/components/progress#20","page_id":"/docs/components/progress","tags":[],"type":"text","url":"/docs/components/progress#api","content":"`ProgressStepMark` and `progressStepSize()` are the look's parts, for a row of your own."},"1559":{"id":"/docs/components/radio-group","page_id":"/docs/components/radio-group","type":"page","content":"Radio","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/radio-group"},"1560":{"id":"/docs/components/radio-group#0","page_id":"/docs/components/radio-group","tags":[],"type":"text","url":"/docs/components/radio-group","content":"A sunk ring that fills in citrus, with a dot growing in — alone or as a choice tile."},"1561":{"id":"/docs/components/radio-group#1","page_id":"/docs/components/radio-group","type":"heading","tags":[],"url":"/docs/components/radio-group#installation","content":"Installation"},"1562":{"id":"/docs/components/radio-group#2","page_id":"/docs/components/radio-group","type":"heading","tags":[],"url":"/docs/components/radio-group#usage","content":"Usage"},"1563":{"id":"/docs/components/radio-group#3","page_id":"/docs/components/radio-group","type":"heading","tags":[],"url":"/docs/components/radio-group#composition","content":"Composition"},"1564":{"id":"/docs/components/radio-group#4","page_id":"/docs/components/radio-group","type":"heading","tags":[],"url":"/docs/components/radio-group#examples","content":"Examples"},"1565":{"id":"/docs/components/radio-group#5","page_id":"/docs/components/radio-group","type":"heading","tags":[],"url":"/docs/components/radio-group#size","content":"Size"},"1566":{"id":"/docs/components/radio-group#6","page_id":"/docs/components/radio-group","type":"heading","tags":[],"url":"/docs/components/radio-group#disabled","content":"Disabled"},"1567":{"id":"/docs/components/radio-group#7","page_id":"/docs/components/radio-group","type":"heading","tags":[],"url":"/docs/components/radio-group#tile","content":"Tile"},"1568":{"id":"/docs/components/radio-group#8","page_id":"/docs/components/radio-group","type":"heading","tags":[],"url":"/docs/components/radio-group#the-look-alone","content":"The look alone"},"1569":{"id":"/docs/components/radio-group#9","page_id":"/docs/components/radio-group","type":"heading","tags":[],"url":"/docs/components/radio-group#names-for-screen-readers","content":"Names for screen readers"},"1570":{"id":"/docs/components/radio-group#10","page_id":"/docs/components/radio-group","type":"heading","tags":[],"url":"/docs/components/radio-group#api","content":"API"},"1571":{"id":"/docs/components/radio-group#11","page_id":"/docs/components/radio-group","tags":[],"type":"text","url":"/docs/components/radio-group#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1572":{"id":"/docs/components/radio-group#12","page_id":"/docs/components/radio-group","tags":[],"type":"text","url":"/docs/components/radio-group#composition","content":"Use the following composition to build a `RadioGroup`:"},"1573":{"id":"/docs/components/radio-group#13","page_id":"/docs/components/radio-group","tags":[],"type":"text","url":"/docs/components/radio-group#size","content":"`size` is `ChoiceSize` (`\"sm\" | \"default\" | \"lg\"`: 0.8, 1 or 1.25 times the page's control size), shared with `Checkbox`."},"1574":{"id":"/docs/components/radio-group#14","page_id":"/docs/components/radio-group","tags":[],"type":"text","url":"/docs/components/radio-group#the-look-alone","content":"`choiceTileLook` is shared by the tile radio and the checkbox. Import it from\n`@/components/ui/lib/choice`."},"1575":{"id":"/docs/components/radio-group#15","page_id":"/docs/components/radio-group","tags":[],"type":"text","url":"/docs/components/radio-group#names-for-screen-readers","content":"A string child is the row's label and its name for screen readers; `accessibilityLabel` wins when it should differ. Children drawn as given are named by the texts inside them."},"1576":{"id":"/docs/components/radio-group#16","page_id":"/docs/components/radio-group","tags":[],"type":"text","url":"/docs/components/radio-group#api","content":"Every prop of `nsh/base` Radio and `RadioGroup` passes through. Style props go over the look's. The row is the `group` the ring sinks with while pressed. `RadioGroupItem` is an alias of `Radio`."},"1577":{"id":"/docs/components/radio-group#17","page_id":"/docs/components/radio-group","tags":[],"type":"text","url":"/docs/components/radio-group#api","content":"| Part    | Props                                                                                                                                                                      | Description                                             |\n| ------- | -------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ------------------------------------------------------- |\n| `Radio` | `variant` (`RadioVariant`, default `\"default\"`), `indicator` (`boolean`, default `true`), `size` (`ChoiceSize`, default `\"default\"`), `children` (`string \\| JSX.Element`) | The ring of the theme's choice recipe, or a choice tile |","table":"table-0"},"1578":{"id":"/docs/components/radio-group#18","page_id":"/docs/components/radio-group","tags":[],"type":"text","url":"/docs/components/radio-group#api","content":"| Part         | Props | Description                                        |\n| ------------ | ----- | -------------------------------------------------- |\n| `RadioGroup` |       | Every prop of `nsh/base` RadioGroup passes through |","table":"table-0"},"1579":{"id":"/docs/components/radio-group#19","page_id":"/docs/components/radio-group","tags":[],"type":"text","url":"/docs/components/radio-group#api","content":"| Part             | Props | Description         |\n| ---------------- | ----- | ------------------- |\n| `RadioGroupItem` |       | An alias of `Radio` |","table":"table-0"},"1580":{"id":"/docs/components/radio-group#20","page_id":"/docs/components/radio-group","tags":[],"type":"text","url":"/docs/components/radio-group#api","content":"`RadioVariant` is `\"default\"` (the sunk ring) or `\"tile\"` (the whole surface is the control, this library's own value)."},"1581":{"id":"/docs/components/refresh-indicator","page_id":"/docs/components/refresh-indicator","type":"page","content":"RefreshIndicator","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/refresh-indicator"},"1582":{"id":"/docs/components/refresh-indicator#0","page_id":"/docs/components/refresh-indicator","tags":[],"type":"text","url":"/docs/components/refresh-indicator","content":"The round chip a pull to refresh draws over a scroll view, traveling in with the pull and spinning while it refreshes."},"1583":{"id":"/docs/components/refresh-indicator#1","page_id":"/docs/components/refresh-indicator","type":"heading","tags":[],"url":"/docs/components/refresh-indicator#installation","content":"Installation"},"1584":{"id":"/docs/components/refresh-indicator#2","page_id":"/docs/components/refresh-indicator","type":"heading","tags":[],"url":"/docs/components/refresh-indicator#usage","content":"Usage"},"1585":{"id":"/docs/components/refresh-indicator#3","page_id":"/docs/components/refresh-indicator","type":"heading","tags":[],"url":"/docs/components/refresh-indicator#examples","content":"Examples"},"1586":{"id":"/docs/components/refresh-indicator#4","page_id":"/docs/components/refresh-indicator","type":"heading","tags":[],"url":"/docs/components/refresh-indicator#pull-to-refresh","content":"Pull to refresh"},"1587":{"id":"/docs/components/refresh-indicator#5","page_id":"/docs/components/refresh-indicator","type":"heading","tags":[],"url":"/docs/components/refresh-indicator#the-system-spinner","content":"The system spinner"},"1588":{"id":"/docs/components/refresh-indicator#6","page_id":"/docs/components/refresh-indicator","type":"heading","tags":[],"url":"/docs/components/refresh-indicator#api","content":"API"},"1589":{"id":"/docs/components/refresh-indicator#7","page_id":"/docs/components/refresh-indicator","tags":[],"type":"text","url":"/docs/components/refresh-indicator#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1590":{"id":"/docs/components/refresh-indicator#8","page_id":"/docs/components/refresh-indicator","tags":[],"type":"text","url":"/docs/components/refresh-indicator#usage","content":"The scroll view (or `List`) keeps `onRefresh`, `refreshing`, `pullValue` and `refreshIndicator`: `refreshIndicator` hides the system's spinner, makes a pull refresh once it reaches `height`, and keeps `height` above the content while refreshing; `pullValue` is the animated value it feeds with how far it is pulled. `RefreshIndicator` only draws that value, over the top of the scroll view: its opacity, travel and scale follow `pull` on the UI thread, with no JS per frame. The arrow turns over once the pull is past half of `height`; while `refreshing` it gives way to a ring that spins. The strip takes no presses, so it sits above the scroll view without blocking it. Pass the same `height` to both."},"1591":{"id":"/docs/components/refresh-indicator#9","page_id":"/docs/components/refresh-indicator","tags":[],"type":"text","url":"/docs/components/refresh-indicator#pull-to-refresh","content":"A list that reloads when it is pulled. `refreshing` is the app's: it is set in `onRefresh` and cleared when the reload ends, and the indicator draws it."},"1592":{"id":"/docs/components/refresh-indicator#10","page_id":"/docs/components/refresh-indicator","tags":[],"type":"text","url":"/docs/components/refresh-indicator#the-system-spinner","content":"Leave `refreshIndicator` and `pullValue` off and the platform draws its own spinner; there is nothing to mount. Use this when the platform's look is what you want."},"1593":{"id":"/docs/components/refresh-indicator#11","page_id":"/docs/components/refresh-indicator","tags":[],"type":"text","url":"/docs/components/refresh-indicator#api","content":"`RefreshIndicator` is a `nsh` View in the library's look; every prop of View passes through but `children`, and `style` goes over the look's. The pull itself (`refreshIndicator`, `pullValue`, `onRefresh`, `refreshing`) is `nsh` Scroll's. There is no pull on the web, so the chip stays hidden there."},"1594":{"id":"/docs/components/refresh-indicator#12","page_id":"/docs/components/refresh-indicator","tags":[],"type":"text","url":"/docs/components/refresh-indicator#api","content":"| Part               | Props                                                                                                 | Description                                                                                                              |\n| ------------------ | ----------------------------------------------------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------ |\n| `RefreshIndicator` | `pull`: `AnimatedValue`; `refreshing`: `boolean`; `height`: `number` (72, `REFRESH_INDICATOR_HEIGHT`) | The chip over the top of a scroll view. `height` is the scroll view's `refreshIndicator` height, read once at make time. |","table":"table-0"},"1595":{"id":"/docs/components/refresh-indicator#13","page_id":"/docs/components/refresh-indicator","tags":[],"type":"text","url":"/docs/components/refresh-indicator#api","content":"`refreshIndicatorLook()` is exported for an indicator the app draws itself: its parts as the styles they wear (`root`, `chip`, `arrow`, `ring`, `glyph`, `tint`). Reduced motion stops the ring's spin; the pull still moves the chip, since it is the user's own hand."},"1596":{"id":"/docs/components/refresh-indicator#14","page_id":"/docs/components/refresh-indicator","tags":[],"type":"text","url":"/docs/components/refresh-indicator#api","content":"shadcn/ui has no counterpart (the web has no pull), so there is nothing to compare; the name follows the `refreshIndicator` prop it is drawn for."},"1597":{"id":"/docs/components/resizable","page_id":"/docs/components/resizable","type":"page","content":"Resizable","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/resizable"},"1598":{"id":"/docs/components/resizable#0","page_id":"/docs/components/resizable","tags":[],"type":"text","url":"/docs/components/resizable","content":"Resize handles with a quiet hairline and a growing thumb."},"1599":{"id":"/docs/components/resizable#1","page_id":"/docs/components/resizable","type":"heading","tags":[],"url":"/docs/components/resizable#installation","content":"Installation"},"1600":{"id":"/docs/components/resizable#2","page_id":"/docs/components/resizable","type":"heading","tags":[],"url":"/docs/components/resizable#usage","content":"Usage"},"1601":{"id":"/docs/components/resizable#3","page_id":"/docs/components/resizable","type":"heading","tags":[],"url":"/docs/components/resizable#composition","content":"Composition"},"1602":{"id":"/docs/components/resizable#4","page_id":"/docs/components/resizable","type":"heading","tags":[],"url":"/docs/components/resizable#examples","content":"Examples"},"1603":{"id":"/docs/components/resizable#5","page_id":"/docs/components/resizable","type":"heading","tags":[],"url":"/docs/components/resizable#a-sidebar","content":"A sidebar"},"1604":{"id":"/docs/components/resizable#6","page_id":"/docs/components/resizable","type":"heading","tags":[],"url":"/docs/components/resizable#vertical","content":"Vertical"},"1605":{"id":"/docs/components/resizable#7","page_id":"/docs/components/resizable","type":"heading","tags":[],"url":"/docs/components/resizable#api","content":"API"},"1606":{"id":"/docs/components/resizable#8","page_id":"/docs/components/resizable","tags":[],"type":"text","url":"/docs/components/resizable#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1607":{"id":"/docs/components/resizable#9","page_id":"/docs/components/resizable","tags":[],"type":"text","url":"/docs/components/resizable#composition","content":"Use the following composition to build a `ResizablePanelGroup`:"},"1608":{"id":"/docs/components/resizable#10","page_id":"/docs/components/resizable","tags":[],"type":"text","url":"/docs/components/resizable#a-sidebar","content":"`size` is the panel's current width; `onResize` reports the drag."},"1609":{"id":"/docs/components/resizable#11","page_id":"/docs/components/resizable","tags":[],"type":"text","url":"/docs/components/resizable#vertical","content":"`axis=\"vertical\"` stacks the panels, with the handle's hairline along the column."},"1610":{"id":"/docs/components/resizable#12","page_id":"/docs/components/resizable","tags":[],"type":"text","url":"/docs/components/resizable#api","content":"`ResizablePanelGroup` spreads `resizableHandleLook` for the axis. Every prop of `nsh/base` ResizablePanelGroup passes through."},"1611":{"id":"/docs/components/resizable#13","page_id":"/docs/components/resizable","tags":[],"type":"text","url":"/docs/components/resizable#api","content":"Also export `resizableHandleLook` and `handleThumb` for a handle the app lays out itself."},"1612":{"id":"/docs/components/resizable#14","page_id":"/docs/components/resizable","tags":[],"type":"text","url":"/docs/components/resizable#api","content":"| Part                  | Props | Description                                |\n| --------------------- | ----- | ------------------------------------------ |\n| `ResizablePanelGroup` |       | Spreads `resizableHandleLook` for the axis |","table":"table-0"},"1613":{"id":"/docs/components/resizable#15","page_id":"/docs/components/resizable","tags":[],"type":"text","url":"/docs/components/resizable#api","content":"| Part             | Props | Description                                              |\n| ---------------- | ----- | -------------------------------------------------------- |\n| `ResizablePanel` |       | `size` is its current width; `onResize` reports the drag |","table":"table-0"},"1614":{"id":"/docs/components/rich-editor","page_id":"/docs/components/rich-editor","type":"page","content":"Rich Editor","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/rich-editor"},"1615":{"id":"/docs/components/rich-editor#0","page_id":"/docs/components/rich-editor","tags":[],"type":"text","url":"/docs/components/rich-editor","content":"Rich document typography and its session API, on nsh/base's RichEditor."},"1616":{"id":"/docs/components/rich-editor#1","page_id":"/docs/components/rich-editor","type":"heading","tags":[],"url":"/docs/components/rich-editor#installation","content":"Installation"},"1617":{"id":"/docs/components/rich-editor#2","page_id":"/docs/components/rich-editor","type":"heading","tags":[],"url":"/docs/components/rich-editor#usage","content":"Usage"},"1618":{"id":"/docs/components/rich-editor#3","page_id":"/docs/components/rich-editor","type":"heading","tags":[],"url":"/docs/components/rich-editor#examples","content":"Examples"},"1619":{"id":"/docs/components/rich-editor#4","page_id":"/docs/components/rich-editor","type":"heading","tags":[],"url":"/docs/components/rich-editor#rich-document","content":"Rich document"},"1620":{"id":"/docs/components/rich-editor#5","page_id":"/docs/components/rich-editor","type":"heading","tags":[],"url":"/docs/components/rich-editor#a-formatting-toolbar","content":"A formatting toolbar"},"1621":{"id":"/docs/components/rich-editor#6","page_id":"/docs/components/rich-editor","type":"heading","tags":[],"url":"/docs/components/rich-editor#a-link-bubble","content":"A link bubble"},"1622":{"id":"/docs/components/rich-editor#7","page_id":"/docs/components/rich-editor","type":"heading","tags":[],"url":"/docs/components/rich-editor#a-node-in-the-text","content":"A node in the text"},"1623":{"id":"/docs/components/rich-editor#8","page_id":"/docs/components/rich-editor","type":"heading","tags":[],"url":"/docs/components/rich-editor#api","content":"API"},"1624":{"id":"/docs/components/rich-editor#9","page_id":"/docs/components/rich-editor","tags":[],"type":"text","url":"/docs/components/rich-editor#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1625":{"id":"/docs/components/rich-editor#10","page_id":"/docs/components/rich-editor","tags":[],"type":"text","url":"/docs/components/rich-editor#usage","content":"`RichEditor` defaults `classes` to `richEditorClasses` and merges yours into them: a part you leave out keeps the look's, `null` drops it, and a part that is a map of node or mark classes (`nodes`, `marks`) merges name by name, so `classes={{ nodes: { heading: \"text-xl\" } }}` overrides that node and keeps the look's others. Every prop of `nsh/base` RichEditor passes through."},"1626":{"id":"/docs/components/rich-editor#11","page_id":"/docs/components/rich-editor","tags":[],"type":"text","url":"/docs/components/rich-editor#usage","content":"The file re-exports the session's API beside the view, so an app imports the editor once: `createRichEditor` and the kits a session starts from (`StarterKit`, `TableKit`), the commands, `defineSchema` / `defineExtension` / `richExtension` and `RichEditorPlugin` for a session of its own, and the types of the session, its parts, its commands, its extensions and its node views. `command(\"<name>\")` runs any Tiptap command by name; `chain`, `undo`, `redo`, `extendMarkRange` and `insertContent` are the named builders a toolbar usually needs."},"1627":{"id":"/docs/components/rich-editor#12","page_id":"/docs/components/rich-editor","tags":[],"type":"text","url":"/docs/components/rich-editor#rich-document","content":"`RichEditor` wears `richEditorClasses`; the session comes from `createRichEditor`."},"1628":{"id":"/docs/components/rich-editor#13","page_id":"/docs/components/rich-editor","tags":[],"type":"text","url":"/docs/components/rich-editor#a-formatting-toolbar","content":"A bar over the document, every control reading the caret: the block it stands in, the marks it\ncarries, the list around it. The session re-reads on each `revision`, so `isActive` and `can` are\ncurrent when the bar draws; a control whose command cannot run where the caret stands is `disabled`\n(`can`), and a press runs the command and puts the caret back with `focus()` — or the document loses\nit to the button. `command` builds the Tiptap commands by name; the list indents are\n`sinkListItem` and `liftListItem` over `listItem`."},"1629":{"id":"/docs/components/rich-editor#14","page_id":"/docs/components/rich-editor","tags":[],"type":"text","url":"/docs/components/rich-editor#a-link-bubble","content":"`bubbleMenu` is Tiptap's bubble menu, filled by the app: it sits over the selection, flips below it\nwhere there is no room, and follows the text as it scrolls. **The app decides when it is there** —\nthis one while the caret stands in a link (`isActive(\"link\")`) or while its address is being\nwritten — and draws what it holds. `extendMarkRange(\"link\")` first, then `setLink` or `unsetLink`,\nso the whole link changes and not just the character under the caret; an address written at an empty\ncaret is `insertContent` of a node marked `link`. Closing the field waits a turn (`setTimeout(…,\n0)`) before `focus()`: on the web the Return that submitted it is still being handled, and an editor\nfocused now would take it and write a line break into the link."},"1630":{"id":"/docs/components/rich-editor#15","page_id":"/docs/components/rich-editor","tags":[],"type":"text","url":"/docs/components/rich-editor#a-node-in-the-text","content":"An extension's node view: `addNodeView` returns the app's own component, and the editor draws\nevery node of that type with it — the component runs when a node appears, and its props change in\nplace when the node's attributes or its selection do. `RichNodeViewProps` carries `node` (its\n`attrs`), `selected` (it takes presses, so the caret steps over an atom as one character and\nBackspace deletes it) and the session's own `updateAttributes` / `deleteNode` for a node that edits\nitself. Typing never runs the component."},"1631":{"id":"/docs/components/rich-editor#16","page_id":"/docs/components/rich-editor","tags":[],"type":"text","url":"/docs/components/rich-editor#api","content":"| Part         | Props                                                                              | Description                  |\n| ------------ | ---------------------------------------------------------------------------------- | ---------------------------- |\n| `RichEditor` | every `nsh/base` RichEditor prop; `classes` over `richEditorClasses`, part by part | Themed `nsh/base` RichEditor |","table":"table-0"},"1632":{"id":"/docs/components/rich-editor#17","page_id":"/docs/components/rich-editor","tags":[],"type":"text","url":"/docs/components/rich-editor#api","content":"| Part                | Props | Description                  |\n| ------------------- | ----- | ---------------------------- |\n| `richEditorClasses` | —     | `RichEditor` document chrome |","table":"table-0"},"1633":{"id":"/docs/components/rich-editor#18","page_id":"/docs/components/rich-editor","tags":[],"type":"text","url":"/docs/components/rich-editor#api","content":"| Part              | Props | Description                               |\n| ----------------- | ----- | ----------------------------------------- |\n| `RichEditorProps` | —     | `nsh/base`'s `RichEditorProps`, unchanged |","table":"table-0"},"1634":{"id":"/docs/components/rich-editor#19","page_id":"/docs/components/rich-editor","tags":[],"type":"text","url":"/docs/components/rich-editor#api","content":"| Part                               | Props        | Description                |\n| ---------------------------------- | ------------ | -------------------------- |\n| `createRichEditor`, `defineSchema` | `nsh/base`'s | The session the view shows |","table":"table-0"},"1635":{"id":"/docs/components/rich-editor#20","page_id":"/docs/components/rich-editor","tags":[],"type":"text","url":"/docs/components/rich-editor#api","content":"| Part                     | Props | Description                          |\n| ------------------------ | ----- | ------------------------------------ |\n| `StarterKit`, `TableKit` | —     | The extensions a session starts from |","table":"table-0"},"1636":{"id":"/docs/components/rich-editor#21","page_id":"/docs/components/rich-editor","tags":[],"type":"text","url":"/docs/components/rich-editor#api","content":"| Part                                                                   | Props        | Description                        |\n| ---------------------------------------------------------------------- | ------------ | ---------------------------------- |\n| `chain`, `command`, `undo`, `redo`, `extendMarkRange`, `insertContent` | `nsh/base`'s | The Tiptap commands a toolbar runs |","table":"table-0"},"1637":{"id":"/docs/components/rich-editor#22","page_id":"/docs/components/rich-editor","tags":[],"type":"text","url":"/docs/components/rich-editor#api","content":"| Part                                                   | Props        | Description                         |\n| ------------------------------------------------------ | ------------ | ----------------------------------- |\n| `defineExtension`, `richExtension`, `RichEditorPlugin` | `nsh/base`'s | An extension or plugin of the app's |","table":"table-0"},"1638":{"id":"/docs/components/rich-editor#23","page_id":"/docs/components/rich-editor","tags":[],"type":"text","url":"/docs/components/rich-editor#api","content":"| Part                                                                        | Props | Description                     |\n| --------------------------------------------------------------------------- | ----- | ------------------------------- |\n| `RichEditorSession`, `RichCommand`, `RichNodeViewProps`, `RichEditorRef`, … | —     | `nsh/base`'s types, re-exported |","table":"table-0"},"1639":{"id":"/docs/components/scrollbar","page_id":"/docs/components/scrollbar","type":"page","content":"Scrollbar","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/scrollbar"},"1640":{"id":"/docs/components/scrollbar#0","page_id":"/docs/components/scrollbar","tags":[],"type":"text","url":"/docs/components/scrollbar","content":"A hover scroll bar in the shared gallery theme."},"1641":{"id":"/docs/components/scrollbar#1","page_id":"/docs/components/scrollbar","type":"heading","tags":[],"url":"/docs/components/scrollbar#installation","content":"Installation"},"1642":{"id":"/docs/components/scrollbar#2","page_id":"/docs/components/scrollbar","type":"heading","tags":[],"url":"/docs/components/scrollbar#usage","content":"Usage"},"1643":{"id":"/docs/components/scrollbar#3","page_id":"/docs/components/scrollbar","type":"heading","tags":[],"url":"/docs/components/scrollbar#examples","content":"Examples"},"1644":{"id":"/docs/components/scrollbar#4","page_id":"/docs/components/scrollbar","type":"heading","tags":[],"url":"/docs/components/scrollbar#a-list","content":"A list"},"1645":{"id":"/docs/components/scrollbar#5","page_id":"/docs/components/scrollbar","type":"heading","tags":[],"url":"/docs/components/scrollbar#every-scroll-view","content":"Every scroll view"},"1646":{"id":"/docs/components/scrollbar#6","page_id":"/docs/components/scrollbar","type":"heading","tags":[],"url":"/docs/components/scrollbar#api","content":"API"},"1647":{"id":"/docs/components/scrollbar#7","page_id":"/docs/components/scrollbar","tags":[],"type":"text","url":"/docs/components/scrollbar#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1648":{"id":"/docs/components/scrollbar#8","page_id":"/docs/components/scrollbar","tags":[],"type":"text","url":"/docs/components/scrollbar#a-list","content":"`Scroll` hides its platform bar; `Scrollbar` draws the theme's bar for it."},"1649":{"id":"/docs/components/scrollbar#9","page_id":"/docs/components/scrollbar","tags":[],"type":"text","url":"/docs/components/scrollbar#every-scroll-view","content":"`Scrollbar.setTheme()` installs the same look on every view that still uses the platform indicator; `null` gives the platform's back."},"1650":{"id":"/docs/components/scrollbar#10","page_id":"/docs/components/scrollbar","tags":[],"type":"text","url":"/docs/components/scrollbar#api","content":"Uses `scrollbarTheme` by default. Call `Scrollbar.setTheme()` to install it on every scroll view. Every prop of `nsh/base` Scrollbar passes through."},"1651":{"id":"/docs/components/scrollbar#11","page_id":"/docs/components/scrollbar","tags":[],"type":"text","url":"/docs/components/scrollbar#api","content":"| Part        | Props | Description                                                                     |\n| ----------- | ----- | ------------------------------------------------------------------------------- |\n| `Scrollbar` |       | Uses `scrollbarTheme` by default; `setTheme()` installs it on every scroll view |","table":"table-0"},"1652":{"id":"/docs/components/segmented","page_id":"/docs/components/segmented","type":"page","content":"Segmented","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/segmented"},"1653":{"id":"/docs/components/segmented#0","page_id":"/docs/components/segmented","tags":[],"type":"text","url":"/docs/components/segmented","content":"A track of mutually exclusive choices whose thumb springs to the chosen one."},"1654":{"id":"/docs/components/segmented#1","page_id":"/docs/components/segmented","type":"heading","tags":[],"url":"/docs/components/segmented#installation","content":"Installation"},"1655":{"id":"/docs/components/segmented#2","page_id":"/docs/components/segmented","type":"heading","tags":[],"url":"/docs/components/segmented#usage","content":"Usage"},"1656":{"id":"/docs/components/segmented#3","page_id":"/docs/components/segmented","type":"heading","tags":[],"url":"/docs/components/segmented#composition","content":"Composition"},"1657":{"id":"/docs/components/segmented#4","page_id":"/docs/components/segmented","type":"heading","tags":[],"url":"/docs/components/segmented#examples","content":"Examples"},"1658":{"id":"/docs/components/segmented#5","page_id":"/docs/components/segmented","type":"heading","tags":[],"url":"/docs/components/segmented#fill--small","content":"Fill / small"},"1659":{"id":"/docs/components/segmented#6","page_id":"/docs/components/segmented","type":"heading","tags":[],"url":"/docs/components/segmented#api","content":"API"},"1660":{"id":"/docs/components/segmented#7","page_id":"/docs/components/segmented","tags":[],"type":"text","url":"/docs/components/segmented#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1661":{"id":"/docs/components/segmented#8","page_id":"/docs/components/segmented","tags":[],"type":"text","url":"/docs/components/segmented#composition","content":"Use the following composition to build a `Segmented`:"},"1662":{"id":"/docs/components/segmented#9","page_id":"/docs/components/segmented","tags":[],"type":"text","url":"/docs/components/segmented#fill--small","content":"`size` is the scale: `default` is the theme's `height.md` high (28 points with a pointer in the\nlibrary's themes, 40 on a touch screen) and `sm` its `height.sm` (24, 32)."},"1663":{"id":"/docs/components/segmented#10","page_id":"/docs/components/segmented","tags":[],"type":"text","url":"/docs/components/segmented#fill--small","content":"The track is the theme's `channel` and the thumb its `plate`, both read where they are drawn: a\nwell holding a raised block. The thumb is always as big as a segment's own box, so the pointer's\nhover shade covers exactly the box the chosen block covers. Every theme draws this one form — the\nlist reads no control dimension, so `apple`'s capsule-in-a-capsule and `material`'s connected\ncells are gone; what the native controls look like instead is in the theme's difference table\n(`packages/theme/themes/material/README.md` / `packages/theme/themes/apple/README.md`)."},"1664":{"id":"/docs/components/segmented#11","page_id":"/docs/components/segmented","tags":[],"type":"text","url":"/docs/components/segmented#api","content":"Uses `segmentedLook`. Composition: `Segmented`, `SegmentedList`, `SegmentedItem`. Every prop of `nsh/base` Tabs / `Tab` passes through on the list and items."},"1665":{"id":"/docs/components/segmented#12","page_id":"/docs/components/segmented","tags":[],"type":"text","url":"/docs/components/segmented#api","content":"| Part        | Props | Description                                           |\n| ----------- | ----- | ----------------------------------------------------- |\n| `Segmented` |       | Composition, with `SegmentedList` and `SegmentedItem` |","table":"table-0"},"1666":{"id":"/docs/components/segmented#13","page_id":"/docs/components/segmented","tags":[],"type":"text","url":"/docs/components/segmented#api","content":"| Part            | Props                                                             | Description                     |\n| --------------- | ----------------------------------------------------------------- | ------------------------------- |\n| `SegmentedList` | `size` (`SegmentedSize`, default `\"default\"`), `fill` (`boolean`) | `size` is `\"default\"` or `\"sm\"` |","table":"table-0"},"1667":{"id":"/docs/components/segmented#14","page_id":"/docs/components/segmented","tags":[],"type":"text","url":"/docs/components/segmented#api","content":"| Part            | Props | Description                                       |\n| --------------- | ----- | ------------------------------------------------- |\n| `SegmentedItem` |       | Composition, with `Segmented` and `SegmentedList` |","table":"table-0"},"1668":{"id":"/docs/components/segmented#15","page_id":"/docs/components/segmented","tags":[],"type":"text","url":"/docs/components/segmented#api","content":"`SegmentedSize` is `\"sm\" | \"default\"`."},"1669":{"id":"/docs/components/select","page_id":"/docs/components/select","type":"page","content":"Select","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/select"},"1670":{"id":"/docs/components/select#0","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select","content":"A list of choices from a field trigger, on the shared listbox look."},"1671":{"id":"/docs/components/select#1","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#installation","content":"Installation"},"1672":{"id":"/docs/components/select#2","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#usage","content":"Usage"},"1673":{"id":"/docs/components/select#3","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#composition","content":"Composition"},"1674":{"id":"/docs/components/select#4","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#examples","content":"Examples"},"1675":{"id":"/docs/components/select#5","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#disabled-choice-disabled-select","content":"Disabled choice, disabled select"},"1676":{"id":"/docs/components/select#6","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#invalid","content":"Invalid"},"1677":{"id":"/docs/components/select#7","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#grouped-choices","content":"Grouped choices"},"1678":{"id":"/docs/components/select#8","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#outline-trigger-and-a-width","content":"Outline trigger, and a width"},"1679":{"id":"/docs/components/select#9","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#a-trigger-that-takes-the-room-of-a-row","content":"A trigger that takes the room of a row"},"1680":{"id":"/docs/components/select#10","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#uncontrolled","content":"Uncontrolled"},"1681":{"id":"/docs/components/select#11","page_id":"/docs/components/select","type":"heading","tags":[],"url":"/docs/components/select#api","content":"API"},"1682":{"id":"/docs/components/select#12","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1683":{"id":"/docs/components/select#13","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#composition","content":"Use the following composition to build a `Select`:"},"1684":{"id":"/docs/components/select#14","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#invalid","content":"The trigger's edge takes the danger tone."},"1685":{"id":"/docs/components/select#15","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#grouped-choices","content":"`SelectLabel` names the section; the list draws its header."},"1686":{"id":"/docs/components/select#16","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#outline-trigger-and-a-width","content":"`variant=\"outline\"` is a trigger that is not a form's field: the `raised` surface instead of the\nfield's well."},"1687":{"id":"/docs/components/select#17","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#a-trigger-that-takes-the-room-of-a-row","content":"`style` on `SelectTrigger` is the trigger's box in the app's layout: the properties that place it\nwhere the app puts it — `flex`, `flexGrow`, `flexShrink`, `flexBasis`, `width`, `minWidth`,\n`maxWidth`, `alignSelf` and the margins — go on the view around the trigger, so it grows, shrinks\nand keeps its distances like any other view. The rest of the style (the fill, the edge, the\npadding) stays on the trigger itself."},"1688":{"id":"/docs/components/select#18","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#a-trigger-that-takes-the-room-of-a-row","content":"With a pointer the trigger asks for 180 points at least (room for the list's rows). A `width` on\n`style` is the trigger's size and wins over that floor, so `style={{ width: 120 }}` stays 120\npoints inside its parent. `minWidth: 0` still lets a narrow row squeeze a trigger that has no\nwidth of its own, and its title ends in an ellipsis instead of overflowing."},"1689":{"id":"/docs/components/select#19","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#api","content":"The root owns the open flag and the value; `SelectContent` mounts `nsh/base` Select and every base prop passes through except those. `listboxProps` and `OptionRow` fill the popup, the scrim and the rows by default."},"1690":{"id":"/docs/components/select#20","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#api","content":"| Part     | Props                                                                                                                                               | Description                               |\n| -------- | --------------------------------------------------------------------------------------------------------------------------------------------------- | ----------------------------------------- |\n| `Select` | `value`, `defaultValue`, `open`, `defaultOpen`, `disabled`, `cleanable`, `placeholder`, `onChange`, `onOpenChange`, `onOpen`, `onClose`, `onCancel` | The root owns the open flag and the value |","table":"table-0"},"1691":{"id":"/docs/components/select#21","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#api","content":"| Part            | Props                                                    | Description                                                                                                               |\n| --------------- | -------------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------------- |\n| `SelectTrigger` | `icon`, `lead`, `invalid`, `variant`, `chevron`, `style` | A `Picker`. The layout keys on `style` place it where the app puts it; a `width` there also overrides the 180-point floor |","table":"table-0"},"1692":{"id":"/docs/components/select#22","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#api","content":"| Part          | Props         | Description                             |\n| ------------- | ------------- | --------------------------------------- |\n| `SelectValue` | `placeholder` | The placeholder while nothing is chosen |","table":"table-0"},"1693":{"id":"/docs/components/select#23","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#api","content":"| Part            | Props               | Description                                        |\n| --------------- | ------------------- | -------------------------------------------------- |\n| `SelectContent` | `items`, `minWidth` | The list; `items` instead of `SelectItem` children |","table":"table-0"},"1694":{"id":"/docs/components/select#24","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#api","content":"| Part         | Props                        | Description                 |\n| ------------ | ---------------------------- | --------------------------- |\n| `SelectItem` | `value`, `disabled`, `group` | A string child is its title |","table":"table-0"},"1695":{"id":"/docs/components/select#25","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#api","content":"| Part          | Props | Description |\n| ------------- | ----- | ----------- |\n| `SelectGroup` |       | A section   |","table":"table-0"},"1696":{"id":"/docs/components/select#26","page_id":"/docs/components/select","tags":[],"type":"text","url":"/docs/components/select#api","content":"| Part          | Props | Description        |\n| ------------- | ----- | ------------------ |\n| `SelectLabel` |       | The section's name |","table":"table-0"},"1697":{"id":"/docs/components/separator","page_id":"/docs/components/separator","type":"page","content":"Separator","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/separator"},"1698":{"id":"/docs/components/separator#0","page_id":"/docs/components/separator","tags":[],"type":"text","url":"/docs/components/separator","content":"A hairline across the content, or down a row."},"1699":{"id":"/docs/components/separator#1","page_id":"/docs/components/separator","type":"heading","tags":[],"url":"/docs/components/separator#installation","content":"Installation"},"1700":{"id":"/docs/components/separator#2","page_id":"/docs/components/separator","type":"heading","tags":[],"url":"/docs/components/separator#usage","content":"Usage"},"1701":{"id":"/docs/components/separator#3","page_id":"/docs/components/separator","type":"heading","tags":[],"url":"/docs/components/separator#examples","content":"Examples"},"1702":{"id":"/docs/components/separator#4","page_id":"/docs/components/separator","type":"heading","tags":[],"url":"/docs/components/separator#orientation","content":"Orientation"},"1703":{"id":"/docs/components/separator#5","page_id":"/docs/components/separator","type":"heading","tags":[],"url":"/docs/components/separator#space-around-it","content":"Space around it"},"1704":{"id":"/docs/components/separator#6","page_id":"/docs/components/separator","type":"heading","tags":[],"url":"/docs/components/separator#decorative-or-not","content":"Decorative or not"},"1705":{"id":"/docs/components/separator#7","page_id":"/docs/components/separator","type":"heading","tags":[],"url":"/docs/components/separator#api","content":"API"},"1706":{"id":"/docs/components/separator#8","page_id":"/docs/components/separator","tags":[],"type":"text","url":"/docs/components/separator#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1707":{"id":"/docs/components/separator#9","page_id":"/docs/components/separator","tags":[],"type":"text","url":"/docs/components/separator#orientation","content":"`horizontal` (the default) runs across its container, one point thick; `vertical` runs down it and\nis as tall as its row, so the row has to have a height (its own, or one its content gives it)."},"1708":{"id":"/docs/components/separator#10","page_id":"/docs/components/separator","tags":[],"type":"text","url":"/docs/components/separator#space-around-it","content":"The separator is the line and nothing else: the room above and below it is the caller's."},"1709":{"id":"/docs/components/separator#11","page_id":"/docs/components/separator","tags":[],"type":"text","url":"/docs/components/separator#decorative-or-not","content":"A separator is usually a line of the layout: `decorative` is `true` by default, and a screen reader\nwalks from one group of content to the next without stopping on it. `decorative={false}` keeps it\nin the accessibility tree, as a `role=\"group\"` (`nsh` has no `separator` role — the nearest is a\nboundary between groups); give it an `accessibilityLabel` saying what it divides."},"1710":{"id":"/docs/components/separator#12","page_id":"/docs/components/separator","tags":[],"type":"text","url":"/docs/components/separator#api","content":"Every prop of `nsh` View passes through (`style`, `role`,\n`accessibilityLabel`, …); `style` goes over the look's."},"1711":{"id":"/docs/components/separator#13","page_id":"/docs/components/separator","tags":[],"type":"text","url":"/docs/components/separator#api","content":"| Part        | Props                                                                                                          | Description                                     |\n| ----------- | -------------------------------------------------------------------------------------------------------------- | ----------------------------------------------- |\n| `Separator` | `orientation` (`\"horizontal\" \\| \"vertical\"`, default `\"horizontal\"`), `decorative` (`boolean`, default `true`) | The line is one point of the theme's edge color |","table":"table-0"},"1712":{"id":"/docs/components/separator#14","page_id":"/docs/components/separator","tags":[],"type":"text","url":"/docs/components/separator#api","content":"The line is one point of the theme's edge color (`colors.border`, `theme.json`'s `border`), with\nno other look: a corner is the caller's `style`, and so is its room."},"1713":{"id":"/docs/components/sheet","page_id":"/docs/components/sheet","type":"page","content":"Sheet","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/sheet"},"1714":{"id":"/docs/components/sheet#0","page_id":"/docs/components/sheet","tags":[],"type":"text","url":"/docs/components/sheet","content":"A panel that slides in from an edge of the screen over a scrim."},"1715":{"id":"/docs/components/sheet#1","page_id":"/docs/components/sheet","type":"heading","tags":[],"url":"/docs/components/sheet#installation","content":"Installation"},"1716":{"id":"/docs/components/sheet#2","page_id":"/docs/components/sheet","type":"heading","tags":[],"url":"/docs/components/sheet#usage","content":"Usage"},"1717":{"id":"/docs/components/sheet#3","page_id":"/docs/components/sheet","type":"heading","tags":[],"url":"/docs/components/sheet#composition","content":"Composition"},"1718":{"id":"/docs/components/sheet#4","page_id":"/docs/components/sheet","type":"heading","tags":[],"url":"/docs/components/sheet#examples","content":"Examples"},"1719":{"id":"/docs/components/sheet#5","page_id":"/docs/components/sheet","type":"heading","tags":[],"url":"/docs/components/sheet#side","content":"Side"},"1720":{"id":"/docs/components/sheet#6","page_id":"/docs/components/sheet","type":"heading","tags":[],"url":"/docs/components/sheet#grabber","content":"Grabber"},"1721":{"id":"/docs/components/sheet#7","page_id":"/docs/components/sheet","type":"heading","tags":[],"url":"/docs/components/sheet#detents","content":"Detents"},"1722":{"id":"/docs/components/sheet#8","page_id":"/docs/components/sheet","type":"heading","tags":[],"url":"/docs/components/sheet#a-draft-the-footer-applies","content":"A draft the footer applies"},"1723":{"id":"/docs/components/sheet#9","page_id":"/docs/components/sheet","type":"heading","tags":[],"url":"/docs/components/sheet#api","content":"API"},"1724":{"id":"/docs/components/sheet#10","page_id":"/docs/components/sheet","tags":[],"type":"text","url":"/docs/components/sheet#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1725":{"id":"/docs/components/sheet#11","page_id":"/docs/components/sheet","tags":[],"type":"text","url":"/docs/components/sheet#composition","content":"Use the following composition to build a `Sheet`:"},"1726":{"id":"/docs/components/sheet#12","page_id":"/docs/components/sheet","tags":[],"type":"text","url":"/docs/components/sheet#grabber","content":"A bottom sheet has a grabber at its top: `nsh/base`'s own handle, which screen readers adjust to\nchange the detent and which moves to the next larger one when pressed. It is the handle itself,\nnot a picture of one, so a sheet never shows two. `grabber`\noff shows it; `grabberAccessibilityLabel` names it (\"Sheet\" by default)."},"1727":{"id":"/docs/components/sheet#13","page_id":"/docs/components/sheet","tags":[],"type":"text","url":"/docs/components/sheet#grabber","content":"The panel's look is `sheetPanel(side)`."},"1728":{"id":"/docs/components/sheet#14","page_id":"/docs/components/sheet","tags":[],"type":"text","url":"/docs/components/sheet#detents","content":"A bottom sheet can rest at heights instead of fitting its content: `detents` names them (`\"medium\"`\nis half the screen, `\"large\"` its room), and a drag or a press on the grabber moves between them. Pass\n`detent` and `onDetentChange` to own which one it rests at, and leave `closeOnSwipe` on to let a\ndownward swipe below the smallest close it."},"1729":{"id":"/docs/components/sheet#15","page_id":"/docs/components/sheet","tags":[],"type":"text","url":"/docs/components/sheet#detents","content":"The `footer` stays at the bottom of the part of the panel that shows, at every detent; the smallest\none has to be tall enough to show it. A `Scroll` above it takes what room is left, so the thread\nmoves under a thumb while the field and its send button stay put."},"1730":{"id":"/docs/components/sheet#16","page_id":"/docs/components/sheet","tags":[],"type":"text","url":"/docs/components/sheet#a-draft-the-footer-applies","content":"A sheet of filters edits a draft, and the footer decides whether the page sees it. Copy the applied\nfilters in when the sheet opens, keep the draft in the content, and write it back only in the\nfooter's button; closing any other way throws the draft away."},"1731":{"id":"/docs/components/sheet#17","page_id":"/docs/components/sheet","tags":[],"type":"text","url":"/docs/components/sheet#a-draft-the-footer-applies","content":"The count in the apply button follows the draft while the page's own count still follows `applied`,\nso the difference between \"what I am choosing\" and \"what is on\" is visible at every press. `Reset`\nclears the draft only; the footer's other button is still what applies it."},"1732":{"id":"/docs/components/sheet#18","page_id":"/docs/components/sheet","tags":[],"type":"text","url":"/docs/components/sheet#api","content":"Every prop of `nsh/base` Sheet passes through on `SheetContent`. `popupStyle` and `backdropStyle` go over the look's."},"1733":{"id":"/docs/components/sheet#19","page_id":"/docs/components/sheet","tags":[],"type":"text","url":"/docs/components/sheet#api","content":"| Part          | Props   | Description                                                    |\n| ------------- | ------- | -------------------------------------------------------------- |\n| `SheetHeader` | `style` | The heading block: a title and its description, 2 points apart |","table":"table-0"},"1734":{"id":"/docs/components/sheet#20","page_id":"/docs/components/sheet","tags":[],"type":"text","url":"/docs/components/sheet#api","content":"| Part          | Props   | Description                          |\n| ------------- | ------- | ------------------------------------ |\n| `SheetFooter` | `style` | The actions, in a row 8 points apart |","table":"table-0"},"1735":{"id":"/docs/components/sheet#21","page_id":"/docs/components/sheet","tags":[],"type":"text","url":"/docs/components/sheet#api","content":"| Part         | Props               | Description                                                                                                                                               |\n| ------------ | ------------------- | --------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `SheetTitle` | `children`, `style` | The title in `DialogTitle`'s type; a string also names the sheet's dialog for screen readers, unless `SheetContent`'s `accessibilityLabel` says otherwise |","table":"table-0"},"1736":{"id":"/docs/components/sheet#22","page_id":"/docs/components/sheet","tags":[],"type":"text","url":"/docs/components/sheet#api","content":"| Part               | Props               | Description                                                                                                         |\n| ------------------ | ------------------- | ------------------------------------------------------------------------------------------------------------------- |\n| `SheetDescription` | `children`, `style` | The description in `DialogDescription`'s type. `nsh/base`'s sheet has no description prop, so it is read as content |","table":"table-0"},"1737":{"id":"/docs/components/sheet#23","page_id":"/docs/components/sheet","tags":[],"type":"text","url":"/docs/components/sheet#api","content":"| Part           | Props                                                                                                                                                                                                                  | Description                                                                                                                                                      |\n| -------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `SheetContent` | `side` (`\"bottom\" \\| \"top\" \\| \"left\" \\| \"right\"`, default `\"bottom\"`), `grabber` (on for `side=\"bottom\"`), `grabberAccessibilityLabel`, `detents`, `detent`, `onDetentChange`, `closeOnSwipe`, `footer`, `footerStyle` | Every prop of `nsh/base` Sheet passes through; `popupStyle` and `backdropStyle` go over the look's. `footer` stays at the visible panel's bottom at every detent |","table":"table-0"},"1738":{"id":"/docs/components/sidebar","page_id":"/docs/components/sidebar","type":"page","content":"Sidebar","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/sidebar"},"1739":{"id":"/docs/components/sidebar#0","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar","content":"An app's navigation column beside its page — folded to a strip of icons, or sliding in as a sheet on a phone."},"1740":{"id":"/docs/components/sidebar#1","page_id":"/docs/components/sidebar","type":"heading","tags":[],"url":"/docs/components/sidebar#installation","content":"Installation"},"1741":{"id":"/docs/components/sidebar#2","page_id":"/docs/components/sidebar","type":"heading","tags":[],"url":"/docs/components/sidebar#usage","content":"Usage"},"1742":{"id":"/docs/components/sidebar#3","page_id":"/docs/components/sidebar","type":"heading","tags":[],"url":"/docs/components/sidebar#composition","content":"Composition"},"1743":{"id":"/docs/components/sidebar#4","page_id":"/docs/components/sidebar","type":"heading","tags":[],"url":"/docs/components/sidebar#examples","content":"Examples"},"1744":{"id":"/docs/components/sidebar#5","page_id":"/docs/components/sidebar","type":"heading","tags":[],"url":"/docs/components/sidebar#the-column","content":"The column"},"1745":{"id":"/docs/components/sidebar#6","page_id":"/docs/components/sidebar","type":"heading","tags":[],"url":"/docs/components/sidebar#the-page-beside-it","content":"The page beside it"},"1746":{"id":"/docs/components/sidebar#7","page_id":"/docs/components/sidebar","type":"heading","tags":[],"url":"/docs/components/sidebar#the-open-state","content":"The open state"},"1747":{"id":"/docs/components/sidebar#8","page_id":"/docs/components/sidebar","type":"heading","tags":[],"url":"/docs/components/sidebar#on-a-phone","content":"On a phone"},"1748":{"id":"/docs/components/sidebar#9","page_id":"/docs/components/sidebar","type":"heading","tags":[],"url":"/docs/components/sidebar#a-row","content":"A row"},"1749":{"id":"/docs/components/sidebar#10","page_id":"/docs/components/sidebar","type":"heading","tags":[],"url":"/docs/components/sidebar#an-action-a-badge","content":"An action, a badge"},"1750":{"id":"/docs/components/sidebar#11","page_id":"/docs/components/sidebar","type":"heading","tags":[],"url":"/docs/components/sidebar#a-sub-menu","content":"A sub menu"},"1751":{"id":"/docs/components/sidebar#12","page_id":"/docs/components/sidebar","type":"heading","tags":[],"url":"/docs/components/sidebar#a-group","content":"A group"},"1752":{"id":"/docs/components/sidebar#13","page_id":"/docs/components/sidebar","type":"heading","tags":[],"url":"/docs/components/sidebar#a-row-that-is-still-coming","content":"A row that is still coming"},"1753":{"id":"/docs/components/sidebar#14","page_id":"/docs/components/sidebar","type":"heading","tags":[],"url":"/docs/components/sidebar#api","content":"API"},"1754":{"id":"/docs/components/sidebar#15","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1755":{"id":"/docs/components/sidebar#16","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#usage","content":"The examples draw icons with `Icon` from `lib/ui/icons`; see Icons for adding it and picking a size and color."},"1756":{"id":"/docs/components/sidebar#17","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#composition","content":"Use the following composition to build a `Sidebar`:"},"1757":{"id":"/docs/components/sidebar#18","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#the-column","content":"`Sidebar` is a column 256 points wide on the sidebar's fill,\nits edge against the page, holding a `SidebarHeader`, the groups in a `SidebarContent` that scrolls\nwhen they do not fit, and a `SidebarFooter`."},"1758":{"id":"/docs/components/sidebar#19","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#the-column","content":"Three axes say how it meets the window:"},"1759":{"id":"/docs/components/sidebar#20","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#the-column","content":"`side` — `left` (default) or `right`: which edge it stands on."},"1760":{"id":"/docs/components/sidebar#21","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#the-column","content":"`variant` — `sidebar` (default) its own edge against the page; `floating` a card standing in the\nwindow's air, 8 points of room around it; `inset` a card on the sidebar's ground, with the page's\nown card beside it on that same ground, 8 points from it and from the window's edges."},"1761":{"id":"/docs/components/sidebar#22","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#the-column","content":"`collapsible` — `offcanvas` (default) leaves the window when it closes; `icon` folds to a strip of\nicons (48 points); `none` never closes."},"1762":{"id":"/docs/components/sidebar#23","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#the-column","content":"Closing takes the room away at once: the platform transitions colors, opacity and transforms, not\nlayout, so there is no 200 ms width animation to land (and no `motion-reduce` to switch off) — the\ncolumn is either as wide as its state says, or gone."},"1763":{"id":"/docs/components/sidebar#24","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#the-page-beside-it","content":"`SidebarInset` is the page, filling what is left of the window: the page's own fill, or in the `inset`\nvariant a card with its corners 8 points from the column's card and from the window's edges. Room for\nthe header of the page is the app's: a row with the trigger, a `Separator` (`orientation=\"vertical\"`,\n16 high), where you are, and what it holds."},"1764":{"id":"/docs/components/sidebar#25","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#the-open-state","content":"`SidebarProvider` owns it: `open` (controlled) or `defaultOpen` (default `true`), reported by\n`onOpenChange({ open, reason })` — `triggerPress`, `railPress` or `shortcut`. Nothing is written\ndown: storage is the app's, which usually keeps the state where it keeps the rest of its settings\nand passes it back as `open`."},"1765":{"id":"/docs/components/sidebar#26","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#the-open-state","content":"`useSidebar()` is what the parts read, and what an app reads inside the provider: `state`\n(`\"expanded\"` or `\"collapsed\"`), `open`, `openMobile`, `isMobile`, `setOpen`, `setOpenMobile` and\n`toggleSidebar`. Every value is live: read it in a JSX binding and it follows the provider."},"1766":{"id":"/docs/components/sidebar#27","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#the-open-state","content":"⌘B on Apple platforms, Ctrl+B elsewhere, folds the column and opens it — `keymap.bind(\"mod+b\")`,\nmade where the provider draws and gone with it. The rail at the column's inner edge takes a press\ntoo: it is 8 points wide (16 wide to a press, past its bounds with `hitSlop`) and shows a hairline in\nthe sidebar's edge color while the pointer is over it. That hairline follows the pointer through the\nclass language (`group-hover:`), not a signal, so passing the cursor over the rail commits no frame;\nthe pointer has to be on the 8-point strip itself, not only in its `hitSlop` margin. `SidebarTrigger` is the button that usually\nsits in the page's header."},"1767":{"id":"/docs/components/sidebar#28","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#on-a-phone","content":"A touch screen, or a window narrower than 600 points, shows the column as a sheet instead — this\nlibrary's `Sheet`, 288 points wide from the side the column stands on, with the same trigger opening\nit. The column's own state is left alone, so a window that widens again finds it as it was."},"1768":{"id":"/docs/components/sidebar#29","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#a-row","content":"`SidebarMenuButton` is a row of `SidebarMenu`, inside a `SidebarGroupContent` of a `SidebarGroup`\nthat a `SidebarGroupLabel` names: the theme's row high (`controlSize.row`), its label the `body`\ntype role, the pointer's fill under it, the `sidebarAccent` fill when `isActive` (the page the app\nis on), the keyboard's ring, and 50% while `disabled`. It takes a press (`onPress`), or it is a\nrow of its own; no `href`, as a navigation menu's link has none."},"1769":{"id":"/docs/components/sidebar#30","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#a-row","content":"`size` is the row's step — `default` the theme's row, `sm` the height step under it, `lg` a team's\nswitcher or a user's row, 48 points where the row is a pointer's (a touch screen's row is already a\nfinger's height) — and `variant` is its look: `default`, bare until the pointer is over it, or\n`outline`, a card of its own on the column."},"1770":{"id":"/docs/components/sidebar#31","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#a-row","content":"A string child is the row's name. Anything else is drawn as given, which is how an icon leads a name:\nthe look has the words for it."},"1771":{"id":"/docs/components/sidebar#32","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#a-row","content":"Folded to icons, the row is a square the height of a row with its icon, and\n`tooltip` names it on a desktop: a\nstring is the name, or the tooltip's own props (`placement`, `delay`, …). It also names the row for\nscreen readers when nothing else does — and it replaces `nsh/base`'s element `tooltip`, which is what\nthis prop is."},"1772":{"id":"/docs/components/sidebar#33","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#a-row","content":"A row keeps its name only while the column is open: nothing else moves, so a look is written once\nwhere the row draws. A row the app draws hands its look the column's fold — `open` and `collapsible`,\nthe app's own signals — and its name goes; a look given no fold options draws the open row, and an\naction or a badge inside a folded item leaves the tree."},"1773":{"id":"/docs/components/sidebar#34","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#an-action-a-badge","content":"`SidebarMenuAction` is a 20-point square at the row's trailing edge, in `SidebarMenuItem`, and\n`SidebarMenuBadge` a pill there — a count, a short word, its numbers tabular. The item keeps the room\nthey need, so the row's name stops short of them; both on one row, the action steps in by the\nbadge's width rather than drawing over it."},"1774":{"id":"/docs/components/sidebar#35","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#an-action-a-badge","content":"An action is always there: hover alone is something a touch screen has no way to do."},"1775":{"id":"/docs/components/sidebar#36","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#a-sub-menu","content":"`SidebarMenuSub` holds the rows under a row that opens them — `SidebarMenuSubItem` and its\n`SidebarMenuSubButton`, the height step under the row (`controlHeight.md`). It is 14 points in from\nthe row above it, with a hairline down its start in the sidebar's edge color, and it hides while the\ncolumn is folded."},"1776":{"id":"/docs/components/sidebar#37","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#a-sub-menu","content":"The row above it opens it. `nsh/base`'s `Collapsible` does the reveal — not this library's\n`Collapsible`, which draws a disclosure row of its own (a settings list wants that; a sidebar row\nwants the row it already has):"},"1777":{"id":"/docs/components/sidebar#38","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#a-group","content":"`SidebarGroupLabel` names a group in 32 points of quiet type; folded to icons it takes no room and\ndraws nothing, and stays in the tree for a screen reader. `SidebarGroupAction` stands at its trailing\nedge — a search, a settings — 20 points square. `SidebarGroupContent` takes the rows, as wide as the\ngroup."},"1778":{"id":"/docs/components/sidebar#39","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#a-row-that-is-still-coming","content":"`SidebarMenuSkeleton` is the skeleton's blocks where an icon and a name will be: an icon's box when\n`showIcon`, then a line of text as long as `width` says (70% when it says nothing). A length made up\nper mount is a picture that changes between runs, so this one is told."},"1779":{"id":"/docs/components/sidebar#40","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#api","content":"The provider owns the state and lays the column and the page out; a column and its parts draw on\n`nsh`'s `View` (`SidebarSeparator` wraps this library's `Separator`, and the phone's sheet is this\nlibrary's `Sheet`). Every `nsh` view prop passes through; a row is an `nsh/base` button's props too."},"1780":{"id":"/docs/components/sidebar#41","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#api","content":"| Part              | Props                                                             | Description                                                                      |\n| ----------------- | ----------------------------------------------------------------- | -------------------------------------------------------------------------------- |\n| `SidebarProvider` | `open` / `defaultOpen`, `onOpenChange({ open, reason })`, `style` | Owns the state and the ⌘B / Ctrl+B binding, and lays the column and the page out |","table":"table-0"},"1781":{"id":"/docs/components/sidebar#42","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#api","content":"| Part      | Props                            | Description                                         |\n| --------- | -------------------------------- | --------------------------------------------------- |\n| `Sidebar` | `side`, `variant`, `collapsible` | The column; on a phone it is this library's `Sheet` |","table":"table-0"},"1782":{"id":"/docs/components/sidebar#43","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#api","content":"| Part             | Props                                                                                                | Description                                 |\n| ---------------- | ---------------------------------------------------------------------------------------------------- | ------------------------------------------- |\n| `SidebarTrigger` | `children` (its icon), `accessibilityLabel` (default `\"Toggle Sidebar\"`), and an icon button's props | The button that opens and closes the column |","table":"table-0"},"1783":{"id":"/docs/components/sidebar#44","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#api","content":"| Part          | Props                | Description                        |\n| ------------- | -------------------- | ---------------------------------- |\n| `SidebarRail` | `accessibilityLabel` | A press at the column's inner edge |","table":"table-0"},"1784":{"id":"/docs/components/sidebar#45","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#api","content":"| Part           | Props                 | Description                |\n| -------------- | --------------------- | -------------------------- |\n| `SidebarInset` | every `nsh` view prop | The page beside the column |","table":"table-0"},"1785":{"id":"/docs/components/sidebar#46","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#api","content":"| Part            | Props                 | Description                                         |\n| --------------- | --------------------- | --------------------------------------------------- |\n| `SidebarHeader` | every `nsh` view prop | The top: a stack of rows, 8 points apart, 8 of room |","table":"table-0"},"1786":{"id":"/docs/components/sidebar#47","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#api","content":"| Part            | Props                 | Description               |\n| --------------- | --------------------- | ------------------------- |\n| `SidebarFooter` | every `nsh` view prop | The bottom, as the header |","table":"table-0"},"1787":{"id":"/docs/components/sidebar#48","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#api","content":"| Part             | Props                 | Description          |\n| ---------------- | --------------------- | -------------------- |\n| `SidebarContent` | every `nsh` view prop | The scrolling middle |","table":"table-0"},"1788":{"id":"/docs/components/sidebar#49","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#api","content":"| Part               | Props               | Description                                                              |\n| ------------------ | ------------------- | ------------------------------------------------------------------------ |\n| `SidebarSeparator` | `Separator`'s props | A separator in the sidebar's edge color, 8 points inset from either side |","table":"table-0"},"1789":{"id":"/docs/components/sidebar#50","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#api","content":"| Part           | Props           | Description                                   |\n| -------------- | --------------- | --------------------------------------------- |\n| `SidebarInput` | `Input`'s props | An input as tall as a row, on the page's fill |","table":"table-0"},"1790":{"id":"/docs/components/sidebar#51","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#api","content":"| Part           | Props                 | Description                      |\n| -------------- | --------------------- | -------------------------------- |\n| `SidebarGroup` | every `nsh` view prop | A titled group, 8 points of room |","table":"table-0"},"1791":{"id":"/docs/components/sidebar#52","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#api","content":"| Part                | Props      | Description                                 |\n| ------------------- | ---------- | ------------------------------------------- |\n| `SidebarGroupLabel` | `children` | A string is the name; folds away to nothing |","table":"table-0"},"1792":{"id":"/docs/components/sidebar#53","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#api","content":"| Part                 | Props                                                             | Description                                    |\n| -------------------- | ----------------------------------------------------------------- | ---------------------------------------------- |\n| `SidebarGroupAction` | `accessibilityLabel`, `onPress`, and an `nsh/base` button's props | A 20-point square at the group's trailing edge |","table":"table-0"},"1793":{"id":"/docs/components/sidebar#54","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#api","content":"| Part                  | Props                 | Description          |\n| --------------------- | --------------------- | -------------------- |\n| `SidebarGroupContent` | every `nsh` view prop | What the group holds |","table":"table-0"},"1794":{"id":"/docs/components/sidebar#55","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#api","content":"| Part          | Props                 | Description                               |\n| ------------- | --------------------- | ----------------------------------------- |\n| `SidebarMenu` | every `nsh` view prop | The rows: a column of them 4 points apart |","table":"table-0"},"1795":{"id":"/docs/components/sidebar#56","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#api","content":"| Part              | Props                 | Description                                               |\n| ----------------- | --------------------- | --------------------------------------------------------- |\n| `SidebarMenuItem` | every `nsh` view prop | One row's box: its button, an action, a badge, a sub menu |","table":"table-0"},"1796":{"id":"/docs/components/sidebar#57","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#api","content":"| Part                | Props                                                                                                                           | Description       |\n| ------------------- | ------------------------------------------------------------------------------------------------------------------------------- | ----------------- |\n| `SidebarMenuButton` | `isActive`, `size`, `variant`, `tooltip`, `children`, `accessibilityLabel`, and an `nsh/base` button's `onPress`, `disabled`, … | A row of the menu |","table":"table-0"},"1797":{"id":"/docs/components/sidebar#58","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#api","content":"| Part                | Props                                                             | Description                                  |\n| ------------------- | ----------------------------------------------------------------- | -------------------------------------------- |\n| `SidebarMenuAction` | `accessibilityLabel`, `onPress`, and an `nsh/base` button's props | A 20-point square at the row's trailing edge |","table":"table-0"},"1798":{"id":"/docs/components/sidebar#59","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#api","content":"| Part               | Props      | Description                                        |\n| ------------------ | ---------- | -------------------------------------------------- |\n| `SidebarMenuBadge` | `children` | A count or a short word at the row's trailing edge |","table":"table-0"},"1799":{"id":"/docs/components/sidebar#60","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#api","content":"| Part             | Props                 | Description                          |\n| ---------------- | --------------------- | ------------------------------------ |\n| `SidebarMenuSub` | every `nsh` view prop | The rows under a row that opens them |","table":"table-0"},"1800":{"id":"/docs/components/sidebar#61","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#api","content":"| Part                 | Props                 | Description |\n| -------------------- | --------------------- | ----------- |\n| `SidebarMenuSubItem` | every `nsh` view prop | One of them |","table":"table-0"},"1801":{"id":"/docs/components/sidebar#62","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#api","content":"| Part                   | Props                                                                                  | Description                 |\n| ---------------------- | -------------------------------------------------------------------------------------- | --------------------------- |\n| `SidebarMenuSubButton` | `isActive`, `size`, `children`, `accessibilityLabel`, and an `nsh/base` button's props | A sub row; it takes a press |","table":"table-0"},"1802":{"id":"/docs/components/sidebar#63","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#api","content":"| Part                  | Props               | Description                                            |\n| --------------------- | ------------------- | ------------------------------------------------------ |\n| `SidebarMenuSkeleton` | `showIcon`, `width` | The skeleton's blocks where an icon and a name will be |","table":"table-0"},"1803":{"id":"/docs/components/sidebar#64","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#api","content":"| Part           | Props | Description                                                                                                                     |\n| -------------- | ----- | ------------------------------------------------------------------------------------------------------------------------------- |\n| `useSidebar()` | —     | What the parts read inside the provider: `state`, `open`, `openMobile`, `isMobile`, `setOpen`, `setOpenMobile`, `toggleSidebar` |","table":"table-0"},"1804":{"id":"/docs/components/sidebar#65","page_id":"/docs/components/sidebar","tags":[],"type":"text","url":"/docs/components/sidebar#api","content":"`sidebarMenuButtonLook({ size, variant, active, trailing })` is exported for a row the app draws\nitself: its `label` and its `glyph` (`size`, `tint`). The other looks stay with the parts."},"1805":{"id":"/docs/components/skeleton","page_id":"/docs/components/skeleton","type":"page","content":"Skeleton","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/skeleton"},"1806":{"id":"/docs/components/skeleton#0","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton","content":"The shape of content that is still coming."},"1807":{"id":"/docs/components/skeleton#1","page_id":"/docs/components/skeleton","type":"heading","tags":[],"url":"/docs/components/skeleton#installation","content":"Installation"},"1808":{"id":"/docs/components/skeleton#2","page_id":"/docs/components/skeleton","type":"heading","tags":[],"url":"/docs/components/skeleton#usage","content":"Usage"},"1809":{"id":"/docs/components/skeleton#3","page_id":"/docs/components/skeleton","type":"heading","tags":[],"url":"/docs/components/skeleton#examples","content":"Examples"},"1810":{"id":"/docs/components/skeleton#4","page_id":"/docs/components/skeleton","type":"heading","tags":[],"url":"/docs/components/skeleton#a-line-an-avatar-a-button","content":"A line, an avatar, a button"},"1811":{"id":"/docs/components/skeleton#5","page_id":"/docs/components/skeleton","type":"heading","tags":[],"url":"/docs/components/skeleton#a-block-of-content","content":"A block of content"},"1812":{"id":"/docs/components/skeleton#6","page_id":"/docs/components/skeleton","type":"heading","tags":[],"url":"/docs/components/skeleton#motion","content":"Motion"},"1813":{"id":"/docs/components/skeleton#7","page_id":"/docs/components/skeleton","type":"heading","tags":[],"url":"/docs/components/skeleton#api","content":"API"},"1814":{"id":"/docs/components/skeleton#8","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1815":{"id":"/docs/components/skeleton#9","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#a-line-an-avatar-a-button","content":"A skeleton has no size of its own: the box is the caller's `style`. A line is as tall as the type\nit will hold and as wide as that text runs; an avatar or an icon is a square, round with\n`borderRadius` half its side."},"1816":{"id":"/docs/components/skeleton#10","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#a-block-of-content","content":"Placeholders keep the layout of what is coming: a column with a `gap` where the rows will be, and\na row for the parts that sit side by side."},"1817":{"id":"/docs/components/skeleton#11","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#motion","content":"The block breathes (an endless motion). When the user asks for less motion it stays still, and a\nterminal shows it still: nothing to play there."},"1818":{"id":"/docs/components/skeleton#12","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#api","content":"Every prop of `nsh` View passes through (`style`, `accessibilityLabel`, …); `style` goes over the look's."},"1819":{"id":"/docs/components/skeleton#13","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#api","content":"| Part       | Props       | Description                                                           |\n| ---------- | ----------- | --------------------------------------------------------------------- |\n| `Skeleton` | `ViewProps` | The block; its box, corners and breathing are the look's and `style`. |","table":"table-0"},"1820":{"id":"/docs/components/skeleton#14","page_id":"/docs/components/skeleton","tags":[],"type":"text","url":"/docs/components/skeleton#api","content":"There is no axis: a skeleton is one look — the theme's `accent` fill, the theme's control corners,\nthe breathing. The box, including a radius of the app's own, is the caller's `style`."},"1821":{"id":"/docs/components/slider","page_id":"/docs/components/slider","type":"page","content":"Slider","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/slider"},"1822":{"id":"/docs/components/slider#0","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider","content":"A sunk rail, citrus fill, and round thumb with a focus ring."},"1823":{"id":"/docs/components/slider#1","page_id":"/docs/components/slider","type":"heading","tags":[],"url":"/docs/components/slider#installation","content":"Installation"},"1824":{"id":"/docs/components/slider#2","page_id":"/docs/components/slider","type":"heading","tags":[],"url":"/docs/components/slider#usage","content":"Usage"},"1825":{"id":"/docs/components/slider#3","page_id":"/docs/components/slider","type":"heading","tags":[],"url":"/docs/components/slider#examples","content":"Examples"},"1826":{"id":"/docs/components/slider#4","page_id":"/docs/components/slider","type":"heading","tags":[],"url":"/docs/components/slider#disabled","content":"Disabled"},"1827":{"id":"/docs/components/slider#5","page_id":"/docs/components/slider","type":"heading","tags":[],"url":"/docs/components/slider#the-rail-and-the-knob","content":"The rail and the knob"},"1828":{"id":"/docs/components/slider#6","page_id":"/docs/components/slider","type":"heading","tags":[],"url":"/docs/components/slider#value-column","content":"Value column"},"1829":{"id":"/docs/components/slider#7","page_id":"/docs/components/slider","type":"heading","tags":[],"url":"/docs/components/slider#vertical","content":"Vertical"},"1830":{"id":"/docs/components/slider#8","page_id":"/docs/components/slider","type":"heading","tags":[],"url":"/docs/components/slider#api","content":"API"},"1831":{"id":"/docs/components/slider#9","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1832":{"id":"/docs/components/slider#10","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#disabled","content":"Opacity on the track comes from the look's `disabled:opacity-50` class on `trackClass`."},"1833":{"id":"/docs/components/slider#11","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#the-rail-and-the-knob","content":"Both come from the theme, read where the slider draws: the `track` value of `control()` gives the\ngroove — its face colour, and, on a graved groove (`sunk`), the inset shade that is also the edge of\nthe accent's run — and the `handle` value gives the knob: a disc, or WinUI's ring, with the rail's\nthickness, the band around it, the pressed size, and a vertical rail 128 points long (144 on a\ntouch screen) on every form."},"1834":{"id":"/docs/components/slider#12","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#value-column","content":"`showValue` lays the value beside a horizontal rail (a 42-point column) or above a vertical one.\nA string of your own replaces the formatted number and keeps that place."},"1835":{"id":"/docs/components/slider#13","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#vertical","content":"A fill that starts at the rail's start (`from` at or below 0) stays nsh's own run, from the\nminimum to the thumb. A fill that starts later sets its own edges. Name the farther end first\nwhen the span reaches back to the start, so a band lit from the middle still places itself at\nthe minimum:"},"1836":{"id":"/docs/components/slider#14","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#api","content":"`Slider` is `nsh/base` Slider wearing `sliderLook` and `sliderFill`: every base prop passes through, and the look's classes and styles are defaults the caller can override."},"1837":{"id":"/docs/components/slider#15","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#api","content":"| Part     | Props                                                                                                                                         | Description                                                                                                    |\n| -------- | --------------------------------------------------------------------------------------------------------------------------------------------- | -------------------------------------------------------------------------------------------------------------- |\n| `Slider` | `axis`, `showValue`, and every `nsh/base` Slider prop (`value`, `min`, `max`, `step`, `onChange`, `onChangeEnd`, `disabled`, `rangeStyle`, …) | The rail, the thumb and the fill. `showValue` lays the value beside a horizontal rail, or above a vertical one |","table":"table-0"},"1838":{"id":"/docs/components/slider#16","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#api","content":"| Part           | Props               | Description                                                                                                                                        |\n| -------------- | ------------------- | -------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `sliderLook()` | `vertical`, `value` | The parts to spread on a slider of your own: `class`, `trackClass`, `indicatorClass` / `indicatorStyle`, `rangeClass`, `thumbClass` / `thumbStyle` |","table":"table-0"},"1839":{"id":"/docs/components/slider#17","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#api","content":"| Part           | Props                    | Description                                                                                                                                         |\n| -------------- | ------------------------ | --------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `sliderFill()` | `from`, `to`, `vertical` | The accent between `from` and `to` when `from` is past the rail's start. A `from` of 0 or less leaves placement to nsh, so a thumb can drag the run |","table":"table-0"},"1840":{"id":"/docs/components/slider#18","page_id":"/docs/components/slider","tags":[],"type":"text","url":"/docs/components/slider#api","content":"| Part                 | Props | Description                                                                                                                                     |\n| -------------------- | ----- | ----------------------------------------------------------------------------------------------------------------------------------------------- |\n| `sliderValueStyle()` | —     | The value label's color. A horizontal column is `w-[42px] text-right font-mono text-[11px] leading-none`; a vertical readout is a centered line |","table":"table-0"},"1841":{"id":"/docs/components/spinner","page_id":"/docs/components/spinner","type":"page","content":"Spinner","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/spinner"},"1842":{"id":"/docs/components/spinner#0","page_id":"/docs/components/spinner","tags":[],"type":"text","url":"/docs/components/spinner","content":"A turning ring: work going on."},"1843":{"id":"/docs/components/spinner#1","page_id":"/docs/components/spinner","type":"heading","tags":[],"url":"/docs/components/spinner#installation","content":"Installation"},"1844":{"id":"/docs/components/spinner#2","page_id":"/docs/components/spinner","type":"heading","tags":[],"url":"/docs/components/spinner#usage","content":"Usage"},"1845":{"id":"/docs/components/spinner#3","page_id":"/docs/components/spinner","type":"heading","tags":[],"url":"/docs/components/spinner#examples","content":"Examples"},"1846":{"id":"/docs/components/spinner#4","page_id":"/docs/components/spinner","type":"heading","tags":[],"url":"/docs/components/spinner#size","content":"Size"},"1847":{"id":"/docs/components/spinner#5","page_id":"/docs/components/spinner","type":"heading","tags":[],"url":"/docs/components/spinner#in-a-button","content":"In a button"},"1848":{"id":"/docs/components/spinner#6","page_id":"/docs/components/spinner","type":"heading","tags":[],"url":"/docs/components/spinner#api","content":"API"},"1849":{"id":"/docs/components/spinner#7","page_id":"/docs/components/spinner","tags":[],"type":"text","url":"/docs/components/spinner#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1850":{"id":"/docs/components/spinner#8","page_id":"/docs/components/spinner","tags":[],"type":"text","url":"/docs/components/spinner#size","content":"`size` is the theme's icon tier, so the ring follows the pointer: 12, 16 and 20 points with a\npointer, 16, 20 and 24 on a touch screen. `side` takes an exact size in points where the scale's\ndoes not fit."},"1851":{"id":"/docs/components/spinner#9","page_id":"/docs/components/spinner","tags":[],"type":"text","url":"/docs/components/spinner#in-a-button","content":"`Button`'s `busy` state draws the ring before the label and blocks a second press."},"1852":{"id":"/docs/components/spinner#10","page_id":"/docs/components/spinner","tags":[],"type":"text","url":"/docs/components/spinner#api","content":"A ring with its top arc in `tint`, turning once every 800 ms; its stroke is an eighth of its side, at least 1.5 points.\nA groove behind the arc is the theme's track form to say: under the sunk form the rest of the ring follows\n`tint` at a quarter, under the tint and hairline forms there is none."},"1853":{"id":"/docs/components/spinner#11","page_id":"/docs/components/spinner","tags":[],"type":"text","url":"/docs/components/spinner#api","content":"| Part      | Props                  | Description                                                                                                                                                            |\n| --------- | ---------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `Spinner` | `size`, `side`, `tint` | The ring: `size` the icon tier (`sm`, `default`, `lg`) or `side` its side in points; `tint` its arc (under a sunk track form, the rest of it that color at a quarter). |","table":"table-0"},"1854":{"id":"/docs/components/split-view","page_id":"/docs/components/split-view","type":"page","content":"SplitView","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/split-view"},"1855":{"id":"/docs/components/split-view#0","page_id":"/docs/components/split-view","tags":[],"type":"text","url":"/docs/components/split-view","content":"Two or three columns of navigation stacks, with the column header and the sidebar button in the theme's look."},"1856":{"id":"/docs/components/split-view#1","page_id":"/docs/components/split-view","type":"heading","tags":[],"url":"/docs/components/split-view#installation","content":"Installation"},"1857":{"id":"/docs/components/split-view#2","page_id":"/docs/components/split-view","type":"heading","tags":[],"url":"/docs/components/split-view#usage","content":"Usage"},"1858":{"id":"/docs/components/split-view#3","page_id":"/docs/components/split-view","type":"heading","tags":[],"url":"/docs/components/split-view#composition","content":"Composition"},"1859":{"id":"/docs/components/split-view#4","page_id":"/docs/components/split-view","type":"heading","tags":[],"url":"/docs/components/split-view#examples","content":"Examples"},"1860":{"id":"/docs/components/split-view#5","page_id":"/docs/components/split-view","type":"heading","tags":[],"url":"/docs/components/split-view#three-columns","content":"Three columns"},"1861":{"id":"/docs/components/split-view#6","page_id":"/docs/components/split-view","type":"heading","tags":[],"url":"/docs/components/split-view#the-sidebar-button","content":"The sidebar button"},"1862":{"id":"/docs/components/split-view#7","page_id":"/docs/components/split-view","type":"heading","tags":[],"url":"/docs/components/split-view#on-a-phone","content":"On a phone"},"1863":{"id":"/docs/components/split-view#8","page_id":"/docs/components/split-view","type":"heading","tags":[],"url":"/docs/components/split-view#controlled","content":"Controlled"},"1864":{"id":"/docs/components/split-view#9","page_id":"/docs/components/split-view","type":"heading","tags":[],"url":"/docs/components/split-view#api","content":"API"},"1865":{"id":"/docs/components/split-view#10","page_id":"/docs/components/split-view","tags":[],"type":"text","url":"/docs/components/split-view#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1866":{"id":"/docs/components/split-view#11","page_id":"/docs/components/split-view","tags":[],"type":"text","url":"/docs/components/split-view#usage","content":"`sidebar`, `content` and `detail` stay props, and each one is a `NavStack`. The platform finds that stack in the slot, so these parts are the pages inside it, not wrappers around it. Leave `content` out for two columns."},"1867":{"id":"/docs/components/split-view#12","page_id":"/docs/components/split-view","tags":[],"type":"text","url":"/docs/components/split-view#composition","content":"Use the following composition to build a `SplitView`:"},"1868":{"id":"/docs/components/split-view#13","page_id":"/docs/components/split-view","tags":[],"type":"text","url":"/docs/components/split-view#examples","content":"The behavior — which columns show, the phone collapsing to one, the system's sidebar button on iOS — is NSH's `SplitView`. This component is that view, plus the column's surface, the header a desktop draws, and the button that hides the sidebar."},"1869":{"id":"/docs/components/split-view#14","page_id":"/docs/components/split-view","tags":[],"type":"text","url":"/docs/components/split-view#examples","content":"The columns' widths are the platform's. Panes the user resizes are `Resizable`."},"1870":{"id":"/docs/components/split-view#15","page_id":"/docs/components/split-view","tags":[],"type":"text","url":"/docs/components/split-view#three-columns","content":"Each column is a stack of its own, so pushing a page in the detail leaves the sidebar and the list where they are. `SplitViewSidebar` is the sidebar's fill (`colors.background`) with a hairline of `colors.line` after it. `SplitViewContent` is the page's fill with `colors.line` after it. `SplitViewDetail` has no hairline. iOS draws the columns' own edges, so the hairlines are left out there."},"1871":{"id":"/docs/components/split-view#16","page_id":"/docs/components/split-view","tags":[],"type":"text","url":"/docs/components/split-view#the-sidebar-button","content":"`SplitViewTrigger` hides the sidebar (`\"doubleColumn\"`) or shows every column (`\"all\"`). It does not show or hide anything itself: the app sets `columnVisibility`, the same value the split takes. The glyph stays `colors.mutedForeground`; the button is selected while the sidebar is showing. iOS draws the system's sidebar button, so leave this one out there."},"1872":{"id":"/docs/components/split-view#17","page_id":"/docs/components/split-view","tags":[],"type":"text","url":"/docs/components/split-view#the-sidebar-button","content":"`leading` and `trailing` are the header's items. On a desktop they sit in the bar; on iOS and Android they are the system header's leading and trailing buttons."},"1873":{"id":"/docs/components/split-view#18","page_id":"/docs/components/split-view","tags":[],"type":"text","url":"/docs/components/split-view#on-a-phone","content":"Where the window is horizontally compact, one column shows: the first that `columnVisibility` includes. A choice that should bring the next column in front sets `\"doubleColumn\"`, then `\"detailOnly\"`. The way back is the page's — a button in `leading`, since a desktop has no system back between columns."},"1874":{"id":"/docs/components/split-view#19","page_id":"/docs/components/split-view","tags":[],"type":"text","url":"/docs/components/split-view#controlled","content":"`columnVisibility` is the app's. `\"automatic\"` (the view's own starting value, when the prop is left out) shows every column except where iPadOS decides, and the sidebar where the room is compact. `\"all\"`, `\"doubleColumn\"` and `\"detailOnly\"` are the other values. `onColumnVisibilityChange` reports what the user or the system shows instead — the sidebar button, a swipe from the edge, going back from a column's first page on a phone."},"1875":{"id":"/docs/components/split-view#20","page_id":"/docs/components/split-view","tags":[],"type":"text","url":"/docs/components/split-view#api","content":"`SplitView` takes every prop of `nsh/base`'s SplitView; `style` goes over the look's. A column page takes every prop of `nsh/base`'s NavPage; `style` goes over the column's. `ColumnVisibility` is `nsh/base`'s, re-exported."},"1876":{"id":"/docs/components/split-view#21","page_id":"/docs/components/split-view","tags":[],"type":"text","url":"/docs/components/split-view#api","content":"| Part        | Props                                              | Description                                                     |\n| ----------- | -------------------------------------------------- | --------------------------------------------------------------- |\n| `SplitView` | `sidebar`, `content`, `detail`, `columnVisibility` | The columns. `content` is optional: without it the view has two |","table":"table-0"},"1877":{"id":"/docs/components/split-view#22","page_id":"/docs/components/split-view","tags":[],"type":"text","url":"/docs/components/split-view#api","content":"| Part               | Props                                    | Description                                       |\n| ------------------ | ---------------------------------------- | ------------------------------------------------- |\n| `SplitViewSidebar` | `title`, `leading`, `trailing`, `header` | The sidebar's page: its fill, a hairline after it |","table":"table-0"},"1878":{"id":"/docs/components/split-view#23","page_id":"/docs/components/split-view","tags":[],"type":"text","url":"/docs/components/split-view#api","content":"| Part               | Props                                    | Description                                           |\n| ------------------ | ---------------------------------------- | ----------------------------------------------------- |\n| `SplitViewContent` | `title`, `leading`, `trailing`, `header` | The middle page: the page's fill, a hairline after it |","table":"table-0"},"1879":{"id":"/docs/components/split-view#24","page_id":"/docs/components/split-view","tags":[],"type":"text","url":"/docs/components/split-view#api","content":"| Part              | Props                                    | Description                        |\n| ----------------- | ---------------------------------------- | ---------------------------------- |\n| `SplitViewDetail` | `title`, `leading`, `trailing`, `header` | The detail's page: the page's fill |","table":"table-0"},"1880":{"id":"/docs/components/split-view#25","page_id":"/docs/components/split-view","tags":[],"type":"text","url":"/docs/components/split-view#api","content":"| Part              | Props                                    | Description                                                    |\n| ----------------- | ---------------------------------------- | -------------------------------------------------------------- |\n| `SplitViewHeader` | `column`, `title`, `leading`, `trailing` | The bar a desktop draws. `header` on a column page replaces it |","table":"table-0"},"1881":{"id":"/docs/components/split-view#26","page_id":"/docs/components/split-view","tags":[],"type":"text","url":"/docs/components/split-view#api","content":"| Part               | Props                                                                | Description                                                     |\n| ------------------ | -------------------------------------------------------------------- | --------------------------------------------------------------- |\n| `SplitViewTrigger` | `columnVisibility`, `onColumnVisibilityChange`, `accessibilityLabel` | The sidebar button. A press reports `\"doubleColumn\"` or `\"all\"` |","table":"table-0"},"1882":{"id":"/docs/components/split-view#27","page_id":"/docs/components/split-view","tags":[],"type":"text","url":"/docs/components/split-view#api","content":"`style` on the view, a column page, the header and the sidebar button goes over the look each one wears."},"1883":{"id":"/docs/components/stat","page_id":"/docs/components/stat","type":"page","content":"Stat","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/stat"},"1884":{"id":"/docs/components/stat#0","page_id":"/docs/components/stat","tags":[],"type":"text","url":"/docs/components/stat","content":"A label above a value for metric grids."},"1885":{"id":"/docs/components/stat#1","page_id":"/docs/components/stat","type":"heading","tags":[],"url":"/docs/components/stat#installation","content":"Installation"},"1886":{"id":"/docs/components/stat#2","page_id":"/docs/components/stat","type":"heading","tags":[],"url":"/docs/components/stat#usage","content":"Usage"},"1887":{"id":"/docs/components/stat#3","page_id":"/docs/components/stat","type":"heading","tags":[],"url":"/docs/components/stat#composition","content":"Composition"},"1888":{"id":"/docs/components/stat#4","page_id":"/docs/components/stat","type":"heading","tags":[],"url":"/docs/components/stat#examples","content":"Examples"},"1889":{"id":"/docs/components/stat#5","page_id":"/docs/components/stat","type":"heading","tags":[],"url":"/docs/components/stat#tone","content":"Tone"},"1890":{"id":"/docs/components/stat#6","page_id":"/docs/components/stat","type":"heading","tags":[],"url":"/docs/components/stat#truncate","content":"Truncate"},"1891":{"id":"/docs/components/stat#7","page_id":"/docs/components/stat","type":"heading","tags":[],"url":"/docs/components/stat#unit-and-note","content":"Unit and note"},"1892":{"id":"/docs/components/stat#8","page_id":"/docs/components/stat","type":"heading","tags":[],"url":"/docs/components/stat#a-row","content":"A row"},"1893":{"id":"/docs/components/stat#9","page_id":"/docs/components/stat","type":"heading","tags":[],"url":"/docs/components/stat#a-trend-beside-a-figure","content":"A trend beside a figure"},"1894":{"id":"/docs/components/stat#10","page_id":"/docs/components/stat","type":"heading","tags":[],"url":"/docs/components/stat#api","content":"API"},"1895":{"id":"/docs/components/stat#11","page_id":"/docs/components/stat","tags":[],"type":"text","url":"/docs/components/stat#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1896":{"id":"/docs/components/stat#12","page_id":"/docs/components/stat","tags":[],"type":"text","url":"/docs/components/stat#composition","content":"Use the following composition to build a `StatGroup`:"},"1897":{"id":"/docs/components/stat#13","page_id":"/docs/components/stat","tags":[],"type":"text","url":"/docs/components/stat#unit-and-note","content":"`unit` sits beside the value, smaller and muted. `note` is a line under it. shadcn/ui has no stat, so the names follow the figure a chart shows: a value, its unit, and a note."},"1898":{"id":"/docs/components/stat#14","page_id":"/docs/components/stat","tags":[],"type":"text","url":"/docs/components/stat#a-row","content":"`StatGroup` wraps several stats onto one row. A stat with no `width` shares that row. A hairline above a chart's figures is the group's class, not the default."},"1899":{"id":"/docs/components/stat#15","page_id":"/docs/components/stat","tags":[],"type":"text","url":"/docs/components/stat#a-trend-beside-a-figure","content":"A figure whose value moves with a series reads better with the series beside it: the `Stat` gives\nthe name, the value and the change in the same tone as the line, and a `Plot` at 104 × 38 draws the\ntrend without axes or a pointer — `interactive={false}`."},"1900":{"id":"/docs/components/stat#16","page_id":"/docs/components/stat","tags":[],"type":"text","url":"/docs/components/stat#a-trend-beside-a-figure","content":"`note` carries the signed move and `tone` the role it and the line share; the previous close is a\ndashed `Grid` behind the wash, so the day's direction is read at a glance."},"1901":{"id":"/docs/components/stat#17","page_id":"/docs/components/stat","tags":[],"type":"text","url":"/docs/components/stat#api","content":"Gallery atom: no `nsh/base` counterpart. shadcn/ui has no stat either."},"1902":{"id":"/docs/components/stat#18","page_id":"/docs/components/stat","tags":[],"type":"text","url":"/docs/components/stat#api","content":"| Part   | Props                                                         | Description                                                                                  |\n| ------ | ------------------------------------------------------------- | -------------------------------------------------------------------------------------------- |\n| `Stat` | `label`, `value`, `unit`, `note`, `tone`, `width`, `truncate` | A muted label over a larger value; `tone` colors the value, `truncate` keeps it to one line. |","table":"table-0"},"1903":{"id":"/docs/components/stat#19","page_id":"/docs/components/stat","tags":[],"type":"text","url":"/docs/components/stat#api","content":"| Part        | Props | Description                               |\n| ----------- | ----- | ----------------------------------------- |\n| `StatGroup` | —     | A wrapping row of stats, 12 points apart. |","table":"table-0"},"1904":{"id":"/docs/components/status","page_id":"/docs/components/status","type":"page","content":"Status","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/status"},"1905":{"id":"/docs/components/status#0","page_id":"/docs/components/status","tags":[],"type":"text","url":"/docs/components/status","content":"A dot and label for quiet state in rows or headers."},"1906":{"id":"/docs/components/status#1","page_id":"/docs/components/status","type":"heading","tags":[],"url":"/docs/components/status#installation","content":"Installation"},"1907":{"id":"/docs/components/status#2","page_id":"/docs/components/status","type":"heading","tags":[],"url":"/docs/components/status#usage","content":"Usage"},"1908":{"id":"/docs/components/status#3","page_id":"/docs/components/status","type":"heading","tags":[],"url":"/docs/components/status#examples","content":"Examples"},"1909":{"id":"/docs/components/status#4","page_id":"/docs/components/status","type":"heading","tags":[],"url":"/docs/components/status#tone","content":"Tone"},"1910":{"id":"/docs/components/status#5","page_id":"/docs/components/status","type":"heading","tags":[],"url":"/docs/components/status#api","content":"API"},"1911":{"id":"/docs/components/status#6","page_id":"/docs/components/status","tags":[],"type":"text","url":"/docs/components/status#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1912":{"id":"/docs/components/status#7","page_id":"/docs/components/status","tags":[],"type":"text","url":"/docs/components/status#api","content":"Gallery atom: no `nsh/base` counterpart."},"1913":{"id":"/docs/components/status#8","page_id":"/docs/components/status","tags":[],"type":"text","url":"/docs/components/status#api","content":"| Part     | Props           | Description                                                                       |\n| -------- | --------------- | --------------------------------------------------------------------------------- |\n| `Status` | `label`, `tone` | A dot and a word, 12 points; a tone that matters tints both, neutral stays quiet. |","table":"table-0"},"1914":{"id":"/docs/components/switch","page_id":"/docs/components/switch","type":"page","content":"Switch","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/switch"},"1915":{"id":"/docs/components/switch#0","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch","content":"An on / off switch whose knob springs across a sunk track."},"1916":{"id":"/docs/components/switch#1","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#installation","content":"Installation"},"1917":{"id":"/docs/components/switch#2","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#usage","content":"Usage"},"1918":{"id":"/docs/components/switch#3","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#examples","content":"Examples"},"1919":{"id":"/docs/components/switch#4","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#size","content":"Size"},"1920":{"id":"/docs/components/switch#5","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#disabled","content":"Disabled"},"1921":{"id":"/docs/components/switch#6","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#in-a-row","content":"In a row"},"1922":{"id":"/docs/components/switch#7","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#a-settings-row","content":"A settings row"},"1923":{"id":"/docs/components/switch#8","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#alone","content":"Alone"},"1924":{"id":"/docs/components/switch#9","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#api","content":"API"},"1925":{"id":"/docs/components/switch#10","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#where-the-numbers-come-from","content":"Where the numbers come from"},"1926":{"id":"/docs/components/switch#11","page_id":"/docs/components/switch","type":"heading","tags":[],"url":"/docs/components/switch#sizes","content":"Sizes"},"1927":{"id":"/docs/components/switch#12","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1928":{"id":"/docs/components/switch#13","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#size","content":"`size` switches between the theme's standard (`default`) and compact (`sm`) switch geometry in `switch.*` and `switch.small.*` (with pointer vs touch scales applied automatically via the active input `tier`; WinUI 3 uses `44 × 22` / `sm 36 × 18` on touch)."},"1929":{"id":"/docs/components/switch#14","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#in-a-row","content":"A row with its label is the target: put the label in `children` and let `listRow` draw the row."},"1930":{"id":"/docs/components/switch#15","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#in-a-row","content":"A switch is the whole row here — its children are its label, so a tap anywhere on the row toggles it — and it is read as a switch that is on or off, because `Switch` sets its own role and its own value. Nothing else has to say either."},"1931":{"id":"/docs/components/switch#16","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#a-settings-row","content":"A `Field` in a row puts a title and its description at the start, `FieldContent` takes the room\nthe control leaves, and the switch sits after them."},"1932":{"id":"/docs/components/switch#17","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#a-settings-row","content":"The title is beside the switch, not in it, so the switch carries the row's name in `accessibilityLabel`; it is still read as that switch and its state. A list of them is a `FieldGroup`, and `FieldSeparator` draws the hairline between two rows."},"1933":{"id":"/docs/components/switch#18","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#a-settings-row","content":"A title beside a switch takes no presses, so the switch is the target — a touch screen gives it the room a finger needs (`hitSlop`) — and a row that should toggle on a tap anywhere is the `listRow` row above."},"1934":{"id":"/docs/components/switch#19","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#a-settings-row","content":"Nothing in the row names a side: `Field` lays its children out along the writing direction, so a right-to-left app puts the switch first and the text against the other edge, with the row unchanged."},"1935":{"id":"/docs/components/switch#20","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#alone","content":"With no children the track is all of it; a touch screen raises the target to 44 points, and the track\nis already at least that wide, so the hit slop only fills the height."},"1936":{"id":"/docs/components/switch#21","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#api","content":"Every prop of `nsh/base` Switch passes through. `trackClass`, `trackStyle` and `thumbStyle` go over the look's."},"1937":{"id":"/docs/components/switch#22","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#api","content":"| Part     | Props                                                                                                                    | Description                                                                                                                       |\n| -------- | ------------------------------------------------------------------------------------------------------------------------ | --------------------------------------------------------------------------------------------------------------------------------- |\n| `Switch` | `checked`, `onChange`, `size`, `disabled`, `children`, `accessibilityLabel`, `hitSlop`, and every `nsh/base` Switch prop | An on / off switch; alone it fills the touch target's height with a hit slop, with children it is a row whose label is the target |","table":"table-0"},"1938":{"id":"/docs/components/switch#23","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#where-the-numbers-come-from","content":"The track, border (`switch.edge.off`, `switch.edge.on`, `switch.edge.color`), knob dimensions (`switch.track`, `switch.knob.*`), and derived press feedback all read `control(\"switch\")` (`@shadcn-nsh/theme`) so switching themes updates geometry and motion on the next frame:"},"1939":{"id":"/docs/components/switch#24","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#where-the-numbers-come-from","content":"**Apple** draws an oval knob on a borderless pill track (`54 × 24` with `31 × 20` knob on pointer; `63 × 28` with `37 × 24` on touch; `sm`: `40 × 18` with `23 × 14` on pointer)."},"1940":{"id":"/docs/components/switch#25","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#where-the-numbers-come-from","content":"**shadcn** draws a borderless pill track (`32 × 18` on pointer, `sm`: `24 × 14`; `44 × 24` / `36 × 20` on touch) with `--input` off track."},"1941":{"id":"/docs/components/switch#26","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#where-the-numbers-come-from","content":"**Material 3** draws a `40 × 24` (`52 × 32` touch; `sm`: `32 × 20` / `40 × 24`) track with an `outline` border when off and an expanding circle knob (`16 → 20 / 24` on, `22 / 28` pressed; `sm`: `12pt` rest)."},"1942":{"id":"/docs/components/switch#27","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#where-the-numbers-come-from","content":"**WinUI 3** draws a `40 × 20` (`44 × 22` touch; `sm`: `32 × 16` / `36 × 18` touch) track with a strong off border (`ControlStrongStrokeColorDefault`) and a `12pt` (`14pt` touch; `sm`: `10pt` / `12pt`) circle knob that enlarges on hover and stretches while pressed."},"1943":{"id":"/docs/components/switch#28","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#where-the-numbers-come-from","content":"A standalone switch adds `focusRing()` shaped to the capsule track and handles disabled appearance directly (dimming via `dimmed.disabled` when `controls.disabled.face` is `keep`, or switching to `disabled.*` surface/ink/edge on Material 3 and WinUI 3)."},"1944":{"id":"/docs/components/switch#29","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#sizes","content":"| Size      | Track (`nsh-gallery` / `solid-glass`)      | Knob      |\n| --------- | ------------------------------------------ | --------- |\n| `default` | `icon.md` + 4 high, 2 × `icon.md` + 4 long | `icon.md` |","table":"table-1"},"1945":{"id":"/docs/components/switch#30","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#sizes","content":"| Size | Track (`nsh-gallery` / `solid-glass`)      | Knob      |\n| ---- | ------------------------------------------ | --------- |\n| `sm` | `icon.sm` + 4 high, 2 × `icon.sm` + 4 long | `icon.sm` |","table":"table-1"},"1946":{"id":"/docs/components/switch#31","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#sizes","content":"In `nsh-gallery` and `solid-glass`, that is 36 × 20 with a 16-point knob under a pointer and 44 × 24 with 20 on a touch screen (`sm`: 28 × 16 with 12, 36 × 20 with 16): 2 points of track above, below and at each end, so the knob travels its own width — as far from the end on as off."},"1947":{"id":"/docs/components/switch#32","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#sizes","content":"`SwitchSize` is `\"sm\" | \"default\"`."},"1948":{"id":"/docs/components/switch#33","page_id":"/docs/components/switch","tags":[],"type":"text","url":"/docs/components/switch#sizes","content":"Off and on, the knob wears `control(\"switch\").knobStyle(checked)` (`packages/ui/switch.tsx`, `knobLook`): the theme states its size, face, gradient and edge per state, and how it grows when pressed."},"1949":{"id":"/docs/components/table","page_id":"/docs/components/table","type":"page","content":"Table","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/table"},"1950":{"id":"/docs/components/table#0","page_id":"/docs/components/table","tags":[],"type":"text","url":"/docs/components/table","content":"Composition parts for a bordered table card using the shared data-table classes."},"1951":{"id":"/docs/components/table#1","page_id":"/docs/components/table","type":"heading","tags":[],"url":"/docs/components/table#installation","content":"Installation"},"1952":{"id":"/docs/components/table#2","page_id":"/docs/components/table","type":"heading","tags":[],"url":"/docs/components/table#usage","content":"Usage"},"1953":{"id":"/docs/components/table#3","page_id":"/docs/components/table","type":"heading","tags":[],"url":"/docs/components/table#composition","content":"Composition"},"1954":{"id":"/docs/components/table#4","page_id":"/docs/components/table","type":"heading","tags":[],"url":"/docs/components/table#examples","content":"Examples"},"1955":{"id":"/docs/components/table#5","page_id":"/docs/components/table","type":"heading","tags":[],"url":"/docs/components/table#selected-row","content":"Selected row"},"1956":{"id":"/docs/components/table#6","page_id":"/docs/components/table","type":"heading","tags":[],"url":"/docs/components/table#string-children","content":"String children"},"1957":{"id":"/docs/components/table#7","page_id":"/docs/components/table","type":"heading","tags":[],"url":"/docs/components/table#api","content":"API"},"1958":{"id":"/docs/components/table#8","page_id":"/docs/components/table","tags":[],"type":"text","url":"/docs/components/table#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1959":{"id":"/docs/components/table#9","page_id":"/docs/components/table","tags":[],"type":"text","url":"/docs/components/table#composition","content":"Use the following composition to build a `Table`:"},"1960":{"id":"/docs/components/table#10","page_id":"/docs/components/table","tags":[],"type":"text","url":"/docs/components/table#selected-row","content":"`TableRow` accepts `selected` for the `rowSelected` fill."},"1961":{"id":"/docs/components/table#11","page_id":"/docs/components/table","tags":[],"type":"text","url":"/docs/components/table#string-children","content":"`TableHead`, `TableCell`, and `TableCaption` render strings with muted or foreground text."},"1962":{"id":"/docs/components/table#12","page_id":"/docs/components/table","tags":[],"type":"text","url":"/docs/components/table#api","content":"| Part    | Props                       | Description                                                           |\n| ------- | --------------------------- | --------------------------------------------------------------------- |\n| `Table` | every `nsh/base` Table prop | The app's rows as a bordered card; screen readers hear the base roles |","table":"table-0"},"1963":{"id":"/docs/components/table#13","page_id":"/docs/components/table","tags":[],"type":"text","url":"/docs/components/table#api","content":"| Part          | Props      | Description     |\n| ------------- | ---------- | --------------- |\n| `TableHeader` | base props | The header band |","table":"table-0"},"1964":{"id":"/docs/components/table#14","page_id":"/docs/components/table","tags":[],"type":"text","url":"/docs/components/table#api","content":"| Part        | Props      | Description    |\n| ----------- | ---------- | -------------- |\n| `TableBody` | base props | The body group |","table":"table-0"},"1965":{"id":"/docs/components/table#15","page_id":"/docs/components/table","tags":[],"type":"text","url":"/docs/components/table#api","content":"| Part          | Props      | Description                       |\n| ------------- | ---------- | --------------------------------- |\n| `TableFooter` | base props | The footer band, a hairline above |","table":"table-0"},"1966":{"id":"/docs/components/table#16","page_id":"/docs/components/table","tags":[],"type":"text","url":"/docs/components/table#api","content":"| Part       | Props                  | Description                                                                    |\n| ---------- | ---------------------- | ------------------------------------------------------------------------------ |\n| `TableRow` | base props, `selected` | A row with a hairline above; `selected` fills it with the look's `rowSelected` |","table":"table-0"},"1967":{"id":"/docs/components/table#17","page_id":"/docs/components/table","tags":[],"type":"text","url":"/docs/components/table#api","content":"| Part        | Props                          | Description                                                        |\n| ----------- | ------------------------------ | ------------------------------------------------------------------ |\n| `TableHead` | `children` (string or element) | A column's header cell; a string is drawn in the quiet header text |","table":"table-0"},"1968":{"id":"/docs/components/table#18","page_id":"/docs/components/table","tags":[],"type":"text","url":"/docs/components/table#api","content":"| Part        | Props      | Description                                               |\n| ----------- | ---------- | --------------------------------------------------------- |\n| `TableCell` | `children` | A body or footer cell; a string is drawn in the body text |","table":"table-0"},"1969":{"id":"/docs/components/table#19","page_id":"/docs/components/table","tags":[],"type":"text","url":"/docs/components/table#api","content":"| Part           | Props      | Description                                         |\n| -------------- | ---------- | --------------------------------------------------- |\n| `TableCaption` | `children` | The caption under the rows; a string is drawn muted |","table":"table-0"},"1970":{"id":"/docs/components/table#20","page_id":"/docs/components/table","tags":[],"type":"text","url":"/docs/components/table#api","content":"`tableRowClass` is the row's color transition, for a row of your own."},"1971":{"id":"/docs/components/tabs","page_id":"/docs/components/tabs","type":"page","content":"Tabs","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/tabs"},"1972":{"id":"/docs/components/tabs#0","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs","content":"A pill track or underlined row with a traveling indicator."},"1973":{"id":"/docs/components/tabs#1","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#installation","content":"Installation"},"1974":{"id":"/docs/components/tabs#2","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#usage","content":"Usage"},"1975":{"id":"/docs/components/tabs#3","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#composition","content":"Composition"},"1976":{"id":"/docs/components/tabs#4","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#examples","content":"Examples"},"1977":{"id":"/docs/components/tabs#5","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#underline","content":"Underline"},"1978":{"id":"/docs/components/tabs#6","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#spanning-the-row","content":"Spanning the row"},"1979":{"id":"/docs/components/tabs#7","page_id":"/docs/components/tabs","type":"heading","tags":[],"url":"/docs/components/tabs#api","content":"API"},"1980":{"id":"/docs/components/tabs#8","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"1981":{"id":"/docs/components/tabs#9","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#usage","content":"The pill track is as wide as its tabs, the tabs as wide as their labels; an underline is as wide as\nits labels and its rule. A touch screen always spans the row, and `fill` spans it with a pointer."},"1982":{"id":"/docs/components/tabs#10","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#usage","content":"The chosen tab is a plate on the track — the theme's `plate`, a labelled block inside the well —\nand a tab's own box is that plate's box, so the pointer's hover shade covers exactly where the pill\nis."},"1983":{"id":"/docs/components/tabs#11","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#composition","content":"Use the following composition to build a `Tabs`:"},"1984":{"id":"/docs/components/tabs#12","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#api","content":"| Part   | Props                                                   | Description                                              |\n| ------ | ------------------------------------------------------- | -------------------------------------------------------- |\n| `Tabs` | `value`, `defaultValue`, `onValueChange`, `orientation` | Holds the selected value and lays its list and panel out |","table":"table-0"},"1985":{"id":"/docs/components/tabs#13","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#api","content":"| Part       | Props                                             | Description                                                                                                         |\n| ---------- | ------------------------------------------------- | ------------------------------------------------------------------------------------------------------------------- |\n| `TabsList` | `variant`, `fill`, and every `nsh/base` Tabs prop | The tablist: `default` the pill track of `tabsLook`, `line` the underlined strip; as wide as its tabs unless `fill` |","table":"table-0"},"1986":{"id":"/docs/components/tabs#14","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#api","content":"| Part          | Props                                  | Description                                                 |\n| ------------- | -------------------------------------- | ----------------------------------------------------------- |\n| `TabsTrigger` | `value`, and every `nsh/base` Tab prop | One tab; a string child is its label, drawn with `TabTitle` |","table":"table-0"},"1987":{"id":"/docs/components/tabs#15","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#api","content":"| Part          | Props   | Description                                                               |\n| ------------- | ------- | ------------------------------------------------------------------------- |\n| `TabsContent` | `value` | The panel for one value, hidden (not unmounted) while another is selected |","table":"table-0"},"1988":{"id":"/docs/components/tabs#16","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#api","content":"| Part       | Props                                                       | Description                                                                            |\n| ---------- | ----------------------------------------------------------- | -------------------------------------------------------------------------------------- |\n| `TabTitle` | `name`, `selected`, `count`, `icon`, `underline`, `onWidth` | The label to pair with a tab: the icon's two tints crossing over, a count in a capsule |","table":"table-0"},"1989":{"id":"/docs/components/tabs#17","page_id":"/docs/components/tabs","tags":[],"type":"text","url":"/docs/components/tabs#api","content":"Every prop of `nsh/base` Tabs / `Tab` passes through on the list and triggers."},"1990":{"id":"/docs/components/terminal","page_id":"/docs/components/terminal","type":"page","content":"Terminal","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/terminal"},"1991":{"id":"/docs/components/terminal#0","page_id":"/docs/components/terminal","tags":[],"type":"text","url":"/docs/components/terminal","content":"A program's output on the theme's field surface, the keys typed back to it."},"1992":{"id":"/docs/components/terminal#1","page_id":"/docs/components/terminal","type":"heading","tags":[],"url":"/docs/components/terminal#installation","content":"Installation"},"1993":{"id":"/docs/components/terminal#2","page_id":"/docs/components/terminal","type":"heading","tags":[],"url":"/docs/components/terminal#usage","content":"Usage"},"1994":{"id":"/docs/components/terminal#3","page_id":"/docs/components/terminal","type":"heading","tags":[],"url":"/docs/components/terminal#examples","content":"Examples"},"1995":{"id":"/docs/components/terminal#4","page_id":"/docs/components/terminal","type":"heading","tags":[],"url":"/docs/components/terminal#a-terminal-in-the-page","content":"A terminal in the page"},"1996":{"id":"/docs/components/terminal#5","page_id":"/docs/components/terminal","type":"heading","tags":[],"url":"/docs/components/terminal#an-app-whose-window-is-the-terminal","content":"An app whose window is the terminal"},"1997":{"id":"/docs/components/terminal#6","page_id":"/docs/components/terminal","type":"heading","tags":[],"url":"/docs/components/terminal#a-real-program","content":"A real program"},"1998":{"id":"/docs/components/terminal#7","page_id":"/docs/components/terminal","type":"heading","tags":[],"url":"/docs/components/terminal#api","content":"API"},"1999":{"id":"/docs/components/terminal#8","page_id":"/docs/components/terminal","tags":[],"type":"text","url":"/docs/components/terminal#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"2000":{"id":"/docs/components/terminal#9","page_id":"/docs/components/terminal","tags":[],"type":"text","url":"/docs/components/terminal#usage","content":"The terminal starts nothing: `term.write(bytes)` shows what the program printed, `onData` carries what the user typed or pasted (keys the program expects, the emulator's answers included), and `onResize` reports the size in cells. `term.reset()` clears the screen and the scrollback, `term.text()` gives every line, `term.focus()` takes the keyboard."},"2001":{"id":"/docs/components/terminal#10","page_id":"/docs/components/terminal","tags":[],"type":"text","url":"/docs/components/terminal#a-terminal-in-the-page","content":"The default: a well of the field's fill and edge, the theme's inner corners and a padding, so a\nterminal sits beside the other controls."},"2002":{"id":"/docs/components/terminal#11","page_id":"/docs/components/terminal","tags":[],"type":"text","url":"/docs/components/terminal#an-app-whose-window-is-the-terminal","content":"`variant=\"ghost\"` draws no fill, no edge, no padding and no corners: the app's own surface is the\nframe, and the terminal covers it."},"2003":{"id":"/docs/components/terminal#12","page_id":"/docs/components/terminal","tags":[],"type":"text","url":"/docs/components/terminal#a-real-program","content":"A terminal is a stream of bytes in and out; the app owns both ends."},"2004":{"id":"/docs/components/terminal#13","page_id":"/docs/components/terminal","tags":[],"type":"text","url":"/docs/components/terminal#a-real-program","content":"**On the desktop**, a pseudo-terminal: the app spawns the shell in a pty (`portable-pty` in Rust,\na native pty module in TypeScript), reads the master side into `term.write(chunk)` and sends\n`onData`'s payload back to it. The size `onResize` reports is the pty's window size."},"2005":{"id":"/docs/components/terminal#14","page_id":"/docs/components/terminal","tags":[],"type":"text","url":"/docs/components/terminal#a-real-program","content":"**On the web**, a WebSocket to a shell service: `socket.onmessage` writes the socket's bytes,\n`onData` and `onResize` send them the other way."},"2006":{"id":"/docs/components/terminal#15","page_id":"/docs/components/terminal","tags":[],"type":"text","url":"/docs/components/terminal#a-real-program","content":"**A remote session** (`ssh`, a container's exec stream) fills the same two directions."},"2007":{"id":"/docs/components/terminal#16","page_id":"/docs/components/terminal","tags":[],"type":"text","url":"/docs/components/terminal#a-real-program","content":"Nothing of that is the terminal's: it interprets the escape sequences it is given and draws them\nwith the platform's text engine. NSH's Terminal documents the\nescape sequences it understands and how a Rust app replaces the emulator (`TerminalEmulatorFactory`)."},"2008":{"id":"/docs/components/terminal#17","page_id":"/docs/components/terminal","tags":[],"type":"text","url":"/docs/components/terminal#api","content":"Every prop of `nsh/base` Terminal passes through, and so does\nits ref (`TerminalRef`): `write`, `reset`, `text`, `focus`. `class`, `style`, `cursorClass` and\n`cursorStyle` go over the look's, so an app gives the cursor its shape (`w-0.5`) and moves the\npadding where it needs another."},"2009":{"id":"/docs/components/terminal#18","page_id":"/docs/components/terminal","tags":[],"type":"text","url":"/docs/components/terminal#api","content":"The 16 ANSI colors are NSH's own palette; text a program leaves uncolored is the theme's\n`foreground`, and cells it leaves without a background show the terminal's own surface."},"2010":{"id":"/docs/components/terminal#19","page_id":"/docs/components/terminal","tags":[],"type":"text","url":"/docs/components/terminal#api","content":"| Part       | Props                                                                                                      | Description                                                                                |\n| ---------- | ---------------------------------------------------------------------------------------------------------- | ------------------------------------------------------------------------------------------ |\n| `Terminal` | `variant`, and every `nsh/base` Terminal prop (`onData`, `onResize`, `style`, …); the ref is `TerminalRef` | A program's output on the theme's field surface; `variant=\"ghost\"` draws no surface at all |","table":"table-0"},"2011":{"id":"/docs/components/text-view","page_id":"/docs/components/text-view","type":"page","content":"TextView","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/text-view"},"2012":{"id":"/docs/components/text-view#0","page_id":"/docs/components/text-view","tags":[],"type":"text","url":"/docs/components/text-view","content":"Brand-colored links and a pulsing streaming caret."},"2013":{"id":"/docs/components/text-view#1","page_id":"/docs/components/text-view","type":"heading","tags":[],"url":"/docs/components/text-view#installation","content":"Installation"},"2014":{"id":"/docs/components/text-view#2","page_id":"/docs/components/text-view","type":"heading","tags":[],"url":"/docs/components/text-view#usage","content":"Usage"},"2015":{"id":"/docs/components/text-view#3","page_id":"/docs/components/text-view","type":"heading","tags":[],"url":"/docs/components/text-view#examples","content":"Examples"},"2016":{"id":"/docs/components/text-view#4","page_id":"/docs/components/text-view","type":"heading","tags":[],"url":"/docs/components/text-view#markdown","content":"Markdown"},"2017":{"id":"/docs/components/text-view#5","page_id":"/docs/components/text-view","type":"heading","tags":[],"url":"/docs/components/text-view#streaming","content":"Streaming"},"2018":{"id":"/docs/components/text-view#6","page_id":"/docs/components/text-view","type":"heading","tags":[],"url":"/docs/components/text-view#copy-on-code-blocks","content":"Copy on code blocks"},"2019":{"id":"/docs/components/text-view#7","page_id":"/docs/components/text-view","type":"heading","tags":[],"url":"/docs/components/text-view#a-block-of-your-own","content":"A block of your own"},"2020":{"id":"/docs/components/text-view#8","page_id":"/docs/components/text-view","type":"heading","tags":[],"url":"/docs/components/text-view#inline-chips","content":"Inline chips"},"2021":{"id":"/docs/components/text-view#9","page_id":"/docs/components/text-view","type":"heading","tags":[],"url":"/docs/components/text-view#images-that-open","content":"Images that open"},"2022":{"id":"/docs/components/text-view#10","page_id":"/docs/components/text-view","type":"heading","tags":[],"url":"/docs/components/text-view#api","content":"API"},"2023":{"id":"/docs/components/text-view#11","page_id":"/docs/components/text-view","tags":[],"type":"text","url":"/docs/components/text-view#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"2024":{"id":"/docs/components/text-view#12","page_id":"/docs/components/text-view","tags":[],"type":"text","url":"/docs/components/text-view#usage","content":"`TextView` merges `textViewClasses` into `classes` by default."},"2025":{"id":"/docs/components/text-view#13","page_id":"/docs/components/text-view","tags":[],"type":"text","url":"/docs/components/text-view#streaming","content":"`streamingCaret` marks the end of text still arriving; `textViewCaretClass` is the caret's look."},"2026":{"id":"/docs/components/text-view#14","page_id":"/docs/components/text-view","tags":[],"type":"text","url":"/docs/components/text-view#copy-on-code-blocks","content":"`codeBlockActions` puts buttons over each code block's top-right corner: ghost buttons that show\nwhile a pointer hovers the block on a desktop and always on a touch screen. The `copy` action is\nbuilt in — it copies the block's code and shows a check for a moment — so a reply with a command\nneeds nothing more. Other ids are the app's: they are drawn with `renderCodeBlockAction`'s icon and\ntheir press arrives at `onCodeBlockAction`."},"2027":{"id":"/docs/components/text-view#15","page_id":"/docs/components/text-view","tags":[],"type":"text","url":"/docs/components/text-view#copy-on-code-blocks","content":"The built-in copy's accessibility label is the action's `label`; give an app action its own\n`renderCodeBlockAction` and handle `id` in `onCodeBlockAction`."},"2028":{"id":"/docs/components/text-view#16","page_id":"/docs/components/text-view","tags":[],"type":"text","url":"/docs/components/text-view#a-block-of-your-own","content":"An extension claims a Markdown shape for the app. A `language` claims a fence; `renderCustom`\nreceives the node, with `node.text` the fence's source, and returns the view to draw in its place.\nHere a `chart` fence lists `label value` lines and becomes bars in the theme's brand color."},"2029":{"id":"/docs/components/text-view#17","page_id":"/docs/components/text-view","tags":[],"type":"text","url":"/docs/components/text-view#a-block-of-your-own","content":"A `pattern` claims inline text instead (the next example), and `tag` and `container` claim a tag\nor a wrapping block. `renderCustom` is called for every custom node in the document, so branch on\n`node.name` when the app claims more than one shape."},"2030":{"id":"/docs/components/text-view#18","page_id":"/docs/components/text-view","tags":[],"type":"text","url":"/docs/components/text-view#inline-chips","content":"An inline extension replaces each match of its `pattern` with the node the app draws. Keep the\nchip's `verticalAlign` at `middle` and its height under the line height, so the paragraph's lines\nkeep their spacing; `styles.root.lineHeight` gives the chip the room it needs."},"2031":{"id":"/docs/components/text-view#19","page_id":"/docs/components/text-view","tags":[],"type":"text","url":"/docs/components/text-view#images-that-open","content":"`onImagePress` reports the image that was pressed as `{ src, alt }`: the shape `ImageViewer` takes. Hold it in a signal, and the viewer is open while it is set."},"2032":{"id":"/docs/components/text-view#20","page_id":"/docs/components/text-view","tags":[],"type":"text","url":"/docs/components/text-view#api","content":"`TextView.parse`, `parseHtml`, and `plainText` are re-exported from base. Every prop of `nsh/base` TextView passes through."},"2033":{"id":"/docs/components/text-view#21","page_id":"/docs/components/text-view","tags":[],"type":"text","url":"/docs/components/text-view#api","content":"| Part       | Props                                     | Description                                                                 |\n| ---------- | ----------------------------------------- | --------------------------------------------------------------------------- |\n| `TextView` | every `nsh/base` TextView prop; `classes` | A Markdown, HTML or block document; `classes` merges over `textViewClasses` |","table":"table-0"},"2034":{"id":"/docs/components/text-view#22","page_id":"/docs/components/text-view","tags":[],"type":"text","url":"/docs/components/text-view#api","content":"| Part                                       | Props          | Description                         |\n| ------------------------------------------ | -------------- | ----------------------------------- |\n| `TextView.parse`, `parseHtml`, `plainText` | base's parsers | A document, parsed ahead of drawing |","table":"table-0"},"2035":{"id":"/docs/components/text-view#23","page_id":"/docs/components/text-view","tags":[],"type":"text","url":"/docs/components/text-view#api","content":"| Part              | Props                 | Description                                                                       |\n| ----------------- | --------------------- | --------------------------------------------------------------------------------- |\n| `textViewClasses` | `{ link, tableGrid }` | Default classes merged into `classes`: brand underlined links and bordered tables |","table":"table-0"},"2036":{"id":"/docs/components/text-view#24","page_id":"/docs/components/text-view","tags":[],"type":"text","url":"/docs/components/text-view#api","content":"| Part                 | Props | Description                                             |\n| -------------------- | ----- | ------------------------------------------------------- |\n| `textViewCaretClass` | —     | The streaming caret: a brand block a line high, pulsing |","table":"table-0"},"2037":{"id":"/docs/components/time-field","page_id":"/docs/components/time-field","type":"page","content":"Time Field","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/time-field"},"2038":{"id":"/docs/components/time-field#0","page_id":"/docs/components/time-field","tags":[],"type":"text","url":"/docs/components/time-field","content":"A sunk well for a time of day, one segment at a time."},"2039":{"id":"/docs/components/time-field#1","page_id":"/docs/components/time-field","type":"heading","tags":[],"url":"/docs/components/time-field#installation","content":"Installation"},"2040":{"id":"/docs/components/time-field#2","page_id":"/docs/components/time-field","type":"heading","tags":[],"url":"/docs/components/time-field#usage","content":"Usage"},"2041":{"id":"/docs/components/time-field#3","page_id":"/docs/components/time-field","type":"heading","tags":[],"url":"/docs/components/time-field#examples","content":"Examples"},"2042":{"id":"/docs/components/time-field#4","page_id":"/docs/components/time-field","type":"heading","tags":[],"url":"/docs/components/time-field#the-look-alone","content":"The look alone"},"2043":{"id":"/docs/components/time-field#5","page_id":"/docs/components/time-field","type":"heading","tags":[],"url":"/docs/components/time-field#api","content":"API"},"2044":{"id":"/docs/components/time-field#6","page_id":"/docs/components/time-field","tags":[],"type":"text","url":"/docs/components/time-field#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"2045":{"id":"/docs/components/time-field#7","page_id":"/docs/components/time-field","tags":[],"type":"text","url":"/docs/components/time-field#api","content":"Every prop of `nsh/base` TimeField passes through; `class`, `segmentClass`, `separatorStyle` and `renderSegment` go over the look's."},"2046":{"id":"/docs/components/time-field#8","page_id":"/docs/components/time-field","tags":[],"type":"text","url":"/docs/components/time-field#api","content":"| Part        | Props                                                    | Description                                                                           |\n| ----------- | -------------------------------------------------------- | ------------------------------------------------------------------------------------- |\n| `TimeField` | `value`, `onChange`, and every `nsh/base` TimeField prop | A time of day, one segment at a time, in the input's well and the calendar's segments |","table":"table-0"},"2047":{"id":"/docs/components/time-field#9","page_id":"/docs/components/time-field","tags":[],"type":"text","url":"/docs/components/time-field#api","content":"| Part             | Props | Description                                                                                          |\n| ---------------- | ----- | ---------------------------------------------------------------------------------------------------- |\n| `timeFieldClass` | —     | The well in `lib/field-look`, shared with `Input` so a field on a page and one in a popup read alike |","table":"table-0"},"2048":{"id":"/docs/components/time-field#10","page_id":"/docs/components/time-field","tags":[],"type":"text","url":"/docs/components/time-field#api","content":"Segment chrome lands with the listbox / date-picker family."},"2049":{"id":"/docs/components/title-bar","page_id":"/docs/components/title-bar","type":"page","content":"TitleBar","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/title-bar"},"2050":{"id":"/docs/components/title-bar#0","page_id":"/docs/components/title-bar","tags":[],"type":"text","url":"/docs/components/title-bar","content":"The bar that drags a desktop window, the window buttons a frameless one draws for itself, and the edges that resize it."},"2051":{"id":"/docs/components/title-bar#1","page_id":"/docs/components/title-bar","type":"heading","tags":[],"url":"/docs/components/title-bar#installation","content":"Installation"},"2052":{"id":"/docs/components/title-bar#2","page_id":"/docs/components/title-bar","type":"heading","tags":[],"url":"/docs/components/title-bar#usage","content":"Usage"},"2053":{"id":"/docs/components/title-bar#3","page_id":"/docs/components/title-bar","type":"heading","tags":[],"url":"/docs/components/title-bar#composition","content":"Composition"},"2054":{"id":"/docs/components/title-bar#4","page_id":"/docs/components/title-bar","type":"heading","tags":[],"url":"/docs/components/title-bar#examples","content":"Examples"},"2055":{"id":"/docs/components/title-bar#5","page_id":"/docs/components/title-bar","type":"heading","tags":[],"url":"/docs/components/title-bar#traffic-lights","content":"Traffic lights"},"2056":{"id":"/docs/components/title-bar#6","page_id":"/docs/components/title-bar","type":"heading","tags":[],"url":"/docs/components/title-bar#caption-buttons","content":"Caption buttons"},"2057":{"id":"/docs/components/title-bar#7","page_id":"/docs/components/title-bar","type":"heading","tags":[],"url":"/docs/components/title-bar#your-own-window-controls","content":"Your own window controls"},"2058":{"id":"/docs/components/title-bar#8","page_id":"/docs/components/title-bar","type":"heading","tags":[],"url":"/docs/components/title-bar#api","content":"API"},"2059":{"id":"/docs/components/title-bar#9","page_id":"/docs/components/title-bar","tags":[],"type":"text","url":"/docs/components/title-bar#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"2060":{"id":"/docs/components/title-bar#10","page_id":"/docs/components/title-bar","tags":[],"type":"text","url":"/docs/components/title-bar#usage","content":"A desktop window with `titleBar: { style: \"hidden\" }` keeps the system's window buttons and leaves\nthe rest of the bar to the app: `TitleBar` builds on `nsh/base`'s `TitleBar` to draw the bar, drag\nthe window, double click to zoom or maximize, and keep its children clear of the system buttons\nautomatically across split panes and full-screen transitions."},"2061":{"id":"/docs/components/title-bar#11","page_id":"/docs/components/title-bar","tags":[],"type":"text","url":"/docs/components/title-bar#usage","content":"`TitleBar` draws nothing where the app has no window of its own — a browser page, a phone — and\n`WindowControls` are inert there: the bar is a window's, and there is none."},"2062":{"id":"/docs/components/title-bar#12","page_id":"/docs/components/title-bar","tags":[],"type":"text","url":"/docs/components/title-bar#composition","content":"Use the following composition to build a `TitleBar`:"},"2063":{"id":"/docs/components/title-bar#13","page_id":"/docs/components/title-bar","tags":[],"type":"text","url":"/docs/components/title-bar#traffic-lights","content":"A window with `frame: \"none\"` has no title bar and no border: the app draws the bar, the lights\nand the edges itself. `WindowControls` puts the platform's three buttons at the leading end, the\napp's own content after them."},"2064":{"id":"/docs/components/title-bar#14","page_id":"/docs/components/title-bar","tags":[],"type":"text","url":"/docs/components/title-bar#traffic-lights","content":"The glyphs are drawn while the pointer is over the lights, as the system draws them, and the\nlights turn grey while the window is in the background."},"2065":{"id":"/docs/components/title-bar#15","page_id":"/docs/components/title-bar","tags":[],"type":"text","url":"/docs/components/title-bar#caption-buttons","content":"Windows' and Linux's buttons are cells at the trailing end of the bar, filling its height.\nThey sit flush against the window's corner, so the inner content row's trailing padding goes to\nzero while keeping `TitleBar`'s own automatic window-control inset intact:"},"2066":{"id":"/docs/components/title-bar#16","page_id":"/docs/components/title-bar","tags":[],"type":"text","url":"/docs/components/title-bar#your-own-window-controls","content":"The three parts are the shapes the platforms draw; an app that wants its own draws the same\n`desktop` views itself, and the platform still carries out the press. A round close button\n(`Icon` from `lib/ui/icons`, `X` from `lucide`; the traffic lights keep macOS's own hues\nwhatever the theme, so the disc's colour is written out rather than read from a role, and the\nglyph on a light is black at half):"},"2067":{"id":"/docs/components/title-bar#17","page_id":"/docs/components/title-bar","tags":[],"type":"text","url":"/docs/components/title-bar#your-own-window-controls","content":"A bar of the app's own takes `desktop={{ windowDrag: true }}` to drag the window, and pads by\n`titleBar().left` and `titleBar().right` so its content clears the system's buttons."},"2068":{"id":"/docs/components/title-bar#18","page_id":"/docs/components/title-bar","tags":[],"type":"text","url":"/docs/components/title-bar#api","content":"| Part       | Props                                                                                         | Description                   |\n| ---------- | --------------------------------------------------------------------------------------------- | ----------------------------- |\n| `TitleBar` | every `nsh/base` TitleBar prop; `style` over the outer bar; `contentStyle` over the inner row | The bar that drags the window |","table":"table-0"},"2069":{"id":"/docs/components/title-bar#19","page_id":"/docs/components/title-bar","tags":[],"type":"text","url":"/docs/components/title-bar#api","content":"| Part             | Props                                                       | Description              |\n| ---------------- | ----------------------------------------------------------- | ------------------------ |\n| `WindowControls` | `variant`; every `nsh` View prop; `style` over the controls | The window's own buttons |","table":"table-0"},"2070":{"id":"/docs/components/title-bar#20","page_id":"/docs/components/title-bar","tags":[],"type":"text","url":"/docs/components/title-bar#api","content":"| Part                | Props | Description                                 |\n| ------------------- | ----- | ------------------------------------------- |\n| `WindowResizeEdges` |       | The edges and corners of a frameless window |","table":"table-0"},"2071":{"id":"/docs/components/title-bar#21","page_id":"/docs/components/title-bar","tags":[],"type":"text","url":"/docs/components/title-bar#api","content":"`TitleBar` wraps `nsh/base` TitleBar; pass inner padding on `contentStyle` rather than `style` so the automatic window-control padding is preserved. Every prop of `nsh` View passes through on `WindowControls` and `WindowResizeEdges`, and `style` goes over the look's on `WindowControls`."},"2072":{"id":"/docs/components/title-bar#22","page_id":"/docs/components/title-bar","tags":[],"type":"text","url":"/docs/components/title-bar#api","content":"| Prop           | Type                   | Default     |\n| -------------- | ---------------------- | ----------- |\n| `contentStyle` | `StyleProp<ViewStyle>` | `undefined` |","table":"table-1"},"2073":{"id":"/docs/components/title-bar#23","page_id":"/docs/components/title-bar","tags":[],"type":"text","url":"/docs/components/title-bar#api","content":"| Prop      | Type                            | Default          |\n| --------- | ------------------------------- | ---------------- |\n| `variant` | `\"traffic-lights\" \\| \"caption\"` | `traffic-lights` |","table":"table-1"},"2074":{"id":"/docs/components/title-bar#24","page_id":"/docs/components/title-bar","tags":[],"type":"text","url":"/docs/components/title-bar#api","content":"`TitleBar` is at least `TITLE_BAR_HEIGHT` (40 points) tall, or the height the system's title bar has, on\nthe inset fill with a hairline under it; its children start `12` points after the system's buttons.\nA traffic light is `TRAFFIC_LIGHT` (12 points) wide, in macOS's own close, minimize and zoom hues wherever the theme goes, with glyphs in black at half and a hairline of black at an eighth around the disc, and `CAPTION_BUTTON` (46) is a caption cell's width; the close cell\nwashes the destructive tint while the pointer is on it. `WindowResizeEdges` draws eight strips —\n`5` points along the edges, `12` at the corners — as the last child of the window's root.\nA bar the app lays out itself takes `desktop={{ windowDrag: true }}` and pads by `titleBar().left` and `titleBar().right`."},"2075":{"id":"/docs/components/toast","page_id":"/docs/components/toast","type":"page","content":"Toast","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/toast"},"2076":{"id":"/docs/components/toast#0","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast","content":"A raised banner with a title, optional description, action and close."},"2077":{"id":"/docs/components/toast#1","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#installation","content":"Installation"},"2078":{"id":"/docs/components/toast#2","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#usage","content":"Usage"},"2079":{"id":"/docs/components/toast#3","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#examples","content":"Examples"},"2080":{"id":"/docs/components/toast#4","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#action","content":"Action"},"2081":{"id":"/docs/components/toast#5","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#from-code","content":"From code"},"2082":{"id":"/docs/components/toast#6","page_id":"/docs/components/toast","type":"heading","tags":[],"url":"/docs/components/toast#api","content":"API"},"2083":{"id":"/docs/components/toast#7","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"2084":{"id":"/docs/components/toast#8","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#from-code","content":"`toast` follows sonner. It returns an id. The same id replaces the toast that held it. `update` changes one where it is, which is how a loading note becomes its result — sonner does that by calling `toast` again with the same id, and this queue also has `toast.update` so the entrance does not restart. `progress` (0 to 1) is the bar under the text; sonner has none."},"2085":{"id":"/docs/components/toast#9","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#from-code","content":"An action's `onClick` runs when it is pressed, and `onDismiss` hears that action's label — or `null` when the toast leaves any other way."},"2086":{"id":"/docs/components/toast#10","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#api","content":"Every prop of `nsh/base` Toast passes through. `style` goes over the banner's own look."},"2087":{"id":"/docs/components/toast#11","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#api","content":"| Part    | Props                                                               | Description                                                          |\n| ------- | ------------------------------------------------------------------- | -------------------------------------------------------------------- |\n| `Toast` | `title`, `description`, `children`, and every `nsh/base` Toast prop | A raised banner; without children it draws `title` and `description` |","table":"table-0"},"2088":{"id":"/docs/components/toast#12","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#api","content":"| Part    | Props                          | Description                                                            |\n| ------- | ------------------------------ | ---------------------------------------------------------------------- |\n| `toast` | `(title, options?)` → `string` | Shows one. `success`, `error`, `warning`, `info`, `loading` set `type` |","table":"table-0"},"2089":{"id":"/docs/components/toast#13","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#api","content":"| Part      | Props                                                                                     | Description                                                                            |\n| --------- | ----------------------------------------------------------------------------------------- | -------------------------------------------------------------------------------------- |\n| `options` | `id`, `description`, `duration`, `type`, `action`, `closeButton`, `progress`, `onDismiss` | `duration` defaults to 4000; `Infinity` stays. `closeButton: true` is labelled \"Close\" |","table":"table-0"},"2090":{"id":"/docs/components/toast#14","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#api","content":"| Part           | Props                    | Description                                                                   |\n| -------------- | ------------------------ | ----------------------------------------------------------------------------- |\n| `toast.update` | `(id, change) → boolean` | Changes a toast in place. `null` clears `description`, `action` or `progress` |","table":"table-0"},"2091":{"id":"/docs/components/toast#15","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#api","content":"| Part            | Props   | Description                                           |\n| --------------- | ------- | ----------------------------------------------------- |\n| `toast.dismiss` | `(id?)` | Closes one toast, or every toast when `id` is omitted |","table":"table-0"},"2092":{"id":"/docs/components/toast#16","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#api","content":"| Part      | Props | Description                                        |\n| --------- | ----- | -------------------------------------------------- |\n| `Toaster` |       | The stack at the foot of the window. Mount it once |","table":"table-0"},"2093":{"id":"/docs/components/toast#17","page_id":"/docs/components/toast","tags":[],"type":"text","url":"/docs/components/toast#api","content":"Without `children`, `Toast` draws `title` and `description`. An action and a close button are `toast`'s `action` and `closeButton`."},"2094":{"id":"/docs/components/toggle","page_id":"/docs/components/toggle","type":"page","content":"Toggle","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/toggle"},"2095":{"id":"/docs/components/toggle#0","page_id":"/docs/components/toggle","tags":[],"type":"text","url":"/docs/components/toggle","content":"A two-state button, in two variants and three sizes, and a group of them."},"2096":{"id":"/docs/components/toggle#1","page_id":"/docs/components/toggle","type":"heading","tags":[],"url":"/docs/components/toggle#installation","content":"Installation"},"2097":{"id":"/docs/components/toggle#2","page_id":"/docs/components/toggle","type":"heading","tags":[],"url":"/docs/components/toggle#usage","content":"Usage"},"2098":{"id":"/docs/components/toggle#3","page_id":"/docs/components/toggle","type":"heading","tags":[],"url":"/docs/components/toggle#composition","content":"Composition"},"2099":{"id":"/docs/components/toggle#4","page_id":"/docs/components/toggle","type":"heading","tags":[],"url":"/docs/components/toggle#examples","content":"Examples"},"2100":{"id":"/docs/components/toggle#5","page_id":"/docs/components/toggle","type":"heading","tags":[],"url":"/docs/components/toggle#variant","content":"Variant"},"2101":{"id":"/docs/components/toggle#6","page_id":"/docs/components/toggle","type":"heading","tags":[],"url":"/docs/components/toggle#size","content":"Size"},"2102":{"id":"/docs/components/toggle#7","page_id":"/docs/components/toggle","type":"heading","tags":[],"url":"/docs/components/toggle#disabled","content":"Disabled"},"2103":{"id":"/docs/components/toggle#8","page_id":"/docs/components/toggle","type":"heading","tags":[],"url":"/docs/components/toggle#group","content":"Group"},"2104":{"id":"/docs/components/toggle#9","page_id":"/docs/components/toggle","type":"heading","tags":[],"url":"/docs/components/toggle#vertical","content":"Vertical"},"2105":{"id":"/docs/components/toggle#10","page_id":"/docs/components/toggle","type":"heading","tags":[],"url":"/docs/components/toggle#inside-a-toolbar","content":"Inside a Toolbar"},"2106":{"id":"/docs/components/toggle#11","page_id":"/docs/components/toggle","type":"heading","tags":[],"url":"/docs/components/toggle#chips","content":"Chips"},"2107":{"id":"/docs/components/toggle#12","page_id":"/docs/components/toggle","type":"heading","tags":[],"url":"/docs/components/toggle#pressed","content":"Pressed"},"2108":{"id":"/docs/components/toggle#13","page_id":"/docs/components/toggle","type":"heading","tags":[],"url":"/docs/components/toggle#names-for-screen-readers","content":"Names for screen readers"},"2109":{"id":"/docs/components/toggle#14","page_id":"/docs/components/toggle","type":"heading","tags":[],"url":"/docs/components/toggle#the-look-alone","content":"The look alone"},"2110":{"id":"/docs/components/toggle#15","page_id":"/docs/components/toggle","type":"heading","tags":[],"url":"/docs/components/toggle#api","content":"API"},"2111":{"id":"/docs/components/toggle#16","page_id":"/docs/components/toggle","tags":[],"type":"text","url":"/docs/components/toggle#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"2112":{"id":"/docs/components/toggle#17","page_id":"/docs/components/toggle","tags":[],"type":"text","url":"/docs/components/toggle#composition","content":"Use the following composition to build a `Toggle`:"},"2113":{"id":"/docs/components/toggle#18","page_id":"/docs/components/toggle","tags":[],"type":"text","url":"/docs/components/toggle#size","content":"A size is a step of the theme's own scales: its `side` the three heights (`dimension.size.height`),\nits `icon` the three icons (`dimension.icon`), its label the `detail`, `body` and `label` type roles.\nThe NSH Gallery theme's heights are 24 / 28 / 32 points with a pointer and 32 / 40 / 48 on a touch\nscreen, where a hit slop makes the target 44 points."},"2114":{"id":"/docs/components/toggle#19","page_id":"/docs/components/toggle","tags":[],"type":"text","url":"/docs/components/toggle#disabled","content":"`disabled` on a `Toggle` locks that one. `disabled` on a `ToggleGroup` locks every toggle in it —\nthe base bar hands its lock down, so no child needs its own `disabled`. A disabled toggle takes no\npress, leaves the arrow keys' walk and reads as disabled to screen readers; it dims to 50%\n(`disabledStyle`)."},"2115":{"id":"/docs/components/toggle#20","page_id":"/docs/components/toggle","tags":[],"type":"text","url":"/docs/components/toggle#group","content":"A group is one toolbar for screen readers: one stop of the keyboard focus, arrow keys between its toggles. The default wears the inset track."},"2116":{"id":"/docs/components/toggle#21","page_id":"/docs/components/toggle","tags":[],"type":"text","url":"/docs/components/toggle#inside-a-toolbar","content":"`inset={false}` skips the track when a parent `Toolbar` already wears it."},"2117":{"id":"/docs/components/toggle#22","page_id":"/docs/components/toggle","tags":[],"type":"text","url":"/docs/components/toggle#chips","content":"A row of single-select capsules is a recipe, not a part. shadcn/ui has no capsule axis on `ToggleGroup`; where it wants one it puts `rounded-full` on the items. Here the same call-site `style` does it: `inset={false}` drops the track, `gap` spaces the chips, and `borderRadius: 999` makes the capsule. A capsule is geometry, not a theme role (`shape.control` is the corner of a badge), so the radius is the full one. The base group holds no value: the app presses the chip asked for and keeps the chosen one pressed. For a row that scrolls, put the group in a horizontal `Scroll`."},"2118":{"id":"/docs/components/toggle#23","page_id":"/docs/components/toggle","tags":[],"type":"text","url":"/docs/components/toggle#names-for-screen-readers","content":"A string child is the toggle's name for screen readers, and `accessibilityLabel` wins when it should differ from the visible label. Children drawn as given (an icon and a label of your own) are named by the texts inside them."},"2119":{"id":"/docs/components/toggle#24","page_id":"/docs/components/toggle","tags":[],"type":"text","url":"/docs/components/toggle#the-look-alone","content":"The look is a function, for a pressable of your own."},"2120":{"id":"/docs/components/toggle#25","page_id":"/docs/components/toggle","tags":[],"type":"text","url":"/docs/components/toggle#api","content":"Every prop of `nsh/base` Toggle and ToggleGroup passes through. `style`, `hoverStyle`, `activeStyle`, `focusVisibleStyle`, `pressedStyle` and `disabledStyle` go over the look's."},"2121":{"id":"/docs/components/toggle#26","page_id":"/docs/components/toggle","tags":[],"type":"text","url":"/docs/components/toggle#api","content":"| Part     | Props                                                                                               | Description                                                       |\n| -------- | --------------------------------------------------------------------------------------------------- | ----------------------------------------------------------------- |\n| `Toggle` | `variant`, `size`, `children`, and every `nsh/base` Toggle prop (`pressed`, `onChange`, `disabled`) | A two-state button; a string child is its name for screen readers |","table":"table-0"},"2122":{"id":"/docs/components/toggle#27","page_id":"/docs/components/toggle","tags":[],"type":"text","url":"/docs/components/toggle#api","content":"| Part          | Props                                                      | Description                                                              |\n| ------------- | ---------------------------------------------------------- | ------------------------------------------------------------------------ |\n| `ToggleGroup` | `vertical`, `inset`, and every `nsh/base` ToggleGroup prop | The inset track of `toolbarTrack` holding a row (or column) of `Toggle`s |","table":"table-0"},"2123":{"id":"/docs/components/toggle#28","page_id":"/docs/components/toggle","tags":[],"type":"text","url":"/docs/components/toggle#api","content":"`toggleLook`, `toggleLabel` and `toggleGlyph` are the look's parts, for a pressable of your own.\n`toggleSizes` is the table a size reads — `side`, `icon` and `text` from the theme's height, icon and\ntype scales, its `pad` the toggle's own (compact with a pointer, roomier on a touch screen) — so a\nbar's own geometry can match a tool's (`toggleSizes.default.side`)."},"2124":{"id":"/docs/components/toolbar","page_id":"/docs/components/toolbar","type":"page","content":"Toolbar","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/toolbar"},"2125":{"id":"/docs/components/toolbar#0","page_id":"/docs/components/toolbar","tags":[],"type":"text","url":"/docs/components/toolbar","content":"An inset track of tools, with groups and hairline separators."},"2126":{"id":"/docs/components/toolbar#1","page_id":"/docs/components/toolbar","type":"heading","tags":[],"url":"/docs/components/toolbar#installation","content":"Installation"},"2127":{"id":"/docs/components/toolbar#2","page_id":"/docs/components/toolbar","type":"heading","tags":[],"url":"/docs/components/toolbar#usage","content":"Usage"},"2128":{"id":"/docs/components/toolbar#3","page_id":"/docs/components/toolbar","type":"heading","tags":[],"url":"/docs/components/toolbar#composition","content":"Composition"},"2129":{"id":"/docs/components/toolbar#4","page_id":"/docs/components/toolbar","type":"heading","tags":[],"url":"/docs/components/toolbar#examples","content":"Examples"},"2130":{"id":"/docs/components/toolbar#5","page_id":"/docs/components/toolbar","type":"heading","tags":[],"url":"/docs/components/toolbar#disabled","content":"Disabled"},"2131":{"id":"/docs/components/toolbar#6","page_id":"/docs/components/toolbar","type":"heading","tags":[],"url":"/docs/components/toolbar#vertical","content":"Vertical"},"2132":{"id":"/docs/components/toolbar#7","page_id":"/docs/components/toolbar","type":"heading","tags":[],"url":"/docs/components/toolbar#the-look-alone","content":"The look alone"},"2133":{"id":"/docs/components/toolbar#8","page_id":"/docs/components/toolbar","type":"heading","tags":[],"url":"/docs/components/toolbar#a-formatting-bar","content":"A formatting bar"},"2134":{"id":"/docs/components/toolbar#9","page_id":"/docs/components/toolbar","type":"heading","tags":[],"url":"/docs/components/toolbar#overflow","content":"Overflow"},"2135":{"id":"/docs/components/toolbar#10","page_id":"/docs/components/toolbar","type":"heading","tags":[],"url":"/docs/components/toolbar#api","content":"API"},"2136":{"id":"/docs/components/toolbar#11","page_id":"/docs/components/toolbar","tags":[],"type":"text","url":"/docs/components/toolbar#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"2137":{"id":"/docs/components/toolbar#12","page_id":"/docs/components/toolbar","tags":[],"type":"text","url":"/docs/components/toolbar#composition","content":"Use the following composition to build a `Toolbar`:"},"2138":{"id":"/docs/components/toolbar#13","page_id":"/docs/components/toolbar","tags":[],"type":"text","url":"/docs/components/toolbar#disabled","content":"`disabled` on a `Toolbar` locks the whole bar: no item takes a press, the arrows skip it and it is\none disabled toolbar to screen readers. `disabled` on a `ToolbarGroup` locks that run alone, the\nrest of the bar still reached. Every item the bar knows locks — a `Button`, a `Toggle`, a `Link`,\na menu's or popover's trigger — because the base bar hands its lock down to each\n(`nsh-base/src/toolbar.rs`, \"items\"). A control that is not a bar item keeps its own `disabled`\nand its own behavior inside a locked bar: a `Command` palette, a text field."},"2139":{"id":"/docs/components/toolbar#14","page_id":"/docs/components/toolbar","tags":[],"type":"text","url":"/docs/components/toolbar#a-formatting-bar","content":"The bar a text editor puts over the text it formats: history, the block, the marks, the alignment,\na hairline between the runs. Undo and Redo are `Button`s that gray out at the ends of the history;\nthe marks a `ToggleGroup`; the alignment `Toggle`s that only ever set. The block is a `Menu` whose\n**trigger is one of the bar's items** — a `View` inside `MenuTrigger`, which `nsh/base` hands the\npress, the focus and the expanded state, so the arrow keys reach it like any other tool and Space or\nReturn opens it. Give that view `role=\"button\"`, a name and `accessibilityState` and it reads like\nthe menu button it is. The menu's rows are `MenuRadioItem`s: one block is chosen at a time."},"2140":{"id":"/docs/components/toolbar#15","page_id":"/docs/components/toolbar","tags":[],"type":"text","url":"/docs/components/toolbar#overflow","content":"Add `ToolbarOverflow` and wrap foldable tools in `ToolbarButton` so the bar measures each item with\n`onLayout` and folds lower-priority tools into the `\"⋯\"` menu as the bar narrows. Give a\n`ToolbarGroup` `fold=\"unit\"` (the default) to fold the whole group together under its\n`accessibilityLabel`, or `fold=\"none\"` to let its `ToolbarButton`s fold individually by their own\n`priority`. The bar draws the hairline rules between visible units and hides until its initial\nmeasurements arrive."},"2141":{"id":"/docs/components/toolbar#16","page_id":"/docs/components/toolbar","tags":[],"type":"text","url":"/docs/components/toolbar#api","content":"Every prop of `nsh/base` Toolbar, `ToolbarGroup` and `ToolbarSeparator` passes through. `style` goes over the look's. Items keep their own look (`Button`, `Toggle`, …)."},"2142":{"id":"/docs/components/toolbar#17","page_id":"/docs/components/toolbar","tags":[],"type":"text","url":"/docs/components/toolbar#api","content":"| Part      | Props                                     | Description                                                                    |\n| --------- | ----------------------------------------- | ------------------------------------------------------------------------------ |\n| `Toolbar` | `axis`, and every `nsh/base` Toolbar prop | The bar: one toolbar for screen readers, arrow keys along `axis`, on the track |","table":"table-0"},"2143":{"id":"/docs/components/toolbar#18","page_id":"/docs/components/toolbar","tags":[],"type":"text","url":"/docs/components/toolbar#api","content":"| Part           | Props                                                                           | Description                                                                                                      |\n| -------------- | ------------------------------------------------------------------------------- | ---------------------------------------------------------------------------------------------------------------- |\n| `ToolbarGroup` | `priority`, `fold` (`\"unit\" \\| \"none\"`), and every `nsh/base` ToolbarGroup prop | A named run of items; its direction follows the bar, and with `ToolbarOverflow` it folds as one unit or per item |","table":"table-0"},"2144":{"id":"/docs/components/toolbar#19","page_id":"/docs/components/toolbar","tags":[],"type":"text","url":"/docs/components/toolbar#api","content":"| Part               | Props                                  | Description                                                                                                          |\n| ------------------ | -------------------------------------- | -------------------------------------------------------------------------------------------------------------------- |\n| `ToolbarSeparator` | every `nsh/base` ToolbarSeparator prop | The hairline between runs, never a tab stop (omitted when `ToolbarOverflow` manages the rules between visible units) |","table":"table-0"},"2145":{"id":"/docs/components/toolbar#20","page_id":"/docs/components/toolbar","tags":[],"type":"text","url":"/docs/components/toolbar#api","content":"| Part            | Props                                            | Description                                                                                                     |\n| --------------- | ------------------------------------------------ | --------------------------------------------------------------------------------------------------------------- |\n| `ToolbarButton` | `menu`, `priority`, `foldable`, `class`, `style` | Wraps one tool so a bar with `ToolbarOverflow` can measure its width and fold it into `\"⋯\"` when space runs out |","table":"table-0"},"2146":{"id":"/docs/components/toolbar#21","page_id":"/docs/components/toolbar","tags":[],"type":"text","url":"/docs/components/toolbar#api","content":"| Part              | Props                                                                                                                                         | Description                                                                                                                                    |\n| ----------------- | --------------------------------------------------------------------------------------------------------------------------------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------- |\n| `ToolbarOverflow` | `accessibilityLabel`, `label`, `open`, `defaultOpen`, `onOpenChange`, `tooltip`, `disabled`, `align`, `offset`, `margin`, `style`, `children` | The `\"⋯\"` trigger and menu showing folded tools in bar order (grouped under each `ToolbarGroup`'s `accessibilityLabel`), before any `children` |","table":"table-0"},"2147":{"id":"/docs/components/toolbar#22","page_id":"/docs/components/toolbar","tags":[],"type":"text","url":"/docs/components/toolbar#api","content":"A bar without `ToolbarOverflow` behaves identically to a static bar. In a bar with `ToolbarOverflow`\non a horizontal non-terminal surface, unmeasured items stay visible rather than blocking folding.\nBecause `nsh/base`'s `Button`, `Toggle` and `Link` do not forward `onFocus`/`onBlur`, `Toolbar` does\nnot expose `onFocusIn`/`onFocusOut`, and `nsh/base`'s roving focus marks non-stop items\n`focusable={false}` (`roving.rs`), focus cannot automatically move to `\"⋯\"` when a focused tool\nfolds while an earlier tool remains visible."},"2148":{"id":"/docs/components/toolbar#23","page_id":"/docs/components/toolbar","tags":[],"type":"text","url":"/docs/components/toolbar#api","content":"`toolbarTrack({ vertical })` (`@/lib/ui/tool`) and `toolbarRule(vertical)` are the look, for a bar of your own."},"2149":{"id":"/docs/components/tooltip","page_id":"/docs/components/tooltip","type":"page","content":"Tooltip","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/tooltip"},"2150":{"id":"/docs/components/tooltip#0","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip","content":"A popover-coloured hint bubble on any element's `tooltip` prop."},"2151":{"id":"/docs/components/tooltip#1","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#installation","content":"Installation"},"2152":{"id":"/docs/components/tooltip#2","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#usage","content":"Usage"},"2153":{"id":"/docs/components/tooltip#3","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#composition","content":"Composition"},"2154":{"id":"/docs/components/tooltip#4","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#examples","content":"Examples"},"2155":{"id":"/docs/components/tooltip#5","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#placement","content":"Placement"},"2156":{"id":"/docs/components/tooltip#6","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#rich","content":"Rich"},"2157":{"id":"/docs/components/tooltip#7","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#on-any-elements-tooltip-prop","content":"On any element's `tooltip` prop"},"2158":{"id":"/docs/components/tooltip#8","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#a-trigger-of-your-own","content":"A trigger of your own"},"2159":{"id":"/docs/components/tooltip#9","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#on-a-menus-trigger","content":"On a menu's trigger"},"2160":{"id":"/docs/components/tooltip#10","page_id":"/docs/components/tooltip","type":"heading","tags":[],"url":"/docs/components/tooltip#api","content":"API"},"2161":{"id":"/docs/components/tooltip#11","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"2162":{"id":"/docs/components/tooltip#12","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#usage","content":"The examples draw icons with `Icon` from `lib/ui/icons`; see Icons for adding it and picking a size and color."},"2163":{"id":"/docs/components/tooltip#13","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#composition","content":"Use the following composition to build a `Tooltip`:"},"2164":{"id":"/docs/components/tooltip#14","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#rich","content":"A title and a note in a column, 10 points of padding."},"2165":{"id":"/docs/components/tooltip#15","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#on-any-elements-tooltip-prop","content":"`nsh/base` takes a hint as a host's `tooltip`; `TooltipContent` alone is that hint."},"2166":{"id":"/docs/components/tooltip#16","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#a-trigger-of-your-own","content":"A string child is a `Button`; anything else is the element itself, and its own press, hover\nand name stay."},"2167":{"id":"/docs/components/tooltip#17","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#on-a-menus-trigger","content":"A tooltip hangs on the element the trigger is. Give that element the `tooltip` prop and\nhand it to the trigger that wants the press; do not nest `TooltipTrigger` around a trigger\npart, which draws nothing for the hint's host to wrap."},"2168":{"id":"/docs/components/tooltip#18","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#api","content":"`nsh/base`'s Tooltip is the bubble itself, shown through a host's `tooltip` prop, so the root renders one host view around its trigger. `TooltipContent` mounts `nsh/base` Tooltip; every base prop passes through and `class` goes over the bubble's own. A string child is drawn in `tooltipTextStyle()`; a shortcut or a note takes `tooltipNote()`."},"2169":{"id":"/docs/components/tooltip#19","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#api","content":"| Part      | Props                                                                                                                               | Description                                                                            |\n| --------- | ----------------------------------------------------------------------------------------------------------------------------------- | -------------------------------------------------------------------------------------- |\n| `Tooltip` | `open` / `defaultOpen`, `placement`, `align`, `offset`, `margin`, `delay`, `disabled`, `style`, `onOpenChange`, `onOpen`, `onClose` | The root: it owns whether the hint shows, and renders one host view around its trigger |","table":"table-0"},"2170":{"id":"/docs/components/tooltip#20","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#api","content":"| Part             | Props                                                                | Description                   |\n| ---------------- | -------------------------------------------------------------------- | ----------------------------- |\n| `TooltipTrigger` | The host: `variant` (a string child's `Button`), `disabled`, `style` | The element the hint hangs on |","table":"table-0"},"2171":{"id":"/docs/components/tooltip#21","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#api","content":"| Part             | Props                                                                                                                         | Description                             |\n| ---------------- | ----------------------------------------------------------------------------------------------------------------------------- | --------------------------------------- |\n| `TooltipContent` | The bubble: `rich`, and base's `placement`, `align`, `offset`, `margin`, `delay`, `disabled`; alone, it is a host's `tooltip` | The hint itself, on the inverse surface |","table":"table-0"},"2172":{"id":"/docs/components/tooltip#22","page_id":"/docs/components/tooltip","tags":[],"type":"text","url":"/docs/components/tooltip#api","content":"| Part                                  | Props | Description                                                                     |\n| ------------------------------------- | ----- | ------------------------------------------------------------------------------- |\n| `tooltipTextStyle()`, `tooltipNote()` |       | The type of a string child, and of a shortcut or a note in a bubble of your own |","table":"table-0"},"2173":{"id":"/docs/components/trace","page_id":"/docs/components/trace","type":"page","content":"Trace","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/trace"},"2174":{"id":"/docs/components/trace#0","page_id":"/docs/components/trace","tags":[],"type":"text","url":"/docs/components/trace","content":"An agent's steps, one line each — reasoning, a tool call, a source, a failed step — where a line can open onto what it did."},"2175":{"id":"/docs/components/trace#1","page_id":"/docs/components/trace","type":"heading","tags":[],"url":"/docs/components/trace#installation","content":"Installation"},"2176":{"id":"/docs/components/trace#2","page_id":"/docs/components/trace","type":"heading","tags":[],"url":"/docs/components/trace#usage","content":"Usage"},"2177":{"id":"/docs/components/trace#3","page_id":"/docs/components/trace","type":"heading","tags":[],"url":"/docs/components/trace#composition","content":"Composition"},"2178":{"id":"/docs/components/trace#4","page_id":"/docs/components/trace","type":"heading","tags":[],"url":"/docs/components/trace#examples","content":"Examples"},"2179":{"id":"/docs/components/trace#5","page_id":"/docs/components/trace","type":"heading","tags":[],"url":"/docs/components/trace#reasoning","content":"Reasoning"},"2180":{"id":"/docs/components/trace#6","page_id":"/docs/components/trace","type":"heading","tags":[],"url":"/docs/components/trace#a-tool-call","content":"A tool call"},"2181":{"id":"/docs/components/trace#7","page_id":"/docs/components/trace","type":"heading","tags":[],"url":"/docs/components/trace#sources","content":"Sources"},"2182":{"id":"/docs/components/trace#8","page_id":"/docs/components/trace","type":"heading","tags":[],"url":"/docs/components/trace#a-failed-step","content":"A failed step"},"2183":{"id":"/docs/components/trace#9","page_id":"/docs/components/trace","type":"heading","tags":[],"url":"/docs/components/trace#api","content":"API"},"2184":{"id":"/docs/components/trace#10","page_id":"/docs/components/trace","tags":[],"type":"text","url":"/docs/components/trace#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"2185":{"id":"/docs/components/trace#11","page_id":"/docs/components/trace","tags":[],"type":"text","url":"/docs/components/trace#composition","content":"Use the following composition to build a `Trace`:"},"2186":{"id":"/docs/components/trace#12","page_id":"/docs/components/trace","tags":[],"type":"text","url":"/docs/components/trace#reasoning","content":"A reasoning line counts while the model thinks (`status=\"running\"`: a `Spinner` in the icon slot, the title pulsing) and then reads what it took. The pulse stands still when the user asks for less motion. It opens onto the text. `open` with `onOpenChange` lets the app open it when the thought is done."},"2187":{"id":"/docs/components/trace#13","page_id":"/docs/components/trace","tags":[],"type":"text","url":"/docs/components/trace#a-tool-call","content":"A call goes `pending` (dimmed), `running`, then done (no status), and opens onto what it did. The result is a `CodeBlock`: a search, a weather lookup and a code run are the same `Trace` with a different body — a list of `Item`s, a card, a `CodeBlock` — not a card of their own. Disable the trigger until there is something to show."},"2188":{"id":"/docs/components/trace#14","page_id":"/docs/components/trace","tags":[],"type":"text","url":"/docs/components/trace#sources","content":"A `TraceLine` with `onPress` is a pressable: it takes the text color under the pointer and the focus ring with the keyboard on it. Use it for a source that opens a page."},"2189":{"id":"/docs/components/trace#15","page_id":"/docs/components/trace","tags":[],"type":"text","url":"/docs/components/trace#a-failed-step","content":"`status=\"error\"` takes the destructive role for the title and the chevron; tint the icon with `colors.destructive` yourself, since an `Icon` draws in the tint it is given. A failed call opens onto its log in a destructive `CodeBlock`."},"2190":{"id":"/docs/components/trace#16","page_id":"/docs/components/trace","tags":[],"type":"text","url":"/docs/components/trace#api","content":"Every prop of `nsh` View passes through on every part but `TraceTitle` and `TraceDescription` (a `nsh` Text), `TraceCollapsible` (the props below) and `TraceCollapsibleContent` (`nsh/base`'s Collapsible); `style` goes over the look's."},"2191":{"id":"/docs/components/trace#17","page_id":"/docs/components/trace","tags":[],"type":"text","url":"/docs/components/trace#api","content":"| Part    | Props | Description          |\n| ------- | ----- | -------------------- |\n| `Trace` | —     | The column of steps. |","table":"table-0"},"2192":{"id":"/docs/components/trace#18","page_id":"/docs/components/trace","tags":[],"type":"text","url":"/docs/components/trace#api","content":"| Part        | Props                                                                                       | Description                                                                                                     |\n| ----------- | ------------------------------------------------------------------------------------------- | --------------------------------------------------------------------------------------------------------------- |\n| `TraceLine` | `status`: `\"running\" \\| \"pending\" \\| \"error\"` (default none: done); `onPress`: `() => void` | One step. With `onPress` it is a pressable. `running` pulses the title, `pending` dims, `error` is destructive. |","table":"table-0"},"2193":{"id":"/docs/components/trace#19","page_id":"/docs/components/trace","tags":[],"type":"text","url":"/docs/components/trace#api","content":"| Part        | Props | Description                                                                             |\n| ----------- | ----- | --------------------------------------------------------------------------------------- |\n| `TraceIcon` | —     | The icon slot, the theme's middle icon square; a `Spinner` while the line is `running`. |","table":"table-0"},"2194":{"id":"/docs/components/trace#20","page_id":"/docs/components/trace","tags":[],"type":"text","url":"/docs/components/trace#api","content":"| Part         | Props | Description                                                    |\n| ------------ | ----- | -------------------------------------------------------------- |\n| `TraceTitle` | —     | What the step is doing or did: one line, cut with an ellipsis. |","table":"table-0"},"2195":{"id":"/docs/components/trace#21","page_id":"/docs/components/trace","tags":[],"type":"text","url":"/docs/components/trace#api","content":"| Part               | Props | Description                                              |\n| ------------------ | ----- | -------------------------------------------------------- |\n| `TraceDescription` | —     | A quieter note: a duration, a count; digits do not jump. |","table":"table-0"},"2196":{"id":"/docs/components/trace#22","page_id":"/docs/components/trace","tags":[],"type":"text","url":"/docs/components/trace#api","content":"| Part               | Props                                                                                            | Description                                             |\n| ------------------ | ------------------------------------------------------------------------------------------------ | ------------------------------------------------------- |\n| `TraceCollapsible` | `open`: `boolean`; `defaultOpen`: `boolean`; `onOpenChange`: `(event: { open, reason }) => void` | A line and what it opens onto; owns whether it is open. |","table":"table-0"},"2197":{"id":"/docs/components/trace#23","page_id":"/docs/components/trace","tags":[],"type":"text","url":"/docs/components/trace#api","content":"| Part                      | Props                                                                                   | Description                                                                      |\n| ------------------------- | --------------------------------------------------------------------------------------- | -------------------------------------------------------------------------------- |\n| `TraceCollapsibleTrigger` | `disabled`: `boolean`; `accessibilityLabel`; `style`, `hoverStyle`, `focusVisibleStyle` | The pressable row: a `TraceLine` and a chevron that turns a quarter as it opens. |","table":"table-0"},"2198":{"id":"/docs/components/trace#24","page_id":"/docs/components/trace","tags":[],"type":"text","url":"/docs/components/trace#api","content":"| Part                      | Props                                                                                              | Description               |\n| ------------------------- | -------------------------------------------------------------------------------------------------- | ------------------------- |\n| `TraceCollapsibleContent` | `children`: `string \\| JSX.Element` (a string is muted text); `reveal`: `boolean` (default `true`) | The panel under the line. |","table":"table-0"},"2199":{"id":"/docs/components/tree","page_id":"/docs/components/tree","type":"page","content":"Tree","breadcrumbs":["Docs","Components"],"tags":[],"url":"/docs/components/tree"},"2200":{"id":"/docs/components/tree#0","page_id":"/docs/components/tree","tags":[],"type":"text","url":"/docs/components/tree","content":"A virtualized tree with chevrons and folder icons."},"2201":{"id":"/docs/components/tree#1","page_id":"/docs/components/tree","type":"heading","tags":[],"url":"/docs/components/tree#installation","content":"Installation"},"2202":{"id":"/docs/components/tree#2","page_id":"/docs/components/tree","type":"heading","tags":[],"url":"/docs/components/tree#usage","content":"Usage"},"2203":{"id":"/docs/components/tree#3","page_id":"/docs/components/tree","type":"heading","tags":[],"url":"/docs/components/tree#examples","content":"Examples"},"2204":{"id":"/docs/components/tree#4","page_id":"/docs/components/tree","type":"heading","tags":[],"url":"/docs/components/tree#folders","content":"Folders"},"2205":{"id":"/docs/components/tree#5","page_id":"/docs/components/tree","type":"heading","tags":[],"url":"/docs/components/tree#expanded","content":"Expanded"},"2206":{"id":"/docs/components/tree#6","page_id":"/docs/components/tree","type":"heading","tags":[],"url":"/docs/components/tree#height","content":"Height"},"2207":{"id":"/docs/components/tree#7","page_id":"/docs/components/tree","type":"heading","tags":[],"url":"/docs/components/tree#a-large-tree","content":"A large tree"},"2208":{"id":"/docs/components/tree#8","page_id":"/docs/components/tree","type":"heading","tags":[],"url":"/docs/components/tree#api","content":"API"},"2209":{"id":"/docs/components/tree#9","page_id":"/docs/components/tree","tags":[],"type":"text","url":"/docs/components/tree#installation","content":"As a TSX module, added once per app — nothing is copied into it:"},"2210":{"id":"/docs/components/tree#10","page_id":"/docs/components/tree","tags":[],"type":"text","url":"/docs/components/tree#folders","content":"`items` nest; a folder opens with a press or its chevron."},"2211":{"id":"/docs/components/tree#11","page_id":"/docs/components/tree","tags":[],"type":"text","url":"/docs/components/tree#expanded","content":"`defaultExpanded` opens folders at first."},"2212":{"id":"/docs/components/tree#12","page_id":"/docs/components/tree","tags":[],"type":"text","url":"/docs/components/tree#height","content":"A row is `treeRowHeight` tall: 28 points with a pointer, 44 on a touch screen. A well that should be\nas tall as its first rows, with the rest scrolling, sets its own height from it (`Tree`'s `style`),\nplus the list's 6 points of padding on each side."},"2213":{"id":"/docs/components/tree#13","page_id":"/docs/components/tree","tags":[],"type":"text","url":"/docs/components/tree#a-large-tree","content":"A hundred folders of a hundred files: 10 100 items. The tree is virtualized, so only the rows in view are made; opening a folder adds its hundred rows without a stall. Give it a height (the tree scrolls inside it) and keep `expanded` and `selected` as signals if you read them."},"2214":{"id":"/docs/components/tree#14","page_id":"/docs/components/tree","tags":[],"type":"text","url":"/docs/components/tree#api","content":"Uses `TreeRow` by default. Every prop of `nsh/base` Tree passes through."},"2215":{"id":"/docs/components/tree#15","page_id":"/docs/components/tree","tags":[],"type":"text","url":"/docs/components/tree#api","content":"| Part   | Props                                                                                | Description                                                   |\n| ------ | ------------------------------------------------------------------------------------ | ------------------------------------------------------------- |\n| `Tree` | `items`, `defaultExpanded`, `renderItem`, `onSelect`, and every `nsh/base` Tree prop | The virtualized list of rows, in a card, `TreeRow` by default |","table":"table-0"},"2216":{"id":"/docs/components/tree#16","page_id":"/docs/components/tree","tags":[],"type":"text","url":"/docs/components/tree#api","content":"| Part      | Props                             | Description                                                     |\n| --------- | --------------------------------- | --------------------------------------------------------------- |\n| `TreeRow` | `entry`, `icon`, `tint`, `detail` | A row: its chevron, its icon, its label and a detail at the end |","table":"table-0"},"2217":{"id":"/docs/components/tree#17","page_id":"/docs/components/tree","tags":[],"type":"text","url":"/docs/components/tree#api","content":"| Part            | Props | Description                                             |\n| --------------- | ----- | ------------------------------------------------------- |\n| `treeRowHeight` | —     | A row's height: 28 with a pointer, 44 on a touch screen |","table":"table-0"},"2218":{"id":"/docs/components","page_id":"/docs/components","type":"page","content":"Components","breadcrumbs":["Docs"],"tags":[],"url":"/docs/components"},"2219":{"id":"/docs/components#0","page_id":"/docs/components","tags":[],"type":"text","url":"/docs/components","content":"Styled components for Native Shell, built on nsh/base. Install with nshm or the copy-into-app CLI."},"2220":{"id":"/docs/components#1","page_id":"/docs/components","type":"heading","tags":[],"url":"/docs/components#base","content":"Base"},"2221":{"id":"/docs/components#2","page_id":"/docs/components","type":"heading","tags":[],"url":"/docs/components#enhanced","content":"Enhanced"},"2222":{"id":"/docs/components#3","page_id":"/docs/components","tags":[],"type":"text","url":"/docs/components","content":"Styled shells on `nsh/base`. Install a component either way:"},"2223":{"id":"/docs/components#4","page_id":"/docs/components","tags":[],"type":"text","url":"/docs/components","content":"With `nshm`, import from `shadcn-nsh/<name>`. With the CLI, the file is copied into the app and the snippets on each page import from `@/components/ui/<name>`."},"2224":{"id":"/docs/components#5","page_id":"/docs/components","tags":[],"type":"text","url":"/docs/components","content":"Each page has Installation, Usage, an optional Composition, Examples, and API. **Base** components align with an NSH element. **Enhanced** components are this library's own. Behavior, keyboard support, and the unstyled props live on nsh.dev/elements. Each page links its base element and the shadcn/ui component it stands in for."},"2225":{"id":"/docs/components#6","page_id":"/docs/components","tags":[],"type":"text","url":"/docs/components","content":"The list is generated from `registry.json` and these pages, so every `registry:ui` item has a page and every page has an item. A page registered on an NSH element is Base. A page registered on none is Enhanced."},"2226":{"id":"/docs/components#7","page_id":"/docs/components","tags":[],"type":"text","url":"/docs/components#base","content":"<ComponentsIndex kind=\"official\" />"},"2227":{"id":"/docs/components#8","page_id":"/docs/components","tags":[],"type":"text","url":"/docs/components#enhanced","content":"<ComponentsIndex kind=\"own\" />"},"2228":{"id":"/docs/customizing","page_id":"/docs/customizing","type":"page","content":"Customizing","breadcrumbs":["Docs"],"tags":[],"url":"/docs/customizing"},"2229":{"id":"/docs/customizing#0","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing","content":"Derive a theme with defineTheme, or change a copied component's shell and its private look."},"2230":{"id":"/docs/customizing#1","page_id":"/docs/customizing","type":"heading","tags":[],"url":"/docs/customizing#custom-themes","content":"Custom themes"},"2231":{"id":"/docs/customizing#2","page_id":"/docs/customizing","type":"heading","tags":[],"url":"/docs/customizing#what-the-build-writes","content":"What the build writes"},"2232":{"id":"/docs/customizing#3","page_id":"/docs/customizing","type":"heading","tags":[],"url":"/docs/customizing#customizing-copied-components","content":"Customizing copied components"},"2233":{"id":"/docs/customizing#4","page_id":"/docs/customizing","type":"heading","tags":[],"url":"/docs/customizing#colors-radii-and-the-spec","content":"Colors, radii, and the spec"},"2234":{"id":"/docs/customizing#5","page_id":"/docs/customizing","type":"heading","tags":[],"url":"/docs/customizing#one-controls-look","content":"One control's look"},"2235":{"id":"/docs/customizing#6","page_id":"/docs/customizing","type":"heading","tags":[],"url":"/docs/customizing#structure-and-api","content":"Structure and API"},"2236":{"id":"/docs/customizing#7","page_id":"/docs/customizing","type":"heading","tags":[],"url":"/docs/customizing#after-an-update","content":"After an update"},"2237":{"id":"/docs/customizing#8","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing","content":"Two kinds of change. A theme reaches every component. A copied file reaches that component. The TSX `nshm` install does not copy files, so appearance changes there go through Custom themes. Editing a shell or a look is the copy-into-app CLI, in Customizing copied components."},"2238":{"id":"/docs/customizing#9","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing#custom-themes","content":"A theme is a `ThemeSpec` compiled by `defineTheme()`. Pass another theme's `spec` as `extends` and state only what you change. `selectTheme()` applies the result while the app runs. `selectTheme(null)` returns to the theme the app was built with."},"2239":{"id":"/docs/customizing#10","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing#custom-themes","content":"`extends` is the theme's `spec`, not the `AppTheme` wrapper. Fields you leave out are kept. Omitting `brand` compiles it to `var(--primary)`. Omitting `tints` and `chart` uses the derived tints and the default chart ramp. A radius change is the same kind of patch: `tokens.radius` is `control`, `container`, `modal`, and `curve` (`\"continuous\"` or `\"circular\"`)."},"2240":{"id":"/docs/customizing#11","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing#custom-themes","content":"With the CLI, the same call lives in a file the app owns. `npx shadcn-nsh@latest add theme-shadcn` writes `themes/shadcn.ts` plus `themes/shadcn/theme.json` and `DESIGN.md`, beside the build-time theme. Import that module and pass it to `selectTheme`. `init --theme <id>` builds the app on that theme instead. See Themes."},"2241":{"id":"/docs/customizing#12","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing#custom-themes","content":"`nativeTheme()` from `shadcn-nsh/themes/native` returns Apple on iOS and macOS, Material on Android, WinUI 3 on Windows, and NSH Gallery elsewhere:"},"2242":{"id":"/docs/customizing#13","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing#what-the-build-writes","content":"`theme.json` is the layer NSH and Tailwind read: `cssVars.theme` (fonts, `radius`, `radius-md`, `radius-lg`, `radius-xl`, `scrim`, `media`, `on-media`) and the same color roles in `cssVars.light` and `cssVars.dark`. Edit keys, and keep the set. Both appearances need the same keys. Components refer to roles by name."},"2243":{"id":"/docs/customizing#14","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing#what-the-build-writes","content":"In this repository, `bun run theme:build` exports three artifacts from the resolved spec. They are generated. Change the TypeScript spec, then run the build. Do not hand-edit the exports and expect the spec to follow."},"2244":{"id":"/docs/customizing#15","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing#what-the-build-writes","content":"| Artifact     | What it is                                |\n| ------------ | ----------------------------------------- |\n| `theme.json` | CSS variables for `setTheme` and Tailwind |","table":"table-0"},"2245":{"id":"/docs/customizing#16","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing#what-the-build-writes","content":"| Artifact                                | What it is                                                                                        |\n| --------------------------------------- | ------------------------------------------------------------------------------------------------- |\n| `light.tokens.json`, `dark.tokens.json` | W3C Design Tokens Community Group format, 2025.10, one file per appearance. Not read at run time. |","table":"table-0"},"2246":{"id":"/docs/customizing#17","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing#what-the-build-writes","content":"| Artifact    | What it is                                           |\n| ----------- | ---------------------------------------------------- |\n| `DESIGN.md` | The design language in words, for agents. Generated. |","table":"table-0"},"2247":{"id":"/docs/customizing#18","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing#what-the-build-writes","content":"An app that only needs different colors can edit the copied `theme.json`. A later `add` merges keys the file lacks and keeps values you changed, unless you pass `--overwrite`. Surfaces, controls, metrics, and motion are not in `theme.json`. Those stay on the spec, in `themes/<id>.ts` after a copy, or in the module `nshm` resolves. Theme specification lists the roles. Architecture is the three layers."},"2248":{"id":"/docs/customizing#19","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing#customizing-copied-components","content":"`init` and `add` copy files into the app. After that they are the app's own. This section is that path. `nshm` does not copy a file to edit."},"2249":{"id":"/docs/customizing#20","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing#customizing-copied-components","content":"Public component shells sit at the top of each file. Component-private `*Look` helpers live at the bottom. The shell is what you change to add a prop or a part. The private look is what you change to restyle that control. Shared looks stay exported, because other files import them: `buttonLook` and `iconButtonLook` in `components/ui/button.tsx`, `pressableLook` in `components/ui/pressable.tsx`, `fieldLook` in `lib/ui/field-look.ts`, and `choiceLook` in `lib/ui/choice.tsx`."},"2250":{"id":"/docs/customizing#21","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing#customizing-copied-components","content":"| Change                  | Where                                           | Reaches         |\n| ----------------------- | ----------------------------------------------- | --------------- |\n| Colors, radii, surfaces | `theme.json`, and `themes/<id>.ts` for the spec | every component |","table":"table-1"},"2251":{"id":"/docs/customizing#22","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing#customizing-copied-components","content":"| Change             | Where                                                      | Reaches                                    |\n| ------------------ | ---------------------------------------------------------- | ------------------------------------------ |\n| One control's look | the private look at the bottom of `components/ui/<id>.tsx` | that control's variants, sizes, and states |","table":"table-1"},"2252":{"id":"/docs/customizing#23","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing#customizing-copied-components","content":"| Change           | Where                                        | Reaches                          |\n| ---------------- | -------------------------------------------- | -------------------------------- |\n| Structure or API | the public shell at the top of the same file | that component's props and parts |","table":"table-1"},"2253":{"id":"/docs/customizing#24","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing#customizing-copied-components","content":"In a monorepo, component files live under `packages/ui/` instead of the app root. The theme readers are still `lib/ui/`."},"2254":{"id":"/docs/customizing#25","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing#colors-radii-and-the-spec","content":"`theme.json` holds the colors for both appearances, the three layer radii (`radius-md`, `radius-lg`, `radius-xl`, with `radius` equal to `radius-md`), the fixed `scrim` / `media` / `on-media` values, and `font-sans` / `font-mono`. Every component reads them through `lib/ui/theme.ts`."},"2255":{"id":"/docs/customizing#26","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing#colors-radii-and-the-spec","content":"With `nshm` the same values are `import { colors, control, shape } from \"shadcn-nsh/theme\"`."},"2256":{"id":"/docs/customizing#27","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing#colors-radii-and-the-spec","content":"What `theme.json` does not carry is the spec's depth: the eleven `surfaces` (fill, gradient, shadow, edges, material), `feedback` (hover, press, focus, disabled, passive), `controls` (a switch's track, a field's focus line), and `metrics` (sizes per input tier). `add theme-<id>` installs that spec as `themes/<id>.ts`. A field a surface leaves out is a neutral (no gradient, no material, no shadow). A shadow names a step of the theme's own `elevation` scale rather than writing a shadow literal. State a device-dependent size twice, under `pointer` and `touch`, with the same keys."},"2257":{"id":"/docs/customizing#28","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing#one-controls-look","content":"A look turns a `variant`, a `size`, a `tone`, and a state into the props `nsh/base` draws with. In a copied file the private helpers sit below the public shell. Change a height, a radius, or a hover fill there, and keep the props the base control reads. Helpers only that file uses stay private."},"2258":{"id":"/docs/customizing#29","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing#one-controls-look","content":"Controls whose shape varies by platform (`checkbox`, `switch`, `slider`, `radio-group`, `progress`, `spinner`, `calendar`, `sheet`) read the theme's control geometry through `control(\"switch\")`, `control(\"slider\")`, `control(\"choice\")`, and `control(\"field\")`."},"2259":{"id":"/docs/customizing#30","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing#structure-and-api","content":"The shell is the component and its parts, above the look. It reads props, spreads the look, and gives a composite its roles."},"2260":{"id":"/docs/customizing#31","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing#structure-and-api","content":"Change the shell to change which props a component takes, which parts it exports, and how they nest. A new prop is read in the shell and passed to the base control. Keep the caller's `style`, `hoverStyle`, and other style props after the look's, so they still win. Behavior — keyboard, focus, dismissal — stays in `nsh/base`. The shell passes those props through. See nsh.dev/elements."},"2261":{"id":"/docs/customizing#32","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing#after-an-update","content":"`add` keeps a file the app changed and reports it. `diff` shows the lines. `add <name> --overwrite` replaces the file."},"2262":{"id":"/docs/customizing#33","page_id":"/docs/customizing","tags":[],"type":"text","url":"/docs/customizing#after-an-update","content":"`theme.json` is the exception: a file that only lacks keys is merged, and customized values are kept unless `--overwrite`."},"2263":{"id":"/docs/getting-started","page_id":"/docs/getting-started","type":"page","content":"Getting started","breadcrumbs":["Docs"],"tags":[],"url":"/docs/getting-started"},"2264":{"id":"/docs/getting-started#0","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started","content":"Add shadcn-nsh to an existing NSH app."},"2265":{"id":"/docs/getting-started#1","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#two-ways-to-install","content":"Two ways to install"},"2266":{"id":"/docs/getting-started#2","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#tsx-nshm","content":"TSX `nshm`"},"2267":{"id":"/docs/getting-started#3","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#copy-into-app","content":"Copy-into-app"},"2268":{"id":"/docs/getting-started#4","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#commands","content":"Commands"},"2269":{"id":"/docs/getting-started#5","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#add","content":"Add"},"2270":{"id":"/docs/getting-started#6","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#list-view-diff","content":"list, view, diff"},"2271":{"id":"/docs/getting-started#7","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#monorepo","content":"Monorepo"},"2272":{"id":"/docs/getting-started#8","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#local-registry","content":"Local registry"},"2273":{"id":"/docs/getting-started#9","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#theme","content":"Theme"},"2274":{"id":"/docs/getting-started#10","page_id":"/docs/getting-started","type":"heading","tags":[],"url":"/docs/getting-started#behavior-previews-and-native-tests","content":"Behavior, previews and native tests"},"2275":{"id":"/docs/getting-started#11","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#two-ways-to-install","content":"|              | TSX `nshm`                  | Copy-into-app CLI               |\n| ------------ | --------------------------- | ------------------------------- |\n| What you get | The module, resolved by NSH | The source, copied into the app |","table":"table-0"},"2276":{"id":"/docs/getting-started#12","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#two-ways-to-install","content":"|         | TSX `nshm`                           | Copy-into-app CLI                                                |\n| ------- | ------------------------------------ | ---------------------------------------------------------------- |\n| Install | `nsh add github:aningdev/shadcn-nsh` | `npx shadcn-nsh@latest init && npx shadcn-nsh@latest add button` |","table":"table-0"},"2277":{"id":"/docs/getting-started#13","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#two-ways-to-install","content":"|     | TSX `nshm` | Copy-into-app CLI                                       |\n| --- | ---------- | ------------------------------------------------------- |\n| npm | None       | Whatever an item declares (the components declare none) |","table":"table-0"},"2278":{"id":"/docs/getting-started#14","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#two-ways-to-install","content":"|       | TSX `nshm`                     | Copy-into-app CLI                                                  |\n| ----- | ------------------------------ | ------------------------------------------------------------------ |\n| Theme | `selectTheme(...)` at run time | `theme.json` at build time, plus `selectTheme` for any extra theme |","table":"table-0"},"2279":{"id":"/docs/getting-started#15","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#tsx-nshm","content":"No `package.json` and no `node_modules`. `selectTheme` switches a built-in theme while the app runs. Tailwind token names such as `bg-surface` and `rounded-(--radius-md)` still need a build-time `theme.json`, which CLI `init` writes."},"2280":{"id":"/docs/getting-started#16","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#copy-into-app","content":"An app with `nsh.json` (from `nsh init`) is ready:"},"2281":{"id":"/docs/getting-started#17","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#copy-into-app","content":"`init` writes `nsh-ui.json`, installs the theme and points each `nsh.json` at `theme.json`; in an app it also sets up the `@/` import alias the docs' snippets use — `\"@/*\": [\"./*\"]` in `tsconfig.json`'s `compilerOptions.paths` (writing the file when there is none) and `\"resolve\": { \"alias\": { \"@\": \"./\" } }` in `nsh.json` — leaving values already there alone with a warning. `add` copies the component and its `registryDependencies` (the theme and the shared files it imports) into the app; from then on the files are the app's own. CLI has every command, flag and default."},"2282":{"id":"/docs/getting-started#18","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#copy-into-app","content":"Consumer monorepo scaffolding (`shadcn-nsh create`) is not built. `init` and `add` work in a workspace that already has `apps/*` and a `packages/ui` named `@workspace/ui` (or already holding `nsh-ui.json`)."},"2283":{"id":"/docs/getting-started#19","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#commands","content":"| Command | What it does                                                                                 |\n| ------- | -------------------------------------------------------------------------------------------- |\n| `init`  | Writes `nsh-ui.json`, installs a theme, points each `nsh.json` at it, sets up `@/` in an app |","table":"table-1"},"2284":{"id":"/docs/getting-started#20","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#commands","content":"| Command        | What it does                                               |\n| -------------- | ---------------------------------------------------------- |\n| `add [items…]` | Copies items and their `registryDependencies` into the app |","table":"table-1"},"2285":{"id":"/docs/getting-started#21","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#commands","content":"| Command | What it does                                      |\n| ------- | ------------------------------------------------- |\n| `list`  | The registry's items, `✓` on the ones the app has |","table":"table-1"},"2286":{"id":"/docs/getting-started#22","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#commands","content":"| Command         | What it does                                           |\n| --------------- | ------------------------------------------------------ |\n| `view <items…>` | The files `add` would write: target paths and contents |","table":"table-1"},"2287":{"id":"/docs/getting-started#23","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#commands","content":"| Command         | What it does                                                     |\n| --------------- | ---------------------------------------------------------------- |\n| `diff [items…]` | The app's files against the registry's; exits 1 when they differ |","table":"table-1"},"2288":{"id":"/docs/getting-started#24","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#commands","content":"| Command           | What it does                                               |\n| ----------------- | ---------------------------------------------------------- |\n| `build` / `serve` | Build `registry.json` into `public/r`, or serve it locally |","table":"table-1"},"2289":{"id":"/docs/getting-started#25","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#commands","content":"Every command takes `-c, --cwd <dir>` (default: the current directory). `init`, `add`, `list`, `view` and `diff` also take `--registry <url>`, a template with `{name}` in it. CLI has every flag and default."},"2290":{"id":"/docs/getting-started#26","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#add","content":"A file the app does not have is written; one identical to the registry's is skipped."},"2291":{"id":"/docs/getting-started#27","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#add","content":"A file the app changed is kept and reported: `kept components/ui/button.tsx, differs (run diff)`. `--overwrite` replaces it and prints the change: `overwrite components/ui/button.tsx (+2 -1)`."},"2292":{"id":"/docs/getting-started#28","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#add","content":"`theme.json` is merged by key: the app keeps its colors and gains any role it lacks. Customized theme values stay as they are."},"2293":{"id":"/docs/getting-started#29","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#add","content":"`--all` adds every `registry:ui` item, dependencies included."},"2294":{"id":"/docs/getting-started#30","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#add","content":"`--dry-run` writes nothing — not even `nsh-ui.json` or the theme — and prints what it would write."},"2295":{"id":"/docs/getting-started#31","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#list-view-diff","content":"`list` reads the catalog (`index.json`) and marks an item when any of its files is in the app; `--json` prints the same catalog for tooling. `view` prints what `add` would write, dependencies first, with imports rewritten for the app. `diff` compares the same rewritten content with the app's files; without an item it lists the installed items that differ, with one it prints the changed lines, and it exits 1 when anything differs:"},"2296":{"id":"/docs/getting-started#32","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#monorepo","content":"If the workspace has `apps/web` and a `packages/ui` named `@workspace/ui`:"},"2297":{"id":"/docs/getting-started#33","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#monorepo","content":"The files install into `packages/ui`, and the app imports them through the workspace:"},"2298":{"id":"/docs/getting-started#34","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#local-registry","content":"When developing this repository:"},"2299":{"id":"/docs/getting-started#35","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#theme","content":"The look is `theme.json` (the roles of both appearances, three `radius-*` layer lengths, the fixed `scrim` / `media` / `on-media` values and any font families) plus `lib/ui/theme.ts`, the readers; the deeper half of a theme — surfaces, feedback, controls, metrics — is the spec in `themes/<id>.ts`, which `add theme-<id>` installs beside the build-time theme. `init` installs the build-time theme and points each `nsh.json` at `theme.json`; in a monorepo they live under `packages/ui`. See Theme specification for the keys, and Customizing to derive a theme or to change a copied component."},"2300":{"id":"/docs/getting-started#36","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#behavior-previews-and-native-tests","content":"| Surface        | Role                                                             |\n| -------------- | ---------------------------------------------------------------- |\n| `apps/website` | Public docs; `apps/website/demos/<id>.tsx` is the page's preview |","table":"table-2"},"2301":{"id":"/docs/getting-started#37","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#behavior-previews-and-native-tests","content":"| Surface        | Role                                                          |\n| -------------- | ------------------------------------------------------------- |\n| `apps/gallery` | Native behavior tests and smoke pages for the same components |","table":"table-2"},"2302":{"id":"/docs/getting-started#38","page_id":"/docs/getting-started","tags":[],"type":"text","url":"/docs/getting-started#behavior-previews-and-native-tests","content":"Behavior, keyboard support and accessibility belong to `nsh/base`: nsh.dev/elements. This site documents install, usage, examples and the props the styled layer adds."},"2303":{"id":"/docs/icons","page_id":"/docs/icons","type":"page","content":"Icons","breadcrumbs":["Docs"],"tags":[],"url":"/docs/icons"},"2304":{"id":"/docs/icons#0","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons","content":"Built-in UI icons, plus any lucide IconNode an app passes in."},"2305":{"id":"/docs/icons#1","page_id":"/docs/icons","type":"heading","tags":[],"url":"/docs/icons#installation","content":"Installation"},"2306":{"id":"/docs/icons#2","page_id":"/docs/icons","type":"heading","tags":[],"url":"/docs/icons#usage","content":"Usage"},"2307":{"id":"/docs/icons#3","page_id":"/docs/icons","type":"heading","tags":[],"url":"/docs/icons#size-and-color","content":"Size and color"},"2308":{"id":"/docs/icons#4","page_id":"/docs/icons","type":"heading","tags":[],"url":"/docs/icons#in-a-native-menu","content":"In a native menu"},"2309":{"id":"/docs/icons#5","page_id":"/docs/icons","type":"heading","tags":[],"url":"/docs/icons#props","content":"Props"},"2310":{"id":"/docs/icons#6","page_id":"/docs/icons","type":"heading","tags":[],"url":"/docs/icons#in-the-terminal","content":"In the terminal"},"2311":{"id":"/docs/icons#7","page_id":"/docs/icons","type":"heading","tags":[],"url":"/docs/icons#changing-them","content":"Changing them"},"2312":{"id":"/docs/icons#8","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons","content":"The components draw their own basic UI icons. `lib/ui/icons.tsx` ships those nodes, so a component does not need the `lucide` package at run time. `Icon` strokes a node on a canvas in its 24-unit box."},"2313":{"id":"/docs/icons#9","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons","content":"An icon value from `lucide` has the same shape (`[tag, attrs][]`) and assigns to `IconNode`. Pass one anywhere a component takes an icon."},"2314":{"id":"/docs/icons#10","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons#installation","content":"This copies `lib/ui/icons.tsx` and does not install an npm package. A component that draws icons of its own (`select`, `menu`, `tabs`, `sidebar`…) brings `icons` when it is added. With the TSX `nshm` install the same module is `shadcn-nsh`'s `Icon` export; nothing else is installed."},"2315":{"id":"/docs/icons#11","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons#usage","content":"The built-in names are the ones the components draw (`ChevronDown`, `Plus`, `Search`, `X`, and the rest of that set). An icon the set does not include still comes from `lucide`:"},"2316":{"id":"/docs/icons#12","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons#usage","content":"The color is one of the theme's roles, never a literal."},"2317":{"id":"/docs/icons#13","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons#size-and-color","content":"Inside a component, the component says how large an icon is and what color it takes, so it matches the label beside it in every variant and state. Spread its glyph helper, or use its size constant:"},"2318":{"id":"/docs/icons#14","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons#size-and-color","content":"| Component | Helper                                               |\n| --------- | ---------------------------------------------------- |\n| `button`  | `buttonGlyph`, `iconButtonGlyph`, `roundButtonGlyph` |","table":"table-0"},"2319":{"id":"/docs/icons#15","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons#size-and-color","content":"| Component | Helper        |\n| --------- | ------------- |\n| `toggle`  | `toggleGlyph` |","table":"table-0"},"2320":{"id":"/docs/icons#16","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons#size-and-color","content":"| Component | Helper          |\n| --------- | --------------- |\n| `menu`    | `menuItemGlyph` |","table":"table-0"},"2321":{"id":"/docs/icons#17","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons#size-and-color","content":"| Component    | Helper            |\n| ------------ | ----------------- |\n| `attachment` | `attachmentGlyph` |","table":"table-0"},"2322":{"id":"/docs/icons#18","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons#size-and-color","content":"| Component | Helper                                                                  |\n| --------- | ----------------------------------------------------------------------- |\n| `alert`   | `ALERT_ICON` (the size; the color is `colors.foreground` or the tone's) |","table":"table-0"},"2323":{"id":"/docs/icons#19","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons#size-and-color","content":"| Component | Helper       |\n| --------- | ------------ |\n| `empty`   | `EMPTY_ICON` |","table":"table-0"},"2324":{"id":"/docs/icons#20","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons#size-and-color","content":"A part that takes an icon as a prop, such as `SelectTrigger`'s `icon` or `MarkerIcon`'s, takes the lucide node itself (`icon={Calendar}`) and draws it in its own size and color."},"2325":{"id":"/docs/icons#21","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons#in-a-native-menu","content":"A native menu draws its own items, so it takes an image rather than a view: an item's `icon` is what `<Image>`'s `src` takes, fitted to the menu's icon size. `iconImage` writes a lucide node as that image, stroked in `currentColor`, so the menu draws it in its own text color:"},"2326":{"id":"/docs/icons#22","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons#in-a-native-menu","content":"The application menu's items take it the same way (`Menu.setApplicationMenu`). `iconImage(icon, options?)`:"},"2327":{"id":"/docs/icons#23","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons#in-a-native-menu","content":"| Argument | Type       | Default | Description                       |\n| -------- | ---------- | ------- | --------------------------------- |\n| `icon`   | `IconNode` |         | The icon, as `lucide` exports it. |","table":"table-1"},"2328":{"id":"/docs/icons#24","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons#in-a-native-menu","content":"| Argument         | Type     | Default | Description                                        |\n| ---------------- | -------- | ------- | -------------------------------------------------- |\n| `options.weight` | `number` | `2`     | The stroke in the 24-unit box (lucide's own is 2). |","table":"table-1"},"2329":{"id":"/docs/icons#25","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons#in-a-native-menu","content":"| Argument      | Type     | Default          | Description                                                                                                                       |\n| ------------- | -------- | ---------------- | --------------------------------------------------------------------------------------------------------------------------------- |\n| `options.ink` | `string` | `\"currentColor\"` | The stroke's color. A fixed ink makes the image a template image, which `tintColor` recolors instead (`CheckMark` passes `#000`). |","table":"table-1"},"2330":{"id":"/docs/icons#26","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons#props","content":"| Prop   | Type       | Default | Description                       |\n| ------ | ---------- | ------- | --------------------------------- |\n| `icon` | `IconNode` |         | The icon, as `lucide` exports it. |","table":"table-2"},"2331":{"id":"/docs/icons#27","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons#props","content":"| Prop   | Type     | Default | Description                        |\n| ------ | -------- | ------- | ---------------------------------- |\n| `size` | `number` | `20`    | The side of its square, in points. |","table":"table-2"},"2332":{"id":"/docs/icons#28","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons#props","content":"| Prop   | Type     | Default | Description                                 |\n| ------ | -------- | ------- | ------------------------------------------- |\n| `tint` | `string` |         | The stroke color, and the fill with `fill`. |","table":"table-2"},"2333":{"id":"/docs/icons#29","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons#props","content":"| Prop     | Type     | Default | Description                                        |\n| -------- | -------- | ------- | -------------------------------------------------- |\n| `weight` | `number` | `2`     | The stroke in the 24-unit box (lucide's own is 2). |","table":"table-2"},"2334":{"id":"/docs/icons#30","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons#props","content":"| Prop   | Type      | Default | Description                                             |\n| ------ | --------- | ------- | ------------------------------------------------------- |\n| `fill` | `boolean` | `false` | Fill the shape instead of stroking it (a solid `Play`). |","table":"table-2"},"2335":{"id":"/docs/icons#31","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons#props","content":"The arrows and chevrons that point along the line (`ChevronLeft`, `ChevronRight`, `ArrowLeft`, `ArrowRight`) are mirrored in a right-to-left layout."},"2336":{"id":"/docs/icons#32","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons#in-the-terminal","content":"The terminal draws no icons: `Icon` shows nothing there, except `Check`, which is the mark `✓`. An icon-only control uses `IconLabel` instead, which shows a short word in the icon's place:"},"2337":{"id":"/docs/icons#33","page_id":"/docs/icons","tags":[],"type":"text","url":"/docs/icons#changing-them","content":"`lib/ui/icons.tsx` is the app's own after `add`. To use another set, keep `Icon`'s props and change what it draws: the components only ever pass an icon, a size, a tint and a weight."},"2338":{"id":"/docs/theme","page_id":"/docs/theme","type":"page","content":"Theme specification","breadcrumbs":["Docs"],"tags":[],"url":"/docs/theme"},"2339":{"id":"/docs/theme#0","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme","content":"One TypeScript spec is the look; theme.json and DESIGN.md are its exports, and lib/ui/theme.ts reads it for every component."},"2340":{"id":"/docs/theme#1","page_id":"/docs/theme","type":"heading","tags":[],"url":"/docs/theme#files","content":"Files"},"2341":{"id":"/docs/theme#2","page_id":"/docs/theme","type":"heading","tags":[],"url":"/docs/theme#installation","content":"Installation"},"2342":{"id":"/docs/theme#3","page_id":"/docs/theme","type":"heading","tags":[],"url":"/docs/theme#colors","content":"Colors"},"2343":{"id":"/docs/theme#4","page_id":"/docs/theme","type":"heading","tags":[],"url":"/docs/theme#surfaces","content":"Surfaces"},"2344":{"id":"/docs/theme#5","page_id":"/docs/theme","type":"heading","tags":[],"url":"/docs/theme#feedback","content":"Feedback"},"2345":{"id":"/docs/theme#6","page_id":"/docs/theme","type":"heading","tags":[],"url":"/docs/theme#controls","content":"Controls"},"2346":{"id":"/docs/theme#7","page_id":"/docs/theme","type":"heading","tags":[],"url":"/docs/theme#radii","content":"Radii"},"2347":{"id":"/docs/theme#8","page_id":"/docs/theme","type":"heading","tags":[],"url":"/docs/theme#reading-the-theme","content":"Reading the theme"},"2348":{"id":"/docs/theme#9","page_id":"/docs/theme","type":"heading","tags":[],"url":"/docs/theme#override-from-nshjson","content":"Override from nsh.json"},"2349":{"id":"/docs/theme#10","page_id":"/docs/theme","type":"heading","tags":[],"url":"/docs/theme#fonts","content":"Fonts"},"2350":{"id":"/docs/theme#11","page_id":"/docs/theme","type":"heading","tags":[],"url":"/docs/theme#restyling","content":"Restyling"},"2351":{"id":"/docs/theme#12","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme","content":"The theme is the upstream gallery's: a graphite page (paper in light appearance), cards and wells, one citrus accent, compact controls with a pointer and roomier ones on a touch screen. It is **one TypeScript module** — the spec `defineTheme()` compiles — plus the module that reads it, and every component takes its colors, radii, typography, motion and depth from there. `theme.json` and `DESIGN.md` are exports of that same spec, so a theme is written once and drawn, shipped and documented from one place. No component writes a color of its own."},"2352":{"id":"/docs/theme#13","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#files","content":"| File                   | What it holds                                                                                                                                                                                                                                                                                              |\n| ---------------------- | ---------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `themes/<id>/index.ts` | The spec: `tokens` (21 appearance roles per mode, the fixed `scrim` / `media` / `on-media`, radii, fonts, tints, charts), `metrics`, `elevation`, the eleven `surfaces`, `feedback`, `motion`, `controls` — a full `ThemeSpec` for `nsh-gallery`, a `defineTheme({ extends, … })` delta for the other five |","table":"table-0"},"2353":{"id":"/docs/theme#14","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#files","content":"| File         | What it holds                                                                                                                                                                                                                  |\n| ------------ | ------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------ |\n| `theme.json` | The build export in shadcn's `cssVars` shape: `cssVars.theme` (`font-sans`, `font-mono`, `radius`, `radius-md`, `radius-lg`, `radius-xl`, `scrim`, `media`, `on-media`), `cssVars.light` and `cssVars.dark` (the same 21 keys) |","table":"table-0"},"2354":{"id":"/docs/theme#15","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#files","content":"| File        | What it holds                                                                                          |\n| ----------- | ------------------------------------------------------------------------------------------------------ |\n| `DESIGN.md` | Generated Google Labs DESIGN.md (`alpha`) specification for coding agents, compiled from the same spec |","table":"table-0"},"2355":{"id":"/docs/theme#16","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#files","content":"| File                                    | What it holds                                                                                                                                                                             |\n| --------------------------------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `light.tokens.json`, `dark.tokens.json` | Standalone W3C DTCG 2025.10 Format files resolved per appearance (in-file aliases, 6-digit `hex` fallbacks) for Figma Variables (Light/Dark modes), Tokens Studio and Style Dictionary v4 |","table":"table-0"},"2356":{"id":"/docs/theme#17","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#files","content":"| File              | What it holds                                                                                                                                         |\n| ----------------- | ----------------------------------------------------------------------------------------------------------------------------------------------------- |\n| `lib/ui/theme.ts` | `colors`, `surface`, `control`, `feedback`, `shape`, `font`, `metrics`, `elevation`, `motion`, `focusRing` and `alpha`, read reactively from the spec |","table":"table-0"},"2357":{"id":"/docs/theme#18","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#files","content":"`bun run theme:build` writes `theme.json`, `DESIGN.md` and the two `.tokens.json` files from `themes/<id>/index.ts`; they are build outputs, so edit the spec, not them."},"2358":{"id":"/docs/theme#19","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#installation","content":"`init` writes the theme into the app — `theme.json`, `DESIGN.md` and the readers under `lib/ui/` (in a monorepo, under `packages/ui`) — and points each `nsh.json` at `theme.json`. `add theme` does the same for the theme `nsh-ui.json` records; naming one (`add theme-shadcn`) installs that theme beside it, as one more `themes/<id>.ts` the app can switch to while it runs. Every component depends on the theme."},"2359":{"id":"/docs/theme#20","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#colors","content":"`theme.json` is a shadcn theme: `cssVars.theme` holds the shared values, `cssVars.light` and `cssVars.dark` hold the same 21 roles for the two appearances. A theme declares every one of them — `defineTheme()` fills what a delta leaves out from the theme it extends — and nothing else is read."},"2360":{"id":"/docs/theme#21","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#colors","content":"| Role                        | Use                                   |\n| --------------------------- | ------------------------------------- |\n| `background` / `foreground` | The page, and the ink that sits on it |","table":"table-1"},"2361":{"id":"/docs/theme#22","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#colors","content":"| Role               | Use                                                             |\n| ------------------ | --------------------------------------------------------------- |\n| `card` / `popover` | A surface that holds content, and one that floats over the page |","table":"table-1"},"2362":{"id":"/docs/theme#23","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#colors","content":"| Role                         | Use                                         |\n| ---------------------------- | ------------------------------------------- |\n| `muted` / `muted-foreground` | A quiet fill, and the text that reads on it |","table":"table-1"},"2363":{"id":"/docs/theme#24","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#colors","content":"| Role      | Use                                                 |\n| --------- | --------------------------------------------------- |\n| `surface` | The tone one step above the page: a control at rest |","table":"table-1"},"2364":{"id":"/docs/theme#25","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#colors","content":"| Role    | Use               |\n| ------- | ----------------- |\n| `faint` | The quietest text |","table":"table-1"},"2365":{"id":"/docs/theme#26","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#colors","content":"| Role                             | Use                                        |\n| -------------------------------- | ------------------------------------------ |\n| `primary` / `primary-foreground` | The accent as a fill, and what reads on it |","table":"table-1"},"2366":{"id":"/docs/theme#27","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#colors","content":"| Role                   | Use                                                                |\n| ---------------------- | ------------------------------------------------------------------ |\n| `secondary` / `accent` | A second fill, and the fill a selected row or a hovered item takes |","table":"table-1"},"2367":{"id":"/docs/theme#28","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#colors","content":"| Role    | Use               |\n| ------- | ----------------- |\n| `brand` | The accent as ink |","table":"table-1"},"2368":{"id":"/docs/theme#29","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#colors","content":"| Role                        | Use                                                                       |\n| --------------------------- | ------------------------------------------------------------------------- |\n| `border` / `line` / `input` | The edge of a card or control, a hairline inside one, and an input's edge |","table":"table-1"},"2369":{"id":"/docs/theme#30","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#colors","content":"| Role   | Use                        |\n| ------ | -------------------------- |\n| `ring` | The keyboard focus outline |","table":"table-1"},"2370":{"id":"/docs/theme#31","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#colors","content":"| Role                                           | Use                                                                                           |\n| ---------------------------------------------- | --------------------------------------------------------------------------------------------- |\n| `info` / `success` / `warning` / `destructive` | The tones beside the accent: information, a gain, a caution, a loss — the last also a failure |","table":"table-1"},"2371":{"id":"/docs/theme#32","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#colors","content":"Three more values do not turn with the appearance and are named in `cssVars.theme` beside the radii: `scrim` (what a modal dims the page with), `media` (the ground a photo or a video sits on) and `on-media` (ink drawn straight onto one)."},"2372":{"id":"/docs/theme#33","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#colors","content":"`colors` maps the roles a component names onto those keys:"},"2373":{"id":"/docs/theme#34","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#colors","content":"One ink serves them all: a card, a popover, a secondary and an accent surface read `foreground` unless the surface states its own, which `surface(role).ink` returns (see Surfaces). `tints.brand`, `tints.info`, `tints.success`, `tints.warning` and `tints.destructive` are the same tones as low fills behind text, and `toneColor(tone)` / `toneTint(tone)` pick either from the `Tone` a prop carries — `\"neutral\"`, `\"accent\"`, `\"info\"`, `\"success\"`, `\"warning\"` or `\"destructive\"`."},"2374":{"id":"/docs/theme#35","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#colors","content":"Read a role where it is drawn (in JSX, a `draw`, or an effect): the getters read the token then, so they follow the appearance."},"2375":{"id":"/docs/theme#36","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#surfaces","content":"A surface is light and depth: what a layer is filled with, and how it sits above what is behind it. There are eleven, and each states the same fields in every theme — `background`, `ink`, `gradient`, `border`, `borderTop`, `borderBottom`, `shadow`, `backdropFilter`, `material` and `elevation` — either for both appearances or split into `light` and `dark`. A field a surface leaves out is not missing: it is a neutral (no gradient, no material, no shadow), and a shadow names the parts of the theme's own scale (`[\"edgeSurface\", \"sm\"]`) instead of writing one, so `elevation(\"md\")` gives the same values on its own."},"2376":{"id":"/docs/theme#37","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#surfaces","content":"| Role   | Use                                             |\n| ------ | ----------------------------------------------- |\n| `card` | A surface that holds content: a card, a section |","table":"table-2"},"2377":{"id":"/docs/theme#38","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#surfaces","content":"| Role     | Use                                                        |\n| -------- | ---------------------------------------------------------- |\n| `raised` | A surface above the page: a button at rest, a chip, a pill |","table":"table-2"},"2378":{"id":"/docs/theme#39","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#surfaces","content":"| Role    | Use                                                    |\n| ------- | ------------------------------------------------------ |\n| `inset` | A surface sunk into its host: a field, a track, a well |","table":"table-2"},"2379":{"id":"/docs/theme#40","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#surfaces","content":"| Role      | Use                                                                |\n| --------- | ------------------------------------------------------------------ |\n| `channel` | The groove a filled track runs in: a slider's rail, a progress bar |","table":"table-2"},"2380":{"id":"/docs/theme#41","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#surfaces","content":"| Role    | Use                                            |\n| ------- | ---------------------------------------------- |\n| `plate` | The plate a row or a group of controls sits on |","table":"table-2"},"2381":{"id":"/docs/theme#42","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#surfaces","content":"| Role      | Use                                                                |\n| --------- | ------------------------------------------------------------------ |\n| `overlay` | A surface the page floats over: a menu, a popover, a select's list |","table":"table-2"},"2382":{"id":"/docs/theme#43","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#surfaces","content":"| Role    | Use                                             |\n| ------- | ----------------------------------------------- |\n| `modal` | A surface the page waits for: a dialog, a sheet |","table":"table-2"},"2383":{"id":"/docs/theme#44","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#surfaces","content":"| Role      | Use                                      |\n| --------- | ---------------------------------------- |\n| `inverse` | The reversed surface: a toast, a tooltip |","table":"table-2"},"2384":{"id":"/docs/theme#45","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#surfaces","content":"| Role    | Use                    |\n| ------- | ---------------------- |\n| `glass` | A control over a photo |","table":"table-2"},"2385":{"id":"/docs/theme#46","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#surfaces","content":"| Role     | Use                                                           |\n| -------- | ------------------------------------------------------------- |\n| `accent` | The brand's own surface: a filled button, a switch that is on |","table":"table-2"},"2386":{"id":"/docs/theme#47","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#surfaces","content":"| Role   | Use                                                      |\n| ------ | -------------------------------------------------------- |\n| `fill` | The accent's gradient face: a primary button's highlight |","table":"table-2"},"2387":{"id":"/docs/theme#48","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#surfaces","content":"`surface(role)` returns the three things a view needs:"},"2388":{"id":"/docs/theme#49","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#surfaces","content":"`style` is the layer's fill, gradient, shadow, edges and blur; `ink` is the text that reads on it; `platformProps` is what the platform's own glass should be — `ios`, `windows` and `android` props, not style keys — for the view that draws the surface:"},"2389":{"id":"/docs/theme#50","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#surfaces","content":"The `material` says what the platform's material should be: `null` (every theme but the glassed ones), `glass` or `acrylic` on the `apple` and `winui` surfaces that float, or a per-platform name. The `apple` theme fills in `glass`, `overlay` and `raised` (Liquid Glass on iOS and macOS 26+), and every other surface is a flat fill with a hairline edge; the `material` theme uses Material 3 Expressive tonal surfaces, circular corners, 8/10/10% state layers, press ripple and Android elevation on raised surfaces; the `winui` theme uses WinUI 3 (Windows 11) fills and strokes, 4/8-point circular corners, Segoe UI Variable, double focus rings and Windows blur on `glass`, `overlay` and `inverse`. `nativeTheme()` from `themes/native` picks the theme of the platform the app runs on — Apple's on iOS and macOS, Material on Android, WinUI 3 on Windows, and the NSH Gallery theme everywhere else:"},"2390":{"id":"/docs/theme#51","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#surfaces","content":"Windows' Mica is not a surface: it is the window's own `backdrop` in `nsh-desktop` (Windows 11 maps it to Mica or Acrylic, macOS to a visual effect material), set once by the app in `nsh.json` and shown through surfaces whose fill is translucent:"},"2391":{"id":"/docs/theme#52","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#feedback","content":"How a control answers the pointer and the keyboard is stated once, per theme, in `feedback`, and every component reads it there:"},"2392":{"id":"/docs/theme#53","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#feedback","content":"| Key     | What it states                                                                                                 |\n| ------- | -------------------------------------------------------------------------------------------------------------- |\n| `hover` | The pointer's treatment: a wash over the surface (`overlay`), or the surface it turns into (`fill`, `surface`) |","table":"table-3"},"2393":{"id":"/docs/theme#54","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#feedback","content":"| Key     | What it states                                                                                                                       |\n| ------- | ------------------------------------------------------------------------------------------------------------------------------------ |\n| `press` | The press: how far the whole control sinks (`scale`, `translateY`), the wash over it, the surface it takes and the accent's own sink |","table":"table-3"},"2394":{"id":"/docs/theme#55","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#feedback","content":"| Key     | What it states                                                                                                      |\n| ------- | ------------------------------------------------------------------------------------------------------------------- |\n| `focus` | The keyboard outline: its style (`halo`, `outline` or `double`), width and offset, and the colour of the inner ring |","table":"table-3"},"2395":{"id":"/docs/theme#56","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#feedback","content":"| Key        | What it states                                                                                           |\n| ---------- | -------------------------------------------------------------------------------------------------------- |\n| `disabled` | A control that cannot act: its content's opacity, whether the face is replaced, and the surface it takes |","table":"table-3"},"2396":{"id":"/docs/theme#57","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#feedback","content":"| Key       | What it states                                                            |\n| --------- | ------------------------------------------------------------------------- |\n| `passive` | The opacity of content that is not interactive at rest, and while pressed |","table":"table-3"},"2397":{"id":"/docs/theme#58","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#feedback","content":"`feedback.hoverStyle(ink?)` is the pointer's fill and `feedback.hoverSurface(ink?)` the surface it becomes, both for the ink you pass or the one the theme reads; `feedback.press(intent, options?)` takes `\"surface\"`, `\"accent\"`, `\"ghost\"`, `\"outline\"`, `\"destructive\"` or `\"sinkOnly\"` and returns the `activeStyle` and `transition` of a press; `feedback.focusRing(offset?)` is the muted `ring` edge and a halo of `ring` at 30%, or the double ring the Windows theme draws."},"2398":{"id":"/docs/theme#59","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#controls","content":"A control's own geometry and face live in the theme too, so switching themes changes its shape, not only its colours. `control(name)` resolves one for the active theme and the device's input tier:"},"2399":{"id":"/docs/theme#60","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#controls","content":"The names are `button`, `badge`, `field`, `choice`, `switch`, `slider`, `progress`, `spinner`, `popup`, `list`, `tabs`, `menubar` and `well`."},"2400":{"id":"/docs/theme#61","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#radii","content":"`theme.json`'s `cssVars.theme` block defines three corner radii, one per layer: `radius-md` (in-page elements: fields, rows, chips, badges, wells, colour areas, keycaps), `radius-lg` (cards, menus, popovers, rich tooltips, list panels, toasts) and `radius-xl` (dialogs, sheets, drawers). shadcn's own `radius` slot equals `radius-md`. `shape` resolves each role reactively via `token()`, and `buttonCorner(size)` reads `control(\"button\").corner` (`\"control\"` or `\"full\"` capsule):"},"2401":{"id":"/docs/theme#62","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#radii","content":"| Theme               | `control` | `container` | `modal` | Buttons   |\n| ------------------- | --------- | ----------- | ------- | --------- |\n| `default`, `shadcn` | 8         | 12          | 14      | `control` |","table":"table-4"},"2402":{"id":"/docs/theme#63","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#radii","content":"| Theme         | `control` | `container` | `modal` | Buttons   |\n| ------------- | --------- | ----------- | ------- | --------- |\n| `solid-glass` | 11        | 14          | 20      | `control` |","table":"table-4"},"2403":{"id":"/docs/theme#64","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#radii","content":"| Theme   | `control` | `container` | `modal` | Buttons |\n| ------- | --------- | ----------- | ------- | ------- |\n| `apple` | 8         | 12          | 26      | capsule |","table":"table-4"},"2404":{"id":"/docs/theme#65","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#radii","content":"| Theme      | `control` | `container` | `modal` | Buttons |\n| ---------- | --------- | ----------- | ------- | ------- |\n| `material` | 4         | 12          | 28      | capsule |","table":"table-4"},"2405":{"id":"/docs/theme#66","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#radii","content":"| Theme   | `control` | `container` | `modal` | Buttons   |\n| ------- | --------- | ----------- | ------- | --------- |\n| `winui` | 4         | 8           | 8       | `control` |","table":"table-4"},"2406":{"id":"/docs/theme#67","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#radii","content":"A surface inside another takes a concentric corner from its outer one: `rounded(outer, inset)` gives `outer − inset`, never below 0. `rounded()` also puts the corner on with `shape.curve` (`\"continuous\"` or `\"circular\"`):"},"2407":{"id":"/docs/theme#68","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#reading-the-theme","content":"`elevation(\"sm\" | \"md\" | \"lg\" | \"xl\" | \"inset\")` resolves the theme's shadow scale for the active appearance, and a surface's `shadow` names those parts rather than writing them. `alpha(color, a)` is a `color-mix` of that color with transparency. `metrics`, `font`, `iconSize`, `controlHeight`, `stroke` and `motion` read the rest of the spec — sizes per input tier, the type scale, the timings — and `activeSpec()` is the whole `ThemeSpec` when a look needs a value the readers do not name. All of them are reactive: read them where they are used."},"2408":{"id":"/docs/theme#69","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#override-from-nshjson","content":"An app's `nsh.json` sets the look in two places, and the two do not merge:"},"2409":{"id":"/docs/theme#70","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#override-from-nshjson","content":"| Key in `nsh.json` | What it sets                                                                | When it is read                                                                 |\n| ----------------- | --------------------------------------------------------------------------- | ------------------------------------------------------------------------------- |\n| `\"theme\"`         | the path to `theme.json`: every base token — colours, the `radius-*` tokens | on each read, at runtime — so `setTheme`, `setThemeOverrides`, `shape` reach it |","table":"table-5"},"2410":{"id":"/docs/theme#71","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#override-from-nshjson","content":"| Key in `nsh.json` | What it sets                                                                | When it is read                                                            |\n| ----------------- | --------------------------------------------------------------------------- | -------------------------------------------------------------------------- |\n| `\"tailwind\"`      | the app's own class strings: `colors`, `fontFamily`, `spacing`, `radius`, … | when the app is built, into the class strings — no component here reads it |","table":"table-5"},"2411":{"id":"/docs/theme#72","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#override-from-nshjson","content":"Components take their look from `\"theme\"`: `colors`, `surface`, `control`, `shape` and `font` read the tokens where they are used. `\"tailwind\"` shapes class names — which this library writes too (`bg-muted`, `text-sm`, `h-8`) — but it is fixed at build time, so nothing in it can follow `setTheme`. NSH's theme tokens has the rule in full."},"2412":{"id":"/docs/theme#73","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#override-from-nshjson","content":"**A colour named in `\"tailwind\"` wins over the token of the same name.** With `\"colors\": { \"primary\": \"#3366ff\" }`, every `bg-primary` in the app draws blue — pagination's selected page, a data table's move indicator — while `colors.primary` in JSX stays the theme's citrus. One name, two colours, and the panels drawn by class are the ones that differ. Set the role in `\"theme\"` instead."},"2413":{"id":"/docs/theme#74","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#override-from-nshjson","content":"The theme file stays complete: copy it, then edit. Every role of both appearances is there, and a colour the app adds must be named in both (a token in one alone is not a token):"},"2414":{"id":"/docs/theme#75","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#override-from-nshjson","content":"Change a role: `primary` in `cssVars.light` and `cssVars.dark`. Change a radius: `radius-md`, `radius-lg` or `radius-xl` in `cssVars.theme` (keep `radius` equal to `radius-md`) — every corner follows them: `shape.*` and `rounded()` in the styles, and `rounded-(--radius…)` in the classes, this library's and the app's own alike. A surface's shape and depth and a control's geometry are the spec's, so an app that changes them edits `themes/<id>.ts` — the file `add theme-<id>` installs — and copies it into its own reader if it does not. Fonts are the app's own: see Fonts."},"2415":{"id":"/docs/theme#76","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#fonts","content":"Every `theme.json` writes `font-sans` and `font-mono`. Built-in themes leave `tokens.font` unset, so those keys are `system-ui` and `monospace` — the system's own faces — and one type scale (sizes and line heights) serves them all, so switching themes never reflows text. Each theme states its own weight and letter spacing per role. `font.sans` and `font.mono` read the two keys; the `font-sans` and `font-mono` classes read the same CSS variables. The user's system font size scales every size."},"2416":{"id":"/docs/theme#77","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#fonts","content":"Set the app's families in the `cssVars.theme` block of its own `theme.json`:"},"2417":{"id":"/docs/theme#78","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#fonts","content":"NSH takes the first family of the list that is not a generic one (`system-ui`, `sans-serif`, `monospace` …), and a list of generics alone is the system's own font. That is why this library writes `monospace`: the system's monospaced font, not a font called \"monospace\"."},"2418":{"id":"/docs/theme#79","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#fonts","content":"A font file is the app's. Import it in TSX — the import registers it before the first frame, and its value is the family name the file declares, not the file name — and name that family in the theme:"},"2419":{"id":"/docs/theme#80","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#fonts","content":"The side-effect import is deliberate: TypeScript drops an import whose value is unused, and the font with it, when the theme names the family as a string. A weight or an italic is a file of its own, `registerFont(bytes)` reads one the app did not ship, and the fallback after the app's family is what NSH draws for a family it cannot find — see NSH's fonts."},"2420":{"id":"/docs/theme#81","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#fonts","content":"This library distributes no font files: `add theme` writes JSON and TypeScript and names no family."},"2421":{"id":"/docs/theme#82","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#restyling","content":"Edit the spec; every component follows. Change a brand colour in `tokens.light` and `tokens.dark`, a radius in `tokens.radius`, a shadow part in `elevation`, a gradient, a surface or a control in the theme's own `index.ts` — then `bun run theme:build` re-exports `theme.json`, `DESIGN.md` and the two `.tokens.json` files. Keep the keys: components and surfaces refer to them by name. A value that follows the device is stated twice, `pointer` and `touch`, with the same keys."},"2422":{"id":"/docs/theme#83","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#restyling","content":"A theme of your own is a `defineTheme()` delta over one that ships: `defineTheme({ id, label, extends: nshGallery.spec, tokens: { … } })`, sparse — what it does not state, it inherits. `ALL_THEMES` in `packages/theme/themes` is the list, and adding one there gives it a page on this site and a registry item."},"2423":{"id":"/docs/theme#84","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#restyling","content":"Add a shipped theme to an app with `shadcn-nsh add theme` (or let `init` do it); subsequent `add` runs key-merge missing entries into `theme.json` while keeping your values."},"2424":{"id":"/docs/theme#85","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#restyling","content":"The demos on this site can draw in an installed theme: the **Demo theme** switch in the nav (Default, shadcn, Solid Glass, Apple, Material or WinUI 3) writes the demo app's palette and loads the panels again. The list is `apps/website/demos/palettes.ts`; a demo reads the palette before it mounts, so its first frame is already the chosen theme. Every palette — its install command and every role it sets — has a page linked from Themes."},"2425":{"id":"/docs/theme#86","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#restyling","content":"To change one component's look instead, edit its look function in the copied component; to change structure or API, edit the shell. See Customizing."},"2426":{"id":"/docs/theme#87","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#restyling","content":"Maintaining this repository: edit the look in `packages/ui` (all of it is ours; a credit line in the header says where it began). After editing `packages/theme`, run `bun run theme:build` and `bun run registry:build`, and commit `public/r`."},"2427":{"id":"/docs/theme#88","page_id":"/docs/theme","tags":[],"type":"text","url":"/docs/theme#restyling","content":"Theme rules: `docs/theme.md` and `packages/theme/README.md`. Behavior and accessibility are `nsh/base`'s: nsh.dev/elements."},"2428":{"id":"/docs/themes/apple","page_id":"/docs/themes/apple","type":"page","content":"Apple","breadcrumbs":["Docs","Themes"],"tags":[],"url":"/docs/themes/apple"},"2429":{"id":"/docs/themes/apple#0","page_id":"/docs/themes/apple","tags":[],"type":"text","url":"/docs/themes/apple","content":"Apple's system colors and Liquid Glass: capsule controls, 20-point cards, hairline edges, and glass on the overlays that float."},"2430":{"id":"/docs/themes/apple#1","page_id":"/docs/themes/apple","type":"heading","tags":[],"url":"/docs/themes/apple#installation","content":"Installation"},"2431":{"id":"/docs/themes/apple#2","page_id":"/docs/themes/apple","type":"heading","tags":[],"url":"/docs/themes/apple#tokens","content":"Tokens"},"2432":{"id":"/docs/themes/apple#3","page_id":"/docs/themes/apple","type":"heading","tags":[],"url":"/docs/themes/apple#the-appearance-roles","content":"The appearance roles"},"2433":{"id":"/docs/themes/apple#4","page_id":"/docs/themes/apple","type":"heading","tags":[],"url":"/docs/themes/apple#the-shared-values","content":"The shared values"},"2434":{"id":"/docs/themes/apple#5","page_id":"/docs/themes/apple","type":"heading","tags":[],"url":"/docs/themes/apple#surfaces","content":"Surfaces"},"2435":{"id":"/docs/themes/apple#6","page_id":"/docs/themes/apple","type":"heading","tags":[],"url":"/docs/themes/apple#design-notes-and-trade-offs","content":"Design notes and trade-offs"},"2436":{"id":"/docs/themes/apple#7","page_id":"/docs/themes/apple","tags":[],"type":"text","url":"/docs/themes/apple","content":"<ThemeIntro id=\"apple\" />"},"2437":{"id":"/docs/themes/apple#8","page_id":"/docs/themes/apple","tags":[],"type":"text","url":"/docs/themes/apple#installation","content":"<ThemeInstall id=\"apple\" />"},"2438":{"id":"/docs/themes/apple#9","page_id":"/docs/themes/apple","tags":[],"type":"text","url":"/docs/themes/apple#tokens","content":"<ThemeTokenLead />"},"2439":{"id":"/docs/themes/apple#10","page_id":"/docs/themes/apple","tags":[],"type":"text","url":"/docs/themes/apple#the-appearance-roles","content":"<ThemeTokens id=\"apple\" group=\"roles\" />"},"2440":{"id":"/docs/themes/apple#11","page_id":"/docs/themes/apple","tags":[],"type":"text","url":"/docs/themes/apple#the-shared-values","content":"<ThemeTokens id=\"apple\" group=\"shared\" />"},"2441":{"id":"/docs/themes/apple#12","page_id":"/docs/themes/apple","tags":[],"type":"text","url":"/docs/themes/apple#surfaces","content":"<ThemeSurfaces id=\"apple\" />"},"2442":{"id":"/docs/themes/apple#13","page_id":"/docs/themes/apple","tags":[],"type":"text","url":"/docs/themes/apple#design-notes-and-trade-offs","content":"This theme maps Apple's system colors and Liquid Glass onto the shared control slots. It does not clone every UIKit or AppKit widget. The official reference is the Apple Human Interface Guidelines."},"2443":{"id":"/docs/themes/apple#14","page_id":"/docs/themes/apple","tags":[],"type":"text","url":"/docs/themes/apple#design-notes-and-trade-offs","content":"**Color.** Light `background`, `card`, and `popover` are white (`#FFFFFF`); `foreground` is black. `primary`, `ring`, and `info` are systemBlue `#007AFF` (`oklch(0.60276 0.21771 257.424)`). Dark `primary` is `oklch(0.62425 0.20558 255.486)`. Light `inset` is `#F2F2F7`. The palette does not inherit a separate `brand`, so `theme.json` compiles `brand` to `var(--primary)`. `tintAlpha` is `0.12`. `scrim` is `oklch(0 0 0 / 0.4)`. The five chart colors are stated system colors, not the default `[brand, info, success, warning, destructive]` ramp."},"2444":{"id":"/docs/themes/apple#15","page_id":"/docs/themes/apple","tags":[],"type":"text","url":"/docs/themes/apple#design-notes-and-trade-offs","content":"**Material.** `appleGlass()` omits `macos.backdrop`, so macOS 26 and later use `NSGlassEffectView` (`glassEffect` and `glassTintColor`). Earlier macOS and the web fall back to `backdropFilter`. The specular highlight is `oklch(1 0 0 / 0.55)` in light and `oklch(1 0 0 / 0.16)` in dark. Optical `liquid-glass` is only on `overlay`, `modal`, `inverse`, and `glass`. Cards have no shadow. Shadows elsewhere are a 0.5px hairline plus a shadow."},"2445":{"id":"/docs/themes/apple#16","page_id":"/docs/themes/apple","tags":[],"type":"text","url":"/docs/themes/apple#design-notes-and-trade-offs","content":"**Radii and density.** `control` / `container` / `modal` are 8 / 12 / 16, with `curve: \"continuous\"`. Pointer button corners are 5 / 6 / 8; touch buttons are `\"full\"`; badges are capsules. Hairline stroke is 0.5; control strokes are 1. Pointer heights are 24 / 28 / 32. Touch heights are 32 / 44 / 56. Keep the 0.5px continuous corners. Do not replace them with a thick border or `curve: \"circular\"`."},"2446":{"id":"/docs/themes/apple#17","page_id":"/docs/themes/apple","tags":[],"type":"text","url":"/docs/themes/apple#design-notes-and-trade-offs","content":"**Controls.** Buttons are not capsules on pointer. Fields keep a four-edge box (the baseline `input` edge), not an underline. Choice is a rounded box, not a circular radio disc. Switch and slider press change geometry (the thumb stretches). There is no drag lens; optical refraction stays on the glass surfaces. Spinner `trackOpacity` is `0`, so no track ring is drawn. `AlertDialog` calls `nsh/base` `AlertDialog.show` on every platform, so this theme's Liquid Glass modal is not applied to alerts."},"2447":{"id":"/docs/themes/material","page_id":"/docs/themes/material","type":"page","content":"Material","breadcrumbs":["Docs","Themes"],"tags":[],"url":"/docs/themes/material"},"2448":{"id":"/docs/themes/material#0","page_id":"/docs/themes/material","tags":[],"type":"text","url":"/docs/themes/material","content":"Material 3 Expressive: tonal surfaces, capsule controls, circular corners, 8/10/10% state layers, and expressive shapes."},"2449":{"id":"/docs/themes/material#1","page_id":"/docs/themes/material","type":"heading","tags":[],"url":"/docs/themes/material#installation","content":"Installation"},"2450":{"id":"/docs/themes/material#2","page_id":"/docs/themes/material","type":"heading","tags":[],"url":"/docs/themes/material#tokens","content":"Tokens"},"2451":{"id":"/docs/themes/material#3","page_id":"/docs/themes/material","type":"heading","tags":[],"url":"/docs/themes/material#the-appearance-roles","content":"The appearance roles"},"2452":{"id":"/docs/themes/material#4","page_id":"/docs/themes/material","type":"heading","tags":[],"url":"/docs/themes/material#the-shared-values","content":"The shared values"},"2453":{"id":"/docs/themes/material#5","page_id":"/docs/themes/material","type":"heading","tags":[],"url":"/docs/themes/material#surfaces","content":"Surfaces"},"2454":{"id":"/docs/themes/material#6","page_id":"/docs/themes/material","type":"heading","tags":[],"url":"/docs/themes/material#design-notes-and-trade-offs","content":"Design notes and trade-offs"},"2455":{"id":"/docs/themes/material#7","page_id":"/docs/themes/material","tags":[],"type":"text","url":"/docs/themes/material","content":"<ThemeIntro id=\"material\" />"},"2456":{"id":"/docs/themes/material#8","page_id":"/docs/themes/material","tags":[],"type":"text","url":"/docs/themes/material#installation","content":"<ThemeInstall id=\"material\" />"},"2457":{"id":"/docs/themes/material#9","page_id":"/docs/themes/material","tags":[],"type":"text","url":"/docs/themes/material#tokens","content":"<ThemeTokenLead />"},"2458":{"id":"/docs/themes/material#10","page_id":"/docs/themes/material","tags":[],"type":"text","url":"/docs/themes/material#the-appearance-roles","content":"<ThemeTokens id=\"material\" group=\"roles\" />"},"2459":{"id":"/docs/themes/material#11","page_id":"/docs/themes/material","tags":[],"type":"text","url":"/docs/themes/material#the-shared-values","content":"<ThemeTokens id=\"material\" group=\"shared\" />"},"2460":{"id":"/docs/themes/material#12","page_id":"/docs/themes/material","tags":[],"type":"text","url":"/docs/themes/material#surfaces","content":"<ThemeSurfaces id=\"material\" />"},"2461":{"id":"/docs/themes/material#13","page_id":"/docs/themes/material","tags":[],"type":"text","url":"/docs/themes/material#design-notes-and-trade-offs","content":"This theme maps Material 3 Expressive onto the shared control slots: tonal surfaces, circular corners, and state layers. It does not clone every Material widget. The official reference is Material Design 3."},"2462":{"id":"/docs/themes/material#14","page_id":"/docs/themes/material","tags":[],"type":"text","url":"/docs/themes/material#design-notes-and-trade-offs","content":"**Color.** Light `background` is `#FEF7FF` (`oklch(0.98379 0.01284 321.894)`). Light `primary` is `#6750A4` (`oklch(0.49552 0.13046 293.709)`). Light `secondary` is `#E8DEF8`. Dark `primary` is `oklch(0.83493 0.09457 298.018)`. `scrim` is `oklch(0 0 0 / 0.32)`. Tints are solid tonal containers for `brand`, `info`, `success`, `warning`, and `destructive`, not a `tintAlpha` wash. After the palette override, `brand` in `theme.json` is `var(--primary)`."},"2463":{"id":"/docs/themes/material#15","page_id":"/docs/themes/material","tags":[],"type":"text","url":"/docs/themes/material#design-notes-and-trade-offs","content":"**Surfaces.** Elevation is tonal steps plus the Material Web double shadow. There is no backdrop blur. `glass` has no `backdropFilter`. `meta.donts`: do not add blur or a border to a tonal container."},"2464":{"id":"/docs/themes/material#16","page_id":"/docs/themes/material","tags":[],"type":"text","url":"/docs/themes/material#design-notes-and-trade-offs","content":"**Radii and density.** `control` / `container` / `modal` are 4 / 12 / 28 (Corner Extra Small / Medium / Extra Large), with `curve: \"circular\"`. Buttons and badges are `\"full\"` at every size. Material 3 has no official desktop density. Pointer heights 24 / 32 / 40 are this library's tier. Touch heights are 32 / 40 / 56. `hit.touch` is 48."},"2465":{"id":"/docs/themes/material#17","page_id":"/docs/themes/material","tags":[],"type":"text","url":"/docs/themes/material#design-notes-and-trade-offs","content":"**Motion and controls.** Press is an 8% hover overlay and a 10% press overlay (`scale` stays 1), not an Android ripple. `themeSwitch` is a `radial-wipe` of 320 ms. Fields are filled: sides have no edge, the bottom edge is `muted-foreground`, and focus is a 2px `brand` underline, not a four-edge box. A selected checkbox face is `primary`. A selected radio face is `none`, so the disc is not filled. Popup corners use `control` (4), not the container radius 12. Switch press expands the thumb. The library does not draw an optional thumb icon."},"2466":{"id":"/docs/themes/nsh-gallery","page_id":"/docs/themes/nsh-gallery","type":"page","content":"NSH Gallery","breadcrumbs":["Docs","Themes"],"tags":[],"url":"/docs/themes/nsh-gallery"},"2467":{"id":"/docs/themes/nsh-gallery#0","page_id":"/docs/themes/nsh-gallery","tags":[],"type":"text","url":"/docs/themes/nsh-gallery","content":"The library's own: graphite surfaces, one citrus accent, 8-point controls and 14-point cards."},"2468":{"id":"/docs/themes/nsh-gallery#1","page_id":"/docs/themes/nsh-gallery","type":"heading","tags":[],"url":"/docs/themes/nsh-gallery#installation","content":"Installation"},"2469":{"id":"/docs/themes/nsh-gallery#2","page_id":"/docs/themes/nsh-gallery","type":"heading","tags":[],"url":"/docs/themes/nsh-gallery#tokens","content":"Tokens"},"2470":{"id":"/docs/themes/nsh-gallery#3","page_id":"/docs/themes/nsh-gallery","type":"heading","tags":[],"url":"/docs/themes/nsh-gallery#the-appearance-roles","content":"The appearance roles"},"2471":{"id":"/docs/themes/nsh-gallery#4","page_id":"/docs/themes/nsh-gallery","type":"heading","tags":[],"url":"/docs/themes/nsh-gallery#the-shared-values","content":"The shared values"},"2472":{"id":"/docs/themes/nsh-gallery#5","page_id":"/docs/themes/nsh-gallery","type":"heading","tags":[],"url":"/docs/themes/nsh-gallery#surfaces","content":"Surfaces"},"2473":{"id":"/docs/themes/nsh-gallery#6","page_id":"/docs/themes/nsh-gallery","tags":[],"type":"text","url":"/docs/themes/nsh-gallery","content":"<ThemeIntro id=\"nsh-gallery\" />"},"2474":{"id":"/docs/themes/nsh-gallery#7","page_id":"/docs/themes/nsh-gallery","tags":[],"type":"text","url":"/docs/themes/nsh-gallery#installation","content":"<ThemeInstall id=\"nsh-gallery\" />"},"2475":{"id":"/docs/themes/nsh-gallery#8","page_id":"/docs/themes/nsh-gallery","tags":[],"type":"text","url":"/docs/themes/nsh-gallery#tokens","content":"<ThemeTokenLead />"},"2476":{"id":"/docs/themes/nsh-gallery#9","page_id":"/docs/themes/nsh-gallery","tags":[],"type":"text","url":"/docs/themes/nsh-gallery#the-appearance-roles","content":"<ThemeTokens id=\"nsh-gallery\" group=\"roles\" />"},"2477":{"id":"/docs/themes/nsh-gallery#10","page_id":"/docs/themes/nsh-gallery","tags":[],"type":"text","url":"/docs/themes/nsh-gallery#the-shared-values","content":"<ThemeTokens id=\"nsh-gallery\" group=\"shared\" />"},"2478":{"id":"/docs/themes/nsh-gallery#11","page_id":"/docs/themes/nsh-gallery","tags":[],"type":"text","url":"/docs/themes/nsh-gallery#surfaces","content":"<ThemeSurfaces id=\"nsh-gallery\" />"},"2479":{"id":"/docs/themes/shadcn","page_id":"/docs/themes/shadcn","type":"page","content":"shadcn/ui","breadcrumbs":["Docs","Themes"],"tags":[],"url":"/docs/themes/shadcn"},"2480":{"id":"/docs/themes/shadcn#0","page_id":"/docs/themes/shadcn","tags":[],"type":"text","url":"/docs/themes/shadcn","content":"shadcn/ui's neutral palette: near-black and near-white fills, flat surfaces, 8-point controls and 14-point cards."},"2481":{"id":"/docs/themes/shadcn#1","page_id":"/docs/themes/shadcn","type":"heading","tags":[],"url":"/docs/themes/shadcn#installation","content":"Installation"},"2482":{"id":"/docs/themes/shadcn#2","page_id":"/docs/themes/shadcn","type":"heading","tags":[],"url":"/docs/themes/shadcn#tokens","content":"Tokens"},"2483":{"id":"/docs/themes/shadcn#3","page_id":"/docs/themes/shadcn","type":"heading","tags":[],"url":"/docs/themes/shadcn#the-appearance-roles","content":"The appearance roles"},"2484":{"id":"/docs/themes/shadcn#4","page_id":"/docs/themes/shadcn","type":"heading","tags":[],"url":"/docs/themes/shadcn#the-shared-values","content":"The shared values"},"2485":{"id":"/docs/themes/shadcn#5","page_id":"/docs/themes/shadcn","type":"heading","tags":[],"url":"/docs/themes/shadcn#surfaces","content":"Surfaces"},"2486":{"id":"/docs/themes/shadcn#6","page_id":"/docs/themes/shadcn","tags":[],"type":"text","url":"/docs/themes/shadcn","content":"<ThemeIntro id=\"shadcn\" />"},"2487":{"id":"/docs/themes/shadcn#7","page_id":"/docs/themes/shadcn","tags":[],"type":"text","url":"/docs/themes/shadcn#installation","content":"<ThemeInstall id=\"shadcn\" />"},"2488":{"id":"/docs/themes/shadcn#8","page_id":"/docs/themes/shadcn","tags":[],"type":"text","url":"/docs/themes/shadcn#tokens","content":"<ThemeTokenLead />"},"2489":{"id":"/docs/themes/shadcn#9","page_id":"/docs/themes/shadcn","tags":[],"type":"text","url":"/docs/themes/shadcn#the-appearance-roles","content":"<ThemeTokens id=\"shadcn\" group=\"roles\" />"},"2490":{"id":"/docs/themes/shadcn#10","page_id":"/docs/themes/shadcn","tags":[],"type":"text","url":"/docs/themes/shadcn#the-shared-values","content":"<ThemeTokens id=\"shadcn\" group=\"shared\" />"},"2491":{"id":"/docs/themes/shadcn#11","page_id":"/docs/themes/shadcn","tags":[],"type":"text","url":"/docs/themes/shadcn#surfaces","content":"<ThemeSurfaces id=\"shadcn\" />"},"2492":{"id":"/docs/themes/solid-glass","page_id":"/docs/themes/solid-glass","type":"page","content":"Solid Glass","breadcrumbs":["Docs","Themes"],"tags":[],"url":"/docs/themes/solid-glass"},"2493":{"id":"/docs/themes/solid-glass#0","page_id":"/docs/themes/solid-glass","tags":[],"type":"text","url":"/docs/themes/solid-glass","content":"Panes of thick smoky glass: a rim of light on each top edge, a hairline round it, a shadow underneath, 11-point controls and 20-point cards."},"2494":{"id":"/docs/themes/solid-glass#1","page_id":"/docs/themes/solid-glass","type":"heading","tags":[],"url":"/docs/themes/solid-glass#installation","content":"Installation"},"2495":{"id":"/docs/themes/solid-glass#2","page_id":"/docs/themes/solid-glass","type":"heading","tags":[],"url":"/docs/themes/solid-glass#tokens","content":"Tokens"},"2496":{"id":"/docs/themes/solid-glass#3","page_id":"/docs/themes/solid-glass","type":"heading","tags":[],"url":"/docs/themes/solid-glass#the-appearance-roles","content":"The appearance roles"},"2497":{"id":"/docs/themes/solid-glass#4","page_id":"/docs/themes/solid-glass","type":"heading","tags":[],"url":"/docs/themes/solid-glass#the-shared-values","content":"The shared values"},"2498":{"id":"/docs/themes/solid-glass#5","page_id":"/docs/themes/solid-glass","type":"heading","tags":[],"url":"/docs/themes/solid-glass#surfaces","content":"Surfaces"},"2499":{"id":"/docs/themes/solid-glass#6","page_id":"/docs/themes/solid-glass","tags":[],"type":"text","url":"/docs/themes/solid-glass","content":"<ThemeIntro id=\"solid-glass\" />"},"2500":{"id":"/docs/themes/solid-glass#7","page_id":"/docs/themes/solid-glass","tags":[],"type":"text","url":"/docs/themes/solid-glass#installation","content":"<ThemeInstall id=\"solid-glass\" />"},"2501":{"id":"/docs/themes/solid-glass#8","page_id":"/docs/themes/solid-glass","tags":[],"type":"text","url":"/docs/themes/solid-glass#tokens","content":"<ThemeTokenLead />"},"2502":{"id":"/docs/themes/solid-glass#9","page_id":"/docs/themes/solid-glass","tags":[],"type":"text","url":"/docs/themes/solid-glass#the-appearance-roles","content":"<ThemeTokens id=\"solid-glass\" group=\"roles\" />"},"2503":{"id":"/docs/themes/solid-glass#10","page_id":"/docs/themes/solid-glass","tags":[],"type":"text","url":"/docs/themes/solid-glass#the-shared-values","content":"<ThemeTokens id=\"solid-glass\" group=\"shared\" />"},"2504":{"id":"/docs/themes/solid-glass#11","page_id":"/docs/themes/solid-glass","tags":[],"type":"text","url":"/docs/themes/solid-glass#surfaces","content":"<ThemeSurfaces id=\"solid-glass\" />"},"2505":{"id":"/docs/themes/winui","page_id":"/docs/themes/winui","type":"page","content":"WinUI 3","breadcrumbs":["Docs","Themes"],"tags":[],"url":"/docs/themes/winui"},"2506":{"id":"/docs/themes/winui#0","page_id":"/docs/themes/winui","tags":[],"type":"text","url":"/docs/themes/winui","content":"WinUI 3 (Windows 11): WinUI fill and stroke tokens, 4/8-point circular corners, Segoe UI Variable, Consolas, double focus rings, and timing motion."},"2507":{"id":"/docs/themes/winui#1","page_id":"/docs/themes/winui","type":"heading","tags":[],"url":"/docs/themes/winui#installation","content":"Installation"},"2508":{"id":"/docs/themes/winui#2","page_id":"/docs/themes/winui","type":"heading","tags":[],"url":"/docs/themes/winui#tokens","content":"Tokens"},"2509":{"id":"/docs/themes/winui#3","page_id":"/docs/themes/winui","type":"heading","tags":[],"url":"/docs/themes/winui#the-appearance-roles","content":"The appearance roles"},"2510":{"id":"/docs/themes/winui#4","page_id":"/docs/themes/winui","type":"heading","tags":[],"url":"/docs/themes/winui#the-shared-values","content":"The shared values"},"2511":{"id":"/docs/themes/winui#5","page_id":"/docs/themes/winui","type":"heading","tags":[],"url":"/docs/themes/winui#surfaces","content":"Surfaces"},"2512":{"id":"/docs/themes/winui#6","page_id":"/docs/themes/winui","type":"heading","tags":[],"url":"/docs/themes/winui#design-notes-and-trade-offs","content":"Design notes and trade-offs"},"2513":{"id":"/docs/themes/winui#7","page_id":"/docs/themes/winui","tags":[],"type":"text","url":"/docs/themes/winui","content":"<ThemeIntro id=\"winui\" />"},"2514":{"id":"/docs/themes/winui#8","page_id":"/docs/themes/winui","tags":[],"type":"text","url":"/docs/themes/winui#installation","content":"<ThemeInstall id=\"winui\" />"},"2515":{"id":"/docs/themes/winui#9","page_id":"/docs/themes/winui","tags":[],"type":"text","url":"/docs/themes/winui#tokens","content":"<ThemeTokenLead />"},"2516":{"id":"/docs/themes/winui#10","page_id":"/docs/themes/winui","tags":[],"type":"text","url":"/docs/themes/winui#the-appearance-roles","content":"<ThemeTokens id=\"winui\" group=\"roles\" />"},"2517":{"id":"/docs/themes/winui#11","page_id":"/docs/themes/winui","tags":[],"type":"text","url":"/docs/themes/winui#the-shared-values","content":"<ThemeTokens id=\"winui\" group=\"shared\" />"},"2518":{"id":"/docs/themes/winui#12","page_id":"/docs/themes/winui","tags":[],"type":"text","url":"/docs/themes/winui#surfaces","content":"<ThemeSurfaces id=\"winui\" />"},"2519":{"id":"/docs/themes/winui#13","page_id":"/docs/themes/winui","tags":[],"type":"text","url":"/docs/themes/winui#design-notes-and-trade-offs","content":"This theme maps Fluent 2 and WinUI 3 onto the shared control slots: Accent blue, 4- and 8-point circular corners, in-app Acrylic, and decelerating motion. It does not clone every WinUI control. The official reference is Windows App Design."},"2520":{"id":"/docs/themes/winui#14","page_id":"/docs/themes/winui","tags":[],"type":"text","url":"/docs/themes/winui#design-notes-and-trade-offs","content":"**Color.** Light `background` is `#F3F3F3` (`oklch(0.96415 0 0)`). Light `primary` and `info` are `#005FB8`. Light `brand` is `#003E92`. Dark `primary` and `info` are `#60CDFF`. Dark `brand` is `oklch(0.8943 0.08425 214.859)`. Info tints are solid: light `#E5F1FB`, dark `#1E3246`. `scrim` is `oklch(0 0 0 / 0.302)`. Chart colors are `primary`, `success`, `warning`, `destructive`, and `input`."},"2521":{"id":"/docs/themes/winui#15","page_id":"/docs/themes/winui","tags":[],"type":"text","url":"/docs/themes/winui#design-notes-and-trade-offs","content":"**Material.** Component material is in-app Acrylic (`kind: \"acrylic\"` plus `acrylic-noise`), not window Mica. Mica is the app shell's `window.backdrop`. This library falls back to Acrylic or an opaque fill. The specular highlight is `oklch(1 0 0 / 0.6)` in light and `oklch(1 0 0 / 0.09)` in dark. `raised` is a translucent top and bottom edge, with no drop shadow. Cards have a translucent black edge and no shadow."},"2522":{"id":"/docs/themes/winui#16","page_id":"/docs/themes/winui","tags":[],"type":"text","url":"/docs/themes/winui#design-notes-and-trade-offs","content":"**Radii and motion.** `control` / `container` / `modal` are 4 / 8 / 8, with `curve: \"circular\"`. Do not switch the curve to `continuous`. Durations are 83 / 167 / 250 / 333 ms, decelerating, with a damping ratio of at least 1 and no overshoot. Focus is a double ring (width 2, offset 0). Hover swaps color. It is not an overlay."},"2523":{"id":"/docs/themes/winui#17","page_id":"/docs/themes/winui","tags":[],"type":"text","url":"/docs/themes/winui#design-notes-and-trade-offs","content":"**Controls.** Buttons stay at the control radius 4. They are not capsules. Press swaps color. Fields are a box: four edges in `line`, a stronger bottom edge in `input`, and a 2px `brand` focus line. Choice and radio both fill with `primary`. Switch press only widens the thumb. Slider and progress tracks use `input`, not a brand fill."},"2524":{"id":"/docs/themes","page_id":"/docs/themes","type":"page","content":"Themes","breadcrumbs":["Docs"],"tags":[],"url":"/docs/themes"},"2525":{"id":"/docs/themes#0","page_id":"/docs/themes","tags":[],"type":"text","url":"/docs/themes","content":"The palettes the demos can draw in: what a theme is, the radius layers, and a page for each palette."},"2526":{"id":"/docs/themes#1","page_id":"/docs/themes","type":"heading","tags":[],"url":"/docs/themes#one-look-more-than-one-palette","content":"One look, more than one palette"},"2527":{"id":"/docs/themes#2","page_id":"/docs/themes","type":"heading","tags":[],"url":"/docs/themes#radii-by-role","content":"Radii by role"},"2528":{"id":"/docs/themes#3","page_id":"/docs/themes","tags":[],"type":"text","url":"/docs/themes#one-look-more-than-one-palette","content":"A theme is one `AppTheme`: the TypeScript spec `defineTheme()` compiles — tokens, metrics, elevation,\neleven surfaces, feedback, motion and controls — and the `theme.json` that same build exports from it\n(the roles of both appearances, three `radius-*` layer lengths and the fixed `scrim` / `media` /\n`on-media` values). A theme that ships beside another is a sparse delta over it, so it states only\nwhat it changes. An app is _built_ with one theme and can _carry_ more, switching between them while\nit runs with `selectTheme`."},"2529":{"id":"/docs/themes#4","page_id":"/docs/themes","tags":[],"type":"text","url":"/docs/themes#one-look-more-than-one-palette","content":"Each built-in theme distills the visual style of its design system — colors, radii, surfaces, and\nmotion — rather than replicating every platform widget 1:1. Apple, Material, and WinUI record that\nmapping under Design notes and trade-offs. A theme of your own is Customizing."},"2530":{"id":"/docs/themes#5","page_id":"/docs/themes","tags":[],"type":"text","url":"/docs/themes#one-look-more-than-one-palette","content":"Every demo on this site can be drawn in any of these palettes: pick one with the **Demo theme**\nswitch in the nav, and the previews load again in it. The panel above is the showcase — buttons, a\ncard with a field, badges, switches, a slider and a progress bar, with the card, inset and press surfaces\nthe palette brings. The list is `apps/website/demos/palettes.ts`. Each palette has its own page,\nwith the same sections: how to install it, every token it sets, and every surface it draws. Those\npages read each theme's own spec. The contract is\n`docs/theme.md`."},"2531":{"id":"/docs/themes#6","page_id":"/docs/themes","tags":[],"type":"text","url":"/docs/themes#radii-by-role","content":"`theme.json` states one corner radius per layer in `cssVars.theme` — `radius-md` (in-page\nelements), `radius-lg` (cards, menus, popovers, toasts) and `radius-xl` (dialogs, sheets) —\nand `control(\"button\").corner.*` makes buttons capsules (`material`, touch `apple`) or points / `control` (the rest). A surface nested in\nanother takes the concentric corner, `rounded(outer, inset)`. Every corner that reads a theme radius\nuses `shape.curve` (`\"continuous\"` or `\"circular\"`), which `rounded()` applies in one place."},"2532":{"id":"/docs/themes#7","page_id":"/docs/themes","tags":[],"type":"text","url":"/docs/themes#radii-by-role","content":"<ThemeIndex />"}},"count":2532},"sorting":{"language":"multilingual","sortableProperties":["content","page_id","type","url"],"sortablePropertiesWithTypes":{"content":"string","page_id":"string","type":"string","url":"string"},"sorts":{"content":{"docs":{"1":1284,"2":1735,"3":1869,"4":2494,"5":1281,"6":1933,"7":2503,"8":2285,"9":403,"10":401,"11":402,"12":400,"13":399,"14":160,"15":894,"16":1927,"17":999,"18":17,"19":16,"20":15,"21":982,"22":2241,"23":1986,"24":1542,"25":2223,"26":333,"27":327,"28":335,"29":331,"30":2212,"31":1739,"32":1710,"33":1420,"34":2276,"35":1513,"36":1419,"37":1599,"38":1757,"39":1153,"40":1879,"41":2492,"42":1528,"43":1730,"44":1391,"45":2024,"46":209,"47":28,"48":2529,"49":379,"50":389,"51":387,"52":386,"53":376,"54":1862,"55":1752,"56":1740,"57":1504,"58":1901,"59":380,"60":378,"61":388,"62":390,"63":372,"64":932,"65":2197,"66":1908,"67":1882,"68":381,"69":391,"70":373,"71":29,"72":1973,"73":382,"74":374,"75":1439,"76":383,"77":375,"78":2527,"79":362,"80":361,"81":360,"82":1597,"83":2209,"84":2286,"85":1392,"86":2104,"87":370,"88":384,"89":2025,"90":371,"91":377,"92":385,"93":207,"94":1147,"95":1880,"96":1765,"97":2332,"98":1442,"99":1603,"100":1541,"101":1129,"102":1997,"103":1496,"104":1198,"105":1287,"106":2458,"107":2264,"108":93,"109":196,"110":274,"111":2472,"112":707,"113":521,"114":580,"115":53