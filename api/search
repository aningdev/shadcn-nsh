card or control, a hairline inside one, and an input's edge |"],[2360,"| Role                        | Use                                   |\n| --------------------------- | ------------------------------------- |\n| `background` / `foreground` | The page, and the ink that sits on it |"],[2366,"| Role                   | Use                                                                |\n| ---------------------- | ------------------------------------------------------------------ |\n| `secondary` / `accent` | A second fill, and the fill a selected row or a hovered item takes |"],[2361,"| Role               | Use                                                             |\n| ------------------ | --------------------------------------------------------------- |\n| `card` / `popover` | A surface that holds content, and one that floats over the page |"],[2379,"| Role      | Use                                                                |\n| --------- | ------------------------------------------------------------------ |\n| `channel` | The groove a filled track runs in: a slider's rail, a progress bar |"],[2381,"| Role      | Use                                                                |\n| --------- | ------------------------------------------------------------------ |\n| `overlay` | A surface the page floats over: a menu, a popover, a select's list |"],[2363,"| Role      | Use                                                 |\n| --------- | --------------------------------------------------- |\n| `surface` | The tone one step above the page: a control at rest |"],[2383,"| Role      | Use                                      |\n| --------- | ---------------------------------------- |\n| `inverse` | The reversed surface: a toast, a tooltip |"],[2385,"| Role     | Use                                                           |\n| -------- | ------------------------------------------------------------- |\n| `accent` | The brand's own surface: a filled button, a switch that is on |"],[2377,"| Role     | Use                                                        |\n| -------- | ---------------------------------------------------------- |\n| `raised` | A surface above the page: a button at rest, a chip, a pill |"],[2378,"| Role    | Use                                                    |\n| ------- | ------------------------------------------------------ |\n| `inset` | A surface sunk into its host: a field, a track, a well |"],[2382,"| Role    | Use                                             |\n| ------- | ----------------------------------------------- |\n| `modal` | A surface the page waits for: a dialog, a sheet |"],[2380,"| Role    | Use                                            |\n| ------- | ---------------------------------------------- |\n| `plate` | The plate a row or a group of controls sits on |"],[2384,"| Role    | Use                    |\n| ------- | ---------------------- |\n| `glass` | A control over a photo |"],[2367,"| Role    | Use               |\n| ------- | ----------------- |\n| `brand` | The accent as ink |"],[2364,"| Role    | Use               |\n| ------- | ----------------- |\n| `faint` | The quietest text |"],[2386,"| Role   | Use                                                      |\n| ------ | -------------------------------------------------------- |\n| `fill` | The accent's gradient face: a primary button's highlight |"],[2376,"| Role   | Use                                             |\n| ------ | ----------------------------------------------- |\n| `card` | A surface that holds content: a card, a section |"],[2369,"| Role   | Use                        |\n| ------ | -------------------------- |\n| `ring` | The keyboard focus outline |"],[1944,"| Size      | Track (`nsh-gallery` / `solid-glass`)      | Knob      |\n| --------- | ------------------------------------------ | --------- |\n| `default` | `icon.md` + 4 high, 2 × `icon.md` + 4 long | `icon.md` |"],[1945,"| Size | Track (`nsh-gallery` / `solid-glass`)      | Knob      |\n| ---- | ------------------------------------------ | --------- |\n| `sm` | `icon.sm` + 4 high, 2 × `icon.sm` + 4 long | `icon.sm` |"],[2300,"| Surface        | Role                                                             |\n| -------------- | ---------------------------------------------------------------- |\n| `apps/website` | Public docs; `apps/website/demos/<id>.tsx` is the page's preview |"],[2301,"| Surface        | Role                                                          |\n| -------------- | ------------------------------------------------------------- |\n| `apps/gallery` | Native behavior tests and smoke pages for the same components |"],[2401,"| Theme               | `control` | `container` | `modal` | Buttons   |\n| ------------------- | --------- | ----------- | ------- | --------- |\n| `default`, `shadcn` | 8         | 12          | 14      | `control` |"],[2402,"| Theme         | `control` | `container` | `modal` | Buttons   |\n| ------------- | --------- | ----------- | ------- | --------- |\n| `solid-glass` | 11        | 14          | 20      | `control` |"],[2404,"| Theme      | `control` | `container` | `modal` | Buttons |\n| ---------- | --------- | ----------- | ------- | ------- |\n| `material` | 4         | 12          | 28      | capsule |"],[2405,"| Theme   | `control` | `container` | `modal` | Buttons   |\n| ------- | --------- | ----------- | ------- | --------- |\n| `winui` | 4         | 8           | 8       | `control` |"],[2403,"| Theme   | `control` | `container` | `modal` | Buttons |\n| ------- | --------- | ----------- | ------- | ------- |\n| `apple` | 8         | 12          | 26      | capsule |"],[1766,"⌘B on Apple platforms, Ctrl+B elsewhere, folds the column and opens it — `keymap.bind(\"mod+b\")`,\nmade where the provider draws and gone with it. The rail at the column's inner edge takes a press\ntoo: it is 8 points wide (16 wide to a press, past its bounds with `hitSlop