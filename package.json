{
  "name": "shadcn-nsh-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "nsh:bootstrap": "bash scripts/nsh-bootstrap.sh",
    "prepare:types": "nsh check apps/gallery && nsh check apps/docs/demos",
    "dev:gallery": "nsh run apps/gallery",
    "check:gallery": "nsh check apps/gallery",
    "dev:docs": "bun --filter @shadcn-nsh/docs dev",
    "build:docs": "bun run docs:demos && bun --filter @shadcn-nsh/docs build",
    "check:docs": "bun --filter @shadcn-nsh/docs check",
    "docs:demos": "bun apps/docs/scripts/build-demos.ts",
    "docs:components": "bun apps/docs/scripts/build-components.ts && vp fmt apps/docs/src/lib/components.generated.ts",
    "check:pages": "bun apps/docs/scripts/check-pages.ts",
    "catalog": "bun scripts/catalog.ts",
    "registry:build": "bun scripts/registry-build.ts",
    "registry:serve": "bun packages/cli/src/index.ts serve",
    "shadcn-nsh": "bun packages/cli/src/index.ts",
    "cli:build": "bun --filter shadcn-nsh build",
    "check": "vp check --fix && bun run catalog --check && bun run port:check && bun run port:coverage && nsh check apps/docs/demos && nsh check apps/gallery && bun run check:pages && bun run check:docs",
    "test:gallery": "nsh test apps/gallery",
    "test:install": "bun scripts/install-test.ts",
    "test:unit": "bun test ./packages/cli ./scripts/theme ./scripts/catalog.test.ts",
    "shots": "bash scripts/shots.sh",
    "port:vendor": "bun scripts/port/vendor.ts",
    "port:check": "bun scripts/port/check.ts",
    "port:render": "bun scripts/port/render.ts",
    "port:render:touch": "bun scripts/port/render-touch.ts",
    "port:new": "bun scripts/port/new.ts",
    "port:bump": "bun scripts/port/bump.ts",
    "port:coverage": "bun scripts/port/coverage.ts",
    "port:sheet": "bun scripts/port/sheet.ts",
    "port:baseline": "bun scripts/port/baseline.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "oxc-parser": "^0.158.0",
    "typescript": "7.1.0-beta",
    "vite-plus": "^1.4.0"
  }
}
