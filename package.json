{
  "name": "shadcn-nsh-monorepo",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare:types": "nsh check apps/gallery && nsh check apps/website/demos && nsh check apps/showcase",
    "dev:gallery": "nsh run apps/gallery",
    "dev:showcase": "nsh run apps/showcase",
    "check:gallery": "nsh check apps/gallery",
    "dev:docs": "bun --filter @shadcn-nsh/website dev",
    "build:docs": "nsh check apps/website/demos && bun run docs:demos && bun --filter @shadcn-nsh/website build && bun run check:size",
    "check:docs": "bun --filter @shadcn-nsh/website check",
    "docs:demos": "bun apps/website/scripts/build-demos.ts",
    "docs:components": "bun apps/website/scripts/build-components.ts && vp fmt apps/website/src/lib/components.generated.ts",
    "docs:semantics": "bun scripts/theme/semantics.ts",
    "check:pages": "bun apps/website/scripts/check-pages.ts",
    "check:size": "bun apps/website/scripts/check-site-size.ts",
    "check:theme": "bun scripts/theme/check.ts",
    "check:ui": "bun scripts/lint/ui.ts",
    "check:palette": "bun apps/website/scripts/check-palette.ts",
    "check:narrow": "bun scripts/lint/narrow.ts",
    "check:demos": "bun scripts/lint/demos.ts",
    "new:component": "bun scripts/scaffold/new-component.ts",
    "check:first-frame": "bun apps/website/scripts/check-first-frame.ts",
    "catalog": "bun scripts/registry/catalog.ts",
    "registry:build": "bun scripts/registry/build.ts",
    "registry:serve": "bun packages/cli/src/index.ts serve",
    "shadcn-nsh": "bun packages/cli/src/index.ts",
    "cli:build": "bun --filter shadcn-nsh build",
    "check": "vp check --fix && bun run cli:build && bun --filter shadcn-nsh typecheck && bun run catalog --check && bun run check:theme && bun run check:ui && bun run registry:build --check && bun run check:demos && nsh check apps/website/demos && nsh check apps/gallery && nsh check apps/showcase && bun run check:pages && bun run check:docs",
    "test:gallery": "nsh test apps/gallery",
    "test:install": "bun scripts/registry/install-test.ts",
    "test:unit": "bun test ./packages/cli ./packages/theme ./scripts ./apps/website/scripts",
    "theme:build": "bun scripts/theme/build.ts",
    "theme:diff": "bun scripts/theme/diff.ts",
    "theme:contrast": "bun scripts/theme/contrast.ts",
    "release:verify": "bun scripts/release/verify.ts"
  },
  "devDependencies": {
    "@google/design.md": "^0.4.0",
    "@material/material-color-utilities": "^0.4.0",
    "@types/bun": "^1.4.5",
    "@types/node": "^26.6.11",
    "oxc-parser": "^0.160.0",
    "typescript": "^7.0.2",
    "vite-plus": "^1.8.0"
  },
  "engines": {
    "nsh": "v0.7.2"
  },
  "packageManager": "bun@1.4.4"
}
